<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The client dials a game server, and the JS5/on-demand cache producers
         fetch archives over the same stack. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      NO storage permission, deliberately.

      Everything the client reads lives under the app's own external files
      directory (Android/data/com.torirs.client/files), which an app may always
      read and write without asking and which `adb push` can reach. Requesting
      WRITE_EXTERNAL_STORAGE would add a runtime prompt on API 23+, do nothing
      at all on API 29+ (scoped storage), and buy access this app never needs.
    -->

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!--
      GLES2 is the ceiling the GPU renderer is written to, and it is only ever
      opted into with the webgl1 flag. required="false" because the software rasterizer is
      the default path and a device with no usable GL driver still runs the
      client perfectly well.
    -->
    <uses-feature android:glEsVersion="0x00020000" android:required="false" />

    <!--
      Both icon forms ship. roundIcon is only consulted by launchers that ask
      for a circular icon; icon is what everything else uses. On API 26+ both
      resolve to mipmap-anydpi-v26/*.xml (the adaptive pair) rather than the
      square PNG beside them, and minSdk here is 21, so those PNGs are not
      vestigial: they are what an API 21 to 25 device actually shows.

      Every one of these is generated from res/torirs_icon.jpg by
      tools/make_app_icons.py. Edit the source image, re-run the tool.
    -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <!--
          The boot menu: pick a profile, or wait and take the default.

          Orientation is FREE here, unlike the client below. The menu is a
          vertical list of rows and reads better in portrait than in landscape,
          where four rows fill the screen and the rest need scrolling; and a
          phone picked up to choose something is usually being held upright.
          The client is a different case  -  its canvas is a 765x503 landscape
          frame, so portrait would letterbox it into a band.

          configChanges keeps the activity ALIVE across a rotation rather than
          recreating it. The view tree is built in code and re-lays-out on its
          own, and surviving the rotation is what stops the boot countdown
          restarting from the top every time the phone is turned.
        -->
        <activity
            android:name=".BootActivity"
            android:exported="true"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The gear button's screen: edit where a profile's server is. -->
        <activity
            android:name=".ProfileEditorActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize" />

        <!--
          The client itself.

          configChanges lists everything it handles ITSELF: the native frame
          loop owns the Surface, and letting Android destroy and recreate the
          activity on a rotation would tear down a running world to build the
          same one back. The surface still changes size, and that arrives
          through surfaceChanged like any other resize.
        -->
        <activity
            android:name=".ClientActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|keyboard|navigation|uiMode|density" />

    </application>

</manifest>

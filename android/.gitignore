# Android build artifacts
build/
.gradle/
.cxx/
gradle-app.setting

# Debug keystore (regenerable)
*.keystore

# Local configuration files
local.properties
gradle.properties

# Generated files
.cxx/
.externalNativeBuild/

# IDE files
.idea/*
!.idea/codeStyles/
!.idea/misc.xml
!.idea/modules.xml
!.idea/vcs.xml
*.iml


# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log

# APK files (unless you want to commit them)
*.apk
*.aab

# The native client, built by `make -C src PLATFORM=android` straight into this
# tree so a native rebuild is what the next `gradlew assemble` packages. It is a
# BUILD OUTPUT, exactly like src/torirs or src/torirs.exe, and belongs in the
# repository no more than they do -- it is ~27 MB per ABI and changes on every
# compile. android/README.md says how to produce it.
src/main/jniLibs/*/*.so

# Pushed to the device instead of packaged: the client reads its cache with
# ordinary stdio, and an APK asset is not a file. See android/README.md.
src/main/assets/

# Temporary files
*.tmp
*.bak
*.swp
*~.nib

# NDK generated files
obj/
libs/
*.o
*.a

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# Proguard
proguard/

.cxx/
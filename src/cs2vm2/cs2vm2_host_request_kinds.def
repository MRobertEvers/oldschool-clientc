/*
 * Hosted CS2 opcodes, as a strict subsequence of cs2_opcode.h.
 *
 * The suffix is deliberately shared by CS2_OP_<suffix>,
 * CS2VM_HOST_REQUEST_<suffix>, struct CS2VM_HostRequest_<suffix>, and the
 * request union arm. The numeric argument records and tests canonical opcode
 * ordering; the final argument selects only the private field layout. There
 * must be exactly one entry per opcode and one public payload identity per row.
 */

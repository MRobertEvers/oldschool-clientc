/*
 * Hosted CS2 opcodes, as a strict subsequence of cs2_opcode.h.
 *
 * The suffix is deliberately shared by CS2_OP_<suffix> and
 * CS2VM_HOST_REQUEST_<suffix>; the numeric argument records and tests the
 * canonical opcode ordering. There must be exactly one entry per opcode.
 */

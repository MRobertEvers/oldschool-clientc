[oploc1,viking_crate]
anim(human_pickuptable, 0);
sound_synth(pick2, 1, 0);
p_delay(1);
if (%varp7_mock_quest_progress = 2) {
    mes("You find a bucket in the crate.");
    inv_add(inv, bucket_empty, 1);
    %varp7_mock_quest_progress = 3;
} else {
    mes("There is nothing interesting in the crate.");
}

[aploc2,viking_crate]
if (stat(strength) < 10) {
    mes("You are not strong enough.");
    return;
}
loc_change(viking_crate_2, 50);
~chatplayer("Ow, my foot.");

[oplocu,viking_crate]
if (last_useitem = hammer) {
    if (inv_total(inv, hammer) < 1) {
        mes("You need a hammer.");
        return;
    }
    p_telejump(0_50_50_10_10);
    return;
}
if (last_useitem = coins) {
    inv_del(inv, coins, 10);
    if (inv_total(inv, coins) = 0) {
        mes("Broke.");
    }
    return;
}
~displaymessage(^dm_default);

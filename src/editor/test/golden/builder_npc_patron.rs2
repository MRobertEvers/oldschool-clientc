[opnpc1,port_roberts_bar_patron]
@ed_port_roberts_bar_patron_talk;

[opnpcu,port_roberts_bar_patron]
@ed_port_roberts_bar_patron_talk;

[label,ed_port_roberts_bar_patron_talk]
~chatnpc_anim(^chat_neutral, "Welcome to the bar, <displayname>. What can I get you?");
@ed_port_roberts_bar_patron_ask;

[label,ed_port_roberts_bar_patron_ask]
def_int $choice_ask = ~p_choice3("A beer, please.", 1, "Any work going?", 2, "Nothing, thanks.", 3);
if ($choice_ask = 1) {
    ~chatplayer_anim(^chat_happy, "A beer, please.");
    if (inv_total(inv, coins) < 2) {
        mes("You can't afford a beer.");
        return;
    }
    ~objbox(beer, "The patron hands you a beer.");
    @ed_port_roberts_bar_patron_thanks;
} else if ($choice_ask = 2) {
    if (%varp7_mock_quest_progress < 2) {
        ~chatnpc_anim(^chat_neutral, "Clean the tables and I'll see you right.");
        %varp7_mock_quest_progress = 2;
        @ed_port_roberts_bar_patron_thanks;
    } else {
        ~chatnpc_anim(^chat_sad, "Not today. Anything else?");
        @ed_port_roberts_bar_patron_ask;
    }
} else if ($choice_ask = 3) {
    @ed_port_roberts_bar_patron_bye;
}

[label,ed_port_roberts_bar_patron_thanks]
~chatplayer("Thanks.");
@ed_port_roberts_bar_patron_bye;

[label,ed_port_roberts_bar_patron_bye]

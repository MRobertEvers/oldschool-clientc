// Men, women and guards. LostCity's man.rs2 and guard.rs2, reduced to the
// coins-and-bones core: the full tables reach for herbs, runes and a clue
// scroll, none of which this tree models.

[ai_queue3,man] @human_drop_table;
[ai_queue3,man_alt] @human_drop_table;
[ai_queue3,man_alt2] @human_drop_table;
[ai_queue3,man_alt3] @human_drop_table;
[ai_queue3,woman] @human_drop_table;
[ai_queue3,woman_alt] @human_drop_table;
[ai_queue3,drunken_man] @human_drop_table;

[label,human_drop_table]

def_int $rng = random(128);
if ($rng < 25) {
    obj_add(npc_coord, coins, 3, ^lootdrop_duration);
} else if ($rng < 40) {
    obj_add(npc_coord, coins, 8, ^lootdrop_duration);
} else if ($rng < 45) {
    obj_add(npc_coord, coins, 15, ^lootdrop_duration);
}

[ai_queue3,guard]
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

def_int $rng = random(128);
if ($rng < 32) {
    obj_add(npc_coord, coins, 30, ^lootdrop_duration);
} else if ($rng < 48) {
    obj_add(npc_coord, coins, 18, ^lootdrop_duration);
} else if ($rng < 52) {
    obj_add(npc_coord, bronze_sword, 1, ^lootdrop_duration);
}

// https://oldschool.runescape.wiki/w/Goblin#Drops
//
// Ported from LostCity's content/scripts/drop tables/scripts/goblin.rs2 with
// the members-only and quest branches removed and the runes it drops replaced
// by ones this content tree has symbols for. The shape is the reference's: one
// `random(128)` roll walked as a chain of thresholds, plus the config's
// death_drop unconditionally.
//
// Every goblin variant OpenRune spawns around Lumbridge shares the table.

[ai_queue3,goblin] @goblin_drop_table;
[ai_queue3,goblin_armed] @goblin_drop_table;
[ai_queue3,goblin_armed_2] @goblin_drop_table;
[ai_queue3,goblin_unarmed] @goblin_drop_table;
[ai_queue3,goblin_12] @goblin_drop_table;
[ai_queue3,goblin_15] @goblin_drop_table;

[label,goblin_drop_table]

obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

def_int $dropint = random(128);

if ($dropint < 1) {
    obj_add(npc_coord, coins, 1, ^lootdrop_duration);
} else if ($dropint < 7) {
    obj_add(npc_coord, coins, 20, ^lootdrop_duration);
} else if ($dropint < 10) {
    obj_add(npc_coord, coins, 15, ^lootdrop_duration);
} else if ($dropint < 13) {
    obj_add(npc_coord, coins, 9, ^lootdrop_duration);
} else if ($dropint < 19) {
    obj_add(npc_coord, air_rune, 4, ^lootdrop_duration);
} else if ($dropint < 22) {
    obj_add(npc_coord, bronze_arrow, 8, ^lootdrop_duration);
} else if ($dropint < 39) {
    obj_add(npc_coord, goblin_mail, 1, ^lootdrop_duration);
} else if ($dropint < 45) {
    obj_add(npc_coord, mind_rune, 6, ^lootdrop_duration);
} else if ($dropint < 63) {
    obj_add(npc_coord, coins, 5, ^lootdrop_duration);
}

// Chickens, cows, rats and ducks — the things a new character kills first.
// LostCity's chicken.rs2 and cow.rs2, trimmed to what this tree has symbols
// for. The bones come from the config's death_drop; everything else is here.

[ai_queue3,chicken]
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);
obj_add(npc_coord, raw_chicken, 1, ^lootdrop_duration);

def_int $rng = random(128);
if ($rng < 32) {
    obj_add(npc_coord, feather, 15, ^lootdrop_duration);
} else if ($rng < 64) {
    obj_add(npc_coord, feather, 5, ^lootdrop_duration);
}

[ai_queue3,cow]
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);
obj_add(npc_coord, cowhide, 1, ^lootdrop_duration);
obj_add(npc_coord, raw_beef, 1, ^lootdrop_duration);

[ai_queue3,rat]
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

[ai_queue3,duck]
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

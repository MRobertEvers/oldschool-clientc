// Combat parameters.
//
// Names, types and defaults are LostCity's
// (content/scripts/skill_combat/configs/combat.param) verbatim, because
// content written against one has to mean the same thing in the other. This is
// the subset the mock's engine reads; the rest of LostCity's file declares
// projectiles, poison and special attacks, which nothing here implements yet.
//
// A weapon or an npc almost never states these by hand: `mock230_content`
// seeds every one of them from the OldSchool cache's own param table, which
// carries exactly this data keyed by the param ids OpenRune's ParamMapper
// documents (0-11 for the bonuses, 14 for attackrate). A `param=` line in a
// .npc or .obj overrides what the cache said, and should be rare enough to
// need a comment when it appears.

[stabattack]
type=int
default=0
autodisable=yes

[slashattack]
type=int
default=0
autodisable=yes

[crushattack]
type=int
default=0
autodisable=yes

[magicattack]
type=int
default=0
autodisable=yes

[rangeattack]
type=int
default=0
autodisable=yes

[stabdefence]
type=int
default=0
autodisable=yes

[slashdefence]
type=int
default=0
autodisable=yes

[crushdefence]
type=int
default=0
autodisable=yes

[magicdefence]
type=int
default=0
autodisable=yes

[rangedefence]
type=int
default=0
autodisable=yes

[strengthbonus]
type=int
default=0
autodisable=yes

[prayerbonus]
type=int
default=0
autodisable=yes

[rangebonus]
type=int
default=0
autodisable=yes

[attackrange]
type=int
default=1
autodisable=yes

[attackrate]
type=int
default=4
autodisable=yes

// 0 stab, 1 slash, 2 crush. Which of the three defence bonuses a hit is rolled
// against, and which of the player's attack bonuses does the rolling.
[damagetype]
type=int
default=2

[slashattack_anim]
type=seq
default=human_unarmedpunch
autodisable=yes

[defend_anim]
type=seq
default=human_unarmedblock
autodisable=yes

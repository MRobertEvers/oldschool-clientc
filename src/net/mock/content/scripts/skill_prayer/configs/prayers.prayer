// The 29 prayers, in the order the prayer book lists them — which is by level,
// and which is also the order the engine's `prayer_active` mask numbers them in.
//
// LostCity keeps this as one `.dbrow` per prayer over a `prayers` `.dbtable`,
// with the drain rates and headicons in `.enum`s beside it. This is the same
// table in the `[symbol]` + `key=value` shape the rest of this tree uses; a
// `.dbtable` reader would be a second config grammar for one table of 29 rows.
// The field names are the reference's.
//
//   button    the component that toggles it, from pack/component.pack. Named
//             rather than derived: the book has 30 buttons and this revision
//             fills 29, so "first button plus index" is true today and not by
//             design.
//   drain     units per tick, weighed against 60 + 2 * prayer bonus. The
//             1/6/12/24 pattern is OldSchool's and is not a smooth curve.
//   group     what the prayer boosts. Two prayers sharing any group cannot be
//             up together, so the combat prayers claim three lines each.
//   headicon  the overhead sprite, from prayers.constant. Omitted for the
//             prayers that draw none.

[prayer_thick_skin]
name=Thick Skin
button=prayerbook_prayer1
level=1
drain=1
group=defence

[prayer_burst_of_strength]
name=Burst of Strength
button=prayerbook_prayer2
level=4
drain=1
group=strength

[prayer_clarity_of_thought]
name=Clarity of Thought
button=prayerbook_prayer3
level=7
drain=1
group=attack

[prayer_sharp_eye]
name=Sharp Eye
button=prayerbook_prayer4
level=8
drain=1
group=ranged

[prayer_mystic_will]
name=Mystic Will
button=prayerbook_prayer5
level=9
drain=1
group=magic

[prayer_rock_skin]
name=Rock Skin
button=prayerbook_prayer6
level=10
drain=6
group=defence

[prayer_superhuman_strength]
name=Superhuman Strength
button=prayerbook_prayer7
level=13
drain=6
group=strength

[prayer_improved_reflexes]
name=Improved Reflexes
button=prayerbook_prayer8
level=16
drain=6
group=attack

// Rapid Restore, Rapid Heal, Protect Item and Preserve claim no group: they

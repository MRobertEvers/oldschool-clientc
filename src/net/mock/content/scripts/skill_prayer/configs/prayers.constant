// Overhead prayer icons.
//
// The index is two things at once: the sprite's position in the client's
// `headicons_prayer` archive, and the bit it occupies in the appearance block's
// headicon field. The client reads one and the server writes the other, so they
// are the same number by construction — which is why it is written down once.
//
// LostCity's player/configs/headicon.constant carries the same list for its own
// revision, where the three protect icons sit at 3..5 behind skull/multi/hint.
// At rev 230 the prayer icons are their own archive and start at 0.
^headicon_prayer_protectfrommelee = 0
^headicon_prayer_protectfrommissiles = 1
^headicon_prayer_protectfrommagic = 2
^headicon_prayer_retribution = 3
^headicon_prayer_smite = 4
^headicon_prayer_redemption = 5

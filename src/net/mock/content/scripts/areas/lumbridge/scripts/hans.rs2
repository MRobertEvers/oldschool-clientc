// Hans, npc 3105, the greeter outside Lumbridge castle.
//
// rev-230 gives him two menu ops: 1 "Talk-to" and 3 "Age". Both reach the
// server as OPNPC<n>, which the engine resolves to [opnpc<n>,hans].
//
// These ids are rev-230 ids from cache.osrs230. They are NOT LostCity's — see
// docs/serverscript.md. The symbols come from content/pack/npc.pack, which
// tools/gameval_import.py generates from OpenRune's gameval table.

[opnpc1,hans]
%mock_greeting_count = calc(%mock_greeting_count + 1);
npc_say("Hello there, adventurer!");
npc_anim(seq_wave, 0);
mes("Hans greets you warmly.");

// A real multi-page conversation. Each ~chatnpc opens the dialogue and blocks
// on p_pausebutton until the player clicks "Click here to continue", so the
// pages are just sequential statements — which is the whole point of having a
// VM that can suspend.
[opnpc3,hans]
~chatnpc(hans, "Hans", "Let me think...");
~chatnpc(hans, "Hans", "I've worked here for years!");
~chatnpc(hans, "Hans", "Longer than anyone, in fact.");
if_close;
mes("Hans looks you up and down.");

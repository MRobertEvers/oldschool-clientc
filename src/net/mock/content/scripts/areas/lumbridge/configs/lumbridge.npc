// Combat definitions for the Lumbridge roster.
//
// Syntax and key names are LostCity's — the same `[symbol]`, the same
// `hitpoints=` / `attack=` / `respawnrate=` / `wanderrange=` / `huntmode=`,
// and the same `param=<name>,<value>` for anything the cache's own npc record
// does not carry. Read one of LostCity's beside this file
// (content/scripts/quests/quest_zanaris/configs/tree_spirit.npc) and nothing
// should look unfamiliar.
//
// What is NOT here, deliberately: model, recolour, walkanim, readyanim, op1-5,
// name, desc and vislevel. LostCity authors those because its content *builds*
// the npc record it packs into its cache. These npcs already exist in
// cache.osrs230 exactly as OldSchool ships them, so a block here is an
// *overlay*: everything omitted comes from the cache, including the equipment
// bonus params, and `mock230_pack` prints what it inherited so an overlay
// cannot quietly disagree with its source.
//
// Hitpoints, attack, strength and defence have to be authored. An OldSchool
// cache states an npc's combat *level* and its bonuses, never its levels or
// its hitpoints — those live on the server in every implementation. Values are
// OpenRune's combat def where it has one (its CowPlugin is the source of the
// cow's 8 hitpoints and 6-tick attack) and the OldSchool monster stats
// otherwise.

// ------------------------------------------------------------------
// Aggressive monsters
// ------------------------------------------------------------------

[goblin]
hitpoints=5
attack=1
strength=1
defence=1
respawnrate=25
wanderrange=8
huntmode=aggressive
param=huntrange,4
param=attackrate,4
param=attack_anim,goblin_attack
param=defend_anim,goblin_block
param=death_anim,goblin_death
param=death_drop,bones

// The goblin variants OpenRune spawns on the Al Kharid road, at the OldSchool
// levels. They share [goblin]'s drop table — see the drop tables area.
[goblin_armed]
hitpoints=12
attack=6
strength=6
defence=6
respawnrate=25
wanderrange=8
huntmode=aggressive
param=huntrange,4
param=attackrate,4
param=attack_anim,goblin_attack
param=defend_anim,goblin_block
param=death_anim,goblin_death
param=death_drop,bones

[goblin_armed_2]
hitpoints=5
attack=1
strength=1
defence=1
respawnrate=25
wanderrange=8
huntmode=aggressive
param=huntrange,4
param=attack_anim,goblin_attack
param=defend_anim,goblin_block
param=death_anim,goblin_death


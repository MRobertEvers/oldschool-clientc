attack=1
strength=1
defence=1
respawnrate=30
wanderrange=3

[woman_alt]
hitpoints=7
attack=1
strength=1
defence=1
respawnrate=30
wanderrange=20

[woman]
hitpoints=7
attack=1
strength=1
defence=1
respawnrate=30
wanderrange=20

[guard]
hitpoints=22
attack=12
strength=14
defence=12
respawnrate=40
wanderrange=4
param=attackrate,4
param=attack_anim,human_sword_slash
param=defend_anim,human_sword_block
param=death_drop,bones

// ------------------------------------------------------------------
// Speaking parts. `moverestrict=nomove` is what stops them wandering off the
// tile their dialogue assumes; none of them carry an Attack op in the cache,
// so no combat block is needed to make them unattackable.
// ------------------------------------------------------------------

[hans]
moverestrict=nomove
wanderrange=0

[bob]
moverestrict=nomove
wanderrange=0

[doomsayer]
moverestrict=nomove
wanderrange=0

[shop_keeper]
moverestrict=nomove
wanderrange=0

[shop_assistant]
moverestrict=nomove
wanderrange=0

[goblin_cook]
moverestrict=nomove
wanderrange=0

[gee]
moverestrict=nomove
wanderrange=0

[father_aereck]
moverestrict=nomove
wanderrange=0

[cooking_tutor]
moverestrict=nomove
wanderrange=0

[crafting_tutor]

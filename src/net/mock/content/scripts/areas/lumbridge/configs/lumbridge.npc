// ------------------------------------------------------------------
// Passive monsters — attackable, but they never start it
// ------------------------------------------------------------------

[chicken]
hitpoints=3
attack=1
strength=1
defence=1
respawnrate=20
wanderrange=5
param=attackrate,4
param=attack_anim,chicken_attack
param=death_anim,chicken_death
param=death_drop,bones

// 8 hitpoints and a 6-tick attack are OpenRune's CowPlugin values verbatim.
[cow]
hitpoints=8
attack=1
strength=1
defence=1
respawnrate=45
wanderrange=6
param=attackrate,6
param=attack_anim,cow_attack
param=death_anim,cow_death
param=death_drop,bones

[duck]
hitpoints=3
attack=1
strength=1
defence=1
respawnrate=20
wanderrange=4
param=death_drop,bones

// Sheep are not attackable at all: their only cache op is "Shear". A combat
// block would be inert, and `mock230_pack` says so — so there is none.
[sheep]
respawnrate=30
wanderrange=10

[ram]
hitpoints=15
attack=1
strength=1
defence=1
respawnrate=30
wanderrange=10

// ------------------------------------------------------------------
// Humans. Attackable but not aggressive; the guard hits back hard enough to be
// a real fight at low levels, which is what makes the combat path worth
// exercising at all.
// ------------------------------------------------------------------

[man]
hitpoints=7
attack=1
strength=1
defence=1
respawnrate=30
wanderrange=20

[man_alt]
hitpoints=7
attack=1
strength=1
defence=1
respawnrate=30
wanderrange=20

[man_alt2]
hitpoints=7
attack=1
strength=1
defence=1
respawnrate=30
wanderrange=20

[man_alt3]
hitpoints=7
attack=1
strength=1
defence=1
respawnrate=30
wanderrange=20

[drunken_man]

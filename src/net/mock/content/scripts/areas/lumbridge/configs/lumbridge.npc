param=death_anim,giantspider_death

// Level 27 and 50 spiders, and the level 81 huge spider. All three are
// OpenRune's own Lumbridge swamp spawns and all three will kill a new
// character — which is the point of having somewhere dangerous nearby.
[giant_spider_27]
hitpoints=27
attack=25
strength=25
defence=25
respawnrate=30
wanderrange=7
huntmode=aggressive
param=huntrange,4
param=attack_anim,giantspider_attack
param=death_anim,giantspider_death

[giant_spider_50]
hitpoints=50
attack=45
strength=45
defence=45
respawnrate=30
wanderrange=7
huntmode=aggressive
param=huntrange,4
param=attack_anim,giantspider_attack
param=death_anim,giantspider_death

[huge_spider]
hitpoints=75
attack=70
strength=70
defence=70
respawnrate=40
wanderrange=7
huntmode=aggressive
param=huntrange,4
param=attack_anim,giantspider_attack

// Runs once per session, in phase 7 of the tick.
//
// The C login burst still sends the scene, the gameframe and the containers —
// that is engine work. What belongs here is anything a server operator would
// want to change without recompiling, and the player's opening state is the
// clearest case of it.

[login,_]
mes("Welcome to Lumbridge.");
mes("Goblins east of the river. Guards on the Al Kharid road.");
mes("Try ::style 1 for aggressive, or ::setlevel 2 40 for some strength.");
%lumbridge_visited = calc(%lumbridge_visited + 1);

// The combat tab's variables.
//
// These were four hardcoded packets in the login burst, which was wrong twice
// over: the ids were magic numbers in a header, and a server operator could not
// change the opening attack style without a compiler. They are ordinary varp
// writes now — the engine transmits any varp declared `transmit=yes` when its
// value changes, so nothing here says anything about the wire.
%com_mode = ^attack_style_accurate;
%option_nodef = ^player_auto_retaliate_on;
%sa_attack = 0;
%sa_energy = ^sa_max_energy;

// Which equipment slot each cell of the worn-items tab stands for.
//
// The tab is eleven components (387:15..387:25), each holding a `cc_create`d
// item child — so the slot identity is in the COMPONENT, not in the sub id an
// op carries, which is 1 for every one of them.
//
// The mapping is not "child index in wear order": the wear positions the tab
// draws skip 6, 8 and 11 (arms, hair, jaw), which are parts of the player's
// body rather than things to equip. OpenRune reads the same table out of the
// cache as `enums.equipment_tab_to_slots_map`; this is that enum, with the
// component names carrying the answer — `wornitems:slot7` IS wear slot 7.
//
// Checked against cache.osrs230's own silhouette graphics: 387:15 draws sprite
// 156, a helmet, and so on down to 387:25's arrow.

[worn_slots]
inputtype=component
outputtype=int
val=worn_slot0,0
val=worn_slot1,1
val=worn_slot2,2
val=worn_slot3,3
val=worn_slot4,4
val=worn_slot5,5
val=worn_slot7,7
val=worn_slot9,9
val=worn_slot10,10
val=worn_slot12,12
val=worn_slot13,13

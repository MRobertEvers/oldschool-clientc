// Player control variables.
//
// LostCity's content/scripts/interface_controls/configs/player_controls.varp,
// same keys and same meaning:
//
//   transmit=yes   the client is told when this changes. A varp the client's
//                  own CS2 reads MUST be transmitted or the interface that
//                  reads it never updates.
//   protect=no     writable outside a protected script.
//   scope=perm     survives logout (the mock has no persistence, so this is a
//                  declaration of intent rather than a behaviour).
//   clientcode=N   a client-side side effect keyed on this varp.
//
// The engine reads `transmit` and nothing else so far; the rest are carried so
// a config shared with a LostCity tree keeps its meaning.

[option_nodef]
protect=no
transmit=yes
scope=perm

[com_mode]
protect=no
transmit=yes
scope=perm

[sa_energy]
protect=no
transmit=yes
scope=perm

[sa_attack]
protect=no
transmit=yes
scope=perm

// OldSchool's run-mode toggle. The minimap orb reads it directly, so it has to
// be transmitted: the server flipping it silently would leave the orb dark
// while the player ran.
[run]
protect=no
transmit=yes
scope=perm

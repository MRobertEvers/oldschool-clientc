// The varps the combat tab's varbits are packed into.
//
// Not the bit ranges — those are in the cache (config group 14), which is where
// the client unpacks them from, so restating them here would be a second source
// of truth. This file says only that the containers must reach the client.
//
//   varp_weapon_category  varp 843, holds varbit weapon_category at bits 0-5
//   varp_combat_level     varp 1105, holds varbit combat_level at bits 24-30
//
// Without transmit=yes the tab reads 0 for the weapon category, script 7593
// hides every style button, and the tab shows nothing but auto-retaliate.

[varp_weapon_category]
protect=no
transmit=yes
scope=perm

[varp_combat_level]
protect=no
transmit=yes
scope=perm

// What the login burst mounts into the gameframe, and where.
//
// This was a 24-entry `{ slot, group }` table of raw numbers in
// mock230_world.c. It is the same list OpenRune's GameframeLoader carries
// (content/.../interfaces/gameframe/GameframeLoader.kt) and in the same order,
// but named on both sides: the key is a gameframe *component* and the value an
// *interface*, so nothing here is a number.
//
// LostCity has no equivalent because its 2004 client builds its own tab strip;
// at rev 230 the server names every slot. `.enum` is the reference's shape for
// a keyed table (inputtype / outputtype / val=key,value), so that is what this
// is.
//
// Order matters and is preserved: the client mounts in the order it is told,
// and the chatbox has to exist before anything tries to write to it.

[gameframe]
inputtype=component
outputtype=interface

// HUD overlays
val=gameframe_chat_container,chatbox
val=gameframe_buff_bar,buff_bar
val=gameframe_stat_boosts_hud,stat_boosts_hud
val=gameframe_pm_container,pm_chat
val=gameframe_hpbar_hud,hpbar_hud
val=gameframe_pvp_icons,pvp_icons
val=gameframe_orbs,orbs
val=gameframe_xp_drops,xp_drops
val=gameframe_popout,popout
val=gameframe_ehc_listener,ehc_worldhop

// Sidebar tabs, side0..side13
val=gameframe_side0,combat_interface
val=gameframe_side1,stats
val=gameframe_side2,side_journal
val=gameframe_side3,inventory
val=gameframe_side4,worn_equipment
val=gameframe_side5,prayerbook
val=gameframe_side6,magic_spellbook
val=gameframe_side7,side_channels
val=gameframe_side8,account
val=gameframe_side9,friends
val=gameframe_side10,logout
val=gameframe_side11,settings_side
val=gameframe_side12,emote
val=gameframe_side13,music

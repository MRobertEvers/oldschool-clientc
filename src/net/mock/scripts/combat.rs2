// Baseline melee combat.
//
// The engine owns hitpoints, hitsplats, death and respawn — the parts that have
// to stay consistent. Content decides who is attackable and what a swing looks
// like, which is all that lives here.
//
// Goblin op 2 is "Attack" in cache.osrs230 (action 31); op 1 is "Talk-to".

[opnpc2,goblin]
p_opnpc(2);

[opnpc2,guard]
p_opnpc(2);

[opnpc1,goblin]
npc_say("Ye be dead soon!");

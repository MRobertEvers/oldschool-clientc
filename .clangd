# Flags must be understood by the same Clang that runs clangd (e.g. Apple Clang on
# macOS). GCC-only options (-ftree-vectorizer-*, -fopt-info-*) break every TU and
# can crash or restart clangd.
#
# Per-OS compile DB dirs are set in .vscode/settings.json ([darwin]/[win32]) via
# clangd --compile-commands-dir. The default is src/, i.e. src/compile_flags.txt:
# the whole client is built by src/makefile, and the CMake build that used to
# populate build/compile_commands.json is deprecated (its sources moved to v0/).
CompileFlags:
  CompilationDatabase: src/
  Add:
    # Fallback include roots when a TU has no compile_commands entry
    - -I.
    - -Isrc
    - -I3rd/rscache/include
    # Android lane (platform_android*.c) and the GLES2 renderer it shares with
    # the web lane need EGL/, GLES2/, android/ and jni.h, which macOS has none
    # of. These come from the NDK gradle actually builds with -- see
    # android/build.gradle's ndkVersion -- so clangd sees the same headers the
    # device build does. -idirafter, NOT -isystem: it is searched AFTER the
    # macOS system dirs, so bionic's stdio.h/stdint.h can never shadow Apple's
    # on a desktop TU, and only the headers macOS genuinely lacks are picked
    # up. Bump the version here when android/build.gradle's ndkVersion moves.
    - -idirafter/Users/matthewevers/Library/Android/sdk/ndk/27.0.12077973/toolchains/llvm/prebuilt/darwin-x86_64/sysroot/usr/include
    - -idirafter/Users/matthewevers/Library/Android/sdk/ndk/27.0.12077973/toolchains/llvm/prebuilt/darwin-x86_64/sysroot/usr/include/aarch64-linux-android
  Remove:
    - -W*
    - -w
    - /W3
    - /W4
    # ASAN flags in build/compile_commands.json crash Apple clangd during AST build.
    - -fsanitize=*
    - -fno-sanitize=*
    - -fno-omit-frame-pointer

Diagnostics:
  ClangTidy:
    Add:
      - readability-*
      - performance-*
      - modernize-*
    Remove:
      - readability-magic-numbers
      - readability-uppercase-literal-suffix
      - readability-braces-around-statements
  UnusedIncludes: Strict
  MissingIncludes: None

Index:
  Background: Build
  StandardLibrary: Yes

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes

Hover:
  ShowAKA: Yes

Completion:
  AllScopes: Yes

---
# 3rd/rscache is a unity-built library — not in CMake compile_commands.json.
If:
  PathMatch: 3rd/rscache/.*\.(c|h)$
CompileFlags:
  CompilationDatabase: 3rd/rscache/
  Add:
    - -I3rd/rscache/include
    - -I3rd/rscache/src
    - -I3rd/rscache
    - -I3rd/bzip
    - -I3rd/miniz
    - -std=c11
---
# src/ is built via Makefile, not CMake — use src/compile_flags.txt.
If:
  PathMatch: src/.*\.(c|h)$
CompileFlags:
  CompilationDatabase: src/
---
# test/gamecache/ is built via Makefile — do not infer flags from build/compile_commands.json.
If:
  PathMatch: test/gamecache/.*\.(c|h)$
CompileFlags:
  CompilationDatabase: test/gamecache/
---
# tools/interfacex/ is built via Makefile — use tools/interfacex/compile_flags.txt.
If:
  PathMatch: tools/interfacex/.*\.(c|h)$
CompileFlags:
  CompilationDatabase: tools/interfacex/
---
# Other test/* targets are Makefile-built — use test/compile_flags.txt, not build/.
If:
  PathMatch: test/(revconfig_load|ui_tree|ui_input|trspk_leak|model_render|datserver|trspk_batch16)/.*\.(c|h)$
CompileFlags:
  CompilationDatabase: test/

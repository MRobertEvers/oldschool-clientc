# Flags must be understood by the same Clang that runs clangd (e.g. Apple Clang on
# macOS). GCC-only options (-ftree-vectorizer-*, -fopt-info-*) break every TU and
# can crash or restart clangd.
CompileFlags:
  CompilationDatabase: build-winxp/
  Add:
    # Project include roots matching the src2 Makefile (-I$(REPO_ROOT), -I$(SRC2))
    - -I.
    - -Isrc
    - -Isrc2
    - -Isrc2/scripting
    # Vendored MinGW toolchain (used by Makefile on Windows)
    - -Itoolchain/win32/mingw32/include
    - -Itoolchain/win32/mingw32/include/SDL2
    # Fallback: Downloads copy of winlibs (kept until fully migrated)
    - -IC:/Users/mrobe/Downloads/winlibs-i686-posix-dwarf-gcc-15.2.0-mingw-w64msvcrt-13.0.0-r2/mingw32/include/SDL2
    - -IC:/Users/mrobe/Downloads/winlibs-i686-posix-dwarf-gcc-15.2.0-mingw-w64msvcrt-13.0.0-r2/mingw32/include
    - -march=native
    - -D_CRT_SECURE_NO_WARNINGS
    - -D_WINSOCK_DEPRECATED_NO_WARNINGS
    - -D_WIN32_WINNT=0x0A00
    - -DUNICODE
    - -D_UNICODE
    - -O3
    - -ffast-math
  Remove:
    - -W*
    - -w
    - /W3
    - /W4

Diagnostics:
  ClangTidy:
    Add:
      - readability-*
      - performance-*
      - modernize-*
    Remove:
      - readability-magic-numbers
      - readability-uppercase-literal-suffix
  UnusedIncludes: Strict
  MissingIncludes: Strict

Index:
  Background: Build
  StandardLibrary: Yes

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes

Hover:
  ShowAKA: Yes

Completion:
  AllScopes: Yes

---
# src2/ is built via Makefile, not CMake — use src2/compile_flags.txt, not build-winxp/.
If:
  PathMatch: src2/.*\.(c|h|u\.c)$
CompileFlags:
  CompilationDatabase: src2/

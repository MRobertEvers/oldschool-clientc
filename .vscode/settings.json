{
  // ---------------------------------------------------------------------
  // C/C++ IntelliSense is provided by clangd (llvm-vs-code-extensions.vscode-clangd),
  // driven by the repo-root .clangd file, which routes each subtree to its own
  // compilation database (src/, 3rd/rscache/, test/, ...).
  // The MS cpptools IntelliSense engine stays off so the two do not fight.
  // NOTE: VS Code has no per-OS settings scope -- "[darwin]"/"[win32]"/"[linux]"
  // blocks are silently ignored, so clangd settings must live at top level.
  // ---------------------------------------------------------------------
  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.autocomplete": "disabled",
  "C_Cpp.errorSquiggles": "disabled",

  "clangd.path": "/usr/bin/clangd",
  "clangd.checkUpdates": false,
  "clangd.onConfigChanged": "restart",
  "clangd.arguments": [
    "--background-index",
    "--header-insertion=never",
    "--completion-style=detailed",
    "--pch-storage=memory",
    "--query-driver=/usr/bin/**,/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/**,/opt/homebrew/bin/**,/opt/homebrew/opt/llvm/bin/**"
  ],
  // Used only for a TU with no compilation-database entry.
  "clangd.fallbackFlags": [
    "-std=gnu11",
    "-I${workspaceFolder}",
    "-I${workspaceFolder}/src",
    "-I${workspaceFolder}/src2",
    "-I${workspaceFolder}/3rd/toridraw",
    "-I${workspaceFolder}/3rd/rscache/include",
    "-I${workspaceFolder}/3rd/rscache/src",
    "-I/opt/homebrew/include/SDL2"
  ],

  // Formatting is the standalone clang-format extension (homebrew clang-format 20).
  // Apple's bundled clangd is 17 and cannot parse this repo's .clang-format, so it
  // must not be the formatter for C/C++.
  "editor.formatOnSave": true,
  "editor.multiCursorModifier": "alt",
  "C_Cpp.formatting": "clangFormat",
  "C_Cpp.clang_format_path": "/opt/homebrew/bin/clang-format",
  "C_Cpp.clang_format_style": "file",
  "clang-format.executable": "/opt/homebrew/bin/clang-format",
  "clangd.enableCodeCompletion": true,
  "[c]": {
    "editor.defaultFormatter": "xaver.clang-format"
  },
  "[cpp]": {
    "editor.defaultFormatter": "xaver.clang-format"
  },
  "[objective-cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },

  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "icon": "terminal-powershell"
    },
    "Command Prompt": {
      "path": "C:\\Windows\\System32\\cmd.exe",
      "args": [],
      "icon": "terminal-cmd"
    },
    "MSYS2 MinGW64": {
      "path": "C:\\msys64\\mingw64.exe",
      "args": [],
      "icon": "terminal-bash",
      "env": {
        "CHERE_INVOKING": "1",
        "PATH": "C:\\msys64\\mingw64\\bin;C:\\msys64\\usr\\bin;${env:PATH}",
        "MSYSTEM": "MINGW64"
      }
    },
    "MSYS2 Terminal": {
      "path": "C:\\msys64\\msys2_shell.cmd",
      "args": [
        "-defterm",
        "-here",
        "-no-start",
        "-mingw64"
      ],
      "icon": "terminal-bash",
      "env": {
        "CHERE_INVOKING": "1",
        "MSYSTEM": "MINGW64",
        "HOME": "${workspaceFolder}/scripts"
      }
    },
    "MSYS2 Bash": {
      "path": "C:\\msys64\\usr\\bin\\bash.exe",
      "args": [
        "--login",
        "-i"
      ],
      "icon": "terminal-bash",
      "env": {
        "PATH": "C:\\msys64\\mingw64\\bin;C:\\msys64\\usr\\bin;${env:PATH}",
        "MSYSTEM": "MINGW64",
        "CHERE_INVOKING": "1"
      }
    }
  },
  "terminal.integrated.defaultProfile.windows": "PowerShell",

  "files.associations": {
    "*.u.c": "c",
    "*.u.h": "c",
    "libtorirs_internal.h": "c",
    "libtorirs_scripting.h": "c",
    "assert.h": "c",
    "emscripten.h": "c",
    "stdlib.h": "c",
    "libtorirs_command_queue_internal.h": "c",
    "cache_dat.h": "c",
    "xtea_config.h": "c",
    "cache.h": "c",
    "reference_table.h": "c",
    "libtorirs_ioqueue.h": "c",
    "configs_dat.h": "c",
    "cachelib_platform.h": "c",
    "lualib.h": "c",
    "cachelib_client.h": "c",
    "dash.h": "c",
    "gamecache.h": "c",
    "platform_x_lua_internal.h": "c",
    "toridraw_types.h": "c",
    "toridraw_model.h": "c",
    "pix3d_deob_compat.h": "c",
    "shade.h": "c",
    "clamp.h": "c",
    "__node_handle": "c",
    "dashmap.h": "c",
    "toridraw_light_model.h": "c",
    "config_textures.h": "c",
    "maps.h": "c",
    "world_scene_events.h": "c",
    "libtorirs_render.h": "c",
    "toridraw.h": "c",
    "webgl1_vertex.h": "c",
    "trspk_batch16.h": "c",
    "opengl3_sdlgl.h": "c",
    "sdl_opengl.h": "c",
    "opengl3_internal.h": "c",
    "stdio.h": "c",
    "trspk_opengl3.h": "c",
    "uv_pnm.h": "c",
    "toridraw_math.h": "c"
  },

  "lldb.displayFormat": "auto",
  "lldb.dereferencePointers": true,
  "lldb.consoleMode": "commands"
}

+            0,
+            pane_w,
+            client_h,
+            SWP_NOZORDER | SWP_NOACTIVATE | SWP_SHOWWINDOW);
+
+    if( p->chrome_open && pane_w > 0 && client_h > 0 &&
+        (pane_w != p->chrome_width || client_h != p->chrome_height) )
+    {
+        p->chrome_input.resized = 1;
+        p->chrome_input.width = pane_w;
+        p->chrome_input.height = client_h;
+        p->chrome_have_input = 1;
+    }
+}
+
+static int
+win32_chrome_rail_count(struct PlatformWindow const* p)
+{
+    int count;
+
+    if( !p || !p->chrome_rail_snapshot_valid )
+        return 0;
+    count = p->chrome_rail_snapshot.entry_count;
+    if( count < 0 )
+        count = 0;
+    if( count > TORIRS_CHROME_RAIL_ENTRY_MAX )
+        count = TORIRS_CHROME_RAIL_ENTRY_MAX;
+    return count;
+}
+
+/** The permanent Manage Plugins destination remains pinned above overflow. */
+static int
+win32_chrome_rail_pinned(struct PlatformWindow const* p)
+{
+    return win32_chrome_rail_count(p) > 0 &&
+           p->chrome_rail_snapshot.entries[0].kind ==
+               TORIRS_CHROME_RAIL_ENTRY_MANAGE;
+}
+
+static int
+win32_chrome_rail_slots(struct PlatformWindow const* p)
+{
+    RECT client;
+
+    if( !p || !p->chrome_rail_hwnd ||
+        !GetClientRect(p->chrome_rail_hwnd, &client) )
+        return 0;
+    return client.bottom > 0
+               ? (client.bottom + WIN32_CHROME_RAIL_ROW - 1) /
+                     WIN32_CHROME_RAIL_ROW
+               : 0;
+}
+
+static int
+win32_chrome_rail_scroll_max(struct PlatformWindow const* p)
+{
+    int const count = win32_chrome_rail_count(p);
+    int const pinned = win32_chrome_rail_pinned(p);
+    int slots = win32_chrome_rail_slots(p) - pinned;
+    int max;
+
+    if( slots < 0 )
+        slots = 0;
+    max = count - pinned - slots;
+    return max > 0 ? max : 0;
+}
+
+static void
+win32_chrome_rail_clamp_scroll(struct PlatformWindow* p)
+{
+    int const max = win32_chrome_rail_scroll_max(p);
+
+    if( p->chrome_rail_scroll < 0 )
+        p->chrome_rail_scroll = 0;
+    if( p->chrome_rail_scroll > max )
+        p->chrome_rail_scroll = max;
+}
+
+/** Snapshot index at one visible slot, accounting for the pinned Manage row. */
+static int
+win32_chrome_rail_index_at_slot(struct PlatformWindow const* p, int slot)
+{
+    int const count = win32_chrome_rail_count(p);
+    int const pinned = win32_chrome_rail_pinned(p);
+    int index;
+
+    if( slot < 0 || slot >= win32_chrome_rail_slots(p) )
+        return -1;
+    if( pinned && slot == 0 )
+        return 0;
+    index = pinned + p->chrome_rail_scroll + slot - pinned;
+    return index >= pinned && index < count ? index : -1;
+}
+
+static int
+win32_chrome_rail_index_at_point(
+    struct PlatformWindow const* p, int x, int y)
+{
+    int const slot = y / WIN32_CHROME_RAIL_ROW;
+    int const local_y = y - slot * WIN32_CHROME_RAIL_ROW;
+
+    if( x < WIN32_CHROME_RAIL_PAD ||
+        x >= WIN32_CHROME_RAIL_PAD + WIN32_CHROME_RAIL_ICON ||
+        y < 0 || local_y < WIN32_CHROME_RAIL_PAD ||
+        local_y >= WIN32_CHROME_RAIL_PAD + WIN32_CHROME_RAIL_ICON )
+        return -1;
+    if( !p->chrome_rail_snapshot_valid )
+        return slot == 0 ? 0 : -1;
+    return win32_chrome_rail_index_at_slot(p, slot);
+}
+
+static void
+win32_chrome_rail_draw_icon(
+    struct PlatformWindow* p,
+    HDC dc,
+    struct ToriRSChromeRailEntry const* entry,
+    RECT const* box)
+{
+    struct Win32ChromeRailIcon* icon = NULL;
+    HGDIOBJ previous;
+    int w;
+    int h;
+    int x;
+    int y;
+
+    if( entry->plugin_index >= 0 &&
+        entry->plugin_index < TORIRS_CHROME_RAIL_ENTRY_MAX )
+        icon = &p->chrome_rail_icons[entry->plugin_index];
+    if( !icon || !icon->bitmap || icon->width <= 0 || icon->height <= 0 )
+        return;
+    if( !p->chrome_rail_icon_dc )
+        p->chrome_rail_icon_dc = CreateCompatibleDC(dc);
+    if( !p->chrome_rail_icon_dc )
+        return;
+    previous = SelectObject(p->chrome_rail_icon_dc, icon->bitmap);
+    if( !previous || previous == HGDI_ERROR )
+        return;
+
+    w = box->right - box->left;
+    h = box->bottom - box->top;
+    if( icon->width * h > icon->height * w )
+        h = icon->height * w / icon->width;
+    else
+        w = icon->width * h / icon->height;
+    if( w < 1 )
+        w = 1;
+    if( h < 1 )
+        h = 1;
+    x = box->left + ((box->right - box->left) - w) / 2;
+    y = box->top + ((box->bottom - box->top) - h) / 2;
+    SetStretchBltMode(dc, COLORONCOLOR);
+    StretchBlt(
+        dc, x, y, w, h, p->chrome_rail_icon_dc, 0, 0,
+        icon->width, icon->height, SRCCOPY);
+    SelectObject(p->chrome_rail_icon_dc, previous);
+}
+
+static void
+win32_chrome_rail_draw_entry(
+    struct PlatformWindow* p, HDC dc, int index, int slot)
+{
+    struct ToriRSChromeRailEntry const* entry =
+        &p->chrome_rail_snapshot.entries[index];
+    struct Win32ChromeRailIcon const* icon = NULL;
+    int const selected =
+        entry->plugin_index == p->chrome_rail_snapshot.selected_entry;
+    int const pressed = index == p->chrome_rail_pressed_entry;
+    RECT box;
+    RECT inner;
+    RECT badge;
+    char fallback[2] = { 'P', '\0' };
+    HGDIOBJ old_font;
+
+    if( entry->plugin_index >= 0 &&
+        entry->plugin_index < TORIRS_CHROME_RAIL_ENTRY_MAX )
+        icon = &p->chrome_rail_icons[entry->plugin_index];
+    box.left = WIN32_CHROME_RAIL_PAD;
+    box.top = slot * WIN32_CHROME_RAIL_ROW + WIN32_CHROME_RAIL_PAD;
+    box.right = box.left + WIN32_CHROME_RAIL_ICON;
+    box.bottom = box.top + WIN32_CHROME_RAIL_ICON;
+    win32_fill_brush(
+        dc,
+        &box,
+        selected || entry->attention
+            ? p->chrome_rail_label_brush
+            : p->chrome_rail_frame_brush);
+    inner = box;
+    inner.left += 2;
+    inner.top += 2;
+    inner.right -= 2;
+    inner.bottom -= 2;
+    win32_fill_brush(dc, &inner, p->chrome_rail_body_brush);
+    inner.left += 2;
+    inner.top += 2;
+    inner.right -= 2;
+    inner.bottom -= 2;
+    win32_fill_brush(
+        dc, &inner,
+        pressed ? p->chrome_rail_body_brush : p->chrome_rail_field_brush);
+
+    if( icon && icon->bitmap )
+        win32_chrome_rail_draw_icon(p, dc, entry, &inner);
+    else
+    {
+        RECT text = inner;
+        if( entry->kind == TORIRS_CHROME_RAIL_ENTRY_MANAGE )
+            fallback[0] = 'M';
+        else if( entry->title[0] >= 32 && entry->title[0] <= 126 )
+            fallback[0] = entry->title[0];
+        SetBkMode(dc, TRANSPARENT);
+        SetTextColor(
+            dc,
+            selected && p->chrome_rail_snapshot.expanded
+                ? WIN32_CHROME_TEXT_RGB
+                : WIN32_CHROME_LABEL_RGB);
+        old_font = SelectObject(dc, GetStockObject(DEFAULT_GUI_FONT));
+        DrawTextA(dc, fallback, 1, &text, DT_SINGLELINE | DT_CENTER | DT_VCENTER);
+        if( old_font )
+            SelectObject(dc, old_font);
+    }
+
+    /* A bounded badge remains legible without widening the RuneLite-like
+     * rail. Attention without text is the same small orange corner pip. */
+    if( entry->badge[0] || entry->attention )
+    {
+        badge.right = box.right + 2;
+        badge.left = entry->badge[0] ? badge.right - 15 : badge.right - 6;
+        badge.top = box.top - 2;
+        badge.bottom = badge.top + (entry->badge[0] ? 11 : 6);
+        win32_fill_brush(dc, &badge, p->chrome_rail_label_brush);
+        if( entry->badge[0] )
+        {
+            char short_badge[4];
+            RECT text = badge;
+            short_badge[0] = entry->badge[0];
+            short_badge[1] = entry->badge[1];
+            short_badge[2] = entry->badge[2];
+            short_badge[3] = '\0';
+            SetBkMode(dc, TRANSPARENT);
+            SetTextColor(dc, WIN32_CHROME_FRAME_RGB);
+            old_font = SelectObject(dc, GetStockObject(DEFAULT_GUI_FONT));
+            DrawTextA(
+                dc, short_badge, -1, &text,
+                DT_SINGLELINE | DT_CENTER | DT_VCENTER | DT_END_ELLIPSIS);
+            if( old_font )
+                SelectObject(dc, old_font);
+        }
+    }
+}
+
+static void
+win32_chrome_paint_rail(struct PlatformWindow* p, HDC dc)
+{
+    RECT client;
+    int slots;
+
+    if( !p || !p->chrome_rail_hwnd || !dc )
+        return;
+    GetClientRect(p->chrome_rail_hwnd, &client);
+    win32_fill_brush(
+        dc,
+        &client,
+        p->chrome_rail_dark_brush
+            ? p->chrome_rail_dark_brush
+            : (HBRUSH)GetStockObject(BLACK_BRUSH));
+
+    /* A quiet tradebacking texture.  This is intentionally a handful of GDI
+     * fills, not a second atlas/rasteriser beside the executor's retained skin. */
+    for( int y = 1; y < client.bottom; y += 4 )
+    {
+        RECT grain = { 2, y, client.right - 2, y + 1 };
+        win32_fill_brush(dc, &grain, p->chrome_rail_grain_brush);
+    }
+    if( !p->chrome_rail_snapshot_valid )
+    {
+        /* Bootstrap/fallback for a platform-only caller with no application
+         * registry yet. Production replaces this with the copied snapshot. */
+        struct ToriRSChromeRailSnapshot saved = p->chrome_rail_snapshot;
+        int const saved_valid = p->chrome_rail_snapshot_valid;
+        memset(&p->chrome_rail_snapshot, 0, sizeof(p->chrome_rail_snapshot));
+        p->chrome_rail_snapshot.entry_count = 1;
+        p->chrome_rail_snapshot.entries[0].kind = TORIRS_CHROME_RAIL_ENTRY_MANAGE;
+        p->chrome_rail_snapshot.entries[0].plugin_index = -2;
+        memcpy(p->chrome_rail_snapshot.entries[0].title, "Plugins", 8);
+        p->chrome_rail_snapshot.selected_entry = p->chrome_open ? -2 : -1;
+        p->chrome_rail_snapshot.expanded = p->chrome_open;
+        p->chrome_rail_snapshot_valid = 1;
+        win32_chrome_rail_draw_entry(p, dc, 0, 0);
+        p->chrome_rail_snapshot = saved;
+        p->chrome_rail_snapshot_valid = saved_valid;
+        return;
+    }
+
+    win32_chrome_rail_clamp_scroll(p);
+    slots = win32_chrome_rail_slots(p);
+    for( int slot = 0; slot < slots; slot++ )
+    {
+        int const index = win32_chrome_rail_index_at_slot(p, slot);
+        if( index >= 0 )
+            win32_chrome_rail_draw_entry(p, dc, index, slot);
+    }
+}
+
+static uint64_t
+win32_chrome_rail_next_sequence(struct PlatformWindow* p)
+{
+    p->chrome_rail_sequence++;
+    if( p->chrome_rail_sequence == 0 )
+        p->chrome_rail_sequence++;
+    return p->chrome_rail_sequence;
+}
+
+static void
+win32_chrome_rail_queue_select(struct PlatformWindow* p, int index)
+{
+    struct ToriRSChromeRailEntry const* entry;
+    struct ToriRSChromeRailIntent intent;
+
+    if( !p || !p->chrome_rail_snapshot_valid ||
+        index < 0 || index >= win32_chrome_rail_count(p) ||
+        p->chrome_rail_snapshot.selection_generation == 0 )
+        return;
+    entry = &p->chrome_rail_snapshot.entries[index];
+    if( (entry->kind != TORIRS_CHROME_RAIL_ENTRY_MANAGE &&
+         entry->kind != TORIRS_CHROME_RAIL_ENTRY_PLUGIN) ||
+        entry->plugin_index < -2 || entry->plugin_index == -1 )
+        return;
+    memset(&intent, 0, sizeof(intent));
+    intent.kind = TORIRS_CHROME_RAIL_INTENT_SELECT;
+    intent.plugin_index = entry->plugin_index;
+    intent.selection_generation = p->chrome_rail_snapshot.selection_generation;
+    intent.sequence = win32_chrome_rail_next_sequence(p);
+    if( p->chrome_rail_intent_count >= WIN32_CHROME_RAIL_INTENT_MAX )
+        p->chrome_rail_intents[WIN32_CHROME_RAIL_INTENT_MAX - 1] = intent;
+    else
+        p->chrome_rail_intents[p->chrome_rail_intent_count++] = intent;
+}
+
+static LRESULT CALLBACK
+chrome_rail_proc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    struct PlatformWindow* p =
+        (struct PlatformWindow*)GetWindowLongPtr(hwnd, GWLP_USERDATA);
+
+    switch( msg )
+    {
+    case WM_ERASEBKGND:
+        return 1;
+    case WM_PAINT:
+        if( p )
+        {
+            PAINTSTRUCT paint;
+            HDC dc = BeginPaint(hwnd, &paint);
+            win32_chrome_paint_rail(p, dc);
+            EndPaint(hwnd, &paint);
+            return 0;
+        }
+        break;
+    case WM_PRINTCLIENT:
+        if( p && wparam )
+            win32_chrome_paint_rail(p, (HDC)wparam);
+        return 0;
+    case WM_LBUTTONDOWN:
+        if( p )
+        {
+            int const index = win32_chrome_rail_index_at_point(
+                p, GET_X_LPARAM(lparam), GET_Y_LPARAM(lparam));
+            if( index >= 0 )
+            {
+                p->chrome_rail_pressed_entry = index;
+                p->chrome_rail_pressed_generation =
+                    p->chrome_rail_snapshot_valid
+                        ? p->chrome_rail_snapshot.selection_generation
+                        : 0;
+                SetCapture(hwnd);
+                InvalidateRect(hwnd, NULL, FALSE);
+                /* The rail is navigation, not a text target.  Returning focus
+                 * keeps the collapsed strip from swallowing game keystrokes. */
+                SetFocus(p->hwnd);
+            }
+            return 0;
+        }
+        break;
+    case WM_LBUTTONUP:
+        if( p )
+        {
+            int const pressed = p->chrome_rail_pressed_entry;
+            uint32_t const generation = p->chrome_rail_pressed_generation;
+            int const released = win32_chrome_rail_index_at_point(
+                p, GET_X_LPARAM(lparam), GET_Y_LPARAM(lparam));
+            p->chrome_rail_pressed_entry = -1;
+            p->chrome_rail_pressed_generation = 0;
+            if( GetCapture() == hwnd )
+                ReleaseCapture();
+            InvalidateRect(hwnd, NULL, FALSE);
+            if( pressed >= 0 && released == pressed )
+            {
+                if( p->chrome_rail_snapshot_valid )
+                {
+                    if( generation ==
+                        p->chrome_rail_snapshot.selection_generation )
+                        win32_chrome_rail_queue_select(p, pressed);
+                }
+                else
+                    p->chrome_toggle_requested = 1;
+            }
+            return 0;
+        }
+        break;
+    case WM_MOUSEWHEEL:
+        if( p && p->chrome_rail_snapshot_valid )
+        {
+            int steps = GET_WHEEL_DELTA_WPARAM(wparam) / WHEEL_DELTA;
+            if( steps == 0 )
+                steps = GET_WHEEL_DELTA_WPARAM(wparam) > 0 ? 1 : -1;
+            p->chrome_rail_scroll -= steps;
+            win32_chrome_rail_clamp_scroll(p);
+            InvalidateRect(hwnd, NULL, FALSE);
+            return 0;
+        }
+        break;
+    case WM_CAPTURECHANGED:
+        if( p )
+        {
+            p->chrome_rail_pressed_entry = -1;
+            p->chrome_rail_pressed_generation = 0;
+            InvalidateRect(hwnd, NULL, FALSE);
+        }
+        break;
+    default:
+        break;
+    }
+    return DefWindowProcA(hwnd, msg, wparam, lparam);
+}
+
+static int
+win32_chrome_make_dib(struct PlatformWindow* p, int width, int height)
+{
+    BITMAPINFO info;
+    HBITMAP made;
+    void* bits = NULL;
+    HGDIOBJ previous;
+
+    if( !p || !p->chrome_window_dc || width <= 0 || height <= 0 )
+        return 0;
+    if( p->chrome_pixels && p->chrome_width == width && p->chrome_height == height )
+        return 1;
+    if( !p->chrome_mem_dc )
+    {
+        p->chrome_mem_dc = CreateCompatibleDC(p->chrome_window_dc);
+        if( !p->chrome_mem_dc )
+            return 0;
+    }
+    memset(&info, 0, sizeof(info));
+    info.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+    info.bmiHeader.biWidth = width;
+    info.bmiHeader.biHeight = -height;
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    info.bmiHeader.biCompression = BI_RGB;
+    made = CreateDIBSection(
+        p->chrome_mem_dc, &info, DIB_RGB_COLORS, &bits, NULL, 0);
+    if( !made || !bits )
+    {
+        if( made )
+            DeleteObject(made);
+        return 0;
+    }
+    previous = SelectObject(p->chrome_mem_dc, made);
+    if( !previous || previous == HGDI_ERROR ||
+        (p->chrome_dib && previous != (HGDIOBJ)p->chrome_dib) )
+    {
+        if( previous && previous != HGDI_ERROR )
+            SelectObject(p->chrome_mem_dc, previous);
+        DeleteObject(made);
+        return 0;
+    }
+    if( !p->chrome_dib )
+        p->chrome_old_bmp = (HBITMAP)previous;
+    else
+        DeleteObject(p->chrome_dib);
+    p->chrome_dib = made;
+    p->chrome_pixels = (int*)bits;
+    p->chrome_width = width;
+    p->chrome_height = height;
+    memset(bits, 0, (size_t)width * (size_t)height * sizeof(int));
+    return 1;
+}
+
+static void
+win32_chrome_drop_dib(struct PlatformWindow* p)
+{
+    if( !p )
+        return;
+    if( p->chrome_mem_dc && p->chrome_old_bmp )
+        SelectObject(p->chrome_mem_dc, p->chrome_old_bmp);
+    if( p->chrome_dib )
+        DeleteObject(p->chrome_dib);
+    if( p->chrome_mem_dc )
+        DeleteDC(p->chrome_mem_dc);
+    p->chrome_mem_dc = NULL;
+    p->chrome_dib = NULL;
+    p->chrome_old_bmp = NULL;
+    p->chrome_pixels = NULL;
+    p->chrome_width = 0;
+    p->chrome_height = 0;
+}
+
+static void
+win32_chrome_paint_surface(struct PlatformWindow* p, HDC dc)
+{
+    RECT client;
+    int width;
+    int height;
+
+    if( !p || !p->chrome_hwnd || !dc )
+        return;
+    GetClientRect(p->chrome_hwnd, &client);
+    if( p->chrome_rail_dark_brush )
+        win32_fill_brush(dc, &client, p->chrome_rail_dark_brush);
+    else
+        win32_fill_color(dc, &client, WIN32_CHROME_DARK_RGB);
+    if( !p->chrome_mem_dc || !p->chrome_pixels )
+        return;
+    width = client.right < p->chrome_width ? client.right : p->chrome_width;
+    height = client.bottom < p->chrome_height ? client.bottom : p->chrome_height;
+    if( width > 0 && height > 0 )
+        BitBlt(dc, 0, 0, width, height, p->chrome_mem_dc, 0, 0, SRCCOPY);
+}
+
+static int
+win32_chrome_edit_key(int vk)
+{
+    switch( vk )
+    {
+    case VK_BACK:
+        return PLATFORM_AUX_KEY_BACKSPACE;
+    case VK_DELETE:
+        return PLATFORM_AUX_KEY_DELETE;
+    case VK_LEFT:
+        return PLATFORM_AUX_KEY_LEFT;
+    case VK_RIGHT:
+        return PLATFORM_AUX_KEY_RIGHT;
+    case VK_HOME:
+        return PLATFORM_AUX_KEY_HOME;
+    case VK_END:
+        return PLATFORM_AUX_KEY_END;
+    case VK_RETURN:
+        return PLATFORM_AUX_KEY_ENTER;
+    case VK_ESCAPE:
+        return PLATFORM_AUX_KEY_ESCAPE;
+    case VK_UP:
+        return PLATFORM_AUX_KEY_UP;
+    case VK_DOWN:
+        return PLATFORM_AUX_KEY_DOWN;
+    default:
+        return PLATFORM_AUX_KEY_NONE;
+    }
+}
+
+static LRESULT CALLBACK
+chrome_surface_proc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    struct PlatformWindow* p =
+        (struct PlatformWindow*)GetWindowLongPtr(hwnd, GWLP_USERDATA);
+
+    switch( msg )
+    {
+    case WM_ERASEBKGND:
+        return 1;
+    case WM_PAINT:
+        if( p )
+        {
+            PAINTSTRUCT paint;
+            HDC dc = BeginPaint(hwnd, &paint);
+            win32_chrome_paint_surface(p, dc);
+            EndPaint(hwnd, &paint);
+            return 0;
+        }
+        break;
+    case WM_PRINTCLIENT:
+        if( p && wparam )
+            win32_chrome_paint_surface(p, (HDC)wparam);
+        return 0;
+    case WM_GETDLGCODE:
+        return DLGC_WANTALLKEYS | DLGC_WANTCHARS;
+    case WM_LBUTTONDOWN:
+        if( p )
+        {
+            SetFocus(hwnd);
+            SetCapture(hwnd);
+            p->chrome_pointer_down = 1;
+            p->chrome_input.mouse_x = GET_X_LPARAM(lparam);
+            p->chrome_input.mouse_y = GET_Y_LPARAM(lparam);
+            p->chrome_input.mouse_down = 1;
+            p->chrome_have_input = 1;
+            return 0;
+        }
+        break;
+    case WM_LBUTTONUP:
+        if( p )
+        {
+            if( GetCapture() == hwnd )
+                ReleaseCapture();
+            p->chrome_pointer_down = 0;
+            p->chrome_input.mouse_x = GET_X_LPARAM(lparam);
+            p->chrome_input.mouse_y = GET_Y_LPARAM(lparam);
+            p->chrome_input.mouse_up = 1;
+            p->chrome_have_input = 1;
+            return 0;
+        }
+        break;
+    case WM_MOUSEMOVE:
+        if( p )
+        {
+            p->chrome_input.mouse_x = GET_X_LPARAM(lparam);
+            p->chrome_input.mouse_y = GET_Y_LPARAM(lparam);
+            p->chrome_have_input = 1;
+            return 0;
+        }
+        break;
+    case WM_MOUSEWHEEL:
+        if( p )
+        {
+            p->chrome_input.wheel += GET_WHEEL_DELTA_WPARAM(wparam) / WHEEL_DELTA;
+            p->chrome_have_input = 1;
+            return 0;
+        }
+        break;
+    case WM_CHAR:
+        if( p && wparam >= 32 && wparam <= 255 )
+        {
+            size_t used = strlen(p->chrome_input.text);
+            if( used + 1 < sizeof(p->chrome_input.text) )
+            {
+                p->chrome_input.text[used] = (char)wparam;
+                p->chrome_input.text[used + 1] = '\0';
+            }
+            p->chrome_have_input = 1;
+            return 0;
+        }
+        break;
+    case WM_KEYDOWN:
+        if( p )
+        {
+            int const key = win32_chrome_edit_key((int)wparam);
+            if( key != PLATFORM_AUX_KEY_NONE )
+            {
+                p->chrome_input.edit_key = key;
+                p->chrome_have_input = 1;
+            }
+            return 0;
+        }
+        break;
+    case WM_KEYUP:
+        return 0;
+    case WM_CAPTURECHANGED:
+        if( p )
+            p->chrome_pointer_down = 0;
+        break;
+    default:
+        break;
+    }
+    return DefWindowProcA(hwnd, msg, wparam, lparam);
+}
+
+static int
+win32_chrome_ensure_rail(struct PlatformWindow* p)
+{
+    int width;
+    int height;
+    LONG_PTR style;
+
+    if( !p || !p->hwnd )
+        return 0;
+    if( p->chrome_rail_hwnd )
+        return 1;
+    if( !win32_main_client_size(p, &width, &height) )
+        return 0;
+    if( !p->chrome_rail_dark_brush )
+        p->chrome_rail_dark_brush = CreateSolidBrush(WIN32_CHROME_DARK_RGB);
+    if( !p->chrome_rail_grain_brush )
+        p->chrome_rail_grain_brush = CreateSolidBrush(RGB(0x25, 0x21, 0x1B));
+    if( !p->chrome_rail_body_brush )
+        p->chrome_rail_body_brush = CreateSolidBrush(WIN32_CHROME_BODY_RGB);
+    if( !p->chrome_rail_field_brush )
+        p->chrome_rail_field_brush = CreateSolidBrush(RGB(0x37, 0x2E, 0x22));
+    if( !p->chrome_rail_frame_brush )
+        p->chrome_rail_frame_brush = CreateSolidBrush(WIN32_CHROME_FRAME_RGB);
+    if( !p->chrome_rail_label_brush )
+        p->chrome_rail_label_brush = CreateSolidBrush(WIN32_CHROME_LABEL_RGB);
+    p->chrome_rail_hwnd = CreateWindowExA(
+        0,
+        RPD_CHROME_RAIL_WNDCLASS,
+        "Plugins",
+        WS_CHILD | WS_CLIPSIBLINGS,
+        width,
+        0,
+        WIN32_CHROME_RAIL_W,
+        height,
+        p->hwnd,
+        NULL,
+        GetModuleHandleA(NULL),
+        NULL);
+    if( !p->chrome_rail_hwnd )
+        return 0;
+    SetWindowLongPtr(
+        p->chrome_rail_hwnd, GWLP_USERDATA, (LONG_PTR)p);
+
+    /* Keep-game-size, RuneLite-style, where USER32 permits it.  Maximized and
+     * popup/fullscreen windows are fit in place and never forced off-screen. */
+    style = GetWindowLongPtr(p->hwnd, GWL_STYLE);
+    if( !(style & WS_POPUP) && !(style & WS_MAXIMIZE) )
+        win32_resize_client(p, width + WIN32_CHROME_RAIL_W, height);
+    win32_main_client_size(p, &width, &height);
+    win32_chrome_layout(p, width, height);
+    ShowWindow(p->chrome_rail_hwnd, SW_SHOWNOACTIVATE);
+    return 1;
+}

+            ToriRSChrome_SetLabel(
+                &app->plugin_ui, row->widget,
+                model->label[0] ? model->label : model->id);
+            ToriRSChrome_SetText(&app->plugin_ui, row->widget, model->text);
+            break;
+        case TORIRS_PLUGIN_W_DROPDOWN:
+            ToriRSChrome_SetLabel(
+                &app->plugin_ui, row->widget,
+                model->label[0] ? model->label : model->id);
+            if( model->choices[0] )

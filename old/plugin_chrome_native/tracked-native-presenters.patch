+        if( old != null && !old.isRecycled() && old.isMutable() && old.getWidth() == width &&
+                old.getHeight() == height )
+        {
+            old.setPixels(argb, 0, width, 0, 0, width, height);
+        }
+        else
+        {
+            surfaceBitmap = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888);
+            surfaceBitmap.setPixels(argb, 0, width, 0, 0, width, height);
+            surfaceBitmap.setDensity(android.util.DisplayMetrics.DENSITY_DEFAULT);
+            if( old != null && !old.isRecycled() )
+                old.recycle();
+        }
+        surfaceWidth = width;
+        surfaceHeight = height;
+        surfaceShellGeneration = shellGeneration;
+        surfacePageGeneration = pageGeneration;
+        chromeSurface.invalidate();

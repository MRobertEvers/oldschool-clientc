+    /** Replace the one visible pane bitmap. Stable dimensions reuse storage. */
+    public int applySurfaceFrame(
+            int shellGeneration,
+            int pageGeneration,
+            int width,
+            int height,
+            int[] argb)
+    {
+        if( width <= 0 || height <= 0 || width > 4096 || height > 4096 ||
+                (long)width * (long)height > Integer.MAX_VALUE || argb == null ||
+                argb.length != width * height )
+            return -1;
+        if( shellGeneration == 0 )
+            return -1;
+        if( shellGeneration != railSelectionGeneration )
+            return Integer.compareUnsigned(shellGeneration, railSelectionGeneration) > 0
+                    ? 0 : -1;
+        if( pageGeneration != railPageGeneration )
+            return Integer.compareUnsigned(pageGeneration, railPageGeneration) > 0
+                    ? 0 : -1;

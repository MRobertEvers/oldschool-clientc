+static void
+android_surface_input_push(
+    struct AndroidChrome* chrome, struct ToriRSChromeSurfaceInput const* input)
+{
+    /* Move storms carry no edge/text and may replace the newest move. Button
+     * edges are never coalesced, so a tap remains down then up. */
+    if( !input->mouse_down && !input->mouse_up && !input->wheel &&
+        !input->text[0] && input->edit_key == TORIRS_CHROME_KEY_NONE &&
+        chrome->surface_input_count > 0 )
+    {
+        struct ToriRSChromeSurfaceInput* tail =
+            &chrome->surface_inputs[chrome->surface_input_count - 1];
+        if( !tail->mouse_down && !tail->mouse_up && !tail->wheel &&
+            !tail->text[0] && tail->edit_key == TORIRS_CHROME_KEY_NONE )
+        {
+            *tail = *input;
+            return;
+        }
+    }
+    if( chrome->surface_input_count >= ANDROID_CHROME_SURFACE_INPUT_MAX )
+    {
+        /* Preserve button edges over intermediate moves; losing a release
+         * would leave the retained model pressed indefinitely. */
+        if( input->mouse_down || input->mouse_up )
+            for( int i = chrome->surface_input_count - 1; i >= 0; i-- )
+            {
+                struct ToriRSChromeSurfaceInput* queued = &chrome->surface_inputs[i];
+                if( queued->mouse_down || queued->mouse_up || queued->text[0] ||
+                    queued->edit_key != TORIRS_CHROME_KEY_NONE )
+                    continue;
+                *queued = *input;
+                chrome->surface_input_overflow = 1;
+                return;
+            }
+        if( input->mouse_up )
+        {
+            chrome->surface_inputs[ANDROID_CHROME_SURFACE_INPUT_MAX - 1] = *input;
+            chrome->surface_input_overflow = 1;
+            return;
+        }
+        chrome->surface_input_overflow = 1;
+        return;
+    }
+    chrome->surface_inputs[chrome->surface_input_count++] = *input;

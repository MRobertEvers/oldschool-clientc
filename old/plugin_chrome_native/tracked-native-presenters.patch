+    exec.rail_sync = android_chrome_rail_sync;
+    exec.rail_icon = android_chrome_rail_icon;
+    exec.rail_poll = android_chrome_rail_poll;
+    exec.surface_size = android_chrome_surface_size;
+    exec.surface_input = android_chrome_surface_input;
+    exec.present = android_chrome_present;
+    exec.is_surface = 1;

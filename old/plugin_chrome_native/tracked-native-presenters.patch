+bool
+PlatformWindow_ChromeOpen(
+    struct PlatformWindow* p, int width, int height, char const* title)
+{
+    int client_w;
+    int client_h;
+    LONG_PTR style;
+
+    (void)title; /* The attached page shares its top-level window's title. */
+    assert(p);
+    if( p->chrome_open )
+        return true;
+    if( !p->hwnd || width <= 0 || !win32_chrome_ensure_rail(p) )
+        return false;
+    if( !win32_main_client_size(p, &client_w, &client_h) )
+        return false;
+
+    p->chrome_requested_w = width;
+    p->chrome_collapsed_client_w = client_w;
+    p->chrome_toggle_requested = 0;
+    p->chrome_pointer_down = 0;
+    p->chrome_have_input = 0;
+    memset(&p->chrome_input, 0, sizeof(p->chrome_input));
+    p->chrome_hwnd = CreateWindowExA(
+        0,
+        RPD_CHROME_WNDCLASS,
+        "Plugins",
+        WS_CHILD | WS_CLIPCHILDREN | WS_CLIPSIBLINGS,
+        client_w,
+        0,
+        width,
+        client_h,
+        p->hwnd,
+        NULL,
+        GetModuleHandleA(NULL),
+        NULL);
+    if( !p->chrome_hwnd )
+    {
+        p->chrome_requested_w = 0;
+        return false;
+    }
+    SetWindowLongPtr(p->chrome_hwnd, GWLP_USERDATA, (LONG_PTR)p);
+    p->chrome_window_dc = GetDC(p->chrome_hwnd);
+    if( !p->chrome_window_dc )
+    {
+        DestroyWindow(p->chrome_hwnd);
+        p->chrome_hwnd = NULL;
+        p->chrome_requested_w = 0;
+        return false;
+    }
+    p->chrome_open = 1;
+
+    /* Add the page exactly once.  The rail was grown separately above and is
+     * now part of the collapsed width, which makes every open/close round trip
+     * return to one stable number instead of accumulating one-pixel drift. */
+    style = GetWindowLongPtr(p->hwnd, GWL_STYLE);
+    if( !(style & WS_POPUP) && !(style & WS_MAXIMIZE) )
+        win32_resize_client(
+            p,
+            p->chrome_collapsed_client_w + width,
+            height > client_h ? height : client_h);
+    win32_main_client_size(p, &client_w, &client_h);
+    win32_chrome_layout(p, client_w, client_h);
+    if( p->chrome_layout_w <= 0 || client_h <= 0 )
+    {
+        PlatformWindow_ChromeClose(p);
+        return false;
+    }
+
+    /* The DIB itself is lazy.  GDI native controls subclass this same child
+     * and never ask for pixels, avoiding a second full-pane allocation. */
+    p->chrome_width = p->chrome_layout_w;
+    p->chrome_height = client_h;
+    p->chrome_input.resized = 0;
+    p->chrome_have_input = 0;
+    ShowWindow(p->chrome_hwnd, SW_SHOWNOACTIVATE);
+    InvalidateRect(p->chrome_rail_hwnd, NULL, FALSE);
+    return true;
+}
+
+void
+PlatformWindow_ChromeClose(struct PlatformWindow* p)
+{
+    int client_w = 0;
+    int client_h = 0;
+    int restore_w;
+    int pane_w;
+    LONG_PTR style;
+
+    assert(p);
+    if( !p->chrome_open )
+        return;
+    win32_main_client_size(p, &client_w, &client_h);
+    pane_w = p->chrome_layout_w;
+    restore_w = client_w - pane_w;
+    if( restore_w < p->chrome_collapsed_client_w )
+        restore_w = p->chrome_collapsed_client_w;
+
+    /* Publish collapsed before destroying/moving anything.  Re-entrant
+     * WM_SIZE/WM_CAPTURECHANGED messages can then only lay out the rail. */
+    p->chrome_open = 0;
+    p->chrome_layout_w = 0;
+    p->chrome_pointer_down = 0;
+    p->chrome_have_input = 0;
+    memset(&p->chrome_input, 0, sizeof(p->chrome_input));
+    if( GetCapture() == p->chrome_hwnd )
+        ReleaseCapture();
+    win32_chrome_drop_dib(p);
+    if( p->chrome_window_dc && p->chrome_hwnd )
+        ReleaseDC(p->chrome_hwnd, p->chrome_window_dc);
+    p->chrome_window_dc = NULL;
+    if( p->chrome_hwnd )
+        DestroyWindow(p->chrome_hwnd);
+    p->chrome_hwnd = NULL;
+    p->chrome_requested_w = 0;
+    p->chrome_width = 0;
+    p->chrome_height = 0;
+    SetFocus(p->hwnd);
+
+    style = GetWindowLongPtr(p->hwnd, GWL_STYLE);
+    if( !(style & WS_POPUP) && !(style & WS_MAXIMIZE) && restore_w > 0 && client_h > 0 )
+        win32_resize_client(p, restore_w, client_h);
+    win32_main_client_size(p, &client_w, &client_h);
+    win32_chrome_layout(p, client_w, client_h);
+    if( p->chrome_rail_hwnd )
+        InvalidateRect(p->chrome_rail_hwnd, NULL, FALSE);
+}
+
+bool
+PlatformWindow_ChromeIsOpen(struct PlatformWindow const* p)
+{
+    assert(p);
+    return p->chrome_open != 0;
+}
+
+int*
+PlatformWindow_ChromePixels(struct PlatformWindow* p)
+{
+    assert(p);
+    if( !p->chrome_open )
+        return NULL;
+    if( !p->chrome_pixels &&
+        !win32_chrome_make_dib(p, p->chrome_width, p->chrome_height) )
+        return NULL;
+    return p->chrome_pixels;
+}
+
+int
+PlatformWindow_ChromeWidth(struct PlatformWindow const* p)
+{
+    assert(p);
+    return p->chrome_open ? p->chrome_width : 0;
+}
+
+int
+PlatformWindow_ChromeHeight(struct PlatformWindow const* p)
+{
+    assert(p);
+    return p->chrome_open ? p->chrome_height : 0;
+}
+
+bool
+PlatformWindow_ChromeResize(struct PlatformWindow* p, int width, int height)
+{
+    assert(p);
+    if( !p->chrome_open || width <= 0 || height <= 0 )
+        return false;
+    return win32_chrome_make_dib(p, width, height) != 0;
+}
+
+void
+PlatformWindow_ChromePresent(struct PlatformWindow* p)
+{
+    assert(p);
+    if( !p->chrome_open || !p->chrome_hwnd || !p->chrome_window_dc ||
+        !p->chrome_pixels )
+        return;
+    win32_chrome_paint_surface(p, p->chrome_window_dc);
+}
+
+bool
+PlatformWindow_ChromeTakeDirty(struct PlatformWindow* p)
+{
+    /* This backend blits the retained pane straight into its child HWND; there
+     * is no GPU texture upload to schedule. */
+    assert(p);
+    return false;
+}
+
+bool
+PlatformWindow_ChromeTakeInput(
+    struct PlatformWindow* p, struct PlatformWindow_AuxInput* out)
+{
+    assert(p);
+    assert(out);
+    if( !p->chrome_open || !p->chrome_have_input )
+        return false;
+    *out = p->chrome_input;
+    p->chrome_input.mouse_down = 0;
+    p->chrome_input.mouse_up = 0;
+    p->chrome_input.wheel = 0;
+    p->chrome_input.text[0] = '\0';
+    p->chrome_input.edit_key = PLATFORM_AUX_KEY_NONE;
+    p->chrome_input.resized = 0;
+    p->chrome_have_input = 0;
+    return true;
+}
+
+void*
+PlatformWindow_Win32ChromeHandle(struct PlatformWindow* p)
+{
+    return p && p->chrome_open ? (void*)p->chrome_hwnd : NULL;
+}
+
+bool
+PlatformWindow_Win32GameClientSize(
+    void* native_window, int* out_width, int* out_height)
+{
+    HWND hwnd = (HWND)native_window;
+    struct PlatformWindow* p;
+
+    if( !hwnd || !out_width || !out_height )
+        return false;
+    /* D3D9 can also be embedded in a probe's arbitrary HWND. Do not interpret
+     * another class's application-defined GWLP_USERDATA as our structure. */
+    if( (WNDPROC)GetWindowLongPtr(hwnd, GWLP_WNDPROC) != wnd_proc )
+        return false;
+    p = (struct PlatformWindow*)GetWindowLongPtr(hwnd, GWLP_USERDATA);
+    if( !p || p->hwnd != hwnd )
+        return false;
+    return win32_game_client_size(p, out_width, out_height) != 0;
+}
+
+void
+PlatformWindow_Win32ChromeRailSync(
+    struct PlatformWindow* p,
+    struct ToriRSChromeRailSnapshot const* snapshot)
+{
+    uint32_t old_registry;
+    uint32_t old_generation;
+    int selected_index = -1;
+    int pinned;
+    int slots;
+
+    if( !p || !p->hwnd || !snapshot || !win32_chrome_ensure_rail(p) )
+        return;
+    old_registry = p->chrome_rail_snapshot.registry_revision;
+    old_generation = p->chrome_rail_snapshot.selection_generation;
+    p->chrome_rail_snapshot = *snapshot;
+    if( p->chrome_rail_snapshot.entry_count < 0 )
+        p->chrome_rail_snapshot.entry_count = 0;
+    if( p->chrome_rail_snapshot.entry_count > TORIRS_CHROME_RAIL_ENTRY_MAX )
+        p->chrome_rail_snapshot.entry_count = TORIRS_CHROME_RAIL_ENTRY_MAX;
+    p->chrome_rail_snapshot.expanded = p->chrome_rail_snapshot.expanded ? 1 : 0;
+    p->chrome_rail_snapshot_valid = 1;
+
+    /* Reordering entries underneath a held pointer must never select the new
+     * occupant of the same visual slot. */
+    if( old_registry != snapshot->registry_revision ||
+        old_generation != snapshot->selection_generation )
+    {
+        p->chrome_rail_pressed_entry = -1;
+        p->chrome_rail_pressed_generation = 0;
+        if( p->chrome_rail_hwnd && GetCapture() == p->chrome_rail_hwnd )
+            ReleaseCapture();
+    }
+
+    for( int i = 0; i < p->chrome_rail_snapshot.entry_count; i++ )
+        if( p->chrome_rail_snapshot.entries[i].plugin_index ==
+            p->chrome_rail_snapshot.selected_entry )
+        {
+            selected_index = i;
+            break;
+        }
+    pinned = win32_chrome_rail_pinned(p);
+    slots = win32_chrome_rail_slots(p) - pinned;
+    if( selected_index >= pinned && slots > 0 )
+    {
+        int const selected = selected_index - pinned;
+        if( selected < p->chrome_rail_scroll )
+            p->chrome_rail_scroll = selected;
+        else if( selected >= p->chrome_rail_scroll + slots )
+            p->chrome_rail_scroll = selected - slots + 1;
+    }
+    win32_chrome_rail_clamp_scroll(p);
+    InvalidateRect(p->chrome_rail_hwnd, NULL, FALSE);
+}
+
+static HBITMAP
+win32_chrome_rail_make_icon(struct ToriRSChromeRailIcon const* icon)
+{
+    BITMAPINFO info;
+    HBITMAP bitmap;
+    uint32_t* pixels = NULL;
+    unsigned const br = 0x37;
+    unsigned const bg = 0x2E;
+    unsigned const bb = 0x22;
+
+    memset(&info, 0, sizeof(info));
+    info.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+    info.bmiHeader.biWidth = icon->width;
+    info.bmiHeader.biHeight = -icon->height;
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    info.bmiHeader.biCompression = BI_RGB;
+    bitmap = CreateDIBSection(
+        NULL, &info, DIB_RGB_COLORS, (void**)&pixels, NULL, 0);
+    if( !bitmap || !pixels )
+    {
+        if( bitmap )
+            DeleteObject(bitmap);
+        return NULL;
+    }
+    for( int y = 0; y < icon->height; y++ )
+        for( int x = 0; x < icon->width; x++ )
+        {
+            uint32_t const source =
+                icon->argb[(size_t)y * (size_t)icon->width + (size_t)x];
+            unsigned const a = (source >> 24) & 0xFF;
+            unsigned const r =
+                (((source >> 16) & 0xFF) * a + br * (255 - a)) / 255;
+            unsigned const g =
+                (((source >> 8) & 0xFF) * a + bg * (255 - a)) / 255;
+            unsigned const b =
+                ((source & 0xFF) * a + bb * (255 - a)) / 255;
+            pixels[(size_t)y * (size_t)icon->width + (size_t)x] =
+                (r << 16) | (g << 8) | b;
+        }
+    return bitmap;
+}
+
+void
+PlatformWindow_Win32ChromeRailIcon(
+    struct PlatformWindow* p,
+    struct ToriRSChromeRailIcon const* icon)
+{
+    struct Win32ChromeRailIcon* retained;
+    HBITMAP bitmap = NULL;
+
+    if( !p || !icon || icon->plugin_index < 0 ||
+        icon->plugin_index >= TORIRS_CHROME_RAIL_ENTRY_MAX ||
+        icon->revision == 0 || icon->width < 0 || icon->height < 0 ||
+        icon->width > TORIRS_CHROME_RAIL_ICON_SIDE_MAX ||
+        icon->height > TORIRS_CHROME_RAIL_ICON_SIDE_MAX ||
+        ((icon->width == 0) != (icon->height == 0)) )
+        return;
+    retained = &p->chrome_rail_icons[icon->plugin_index];
+    if( retained->revision == icon->revision )
+        return;
+    if( icon->width > 0 )
+    {
+        bitmap = win32_chrome_rail_make_icon(icon);
+        if( !bitmap )
+            return; /* keep the last complete revision on allocation failure */
+    }
+    if( retained->bitmap )
+        DeleteObject(retained->bitmap);
+    retained->bitmap = bitmap;
+    retained->revision = icon->revision;
+    retained->width = icon->width;
+    retained->height = icon->height;
+    if( p->chrome_rail_hwnd )
+        InvalidateRect(p->chrome_rail_hwnd, NULL, FALSE);
+}
+
+int
+PlatformWindow_Win32ChromeRailPoll(
+    struct PlatformWindow* p,
+    struct ToriRSChromeRailIntent* out,
+    int max)
+{
+    int count;
+
+    if( !p || !out || max <= 0 )
+        return 0;
+    count = p->chrome_rail_intent_count < max
+                ? p->chrome_rail_intent_count
+                : max;
+    for( int i = 0; i < count; i++ )

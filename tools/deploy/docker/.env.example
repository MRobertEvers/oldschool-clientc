# Copy to `.env` beside compose.yaml and edit. These are WSL paths: the
# Windows drive C: is /mnt/c inside the distro, so C:\torirs\osrs239 is
# /mnt/c/torirs/osrs239.
#
# All three point at the REAL Windows disk on purpose — that is what makes the
# saves survive an image rebuild, a `docker compose down`, or the container
# being deleted outright, and what keeps them hand-editable from Windows
# (torirs_server_save.c writes an INI and says it is safe to edit).

# The unpacked deployment: bin-linux/, cache.osrs239/, content/, build-web/,
# manifests/, revconfig/, script/. Mounted read-only.
TORIRS_DEPLOY_ROOT=/mnt/c/torirs/osrs239

# Player saves — one INI per character, and the player settings live inside it
# ([chat] filters, run toggle, layout mode, appearance, stats, bank).
TORIRS_SAVES_DIR=/mnt/c/torirs/osrs239/saves

# torirsserver.log and io_server.log, appended to by the supervisor.
TORIRS_LOGS_DIR=/mnt/c/torirs/osrs239/logs

# Ports, as published on the Windows host's LAN address. The node proxy on
# 10.0.0.1 expects 8088 (page) and 43594 (game WebSocket).
TORIRS_GAME_PORT=43594   # published on the Windows host; inside the container it is always 43594
TORIRS_WEB_PORT=8088     # published on the Windows host; inside the container it is always 8088

TORIRS_REV=osrs239

# The uid/gid the servers run as. It must match the uid that owns /mnt/c inside
# the distro (`id -u` / `id -g`, normally 1000) or the bind-mounted saves are
# read-only to the container and every logout fails to persist.
TORIRS_UID=1000
TORIRS_GID=1000

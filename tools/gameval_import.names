items:firerune as fire_rune
items:mindrune as mind_rune
items:bronze_arrow

// Weapons and armour. The starting kit spans every visible equipment slot so
// equipping, swapping and the wearpos_2/_3 slot claims all have something to
// act on.
items:bronze_sword
items:bronze_dagger
items:bronze_scimitar
items:bronze_axe
items:bronze_pickaxe
items:wooden_shield
items:bronze_kiteshield
items:bronze_med_helm
items:bronze_full_helm
items:bronze_platebody
items:bronze_platelegs
items:leather_gloves
items:leather_boots
items:amulet_of_power

// ------------------------------------------------------------------
// Locs — the Lumbridge castle stairs, ladders and doors that content names.
// The bulk door/gate id pairs are NOT here: they are a curated table stolen
// wholesale from OpenRune's data/cfg/doors, and giving 200 door variants
// symbols nothing reads would be noise. See content/configs/doors.door.
// ------------------------------------------------------------------
objects:spiralstairsbottom_3 as castle_stairs_bottom
objects:spiralstairsmiddle as castle_stairs_middle
objects:spiralstairstop_3 as castle_stairs_top
objects:ladder
objects:laddermiddle as ladder_middle
objects:laddertop as ladder_top
objects:qip_cook_trapdoor_open as castle_trapdoor
objects:castledoubledoorl as castle_door_left
objects:castledoubledoorr as castle_door_right

// Bank booths. The engine keys on the cache's own "Bank" menu op, so these
// symbols exist so content can bind [oploc<n>] to a specific booth — not so the
// engine can find one.
objects:bankbooth
objects:bankboothclosed
objects:bank_deposit_box

// ------------------------------------------------------------------
// Sequences — combat animations for the npcs above and for the player.
// ------------------------------------------------------------------
sequences:human_unarmedpunch
sequences:human_unarmedblock
sequences:human_death
sequences:human_sword_slash
sequences:human_sword_block
sequences:goblin_attack_unarmed as goblin_attack
sequences:goblin_block
sequences:goblin_death
sequences:rat_attack
sequences:rat_death
sequences:chicken_attack
sequences:chicken_death
sequences:cow_attack
sequences:cow_death
sequences:spider_attack
sequences:spider_death
sequences:giantspider_attack
sequences:giantspider_death
sequences:imp_attack
sequences:imp_death

// Chathead and emote sequences the dialogue scripts play.
sequences:chatneu1 as seq_chathead_talk
sequences:emote_wave as seq_wave
sequences:human_ready as seq_idle

// Drop-table objs (appended after the first pass; see content/configs/lumbridge.npc)
items:cow_hide as cowhide
items:goblin_armour as goblin_mail

// ------------------------------------------------------------------
// Interfaces — the gameframe root and everything the login burst mounts into
// it. See content/scripts/player/configs/gameframe.enum.
// ------------------------------------------------------------------
interfaces:toplevel_osrs_stretch as gameframe
interfaces:chat_left as npcchat
interfaces:chat_right as playerchat
interfaces:chatmenu as chatmulti
interfaces:messagebox as chatmessage
interfaces:bankmain
interfaces:bankside
// The equipment-stats screen and its side panel. Aliased away from OpenRune's
// bare `equipment`, which reads like the worn-items tab (387) it is opened
// from and is a different interface entirely.
interfaces:equipment as equipment_stats
interfaces:equipment_side as equipment_stats_side
interfaces:chatbox
interfaces:buff_bar
interfaces:stat_boosts_hud
interfaces:pm_chat
interfaces:hpbar_hud
interfaces:pvp_icons
interfaces:orbs
interfaces:xp_drops
interfaces:popout
interfaces:ehc_worldhop
interfaces:combat_interface
interfaces:stats
interfaces:side_journal
interfaces:inventory
interfaces:wornitems as worn_equipment
interfaces:prayerbook
interfaces:worldmap
interfaces:magic_spellbook
interfaces:side_channels
interfaces:account
interfaces:friends
interfaces:logout
interfaces:settings_side
interfaces:emote
interfaces:music

// ------------------------------------------------------------------
// Components. A gameval component value is the packed (interface << 16) | child
// uid the rev-230 protocol addresses a component by — not a bare child id — so
// these import directly. Aliases keep the shorter names the scripts already use.
// ------------------------------------------------------------------
// Varbits the combat tab reads. 357 is the equipped weapon's category, which
// selects which of the ten button layouts the tab builds — with it unset every
// button hides and the tab shows nothing but auto-retaliate. 13027 is the
// combat level printed above them.
varbits:combat_weapon_category as weapon_category
varbits:combatlevel_transmit as combat_level

// The bank's settings. Every one is a bit range inside a shared varplayer —
// the ranges come from config group 14 at runtime, these are only the ids.
// `bank_tab_1..9` are read as a run: the count of them the pack carries is how
// many tabs the bank has, so adding a tenth is a line here and nothing else.
varbits:bank_withdrawnotes
varbits:bank_insertmode
varbits:bank_requestedquantity
varbits:bank_quantity_type
varbits:bank_currenttab
varbits:bank_tab_display
varbits:bank_tab_1
varbits:bank_tab_2
varbits:bank_tab_3
varbits:bank_tab_4
varbits:bank_tab_5
varbits:bank_tab_6
varbits:bank_tab_7
varbits:bank_tab_8
varbits:bank_tab_9
varbits:bank_leaveplaceholders
varbits:bank_showincinerator
varbits:bank_hidedepositworn
varbits:bank_side_slot_ignoreinvlocks as bank_side_slot_ignore

// The varps those varbits are packed into. The bit ranges come from the cache
// (config group 14), not from here — this is only the name of the container.
varp:randomhitsound as varp_weapon_category
varp:wilderness_statistics as varp_combat_level

// The combat tab's own four, which OpenRune's AttackTab writes. Declared in
// content/scripts/player/configs/player_controls.varp and written by [login].
varp:com_mode
varp:option_nodef
varp:option_run as run
varp:sa_energy
varp:sa_attack

// Bank. `bankcert` is note-mode and `bankinsert` is insert-mode; the aliases
// are the names the bank content already writes.
varp:bankcert
// REMOVED: `bank_withdrawnotes` is a varbit (3958, varp 115 bit 0), and it is
// requested as one above. Aliasing the *base varp* under the same name made
// `%bank_withdrawnotes` resolve varp-first and compile to a whole-varp write,
// wiping bank_currenttab in bits 4..7. See docs/CONTENT_ARCHITECTURE.md §6.1.
varp:bankinsert
// REMOVED: same as bank_withdrawnotes — varbit 3959 is varp 304 bit 0, and
// varp 304 bits 1..31 are bank_requestedquantity.

// The three dialogue interfaces the chat toolkit drives, all mounted into the
// same chatbox slot: 231 the npc's side, 217 the player's, 229 a plain message
// box with no head at all. 231's four keep their unqualified names because
// content already writes them; the other two are prefixed with the interface
// so a call site says which side it is setting.
components:chat_left:head as chat_head
components:chat_left:name as chat_name
components:chat_left:continue as chat_continue
components:chat_left:text as chat_body
components:chat_right:head as playerchat_head
components:chat_right:name as playerchat_name
components:chat_right:continue as playerchat_continue
components:chat_right:text as playerchat_body
components:messagebox:text as chatmessage_body
components:messagebox:continue as chatmessage_continue
components:chatbox:chatcrm as chat_container
components:chatbox:crmcanvas as chat_slot

components:bankmain:items as bankmain_items
components:bankmain:swap as bankmain_swap
components:bankmain:insert as bankmain_insert
components:bankmain:item as bankmain_item_mode
components:bankmain:note as bankmain_note_mode
components:bankmain:quantity1 as bankmain_qty_1
components:bankmain:quantity5 as bankmain_qty_5
components:bankmain:quantity10 as bankmain_qty_10
components:bankmain:quantityx as bankmain_qty_x
components:bankmain:quantityall as bankmain_qty_all
components:bankmain:depositinv as bankmain_deposit_inv
components:bankmain:depositworn as bankmain_deposit_worn
components:bankside:items as bankside_items

// The two panels the sidebar tabs and the modal screens mount into, and the
// inventory tab's own grid. `wornitems:equipment` is 387:1 — the worn tab's
// only op, "View equipment stats".
components:toplevel_osrs_stretch:mainmodal as gameframe_mainmodal
components:toplevel_osrs_stretch:sidemodal as gameframe_sidemodal
components:inventory:items as inventory_items
components:toplevel_osrs_stretch:floater as gameframe_floater
components:worldmap:esckey as worldmap_esckey
components:worldmap:close as worldmap_close
components:wornitems:equipment as worn_equipment_stats

// The worn tab's eleven slot components. OpenRune reads the same mapping out of
// the cache (`enums.equipment_tab_to_slots_map`); the gameval name carries the
// wear slot, which is why they are not consecutive — 6, 8 and 11 are arms, hair
// and jaw, which nothing is equipped into. See player/configs/worn.enum.
components:wornitems:slot0 as worn_slot0
components:wornitems:slot1 as worn_slot1
components:wornitems:slot2 as worn_slot2
components:wornitems:slot3 as worn_slot3
components:wornitems:slot4 as worn_slot4
components:wornitems:slot5 as worn_slot5
components:wornitems:slot7 as worn_slot7
components:wornitems:slot9 as worn_slot9
components:wornitems:slot10 as worn_slot10
components:wornitems:slot12 as worn_slot12
components:wornitems:slot13 as worn_slot13

// The equipment-stats screen. `universe` is 84:0, which the worn container
// binds to; the other eighteen are the empty text rows under each heading, in
// screen order. The gameval names are the cross-check that this is the modern
// layout: `stabatt` IS the stab-attack row, not a component that happens to sit
// where one used to.
components:equipment:universe as equipment_stats_container
components:equipment:stabatt as equipment_stats_stabatt
components:equipment:slashatt as equipment_stats_slashatt
components:equipment:crushatt as equipment_stats_crushatt
components:equipment:magicatt as equipment_stats_magicatt
components:equipment:rangeatt as equipment_stats_rangeatt
components:equipment:stabdef as equipment_stats_stabdef
components:equipment:slashdef as equipment_stats_slashdef
components:equipment:crushdef as equipment_stats_crushdef
components:equipment:magicdef as equipment_stats_magicdef
components:equipment:rangedef as equipment_stats_rangedef
components:equipment:meleestrength as equipment_stats_meleestrength
components:equipment:rangestrength as equipment_stats_rangestrength
components:equipment:magicdamage as equipment_stats_magicdamage
components:equipment:prayer as equipment_stats_prayer
components:equipment:typemultiplier as equipment_stats_typemultiplier
components:equipment:slayermultiplier as equipment_stats_slayermultiplier
components:equipment:attackspeedbase as equipment_stats_attackspeedbase
components:equipment:attackspeedactual as equipment_stats_attackspeedactual


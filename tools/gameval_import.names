// Symbols the rev-230 mock's content refers to, resolved against OpenRune's
// gameval table by tools/gameval_import.py:
//
//     python3 tools/gameval_import.py --names tools/gameval_import.names \
//         --out src/net/mock/content/pack
//
// One `namespace:name` per line; `name as alias` renames the symbol content
// writes. Every id is re-validated against cache.osrs230 by mock230_pack —
// OpenRune's cache is revision 235.10 and this list is a claim, not a fact.
//
// Find a symbol with:  tools/gameval_import.py --search npcs goblin

// ------------------------------------------------------------------
// NPCs — OpenRune's Lumbridge roster (areas/lumbridge/spawns/SpawnPlugin.kt)
// ------------------------------------------------------------------
npcs:hans
npcs:man
npcs:man3 as man_alt
npcs:woman
npcs:rat
npcs:imp
npcs:goblin
npcs:chicken
npcs:cow
npcs:guard1 as guard
npcs:duck
npcs:sheepunsheeredshaggy2 as sheep
npcs:ramunsheeredshaggy as ram
npcs:giantspider1 as giant_spider
npcs:giantspider2 as giant_spider_27
npcs:sos_pest_giantspider1 as giant_spider_50
npcs:poh_giantspider as huge_spider
npcs:godwars_goblin2 as goblin_12
npcs:godwars_goblin4 as goblin_15
npcs:sos_war_goblin_armed as goblin_armed
npcs:goblin_unarmed_melee_in_3 as goblin_unarmed
npcs:goblin_armed_melee_4 as goblin_armed_2
npcs:man4 as man_alt2
npcs:varrock_man1 as man_alt3
npcs:woman2 as woman_alt
npcs:falador_man1 as drunken_man
npcs:dragonslayer_giantrat_1_key as zombie_rat
npcs:dragonslayer_giantrat_2 as zombie_rat_2


items:bronze_platebody
items:bronze_platelegs
items:leather_gloves
items:leather_boots
items:amulet_of_power

// ------------------------------------------------------------------
// Locs — the Lumbridge castle stairs, ladders and doors that content names.
// The bulk door/gate id pairs are NOT here: they are a curated table stolen
// wholesale from OpenRune's data/cfg/doors, and giving 200 door variants
// symbols nothing reads would be noise. See content/configs/doors.door.
// ------------------------------------------------------------------
objects:spiralstairsbottom_3 as castle_stairs_bottom
objects:spiralstairsmiddle as castle_stairs_middle
objects:spiralstairstop_3 as castle_stairs_top
objects:ladder
objects:laddermiddle as ladder_middle
objects:laddertop as ladder_top
objects:qip_cook_trapdoor_open as castle_trapdoor
objects:castledoubledoorl as castle_door_left
objects:castledoubledoorr as castle_door_right

// ------------------------------------------------------------------
// Sequences — combat animations for the npcs above and for the player.
// ------------------------------------------------------------------
sequences:human_unarmedpunch
sequences:human_unarmedblock
sequences:human_death
sequences:human_sword_slash
sequences:human_sword_block
sequences:goblin_attack_unarmed as goblin_attack
sequences:goblin_block
sequences:goblin_death
sequences:rat_attack
sequences:rat_death
sequences:chicken_attack
sequences:chicken_death
sequences:cow_attack
sequences:cow_death
sequences:spider_attack
sequences:spider_death
sequences:giantspider_attack
sequences:giantspider_death
sequences:imp_attack
sequences:imp_death

// Chathead and emote sequences the dialogue scripts play.
sequences:chatneu1 as seq_chathead_talk
sequences:emote_wave as seq_wave
sequences:human_ready as seq_idle


files: src/platform/platform_sdl2_renderer_soft3d.c
---
 src/platform/platform_sdl2_renderer_soft3d.c | 80 +++++++++++++++++++-
 1 file changed, 79 insertions(+), 1 deletion(-)

diff --git a/src/platform/platform_sdl2_renderer_soft3d.c b/src/platform/platform_sdl2_renderer_soft3d.c
index de701e34e..dfc520db6 100644
--- a/src/platform/platform_sdl2_renderer_soft3d.c
+++ b/src/platform/platform_sdl2_renderer_soft3d.c
@@ -1030,6 +1030,74 @@ soft3d_draw_model(
     }
 }
 
+/*
+ * ROUTE fbtraffic -- the framebuffer's memory FOOTPRINT, isolated from every
+ * other thing the frame does.
+ *
+ * TORIDRAW_FB_STRIDE=<pixels> overrides only the stride the 3D raster steps
+ * rows by. Nothing else moves: the same faces are ordered, the same spans run,
+ * the same pixels are written by the same instructions -- vp.stride is already
+ * a variable loaded from a struct, so the codegen is untouched. All that
+ * changes is WHERE those stores land. At 765 the 3D pass scatters over
+ * 1.539 MB against a 1 MB L2; at 64 it covers 128 KB; at 1 the whole pass fits
+ * in 5 KB of a 16 KB L1. The picture is garbage and that is the point -- the
+ * delta is the entire cost of the framebuffer footprint and nothing else.
+ *
+ * TORIDRAW_FB_NOCLEAR=1 removes the per-frame clear: 384,795 stores over
+ * 1.539 MB. It ablates two things at once and they pull opposite ways -- it
+ * removes the stores, and it removes the pass that leaves the last megabyte of
+ * the buffer warm in L2 for the rasterizer that follows.
+ *
+ * TORIDRAW_FB_NTCLEAR=1 runs the non-temporal asm clear instead of the dword
+ * loop. Note which of those the shipped build actually executes: the call to
+ * toridraw_fb_clear32_nt_asm sits behind ToriDraw_FrameAbArm(), which returns
+ * 0 unless TORIDRAW_FRAME_AB is in the environment -- so the kernel is linked,
+ * nm finds it, and it never runs.
+ */
+static int
+fb_env_int(const char* name, int missing)
+{
+    const char* v;
+
+    assert(name);
+    v = getenv(name);
+    if( !v || v[0] == '\0' )
+        return missing;
+    return atoi(v);
+}
+
+/** Pixels per raster row, or -1 for "leave the viewport alone". Read once. */
+static int
+fb_stride_override(void)
+{
+    static int cached = -2; /* -2 = not looked at yet */
+
+    if( cached == -2 )
+    {
+        int v = fb_env_int("TORIDRAW_FB_STRIDE", -1);
+        cached = (v > 0) ? v : -1;
+    }
+    return cached;
+}
+
+/** 0 = clear as shipped, 1 = skip it, 2 = non-temporal kernel. Read once. */
+static int
+fb_clear_mode(void)
+{
+    static int cached = -1;
+
+    if( cached < 0 )
+    {
+        if( fb_env_int("TORIDRAW_FB_NOCLEAR", 0) )
+            cached = 1;
+        else if( fb_env_int("TORIDRAW_FB_NTCLEAR", 0) )
+            cached = 2;
+        else
+            cached = 0;
+    }
+    return cached;
+}
+
 void
 ToriRS_Soft3D_Init(
     struct ToriRS_Soft3D* soft,
@@ -1080,6 +1148,11 @@ ToriRS_Soft3D_Execute(
         ToriDraw_ScenePrepareProjectionCamera(soft->scene, &soft->camera_3d);
         if( soft->view_port_3d.stride <= 0 )
             soft->view_port_3d.stride = soft->stride;
+        {
+            int const fb_ov = fb_stride_override();
+            if( fb_ov > 0 )
+                soft->view_port_3d.stride = fb_ov;
+        }
         break;
 
     case TORIRSRC_END_3D:
@@ -1607,7 +1680,12 @@ ToriRS_Soft3D_RenderFrame(
 #else
         uint32_t bg = (uint32_t)TORIRS_SOFT3D_BG;
 #endif
-        if( ToriDraw_FrameAbArm() )
+        int const fb_mode = fb_clear_mode();
+        if( fb_mode == 1 )
+        {
+            /* ablation: the frame opens on whatever the last one left */
+        }
+        else if( fb_mode == 2 || ToriDraw_FrameAbArm() )
         {
             TORIDRAW_FB_CLEAR32(p, n, bg);
         }

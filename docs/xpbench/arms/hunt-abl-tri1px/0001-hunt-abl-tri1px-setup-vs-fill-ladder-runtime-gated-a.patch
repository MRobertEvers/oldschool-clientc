diff --git a/3rd/toridraw/graphics/raster/huntabl.h b/3rd/toridraw/graphics/raster/huntabl.h
new file mode 100644
index 000000000..34723b8aa
--- /dev/null
+++ b/3rd/toridraw/graphics/raster/huntabl.h
@@ -0,0 +1,72 @@
+#ifndef TORIDRAW_HUNTABL_H
+#define TORIDRAW_HUNTABL_H
+
+/*
+ * HUNT ABLATION: per-triangle SETUP versus per-pixel FILL.
+ *
+ * Not shippable. Not an optimisation. This is a stopwatch that answers one
+ * question the XP frame hunt is stuck on: of the 26.61 ms the EIP map credits
+ * to the two handrolled raster kernels, how much is the per-triangle prologue
+ * (vertex sort, gradient solve, the divides, edge setup) and how much is the
+ * trapezoid walk and the span fill?
+ *
+ * Deliberately NOT named after the makefile's three poisoned strings
+ * (see src/makefile: any of them inside TORIDRAW_PROBE_CFLAGS silently drops
+ * all four handrolled asm kernels, so a build that carries them measures a
+ * different renderer). Nothing here is a compile flag at all: the level is a
+ * global the asm kernels read, so ONE binary carries every rung and every
+ * delta is within-binary as well as within-job.
+ *
+ *   HUNTABL_LEVEL=0 (or unset)  everything runs. The ladder's own control:
+ *                               it still pays the level load and branch, so
+ *                               rung-to-rung deltas do not contain them.
+ *   HUNTABL_LEVEL=1             the per-triangle prologue runs in full and
+ *                               the scanline walk and span fill do not.
+ *                               Zero pixels are written by any triangle.
+ *   HUNTABL_LEVEL=2             the triangle kernel returns at its entry.
+ *                               Bounds the WHOLE of both kernels, which is
+ *                               what tests whether the EIP map's 16.27 ms and
+ *                               10.34 ms are where the time actually is.
+ *
+ * base - 1 = walk + span setup + fill.   1 - 2 = the per-triangle prologue.
+ *
+ * Why a runtime global and not #ifdef: an unconditional `return` after the
+ * prologue lets GCC delete the prologue as dead, which would hand back a
+ * measurement of nothing. A load the compiler cannot fold keeps every divide
+ * live. The asm kernels have no such hazard but read the same global so the
+ * rungs line up.
+ */
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** -1 until HUNTABL_LEVEL is read; 0/1/2 after. Read by name from
+ *  gouraud_tri_i686.S and tex_tri_i686.S, so it must stay non-static. */
+extern int g_huntabl_level;
+
+/** Reads HUNTABL_LEVEL once. Called from the model raster entry, never from a
+ *  triangle: getenv() walks environ with a strncmp per entry. */
+void HuntAbl_LevelInit(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+/** Cut the trapezoid walk and everything under it; keep the prologue. */
+#define HUNTABL_CUT_WALK()                                                     \
+    do                                                                         \
+    {                                                                          \
+        if( g_huntabl_level >= 1 )                                             \
+            return;                                                            \
+    } while( 0 )
+
+/** Cut the whole triangle. Placed at the first statement of the walk. */
+#define HUNTABL_CUT_ALL()                                                      \
+    do                                                                         \
+    {                                                                          \
+        if( g_huntabl_level >= 2 )                                             \
+            return;                                                            \
+    } while( 0 )
+
+#endif
diff --git a/3rd/toridraw/graphics/raster/raster_ablate.c b/3rd/toridraw/graphics/raster/raster_ablate.c
index 06e9b3e2b..5c8b76fff 100644
--- a/3rd/toridraw/graphics/raster/raster_ablate.c
+++ b/3rd/toridraw/graphics/raster/raster_ablate.c
@@ -7,3 +7,28 @@ int g_toridraw_ablate = -1;
 int g_toridraw_ablate_tex = -1;
 
 #endif
+
+/* ---- hunt ablation: setup vs fill -------------------------------------- */
+/* Lives here because raster_ablate.c is already in the toridraw unity link and
+ * the two asm kernels need a real, non-static symbol to load. Deliberately
+ * OUTSIDE the TORIDRAW_ABLATE guard above: this ladder must exist in a build
+ * that still has all four handrolled kernels, which is exactly the build the
+ * makefile refuses to give the guarded ladder. See graphics/raster/huntabl.h. */
+#include "graphics/raster/huntabl.h"
+#include <assert.h>
+#include <stdlib.h>
+
+/* `used` so LTO cannot delete or privatise the symbol the .S files load:
+ * the assembler objects are not IR, so nothing in the IR ever names it. */
+__attribute__((used)) int g_huntabl_level = -1;
+
+void
+HuntAbl_LevelInit(void)
+{
+    char const* s = getenv("HUNTABL_LEVEL");
+    g_huntabl_level = s ? atoi(s) : 0;
+    if( g_huntabl_level < 0 )
+        g_huntabl_level = 0;
+    if( g_huntabl_level > 2 )
+        g_huntabl_level = 2;
+}

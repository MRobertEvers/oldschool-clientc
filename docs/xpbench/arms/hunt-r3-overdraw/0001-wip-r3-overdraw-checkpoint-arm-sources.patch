diff --git a/3rd/toridraw/graphics/raster/od_census.c b/3rd/toridraw/graphics/raster/od_census.c
new file mode 100644
index 000000000..59ef47dd0
--- /dev/null
+++ b/3rd/toridraw/graphics/raster/od_census.c
@@ -0,0 +1,490 @@
+#include "graphics/raster/od_census.h"
+
+#if defined(TORIDRAW_OD_CENSUS) && TORIDRAW_OD_CENSUS
+
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define OD_MAX_FACES (1 << 19)
+#define OD_MAX_MODELS (1 << 14)
+#define OD_HIST 33
+#define OD_SURVBINS 11
+
+int g_toridraw_od_active;
+int g_toridraw_od_class;
+
+static uint8_t const* g_base;
+static size_t g_pixels;
+
+static uint8_t* g_cnt;      /* writes to this pixel this frame, saturating */
+static uint8_t* g_lastkind; /* kernel that wrote it last */
+static uint8_t* g_lastclass; /* geometry class that wrote it last */
+static uint32_t* g_owner;   /* face id that wrote it last (1-based, 0 = none) */
+
+static uint32_t* g_face_writes;
+static uint32_t* g_face_model;
+static uint32_t* g_face_surv;
+static uint32_t* g_model_writes;
+static uint32_t* g_model_surv;
+static uint8_t* g_model_class;
+static uint32_t* g_model_spans;
+static uint8_t g_cur_class;
+
+static uint32_t g_face_id;  /* faces seen this frame; ids are 1-based */
+static uint32_t g_model_id; /* models seen this frame; ids are 1-based */
+
+/* Accumulators over the whole run. */
+static double g_frames;
+static double g_hist[OD_HIST];
+static double g_covered;
+static double g_writes[TORIDRAW_OD_KINDS];
+static double g_wasted[TORIDRAW_OD_KINDS];
+static double g_hidden_faces, g_hidden_face_writes, g_drawn_faces, g_drawn_face_writes;
+static double g_hidden_models, g_hidden_model_writes, g_drawn_models;
+static double g_model_surv_hist[OD_SURVBINS]; /* models by surviving-pixel share */
+static double g_model_surv_writes[OD_SURVBINS];
+static double g_face_overflow, g_model_overflow, g_span_oob;
+static double g_spans;
+static double g_class_writes[TORIDRAW_OD_CLASSES];
+static double g_class_hidden_writes[TORIDRAW_OD_CLASSES];
+static double g_class_models[TORIDRAW_OD_CLASSES];
+static double g_class_hidden_models[TORIDRAW_OD_CLASSES];
+static double g_class_surv[TORIDRAW_OD_CLASSES];
+static double g_class_spans[TORIDRAW_OD_CLASSES];
+static double g_class_hidden_spans[TORIDRAW_OD_CLASSES];
+/* g_overmat[victim][killer]: pixels written by `victim` and later replaced by
+ * `killer`. The causal form of "wasted writes" -- it names the occluder. */
+static double g_overmat[TORIDRAW_OD_CLASSES][TORIDRAW_OD_CLASSES];
+static int g_registered;
+
+static void
+od_dump(void);
+
+static void
+od_alloc(size_t pixels)
+{
+    g_cnt = calloc(pixels, 1);
+    assert(g_cnt);
+    g_lastkind = calloc(pixels, 1);
+    assert(g_lastkind);
+    g_lastclass = calloc(pixels, 1);
+    assert(g_lastclass);
+    g_owner = calloc(pixels, sizeof(*g_owner));
+    assert(g_owner);
+    g_face_writes = calloc(OD_MAX_FACES, sizeof(*g_face_writes));
+    assert(g_face_writes);
+    g_face_model = calloc(OD_MAX_FACES, sizeof(*g_face_model));
+    assert(g_face_model);
+    g_face_surv = calloc(OD_MAX_FACES, sizeof(*g_face_surv));
+    assert(g_face_surv);
+    g_model_writes = calloc(OD_MAX_MODELS, sizeof(*g_model_writes));
+    assert(g_model_writes);
+    g_model_surv = calloc(OD_MAX_MODELS, sizeof(*g_model_surv));
+    assert(g_model_surv);
+    g_model_class = calloc(OD_MAX_MODELS, 1);
+    assert(g_model_class);
+    g_model_spans = calloc(OD_MAX_MODELS, sizeof(*g_model_spans));
+    assert(g_model_spans);
+}
+
+static size_t
+od_face_span(void)
+{
+    size_t n = (size_t)g_face_id + 1u;
+    return n < OD_MAX_FACES ? n : (size_t)OD_MAX_FACES;
+}
+
+static size_t
+od_model_span(void)
+{
+    size_t n = (size_t)g_model_id + 1u;
+    return n < OD_MAX_MODELS ? n : (size_t)OD_MAX_MODELS;
+}
+
+/*
+ * Close out the frame that just finished: fold its per-pixel counters into the
+ * run histogram, resolve who survived, then zero for the next one.
+ */
+static void
+od_flush(void)
+{
+    size_t fspan;
+    size_t mspan;
+
+    if( !g_cnt || g_face_id == 0 )
+        return;
+
+    for( size_t p = 0; p < g_pixels; p++ )
+    {
+        int c = g_cnt[p];
+        if( c == 0 )
+            continue;
+        g_covered += 1.0;
+        g_hist[c < OD_HIST - 1 ? c : OD_HIST - 1] += 1.0;
+        g_face_surv[g_owner[p]]++;
+    }
+
+    fspan = od_face_span();
+    mspan = od_model_span();
+
+    for( size_t f = 1; f < fspan; f++ )
+    {
+        uint32_t w = g_face_writes[f];
+        if( w == 0 )
+            continue;
+        if( g_face_surv[f] == 0 )
+        {
+            g_hidden_faces += 1.0;
+            g_hidden_face_writes += (double)w;
+        }
+        else
+        {
+            g_drawn_faces += 1.0;
+            g_drawn_face_writes += (double)w;
+        }
+        g_model_surv[g_face_model[f]] += g_face_surv[f];
+    }
+
+    for( size_t m = 1; m < mspan; m++ )
+    {
+        uint32_t w = g_model_writes[m];
+        int bin;
+        if( w == 0 )
+            continue;
+        int cl = g_model_class[m];
+        g_drawn_models += 1.0;
+        g_class_models[cl] += 1.0;
+        g_class_writes[cl] += (double)w;
+        g_class_surv[cl] += (double)g_model_surv[m];
+        g_class_spans[cl] += (double)g_model_spans[m];
+        if( g_model_surv[m] == 0 )
+        {
+            g_hidden_models += 1.0;
+            g_hidden_model_writes += (double)w;
+            g_class_hidden_models[cl] += 1.0;
+            g_class_hidden_writes[cl] += (double)w;
+            g_class_hidden_spans[cl] += (double)g_model_spans[m];
+        }
+        bin = (int)((double)g_model_surv[m] * (OD_SURVBINS - 1) / (double)w);
+        if( bin < 0 )
+            bin = 0;
+        if( bin > OD_SURVBINS - 1 )
+            bin = OD_SURVBINS - 1;
+        g_model_surv_hist[bin] += 1.0;
+        g_model_surv_writes[bin] += (double)w;
+    }
+
+    memset(g_cnt, 0, g_pixels);
+    memset(g_lastkind, 0, g_pixels);
+    memset(g_lastclass, 0, g_pixels);
+    memset(g_owner, 0, g_pixels * sizeof(*g_owner));
+    memset(g_face_writes, 0, fspan * sizeof(*g_face_writes));
+    memset(g_face_surv, 0, fspan * sizeof(*g_face_surv));
+    memset(g_face_model, 0, fspan * sizeof(*g_face_model));
+    memset(g_model_writes, 0, mspan * sizeof(*g_model_writes));
+    memset(g_model_surv, 0, mspan * sizeof(*g_model_surv));
+    memset(g_model_class, 0, mspan);
+    memset(g_model_spans, 0, mspan * sizeof(*g_model_spans));
+    g_face_id = 0;
+    g_model_id = 0;
+    g_frames += 1.0;
+}
+
+void
+ToriDraw_OdCensusFrame(void const* fb_base, size_t pixels)
+{
+    assert(fb_base);
+    assert(pixels > 0);
+
+    if( !g_registered )
+    {
+        g_registered = 1;
+        atexit(od_dump);
+    }
+    if( !g_cnt )
+    {
+        g_pixels = pixels;
+        od_alloc(pixels);
+    }
+    else
+    {
+        od_flush();
+    }
+    /* A resize would invalidate the counters; the bench never resizes. */
+    assert(pixels == g_pixels);
+    g_base = (uint8_t const*)fb_base;
+    g_toridraw_od_active = 1;
+}
+
+void
+ToriDraw_OdCensusModel(void)
+{
+    if( !g_toridraw_od_active )
+        return;
+    if( g_model_id + 1 >= OD_MAX_MODELS )
+    {
+        g_model_overflow += 1.0;
+        return;
+    }
+    g_model_id++;
+    g_model_class[g_model_id] =
+        (uint8_t)(g_toridraw_od_class >= 0 && g_toridraw_od_class < TORIDRAW_OD_CLASSES
+                      ? g_toridraw_od_class
+                      : TORIDRAW_OD_CLASS_OTHER);
+    g_cur_class = g_model_class[g_model_id];
+}
+
+void
+ToriDraw_OdCensusFace(void)
+{
+    if( !g_toridraw_od_active )
+        return;
+    if( g_face_id + 1 >= OD_MAX_FACES )
+    {
+        g_face_overflow += 1.0;
+        return;
+    }
+    g_face_id++;
+    g_face_model[g_face_id] = g_model_id;
+}
+
+void
+ToriDraw_OdCensusSpan(void const* first, int len, int kind)
+{
+    ptrdiff_t byte_off;
+    size_t idx;
+
+    assert(first);
+    assert(kind >= 0);
+    assert(kind < TORIDRAW_OD_KINDS);
+
+    if( len <= 0 || !g_cnt || g_face_id == 0 )
+        return;
+
+    byte_off = (uint8_t const*)first - g_base;
+    if( byte_off < 0 )
+    {
+        g_span_oob += 1.0;
+        return;
+    }
+    idx = (size_t)byte_off / 4u;
+    if( idx + (size_t)len > g_pixels )
+    {
+        g_span_oob += 1.0;
+        return;
+    }
+
+    g_spans += 1.0;
+    g_writes[kind] += (double)len;
+    g_face_writes[g_face_id] += (unsigned)len;
+    g_model_writes[g_model_id] += (unsigned)len;
+    g_model_spans[g_model_id] += 1u;
+
+    for( int i = 0; i < len; i++ )
+    {
+        size_t p = idx + (size_t)i;
+        if( g_cnt[p] )
+        {
+            g_wasted[g_lastkind[p]] += 1.0;
+            g_overmat[g_lastclass[p]][g_cur_class] += 1.0;
+        }
+        if( g_cnt[p] < 255 )
+            g_cnt[p]++;
+        g_lastkind[p] = (uint8_t)kind;
+        g_lastclass[p] = g_cur_class;
+        g_owner[p] = g_face_id;
+    }
+}
+
+static char const* const g_kind_name[TORIDRAW_OD_KINDS] = { "gouraud",    "gouraud_a",
+                                                            "flat",       "flat_a",
+                                                            "tex_opaque", "tex_trans",
+                                                            "tex_other" };
+
+static char const* const g_class_name[TORIDRAW_OD_CLASSES] = {
+    "terrain",   "elem_invalid", "elem_ground",  "scenery",       "wall_a",
+    "wall_b",    "ground_decor", "wall_decor",   "ground_object", "other/widget"
+};
+
+static void
+od_dump(void)
+{
+    char const* path = getenv("TORIDRAW_OD_CENSUS_FILE");
+    FILE* out = stderr;
+    double writes = 0.0;
+    double wasted = 0.0;
+    double f;
+
+    od_flush();
+    if( g_frames <= 0.0 )
+        return;
+    f = g_frames;
+
+    if( path )
+    {
+        FILE* fp = fopen(path, "wb");
+        if( fp )
+            out = fp;
+    }
+
+    for( int k = 0; k < TORIDRAW_OD_KINDS; k++ )
+    {
+        writes += g_writes[k];
+        wasted += g_wasted[k];
+    }
+
+    fprintf(out, "od-census: %.0f frames, %.0f fb pixels\n", f, (double)g_pixels);
+    fprintf(
+        out,
+        "  writes/frame      %.0f\n"
+        "  covered/frame     %.0f  (%.2f%% of the canvas)\n"
+        "  overdraw vs canvas   %.3fx\n"
+        "  overdraw vs covered  %.3fx\n"
+        "  wasted writes     %.0f/frame  (%.2f%% of writes)\n"
+        "  spans/frame       %.0f   px/span %.2f\n",
+        writes / f,
+        g_covered / f,
+        100.0 * (g_covered / f) / (double)g_pixels,
+        (writes / f) / (double)g_pixels,
+        writes / g_covered,
+        wasted / f,
+        100.0 * wasted / writes,
+        g_spans / f,
+        writes / g_spans);
+
+    fprintf(out, "  by kernel: kind, writes/frame, share, wasted/frame, share of own\n");
+    for( int k = 0; k < TORIDRAW_OD_KINDS; k++ )
+    {
+        if( g_writes[k] == 0.0 )
+            continue;
+        fprintf(
+            out,
+            "    %-11s %10.0f  %5.2f%%  %10.0f  %5.2f%%\n",
+            g_kind_name[k],
+            g_writes[k] / f,
+            100.0 * g_writes[k] / writes,
+            g_wasted[k] / f,
+            100.0 * g_wasted[k] / g_writes[k]);
+    }
+
+    fprintf(out, "  writes-per-pixel histogram (share of COVERED pixels):\n");
+    {
+        double run = 0.0;
+        for( int i = 1; i < OD_HIST; i++ )
+        {
+            if( g_hist[i] == 0.0 )
+                continue;
+            run += g_hist[i];
+            fprintf(
+                out,
+                "    n=%-3d %10.0f/frame %6.2f%%  cum %6.2f%%\n",
+                i,
+                g_hist[i] / f,
+                100.0 * g_hist[i] / g_covered,
+                100.0 * run / g_covered);
+        }
+    }
+
+    fprintf(
+        out,
+        "  faces:  %.0f/frame drew a visible pixel, %.0f/frame FULLY HIDDEN (%.2f%%)\n"
+        "          hidden face write mass %.0f/frame = %.2f%% of all writes\n",
+        g_drawn_faces / f,
+        g_hidden_faces / f,
+        100.0 * g_hidden_faces / (g_hidden_faces + g_drawn_faces),
+        g_hidden_face_writes / f,
+        100.0 * g_hidden_face_writes / writes);
+    fprintf(
+        out,
+        "  models: %.0f/frame drew pixels, %.0f/frame FULLY HIDDEN (%.2f%%)\n"
+        "          hidden model write mass %.0f/frame = %.2f%% of all writes\n",
+        g_drawn_models / f,
+        g_hidden_models / f,
+        100.0 * g_hidden_models / g_drawn_models,
+        g_hidden_model_writes / f,
+        100.0 * g_hidden_model_writes / writes);
+
+    fprintf(out, "  models by surviving-pixel share (0 = every pixel overdrawn):\n");
+    for( int b = 0; b < OD_SURVBINS; b++ )
+    {
+        if( g_model_surv_hist[b] == 0.0 )
+            continue;
+        fprintf(
+            out,
+            "    %3d-%3d%%  %8.1f models/frame  %10.0f writes/frame (%.2f%%)\n",
+            b * 10,
+            b * 10 + 10,
+            g_model_surv_hist[b] / f,
+            g_model_surv_writes[b] / f,
+            100.0 * g_model_surv_writes[b] / writes);
+    }
+
+    fprintf(out, "  by geometry class: models/frame, hidden, writes/frame, share, hidden writes, share of own\n");
+    for( int c = 0; c < TORIDRAW_OD_CLASSES; c++ )
+    {
+        if( g_class_models[c] == 0.0 )
+            continue;
+        fprintf(
+            out,
+            "    %-13s %7.1f  %7.1f (%5.2f%%)  %9.0f  %5.2f%%  %9.0f  %5.2f%%  surv/write %.3f\n",
+            g_class_name[c],
+            g_class_models[c] / f,
+            g_class_hidden_models[c] / f,
+            100.0 * g_class_hidden_models[c] / g_class_models[c],
+            g_class_writes[c] / f,
+            100.0 * g_class_writes[c] / writes,
+            g_class_hidden_writes[c] / f,
+            100.0 * g_class_hidden_writes[c] / g_class_writes[c],
+            g_class_surv[c] / g_class_writes[c]);
+    }
+
+    fprintf(out, "  spans by class: spans/frame, hidden spans/frame, share of own, px/span\n");
+    for( int c = 0; c < TORIDRAW_OD_CLASSES; c++ )
+    {
+        if( g_class_spans[c] == 0.0 )
+            continue;
+        fprintf(
+            out,
+            "    %-13s %9.0f  %9.0f  %5.2f%%  %.2f\n",
+            g_class_name[c],
+            g_class_spans[c] / f,
+            g_class_hidden_spans[c] / f,
+            100.0 * g_class_hidden_spans[c] / g_class_spans[c],
+            g_class_writes[c] / g_class_spans[c]);
+    }
+
+    fprintf(out, "  overdraw matrix, victim (row) covered by killer (col), px/frame:\n");
+    fprintf(out, "    %-13s", "victim\\killer");
+    for( int k = 0; k < TORIDRAW_OD_CLASSES; k++ )
+        if( g_class_models[k] != 0.0 )
+            fprintf(out, " %12s", g_class_name[k]);
+    fprintf(out, " %12s\n", "TOTAL");
+    for( int v = 0; v < TORIDRAW_OD_CLASSES; v++ )
+    {
+        double row = 0.0;
+        for( int k = 0; k < TORIDRAW_OD_CLASSES; k++ )
+            row += g_overmat[v][k];
+        if( row == 0.0 )
+            continue;
+        fprintf(out, "    %-13s", g_class_name[v]);
+        for( int k = 0; k < TORIDRAW_OD_CLASSES; k++ )
+            if( g_class_models[k] != 0.0 )
+                fprintf(out, " %12.0f", g_overmat[v][k] / f);
+        fprintf(out, " %12.0f\n", row / f);
+    }
+
+    if( g_face_overflow || g_model_overflow || g_span_oob )
+        fprintf(
+            out,
+            "  OVERFLOW face=%.0f model=%.0f span_oob=%.0f\n",
+            g_face_overflow,
+            g_model_overflow,
+            g_span_oob);
+    fflush(out);
+    if( out != stderr )
+        fclose(out);
+}
+
+#endif
diff --git a/3rd/toridraw/graphics/raster/od_census.h b/3rd/toridraw/graphics/raster/od_census.h
new file mode 100644
index 000000000..a01e2cb70
--- /dev/null
+++ b/3rd/toridraw/graphics/raster/od_census.h
@@ -0,0 +1,97 @@
+#ifndef TORIDRAW_RASTER_OD_CENSUS_H
+#define TORIDRAW_RASTER_OD_CENSUS_H
+
+/**
+ * How many times is a world pixel actually written?
+ *
+ * Every occlusion proposal is a bet on this one distribution. "Overdraw is
+ * 2.25x" and "overdraw is 5.06x" were two different guesses about the
+ * DENOMINATOR (canvas versus a 512x334 world box), and neither had counted a
+ * single write. This counts them.
+ *
+ * -DTORIDRAW_OD_CENSUS=1 only. A census build is never timed, so this is free
+ * to keep a byte-per-pixel counter, a dword-per-pixel owner and two per-frame
+ * side tables; it must never appear in a shipping build.
+ *
+ * Three questions, three answers:
+ *
+ *   1. writes/pixel histogram  -- the real overdraw factor, over pixels the
+ *      3D pass actually touches, not over the canvas.
+ *   2. wasted writes by kernel -- a write is wasted when a later write to the
+ *      same pixel replaces it. The painter is back-to-front, so the LAST
+ *      writer is the visible one and every earlier write is dead.
+ *   3. hidden faces / hidden models -- geometry every pixel of which was
+ *      replaced. This is the exact mass a perfect FACE-level or MODEL-level
+ *      front-to-back cull would remove, which is a much cheaper scheme than a
+ *      per-pixel coverage buffer and therefore the number worth costing.
+ */
+
+#if defined(TORIDRAW_OD_CENSUS) && TORIDRAW_OD_CENSUS
+
+#include <stddef.h>
+#include <stdint.h>
+
+enum
+{
+    TORIDRAW_OD_KIND_GOURAUD = 0,
+    TORIDRAW_OD_KIND_GOURAUD_ALPHA,
+    TORIDRAW_OD_KIND_FLAT,
+    TORIDRAW_OD_KIND_FLAT_ALPHA,
+    TORIDRAW_OD_KIND_TEX_OPAQUE,
+    TORIDRAW_OD_KIND_TEX_TRANS,
+    TORIDRAW_OD_KIND_TEX_OTHER,
+    TORIDRAW_OD_KINDS
+};
+
+/** Absolute framebuffer base and pixel count, re-registered every frame. */
+void
+ToriDraw_OdCensusFrame(void const* fb_base, size_t pixels);
+
+/** One model (one ToriDraw_RasterWithFaceIndices call). */
+void
+ToriDraw_OdCensusModel(void);
+
+/** One face inside the current model. */
+void
+ToriDraw_OdCensusFace(void);
+
+/** `first` is the absolute pixel address of the span's left end. */
+void
+ToriDraw_OdCensusSpan(void const* first, int len, int kind);
+
+extern int g_toridraw_od_active;
+
+/** Geometry class of the model about to be rastered: 0 = terrain mesh,
+ *  otherwise 1 + PaintersElementKind (see src/painters/painters.h), and
+ *  TORIDRAW_OD_CLASS_OTHER for widget/non-world models. */
+extern int g_toridraw_od_class;
+
+#define TORIDRAW_OD_CLASSES 10
+#define TORIDRAW_OD_CLASS_OTHER 9
+
+#define TORIDRAW_OD_CLASS(c) (g_toridraw_od_class = (c))
+
+#define TORIDRAW_OD_SPAN(buf, off, len, kind)                                             \
+    do                                                                                    \
+    {                                                                                     \
+        if( g_toridraw_od_active )                                                        \
+            ToriDraw_OdCensusSpan((void const*)((buf) + (off)), (len), (kind));           \
+    } while( 0 )
+
+#define TORIDRAW_OD_MODEL() ToriDraw_OdCensusModel()
+#define TORIDRAW_OD_FACE() ToriDraw_OdCensusFace()
+#define TORIDRAW_OD_FRAME(base, px) ToriDraw_OdCensusFrame((base), (px))
+
+#else
+
+#define TORIDRAW_OD_SPAN(buf, off, len, kind) ((void)0)
+#define TORIDRAW_OD_MODEL() ((void)0)
+#define TORIDRAW_OD_FACE() ((void)0)
+#define TORIDRAW_OD_FRAME(base, px) ((void)0)
+#define TORIDRAW_OD_CLASS(c) ((void)(c))
+#define TORIDRAW_OD_CLASSES 10
+#define TORIDRAW_OD_CLASS_OTHER 9
+
+#endif
+
+#endif

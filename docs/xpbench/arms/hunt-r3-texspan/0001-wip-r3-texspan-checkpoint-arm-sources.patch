From 96f8dc75ec96809f69a5927f23a90034482beda2 Mon Sep 17 00:00:00 2001
From: hunt <hunt@local>
Date: Tue, 25 Aug 2026 04:16:31 -0500
Subject: [PATCH] wip(r3-texspan): checkpoint arm sources

Committed by the batch sweep, not by the agent that wrote it. The scratchpad
lost ~half its built exes when C: hit 100%, so the source in this worktree is
the only surviving copy of this arm. Branch hunt/r3-texspan.

files: 3rd/toridraw/graphics/raster/span_census.c 3rd/toridraw/graphics/raster/span_census.h 3rd/toridraw/graphics/raster/texture/span/tex.span.sse2.u.c
---
 3rd/toridraw/graphics/raster/span_census.c    | 62 +++++++++++++++++++
 3rd/toridraw/graphics/raster/span_census.h    | 59 ++++++++++++++++++
 .../raster/texture/span/tex.span.sse2.u.c     | 23 +++++--
 3 files changed, 140 insertions(+), 4 deletions(-)

diff --git a/3rd/toridraw/graphics/raster/span_census.c b/3rd/toridraw/graphics/raster/span_census.c
index e9699b523..ffb31ba74 100644
--- a/3rd/toridraw/graphics/raster/span_census.c
+++ b/3rd/toridraw/graphics/raster/span_census.c
@@ -84,6 +84,68 @@ ToriDraw_TexSpanCensusDump(void)
         100.0 *
             (c->pixels - c->blocks_lerp8 * 8.0 - c->pixels_exact - c->pixels_tail) /
             c->pixels);
+
+    {
+        double n = (double)c->spans;
+        double run = 0.0;
+        double pxrun = 0.0;
+        double px = c->pixels;
+        int i;
+        fprintf(stderr, "  --- r3 span-setup census ---\n");
+        fprintf(stderr, "  steps  spans     %%spans   cum%%spans  cum%%px\n");
+        for( i = 0; i <= 32; i++ )
+        {
+            if( c->steps_hist[i] == 0.0 )
+                continue;
+            run += c->steps_hist[i];
+            pxrun += c->steps_hist[i] * (double)i;
+            fprintf(
+                stderr,
+                "  %s%2d  %9.0f  %6.2f%%   %6.2f%%   %6.2f%%\n",
+                i == 32 ? ">=" : "  ",
+                i,
+                c->steps_hist[i],
+                100.0 * c->steps_hist[i] / n,
+                100.0 * run / n,
+                px > 0.0 ? 100.0 * pxrun / px : 0.0);
+        }
+        run = 0.0;
+        fprintf(stderr, "  blocks spans     %%spans   cum%%spans\n");
+        for( i = 0; i <= 8; i++ )
+        {
+            run += c->blocks_hist[i];
+            fprintf(
+                stderr,
+                "  %s%2d  %9.0f  %6.2f%%   %6.2f%%\n",
+                i == 8 ? ">=" : "  ",
+                i,
+                c->blocks_hist[i],
+                100.0 * c->blocks_hist[i] / n,
+                100.0 * run / n);
+        }
+        fprintf(
+            stderr,
+            "  wrapped_quotient  %.0f calls  %.0f idivl  (%.2f%% slow)  %.2f calls/span\n"
+            "  u_quotient        %.0f calls   reciprocals %.0f  (%.2f recip/span)\n"
+            "  tail: lerp %.0f (%.1f%%)  exact %.0f (%.1f%%)  w==0 %.0f  none %.0f\n"
+            "  exact_block pixels %.0f, of which w==0 skipped %.0f (%.1f%%)\n",
+            c->wq_calls,
+            c->wq_slow,
+            c->wq_calls > 0.0 ? 100.0 * c->wq_slow / c->wq_calls : 0.0,
+            c->wq_calls / n,
+            c->uq_calls,
+            c->recips,
+            c->recips / n,
+            c->tail_lerp,
+            100.0 * c->tail_lerp / n,
+            c->tail_exact,
+            100.0 * c->tail_exact / n,
+            c->tail_wzero,
+            c->tail_none,
+            c->exact_px,
+            c->exact_px_wzero,
+            c->exact_px > 0.0 ? 100.0 * c->exact_px_wzero / c->exact_px : 0.0);
+    }
     fflush(stderr);
 }
 
diff --git a/3rd/toridraw/graphics/raster/span_census.h b/3rd/toridraw/graphics/raster/span_census.h
index 453566acf..4d2a9b4be 100644
--- a/3rd/toridraw/graphics/raster/span_census.h
+++ b/3rd/toridraw/graphics/raster/span_census.h
@@ -183,6 +183,10 @@ toridraw_span_trace_record(int len, int first, int clipped, int color, int step)
 #include <stdio.h>
 #include <stdlib.h>
 
+/* Same value as TEX_SPAN_RECIPROCAL_EXACT_LIMIT in tex.span_uv.h; repeated so
+ * this header does not depend on include order. A census build only. */
+#define TEX_SPAN_RECIPROCAL_EXACT_LIMIT_CEN 2097152.0f
+
 /**
  * The texture span's own census, which asks a different question than the
  * gouraud one above.
@@ -212,6 +216,28 @@ struct ToriDraw_TexSpanCensus
     double pixels_tail;
     /** Spans that never ran a single eight-pixel block. */
     unsigned int spans_no_block;
+
+    /* --- r3 texture span-setup route additions ------------------------- */
+    /** Span length (steps = x1 - x0) histogram, exact 0..31, 32 = >= 32. */
+    double steps_hist[33];
+    /** Blocks-per-span histogram, exact 0..7, 8 = >= 8. */
+    double blocks_hist[9];
+    /** tex_span_wrapped_quotient calls from the OPAQUE lerp8_v3 path, and how
+     *  many of them abandoned the reciprocal and ran the idivl. */
+    double wq_calls;
+    double wq_slow;
+    /** tex_span_u_quotient calls from the same path (no divide, for ratio). */
+    double uq_calls;
+    /** Where the `steps & 7` tail went. */
+    double tail_lerp;
+    double tail_exact;
+    double tail_wzero;   /* w == 0, tail drew nothing */
+    double tail_none;    /* remaining == 0 */
+    /** Reciprocal (1.0f/(float)w) evaluations on the opaque path. */
+    double recips;
+    /** Per-pixel w == 0 skips inside tex_span_exact_block. */
+    double exact_px;
+    double exact_px_wzero;
 };
 
 extern struct ToriDraw_TexSpanCensus g_toridraw_texspan_census;
@@ -254,6 +280,33 @@ toridraw_texspan_census_exact(int count)
     g_toridraw_texspan_census.pixels_exact += (double)count;
 }
 
+static inline void
+toridraw_texspan_census_steps(int steps, int blocks)
+{
+    int b = steps < 0 ? 0 : (steps > 32 ? 32 : steps);
+    g_toridraw_texspan_census.steps_hist[b] += 1.0;
+    b = blocks < 0 ? 0 : (blocks > 8 ? 8 : blocks);
+    g_toridraw_texspan_census.blocks_hist[b] += 1.0;
+}
+
+static inline int
+toridraw_texcen_wq(int n, int w, float inv_w)
+{
+    float q = (float)n * inv_w;
+    g_toridraw_texspan_census.wq_calls += 1.0;
+    if( q > -TEX_SPAN_RECIPROCAL_EXACT_LIMIT_CEN && q < TEX_SPAN_RECIPROCAL_EXACT_LIMIT_CEN )
+        return (int)q;
+    g_toridraw_texspan_census.wq_slow += 1.0;
+    return n / w;
+}
+
+#define TORIDRAW_TEXSPAN_CENSUS_STEPS(steps, blocks)                                          toridraw_texspan_census_steps((steps), (blocks))
+#define TORIDRAW_TEXSPAN_CENSUS_UQ() (g_toridraw_texspan_census.uq_calls += 1.0)
+#define TORIDRAW_TEXSPAN_CENSUS_RECIP() (g_toridraw_texspan_census.recips += 1.0)
+#define TORIDRAW_TEXSPAN_CENSUS_TAILWAY(field) (g_toridraw_texspan_census.field += 1.0)
+#define TORIDRAW_TEXSPAN_CENSUS_EXACTPX(n, z)                                                 do                                                                                        {                                                                                             g_toridraw_texspan_census.exact_px += (double)(n);                                        g_toridraw_texspan_census.exact_px_wzero += (double)(z);                              } while( 0 )
+
+#define TEXCEN_WQ(n, w, inv_w) toridraw_texcen_wq((n), (w), (inv_w))
 #define TORIDRAW_TEXSPAN_CENSUS_SPAN(steps) toridraw_texspan_census_span((steps))
 #define TORIDRAW_TEXSPAN_CENSUS_LERP8() toridraw_texspan_census_lerp8()
 #define TORIDRAW_TEXSPAN_CENSUS_EXACT(count) toridraw_texspan_census_exact((count))
@@ -261,7 +314,13 @@ toridraw_texspan_census_exact(int count)
 
 #else
 
+#define TEXCEN_WQ(n, w, inv_w) tex_span_wrapped_quotient((n), (w), (inv_w))
 #define TORIDRAW_TEXSPAN_CENSUS_SPAN(steps) ((void)0)
+#define TORIDRAW_TEXSPAN_CENSUS_STEPS(steps, blocks) ((void)0)
+#define TORIDRAW_TEXSPAN_CENSUS_UQ() ((void)0)
+#define TORIDRAW_TEXSPAN_CENSUS_RECIP() ((void)0)
+#define TORIDRAW_TEXSPAN_CENSUS_TAILWAY(field) ((void)0)
+#define TORIDRAW_TEXSPAN_CENSUS_EXACTPX(n, z) ((void)0)
 #define TORIDRAW_TEXSPAN_CENSUS_LERP8() ((void)0)
 #define TORIDRAW_TEXSPAN_CENSUS_EXACT(count) ((void)0)
 #define TORIDRAW_TEXSPAN_CENSUS_TAIL(count) ((void)0)
diff --git a/3rd/toridraw/graphics/raster/texture/span/tex.span.sse2.u.c b/3rd/toridraw/graphics/raster/texture/span/tex.span.sse2.u.c
index 6954be769..c4c4f57b0 100644
--- a/3rd/toridraw/graphics/raster/texture/span/tex.span.sse2.u.c
+++ b/3rd/toridraw/graphics/raster/texture/span/tex.span.sse2.u.c
@@ -738,6 +738,7 @@ draw_texture_scanline_opaque_blend_branching_lerp8_v3_ordered(
     int remaining = steps & 7;
 
     TORIDRAW_TEXSPAN_CENSUS_SPAN(steps);
+    TORIDRAW_TEXSPAN_CENSUS_STEPS(steps, blocks);
 
     /* Everything above is the per-span prologue -- clip, adjust, step. This
      * keeps it and drops the fill, the same cut TORIDRAW_ABLATE=1 makes in the
@@ -764,8 +765,10 @@ draw_texture_scanline_opaque_blend_branching_lerp8_v3_ordered(
             if( !have_cur )
             {
                 float inv_w = 1.0f / (float)w;
+                TORIDRAW_TEXSPAN_CENSUS_RECIP();
+                TORIDRAW_TEXSPAN_CENSUS_UQ();
                 cur_u = tex_span_u_quotient(au, inv_w, texture_width);
-                cur_v = tex_span_wrapped_quotient(bv, w, inv_w);
+                cur_v = TEXCEN_WQ(bv, w, inv_w);
             }
 
             int w_n = (cw + step_cw8) >> texture_shift;
@@ -774,8 +777,10 @@ draw_texture_scanline_opaque_blend_branching_lerp8_v3_ordered(
             if( w_n != 0 )
             {
                 float inv_w_n = 1.0f / (float)w_n;
+                TORIDRAW_TEXSPAN_CENSUS_RECIP();
+                TORIDRAW_TEXSPAN_CENSUS_UQ();
                 nxt_u = tex_span_u_quotient(au + step_au8, inv_w_n, texture_width);
-                nxt_v = tex_span_wrapped_quotient(bv + step_bv8, w_n, inv_w_n);
+                nxt_v = TEXCEN_WQ(bv + step_bv8, w_n, inv_w_n);
             }
             else
             {
@@ -840,14 +845,20 @@ draw_texture_scanline_opaque_blend_branching_lerp8_v3_ordered(
             toridraw_wrap_add(shade8bit_ish8, toridraw_wrap_shl(step_shade8bit_dx_ish8, 3));
     }
 
+    if( remaining == 0 )
+        TORIDRAW_TEXSPAN_CENSUS_TAILWAY(tail_none);
+    else if( (cw >> texture_shift) == 0 )
+        TORIDRAW_TEXSPAN_CENSUS_TAILWAY(tail_wzero);
     if( remaining > 0 && (cw >> texture_shift) != 0 )
     {
         int w = cw >> texture_shift;
         if( !have_cur )
         {
             float inv_w = 1.0f / (float)w;
+            TORIDRAW_TEXSPAN_CENSUS_RECIP();
+            TORIDRAW_TEXSPAN_CENSUS_UQ();
             cur_u = tex_span_u_quotient(au, inv_w, texture_width);
-            cur_v = tex_span_wrapped_quotient(bv, w, inv_w);
+            cur_v = TEXCEN_WQ(bv, w, inv_w);
         }
 
         int w_n = (cw + step_cw8) >> texture_shift;
@@ -856,14 +867,17 @@ draw_texture_scanline_opaque_blend_branching_lerp8_v3_ordered(
         if( w_n != 0 )
         {
             float inv_w_n = 1.0f / (float)w_n;
+            TORIDRAW_TEXSPAN_CENSUS_RECIP();
+            TORIDRAW_TEXSPAN_CENSUS_UQ();
             nxt_u = tex_span_u_quotient(au + step_au8, inv_w_n, texture_width);
-            nxt_v = tex_span_wrapped_quotient(bv + step_bv8, w_n, inv_w_n);
+            nxt_v = TEXCEN_WQ(bv + step_bv8, w_n, inv_w_n);
         }
 
         int shade = shade8bit_ish8 >> 8;
 
         if( w_n == 0 || !tex_span_lerp8_fits(cur_v, nxt_v, texture_width) )
         {
+            TORIDRAW_TEXSPAN_CENSUS_TAILWAY(tail_exact);
             TORIDRAW_TEXSPAN_CENSUS_EXACT(remaining);
             tex_span_exact_block(
                 pixel_buffer,
@@ -889,6 +903,7 @@ draw_texture_scanline_opaque_blend_branching_lerp8_v3_ordered(
         int u_scan = cur_u << texture_shift;
         int v_scan = tex_span_wrapped_scan_start(cur_v, texture_width, texture_shift);
 
+        TORIDRAW_TEXSPAN_CENSUS_TAILWAY(tail_lerp);
         TORIDRAW_TEXSPAN_CENSUS_TAIL(remaining);
         TORIDRAW_ABLATE_TEX_RETURN_IF(2);
         for( int i = 0; i < remaining; i++ )

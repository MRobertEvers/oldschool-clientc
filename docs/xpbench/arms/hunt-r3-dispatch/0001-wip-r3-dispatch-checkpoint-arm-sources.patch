-static inline void
+/**
+ * TORIDRAW_SKIP_TEXTURED, resolved once for the process.
+ *
+ * getenv() walks environ with a strncmp per entry, and the answer cannot change
+ * mid-run.  Kept out of the per-face path entirely -- see the call site.
+ */
+static int
+toridraw_raster_skip_textured(void)
+{
+    static int cached = -1;
+    if( cached < 0 )
+        cached = getenv("TORIDRAW_SKIP_TEXTURED") ? 1 : 0;
+    return cached;
+}
+
+/**
+ * `generic` is a COMPILE-TIME literal at every call site, never a variable.
+ *
+ * Measured on the moving-Lumbridge bench (900-frame run minus 450-frame run, so
+ * startup cancels): raster_debug was non-NULL for 0 of 586,160 models, and
+ * zbuffered for 0 of 586,160.  Both are none the less tested on every one of
+ * the 19,919 faces per frame that reach here, and -- worse -- their never-taken
+ * arms force GCC to canonicalise the stack slots of face_indices_a/b/c and
+ * vertex_x at each merge point, which is where 10 of the 54 stores on the hot
+ * gouraud path come from.  Passing 0 lets that whole half fold away; a model
+ * that really wants debug stats or z-buffering goes to the out-of-line generic
+ * clone instead, so neither feature changes.
+ */
+static inline __attribute__((always_inline)) void
 ToriDraw_RasterModelFace(
     int face,
-    struct ToriDrawModelRasterContext* ctx)
+    struct ToriDrawModelRasterContext* ctx,
+    const int generic)
 {
     assert(face >= 0 && face < ctx->num_faces);
+    DC(faces_visited);
 
     struct ToriDraw_Texture* texture = NULL;
-    struct ToriDraw_RasterDebugStats* dbg = ctx->raster_debug;
+    struct ToriDraw_RasterDebugStats* dbg = generic ? ctx->raster_debug : NULL;
 
     /* Render type is the raw byte (reference ModelData.light). 0=gouraud,
      * 1=flat, 2=hidden, 3=black/hidden; any other value is also hidden. */
@@ -391,6 +509,7 @@ ToriDraw_RasterModelFace(
     {
         if( dbg )
             dbg->skipped_type++;
+        DC(skip_type);
         return;
     }
     enum FaceType type = (enum FaceType)raw_type;
@@ -432,6 +551,7 @@ ToriDraw_RasterModelFace(
         // getModelFaces
         if( dbg )
             dbg->skipped_hidden++;
+        DC(skip_hidden);
         return;
         // color_c = 0;
     }
@@ -474,19 +594,28 @@ ToriDraw_RasterModelFace(
      * A bisect knob for docs/qbd_toridraw_streaks_debug.md - it answers whether
      * a given artifact comes from the textured span path or from
      * gouraud/flat, without having to reason about which faces are which. */
+    /* `generic` only: the knob fired 0 times in 8,963,657 faces on the bench,
+     * yet its guarded-static load plus two tests sat on the per-face path.  The
+     * caller reads it once per model and sends every model down the generic
+     * clone when it is set, so setting it still drops exactly the same faces. */
+    if( generic && toridraw_raster_skip_textured() && texture_id != -1 )
     {
-        static int skip_textured = -1;
-        if( skip_textured < 0 )
-            skip_textured = getenv("TORIDRAW_SKIP_TEXTURED") ? 1 : 0;
-        if( skip_textured && texture_id != -1 )
-            return;
+        DC(skip_env);
+        return;
     }
     /* #endregion */
 
     if( texture_id != -1 )
     {
+        DC(textured);
+#if defined(TORIDRAW_DISPATCH_CENSUS) && TORIDRAW_DISPATCH_CENSUS
+        if( ctx->dc_last_tex >= -1 && ctx->dc_last_tex != texture_id )
+            ctx->dc_uniform_tex = 0;
+        ctx->dc_last_tex = texture_id;
+#endif
         if( texture_id == ctx->cache_texture_id )
         {
+            DC(tex_cache_hit);
             texels = ctx->cache_texels;
             texture_size = ctx->cache_texture_size;
             texture_opaque = ctx->cache_texture_opaque;
@@ -496,6 +625,7 @@ ToriDraw_RasterModelFace(
                 goto textured;
         }
 
+        DC(tex_cache_miss);
         // gamma 0.8 is the default in os1
         texture = (texture_id >= 0 && texture_id < TORIDRAW_TEXTURE_ID_CAPACITY)
                       ? ToriDraw_TextureMapGet(ctx->texture_map, texture_id)
@@ -505,6 +635,7 @@ ToriDraw_RasterModelFace(
         // draw garbage; the reference skips the face too.
         if( texture == NULL )
         {
+            DC(skip_texmiss);
             if( dbg )
                 dbg->skipped_tex_miss++;
             /* TORIRS_RASTER_TEX_DEBUG=1: tally skipped textured faces.
@@ -562,6 +693,7 @@ ToriDraw_RasterModelFace(
         {
             if( dbg )
                 dbg->skipped_alpha++;
+            DC(skip_alpha);
             return;
         }
 
@@ -619,7 +751,7 @@ ToriDraw_RasterModelFace(
         /* A z-buffered model routes every face here instead. The shades a flat
          * face carries in colors_b/c are the TORIDRAWHSL16_FLAT selector, not
          * colours, so it passes colors_a three times. */
-        if( ctx->zbuffered )
+        if( generic && ctx->zbuffered )
         {
             bool const flat = type == FACE_TYPE_FLAT;
 
@@ -649,6 +781,7 @@ ToriDraw_RasterModelFace(
         case FACE_TYPE_GOURAUD:
             if( (ctx->flags & RASTER_FLAG_GOURAUD_SMOOTH) != 0 )

+                DC_KERNEL(ctx, DCK_GOURAUD_SMOOTH);
                 ToriDraw_TriangleFaceGouraudSmooth(
                     ctx->pixel_buffer,
                     face,
@@ -677,6 +810,7 @@ ToriDraw_RasterModelFace(
             }
             else
             {
+                DC_KERNEL(ctx, DCK_GOURAUD);

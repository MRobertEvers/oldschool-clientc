                     ctx->pixel_buffer,
                     face,
@@ -708,6 +842,7 @@ ToriDraw_RasterModelFace(
         case FACE_TYPE_FLAT:
             // Skip triangle if any vertex was clipped
 
+            DC_KERNEL(ctx, DCK_FLAT);
             ToriDraw_TriangleFaceFlat(
                 ctx->pixel_buffer,
                 face,
@@ -787,7 +922,7 @@ ToriDraw_RasterModelFace(
             assert(tm_vertex < ctx->num_vertices);
             assert(tn_vertex < ctx->num_vertices);
 
-            if( ctx->zbuffered )
+            if( generic && ctx->zbuffered )
             {
                 ToriDraw_TriangleFaceZBuffered(
                     &ctx->zbuf_target,
@@ -826,6 +961,7 @@ ToriDraw_RasterModelFace(
 
             if( (ctx->flags & RASTER_FLAG_TEXTURE_AFFINE) != 0 || complex_texture )
             {
+                DC_KERNEL(ctx, DCK_TEX_AFFINE);
                 ToriDraw_TriangleFaceTextureBlendAffineV3(
                     ctx->pixel_buffer,
                     ctx->stride,
@@ -859,6 +995,7 @@ ToriDraw_RasterModelFace(
             }
             else if( texture_opaque )
             {
+                DC_KERNEL(ctx, DCK_TEX_OPAQUE);
                 ToriDraw_TriangleFaceTextureBlendOpaque(
                     ctx->pixel_buffer,
                     ctx->stride,
@@ -891,6 +1028,7 @@ ToriDraw_RasterModelFace(
             }
             else
             {
+                DC_KERNEL(ctx, DCK_TEX_TRANSP);
                 ToriDraw_TriangleFaceTextureBlendTransparent(
                     ctx->pixel_buffer,
                     ctx->stride,
@@ -973,7 +1111,7 @@ ToriDraw_RasterModelFace(
             assert(tm_vertex < ctx->num_vertices);
             assert(tn_vertex < ctx->num_vertices);
 
-            if( ctx->zbuffered )
+            if( generic && ctx->zbuffered )
             {
                 /* Flat-shaded: one lightness for the whole face. */
                 ToriDraw_TriangleFaceZBuffered(
@@ -1003,6 +1141,7 @@ ToriDraw_RasterModelFace(
                 ctx->texture_render_types_nullable[texture_face] != 0;
             if( (ctx->flags & RASTER_FLAG_TEXTURE_AFFINE) != 0 || complex_texture_flat )
             {
+                DC_KERNEL(ctx, DCK_TEXFLAT_AFFINE);
                 ToriDraw_TriangleFaceTextureFlatAffineV3(
                     ctx->pixel_buffer,
                     ctx->stride,
@@ -1034,6 +1173,7 @@ ToriDraw_RasterModelFace(
             }

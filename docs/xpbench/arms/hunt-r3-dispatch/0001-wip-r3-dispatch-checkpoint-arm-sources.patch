+                DC_KERNEL(ctx, DCK_TEXFLAT_OPAQUE);
                 ToriDraw_TriangleFaceTextureFlatOpaque(
                     ctx->pixel_buffer,
                     ctx->stride,
@@ -1064,6 +1204,7 @@ ToriDraw_RasterModelFace(

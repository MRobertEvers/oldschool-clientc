+                DC_KERNEL(ctx, DCK_TEXFLAT_TRANSP);
                 ToriDraw_TriangleFaceTextureFlatTransparent(
                     ctx->pixel_buffer,
                     ctx->stride,
@@ -1289,6 +1430,41 @@ toridraw_raster_face_front_facing(
         ctx->vertex_y[c]);
 }
 
+/**
+ * The debug / z-buffer walk, deliberately kept OUT of line.
+ *
+ * It is entered by 0 of 586,160 models on the bench, so every byte of it inside
+ * the hot function is a byte of Prescott trace cache spent on nothing.  The two
+ * loops are the same two the caller has; only `generic` differs.
+ */
+static void __attribute__((noinline))
+toridraw_raster_faces_generic(
+    struct ToriDraw_Scene* scene,
+    struct ToriDrawModelRasterContext* ctx,
+    bool unsorted)
+{
+    assert(scene);
+    assert(ctx);
+
+    if( unsorted )
+    {
+        for( int face = 0; face < ctx->num_faces; face++ )
+        {
+            if( !toridraw_raster_face_front_facing(ctx, face) )
+                continue;
+            ToriDraw_RasterModelFace(face, ctx, 1);
+        }
+    }
+    else
+    {
+        for( int i = 0; i < scene->tmp_face_order_count; i++ )
+        {
+            int face = scene->tmp_face_order[i];
+            ToriDraw_RasterModelFace(face, ctx, 1);
+        }
+    }
+}
+
 static inline void
 ToriDraw_RasterWithFaceIndices(
     struct ToriDraw_Scene* scene,
@@ -1353,25 +1529,70 @@ ToriDraw_RasterWithFaceIndices(
     /* #region agent log */
     ctx.ordered_faces = unsorted ? ctx.num_faces : scene->tmp_face_order_count;
     /* #endregion */
+#if defined(TORIDRAW_DISPATCH_CENSUS) && TORIDRAW_DISPATCH_CENSUS
+    DC_INIT();
+    DC(models);
+    if( !ctx.face_infos )              DC(models_face_infos_null);
+    if( !ctx.face_alphas_nullable )    DC(models_alphas_null);
+    if( !ctx.texture_render_types_nullable ) DC(models_rendertypes_null);
+    if( !ctx.face_texture_coords )     DC(models_texcoords_null);
+    if( ctx.raster_debug )             DC(models_dbg);
+    if( ctx.zbuffered )                DC(models_zbuf);
+    if( ctx.near_clipped )             DC(models_nearclipped);
+    ctx.dc_last_kernel = -1;
+    ctx.dc_uniform_kernel = 1;
+    ctx.dc_last_tex = -2;
+    ctx.dc_uniform_tex = 1;
+#endif
 
-    if( unsorted )
+    /* Two clones of the walk, chosen once per model, never once per face.  See
+     * the note on ToriDraw_RasterModelFace: `generic` has to arrive there as a
+     * literal or none of the folding happens. */
+    if( ctx.raster_debug || ctx.zbuffered || toridraw_raster_skip_textured() )
     {
-        for( int face = 0; face < ctx.num_faces; face++ )
-        {
-            if( !toridraw_raster_face_front_facing(&ctx, face) )
-                continue;
-            ToriDraw_RasterModelFace(face, &ctx);
-        }
+        toridraw_raster_faces_generic(scene, &ctx, unsorted);
     }
     else
     {
-        for( int i = 0; i < scene->tmp_face_order_count; i++ )
+        /* `lctx` is the same context, but its address never reaches a function
+         * GCC cannot see through -- ToriDraw_RasterModelFace is always_inline
+         * and nothing else takes it.  `ctx` itself escapes into
+         * context_from_handle and toridraw_raster_faces_generic, so every one
+         * of its fields has to be treated as clobbered by each kernel call:
+         * that is where the 24-instruction ctx-to-canonical-slot copy block at
+         * the head of every face comes from.  Through lctx the copy is loop
+         * invariant and hoists out.
+         *
+         * Same reason for `order` / `order_count`: scene->tmp_face_order was a
+         * two-deep dependent load at the top of each of the 19,919 faces per
+         * frame, and the count a third load at the bottom, purely because a
+         * kernel writing through pixel_buffer might have aliased scene. */
+        struct ToriDrawModelRasterContext lctx = ctx;
+        int const* const order = scene->tmp_face_order;
+        int const order_count = scene->tmp_face_order_count;
+        int const num_faces = ctx.num_faces;
+
+        if( unsorted )
         {
-            int face = scene->tmp_face_order[i];
-            ToriDraw_RasterModelFace(face, &ctx);
+            for( int face = 0; face < num_faces; face++ )
+            {
+                if( !toridraw_raster_face_front_facing(&lctx, face) )
+                    continue;
+                ToriDraw_RasterModelFace(face, &lctx, 0);
+            }
+        }
+        else
+        {
+            for( int i = 0; i < order_count; i++ )
+                ToriDraw_RasterModelFace(order[i], &lctx, 0);
         }
     }
 
+#if defined(TORIDRAW_DISPATCH_CENSUS) && TORIDRAW_DISPATCH_CENSUS
+    if( ctx.dc_uniform_kernel ) DC(models_uniform_kernel);
+    if( ctx.dc_uniform_tex )    DC(models_uniform_tex);
+#endif
+
     if( ctx.raster_debug )
         toridraw_raster_debug_print(ctx.raster_debug, &ctx, (void*)model_as_full(hnd));
 }

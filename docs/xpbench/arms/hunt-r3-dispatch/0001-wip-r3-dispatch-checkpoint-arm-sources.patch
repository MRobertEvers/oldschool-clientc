+/* ------------------------------------------------------------------ */
+/* Dispatch census: -DTORIDRAW_DISPATCH_CENSUS=1. Never timed.        */
+/* ------------------------------------------------------------------ */
+#if defined(TORIDRAW_DISPATCH_CENSUS) && TORIDRAW_DISPATCH_CENSUS
+#include <stdlib.h>
+struct ToriDraw_DispatchCensus
+{
+    long long models;
+    long long models_face_infos_null;
+    long long models_alphas_null;
+    long long models_rendertypes_null;
+    long long models_texcoords_null;

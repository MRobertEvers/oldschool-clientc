+static struct ToriDraw_DispatchCensus g_dc;
+enum { DCK_GOURAUD_SMOOTH=0, DCK_GOURAUD=1, DCK_FLAT=2, DCK_ZBUF=3,
+       DCK_TEX_AFFINE=4, DCK_TEX_OPAQUE=5, DCK_TEX_TRANSP=6,
+       DCK_TEXFLAT_AFFINE=7, DCK_TEXFLAT_OPAQUE=8, DCK_TEXFLAT_TRANSP=9 };
+static const char* g_dck_name[12] = {
+    "gouraud_smooth","gouraud","flat","zbuf",
+    "tex_affine","tex_opaque","tex_transp",
+    "texflat_affine","texflat_opaque","texflat_transp","?10","?11" };
+static void
+toridraw_dispatch_census_print(void)
+{
+    fprintf(stderr, "\n=== DISPATCH CENSUS ===\n");
+    fprintf(stderr, "models                 %lld\n", g_dc.models);
+    fprintf(stderr, "  face_infos NULL      %lld\n", g_dc.models_face_infos_null);
+    fprintf(stderr, "  face_alphas NULL     %lld\n", g_dc.models_alphas_null);
+    fprintf(stderr, "  render_types NULL    %lld\n", g_dc.models_rendertypes_null);
+    fprintf(stderr, "  tex_coords NULL      %lld\n", g_dc.models_texcoords_null);
+    fprintf(stderr, "  raster_debug != NULL %lld\n", g_dc.models_dbg);
+    fprintf(stderr, "  zbuffered            %lld\n", g_dc.models_zbuf);
+    fprintf(stderr, "  near_clipped         %lld\n", g_dc.models_nearclipped);
+    fprintf(stderr, "  uniform kernel       %lld\n", g_dc.models_uniform_kernel);
+    fprintf(stderr, "  uniform texture id   %lld\n", g_dc.models_uniform_tex);
+    fprintf(stderr, "faces visited          %lld\n", g_dc.faces_visited);
+    fprintf(stderr, "  skip raw_type        %lld\n", g_dc.skip_type);
+    fprintf(stderr, "  skip hidden(-2)      %lld\n", g_dc.skip_hidden);
+    fprintf(stderr, "  skip alpha<=1        %lld\n", g_dc.skip_alpha);
+    fprintf(stderr, "  skip tex not loaded  %lld\n", g_dc.skip_texmiss);
+    fprintf(stderr, "  skip env knob        %lld\n", g_dc.skip_env);
+    fprintf(stderr, "  drawn                %lld\n", g_dc.drawn);
+    fprintf(stderr, "textured faces         %lld  (cache hit %lld / miss %lld)\n",
+            g_dc.textured, g_dc.tex_cache_hit, g_dc.tex_cache_miss);
+    for( int i = 0; i < 10; i++ )
+        if( g_dc.kernel[i] )
+            fprintf(stderr, "  kernel %-16s %lld\n", g_dck_name[i], g_dc.kernel[i]);
+    fprintf(stderr, "kernel transitions     %lld  (of %lld drawn)\n",
+            g_dc.kernel_transitions, g_dc.drawn);
+}
+static int g_dc_registered;
+#define DC_INIT() do { if(!g_dc_registered){ g_dc_registered=1; atexit(toridraw_dispatch_census_print);} } while(0)
+#define DC(f) do { g_dc.f++; } while(0)
+#define DC_KERNEL(ctx,k) do { \
+    g_dc.kernel[(k)]++; g_dc.drawn++; \
+    if( (ctx)->dc_last_kernel >= 0 && (ctx)->dc_last_kernel != (k) ) { \
+        g_dc.kernel_transitions++; (ctx)->dc_uniform_kernel = 0; } \
+    (ctx)->dc_last_kernel = (k); \
+} while(0)
+#else
+#define DC_INIT() do { } while(0)
+#define DC(f) do { } while(0)
+#define DC_KERNEL(ctx,k) do { (void)(ctx); } while(0)
+#endif
+
 enum DashModelRasterFlags

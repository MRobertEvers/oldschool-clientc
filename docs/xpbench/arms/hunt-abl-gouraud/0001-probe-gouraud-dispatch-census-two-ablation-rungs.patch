--- /dev/null
+++ b/3rd/toridraw/graphics/raster/gouraud_ablate.c
@@ -0,0 +1,38 @@
+#include "graphics/raster/gouraud_ablate.h"
+
+#if HUNTABL_GNULL
+
+volatile int g_huntabl_gnull_sink;
+
+__attribute__((noinline, noclone, noipa)) void
+huntabl_gouraud_tri_null(
+    toripixel_t* pixel_buffer,
+    int stride,
+    int screen_width,
+    int screen_height,
+    int x0,
+    int x1,
+    int x2,
+    int y0,
+    int y1,
+    int y2,
+    int color0_hsl16,
+    int color1_hsl16,
+    int color2_hsl16)
+{
+    (void)pixel_buffer;
+    (void)stride;
+    (void)screen_width;
+    (void)screen_height;
+    (void)x1;
+    (void)x2;
+    (void)y0;
+    (void)y1;
+    (void)y2;
+    (void)color0_hsl16;
+    (void)color1_hsl16;
+    (void)color2_hsl16;

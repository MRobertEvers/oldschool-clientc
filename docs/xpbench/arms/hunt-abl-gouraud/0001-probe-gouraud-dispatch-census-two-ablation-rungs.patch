+#endif
diff --git a/3rd/toridraw/graphics/raster/gouraud_ablate.h b/3rd/toridraw/graphics/raster/gouraud_ablate.h
new file mode 100644
index 000000000..3fd36e4e0
--- /dev/null
+++ b/3rd/toridraw/graphics/raster/gouraud_ablate.h
@@ -0,0 +1,72 @@
+#ifndef TORIDRAW_RASTER_GOURAUD_ABLATE_H
+#define TORIDRAW_RASTER_GOURAUD_ABLATE_H
+
+/**
+ * Two ablation rungs for the gouraud route. Neither is shippable; both exist
+ * only to put a ceiling on what optimising this route could ever be worth.
+ *
+ *   HUNTABL_NOGOURAUD=1  the raster dispatch drops every FACE_TYPE_GOURAUD
+ *                        face on the floor. Everything above the dispatch --
+ *                        projection, the depth sort, the painter buckets, the
+ *                        render-type / hidden / alpha gates, the texture cache
+ *                        probe -- still runs, and flat and textured faces
+ *                        still draw. So the delta is the gouraud LEAF and
+ *                        nothing else.
+ *
+ *   HUNTABL_GNULL=1      keeps the whole chain, including the thirteen-argument
+ *                        marshalling in ToriDraw_TriangleGouraud, and replaces
+ *                        only the asm kernel's body with a function that
+ *                        returns. NOGOURAUD minus GNULL is therefore the cost
+ *                        of getting TO the kernel, which is the exact quantity
+ *                        the texture route could not separate when abl_texnull
+ *                        came out smaller than abl_texv1.
+ *
+ * The names deliberately avoid the strings TORIDRAW_ABLATE, TORIDRAW_SPAN_CENSUS
+ * and TORIDRAW_SPAN_TRACE. src/makefile greps TORIDRAW_PROBE_CFLAGS for those
+ * three and withdraws all four handrolled asm kernels from the link when it
+ * finds one, which would make a timed binary a different renderer.
+ */
+
+#ifndef HUNTABL_NOGOURAUD
+#define HUNTABL_NOGOURAUD 0
+#endif
+
+#ifndef HUNTABL_GNULL
+#define HUNTABL_GNULL 0
+#endif
+
+#if HUNTABL_GNULL
+
+#include "toridraw_types.h"
+
+/**
+ * Same signature as toridraw_gouraud_tri_opaque_s4_asm, empty body.
+ *
+ * noipa, not merely noinline: with LTO on, an interprocedural pass that proved
+ * the callee reads nothing would delete the argument stores as dead and the arm
+ * would silently ablate the marshalling as well as the fill -- which is the one
+ * thing this rung exists to keep. The volatile store is the second belt: it
+ * makes the call observably side-effecting even to a pass that ignores the
+ * attribute.
+ */
+extern volatile int g_huntabl_gnull_sink;
+
+__attribute__((noinline, noclone, noipa)) void
+huntabl_gouraud_tri_null(
+    toripixel_t* pixel_buffer,
+    int stride,
+    int screen_width,
+    int screen_height,
+    int x0,
+    int x1,
+    int x2,
+    int y0,
+    int y1,
+    int y2,
+    int color0_hsl16,
+    int color1_hsl16,
+    int color2_hsl16);
+
+#endif
+
+#endif
diff --git a/3rd/toridraw/graphics/raster/gouraud_census.c b/3rd/toridraw/graphics/raster/gouraud_census.c
new file mode 100644
index 000000000..94c95898b
--- /dev/null
+++ b/3rd/toridraw/graphics/raster/gouraud_census.c
@@ -0,0 +1,83 @@
+#include "graphics/raster/gouraud_census.h"
+
+#if defined(HUNTCEN_GOURAUD) && HUNTCEN_GOURAUD
+
+#include <stdio.h>
+#include <stdlib.h>
+
+struct ToriDraw_GouraudCensus g_toridraw_gouraud_census;
+
+static char const* const g_gouraud_census_names[HUNTCEN_G_BUCKETS] = {
+    "dispatch faces in",
+    "  skip: render type",
+    "  skip: color hidden",
+    "  skip: alpha <= 1",
+    "  textured",
+    "  skip: texture miss",
+    "  flat",
+    "  GOURAUD",
+    "  zbuffered (untex)",
+    "gouraud -> smooth S1",
+    "gouraud -> plain S4",
+    "face: near-clip route",
+    "face: near-clip drop",
+    "TriangleGouraud calls",
+    "  -> scanline family",
+    "  -> ASM opaque s4",
+    "  -> C alpha s4",
+    "TriangleGouraudS1 calls",
+    "  -> C opaque s1",
+    "  -> C alpha s1",
+};
+
+void
+ToriDraw_GouraudCensusDump(void)
+{
+    char const* path = getenv("HUNTCEN_GOURAUD_FILE");
+    FILE* f = path ? fopen(path, "w") : stderr;
+    int i;
+    double tri_calls;
+
+    if( !f )
+        f = stderr;
+
+    tri_calls = g_toridraw_gouraud_census.n[HUNTCEN_G_TRI_CALLS];
+
+    fprintf(f, "\n=== gouraud dispatch census ===\n");
+    fprintf(f, "%-26s %16s %18s %12s\n", "bucket", "count", "area px", "px/face");
+    for( i = 0; i < HUNTCEN_G_BUCKETS; i++ )
+    {
+        double n = g_toridraw_gouraud_census.n[i];
+        double a = g_toridraw_gouraud_census.area[i];
+
+        if( n == 0.0 && a == 0.0 )
+            continue;
+
+        fprintf(f, "%-26s %16.0f %18.0f %12.2f\n",
+                g_gouraud_census_names[i], n, a, n > 0.0 ? a / n : 0.0);
+    }
+
+    fprintf(f, "\nasm share of TriangleGouraud calls   %.4f%%\n",
+            tri_calls > 0.0
+                ? 100.0 * g_toridraw_gouraud_census.n[HUNTCEN_G_TRI_ASM] / tri_calls
+                : 0.0);
+    {
+        double asm_area = g_toridraw_gouraud_census.area[HUNTCEN_G_TRI_ASM];
+        double c_area = g_toridraw_gouraud_census.area[HUNTCEN_G_TRI_CALPHA];
+        double tot = asm_area + c_area;
+        fprintf(f, "asm share of TriangleGouraud area    %.4f%%\n",
+                tot > 0.0 ? 100.0 * asm_area / tot : 0.0);
+    }
+
+    fprintf(f, "\nalpha histogram over the C alpha leaf (non-zero rows only)\n");
+    for( i = 0; i < 256; i++ )
+        if( g_toridraw_gouraud_census.alpha_hist[i] != 0.0 )
+            fprintf(f, "  alpha %3d  %16.0f\n",
+                    i, g_toridraw_gouraud_census.alpha_hist[i]);
+
+    fflush(f);
+    if( path && f != stderr )
+        fclose(f);
+}
+
+#endif
diff --git a/3rd/toridraw/graphics/raster/gouraud_census.h b/3rd/toridraw/graphics/raster/gouraud_census.h
new file mode 100644
index 000000000..7cd8896bc
--- /dev/null
+++ b/3rd/toridraw/graphics/raster/gouraud_census.h
@@ -0,0 +1,133 @@
+#ifndef TORIDRAW_RASTER_GOURAUD_CENSUS_H
+#define TORIDRAW_RASTER_GOURAUD_CENSUS_H
+
+/**
+ * Where do gouraud faces actually go, and what keeps one out of the asm?
+ *
+ * The EIP map credits toridraw_gouraud_tri_opaque_s4_asm with 10.34 ms and
+ * ToriDraw_TriangleGouraud -- the C wrapper around it -- with a further
+ * 1.15 ms. A wrapper that only dispatches should not cost 1.15 ms, so either
+ * the wrapper is doing work or a second, C-only leaf is inlined into it. This
+ * counts the dispatch so the answer is a number rather than a reading of the
+ * source.
+ *
+ * Compile-time gated on HUNTCEN_GOURAUD so a shipping build has no branch
+ * here, and deliberately NOT named with any of the three strings src/makefile
+ * greps for -- TORIDRAW_SPAN_CENSUS / TORIDRAW_ABLATE / TORIDRAW_SPAN_TRACE --
+ * because those withdraw all four handrolled asm kernels from the link, which
+ * would make this census describe a renderer nobody ships.
+ */
+
+#if defined(HUNTCEN_GOURAUD) && HUNTCEN_GOURAUD
+
+#include <stdio.h>
+#include <stdlib.h>
+
+enum
+{
+    /* Face-level, counted in ToriDraw_RasterModelFace. */
+    HUNTCEN_G_DISPATCH_FACES = 0,   /**< every face entering the dispatch */
+    HUNTCEN_G_SKIP_TYPE,            /**< raw render type hidden/out of range */
+    HUNTCEN_G_SKIP_HIDDEN,          /**< color_c == HSL16_HIDDEN */
+    HUNTCEN_G_SKIP_ALPHA,           /**< alpha <= 1 on an untextured face */
+    HUNTCEN_G_TEXTURED,             /**< routed to a texture leaf */
+    HUNTCEN_G_TEX_MISS,             /**< textured, texture not resident */
+    HUNTCEN_G_FLAT,                 /**< FACE_TYPE_FLAT, untextured */
+    HUNTCEN_G_GOURAUD,              /**< FACE_TYPE_GOURAUD, untextured */
+    HUNTCEN_G_ZBUF,                 /**< untextured face taken by the z-buffer */
+    HUNTCEN_G_SMOOTH,               /**< gouraud face on the S1 smooth path */
+    HUNTCEN_G_PLAIN,                /**< gouraud face on the S4 path */
+
+    /* Leaf-level, counted in toridraw_triangle_gouraud.u.c. */
+    HUNTCEN_G_FACE_NEARCLIP,        /**< routed to the near-plane clip builder */
+    HUNTCEN_G_FACE_NEARCLIP_DROP,   /**< near-clipped and dropped, no ortho */
+    HUNTCEN_G_TRI_CALLS,            /**< ToriDraw_TriangleGouraud entries */
+    HUNTCEN_G_TRI_SCANLINE,         /**< ... diverted to the scanline family */
+    HUNTCEN_G_TRI_ASM,              /**< ... alpha == 0xFF, the asm kernel */
+    HUNTCEN_G_TRI_CALPHA,           /**< ... alpha != 0xFF, the C alpha leaf */
+    HUNTCEN_G_TRI_S1_CALLS,         /**< ToriDraw_TriangleGouraudS1 entries */
+    HUNTCEN_G_TRI_S1_OPAQUE,
+    HUNTCEN_G_TRI_S1_ALPHA,
+    HUNTCEN_G_BUCKETS
+};
+
+struct ToriDraw_GouraudCensus
+{
+    double n[HUNTCEN_G_BUCKETS];
+    double area[HUNTCEN_G_BUCKETS];
+    /* Alpha histogram over the C-alpha leaf, 0..255. "What value is it, and is
+     * it one value or many" is the difference between a special case worth
+     * folding into the asm and a general blend. */
+    double alpha_hist[256];
+    int registered;
+};
+
+extern struct ToriDraw_GouraudCensus g_toridraw_gouraud_census;
+
+void
+ToriDraw_GouraudCensusDump(void);
+
+static inline void
+huntcen_gouraud_register(void)
+{
+    if( !g_toridraw_gouraud_census.registered )
+    {
+        g_toridraw_gouraud_census.registered = 1;
+        atexit(ToriDraw_GouraudCensusDump);
+    }
+}
+
+static inline void
+huntcen_gouraud_bump(int bucket)
+{
+    huntcen_gouraud_register();
+    g_toridraw_gouraud_census.n[bucket] += 1.0;
+}
+
+/* Doubles for the same reason face_census.h uses them: a near-clipped
+ * triangle's coordinates are not bounded by the viewport, and this is
+ * measurement code where an overflow is a silently wrong answer. */
+static inline void
+huntcen_gouraud_bump_area(
+    int bucket, int x0, int y0, int x1, int y1, int x2, int y2, int cap)
+{
+    double cross;
+    double area;
+
+    huntcen_gouraud_register();
+
+    cross = (double)(x1 - x0) * (double)(y2 - y0) -
+            (double)(x2 - x0) * (double)(y1 - y0);
+    area = (cross < 0.0 ? -cross : cross) * 0.5;
+    if( cap > 0 && area > (double)cap )
+        area = (double)cap;
+
+    g_toridraw_gouraud_census.n[bucket] += 1.0;
+    g_toridraw_gouraud_census.area[bucket] += area;
+}
+
+static inline void
+huntcen_gouraud_alpha(int alpha)
+{
+    huntcen_gouraud_register();
+    if( alpha < 0 )
+        alpha = 0;
+    if( alpha > 255 )
+        alpha = 255;
+    g_toridraw_gouraud_census.alpha_hist[alpha] += 1.0;
+}
+
+#define HUNTCEN_G_BUMP(b)                       huntcen_gouraud_bump((b))
+#define HUNTCEN_G_AREA(b, x0, y0, x1, y1, x2, y2, cap)                       \
+    huntcen_gouraud_bump_area((b), (x0), (y0), (x1), (y1), (x2), (y2), (cap))
+#define HUNTCEN_G_ALPHA(a)                      huntcen_gouraud_alpha((a))
+
+#else
+
+#define HUNTCEN_G_BUMP(b)                                ((void)0)
+#define HUNTCEN_G_AREA(b, x0, y0, x1, y1, x2, y2, cap)   ((void)0)
+#define HUNTCEN_G_ALPHA(a)                               ((void)0)
+
+#endif
+
+#endif

diff --git a/3rd/toridraw/triangles/toridraw_triangle_gouraud.u.c b/3rd/toridraw/triangles/toridraw_triangle_gouraud.u.c
index 22e2fd2eb..7516fcd7e 100644
--- a/3rd/toridraw/triangles/toridraw_triangle_gouraud.u.c
+++ b/3rd/toridraw/triangles/toridraw_triangle_gouraud.u.c
@@ -20,8 +20,18 @@
 #include "graphics/raster/face_census.h"
 // clang-format on
 
-static inline void
-ToriDraw_TriangleGouraud(
+/*
+ * The rare half of the gouraud dispatcher: the scanline family and the
+ * alpha-blended kernel. Kept out of line on purpose so the hot half below can
+ * be forced inline without dragging four extra call sequences into every
+ * caller. Measured on the Pentium 4 target: the merged dispatcher was compiled
+ * as a single out-of-line body whose entire job was to reload its fourteen
+ * incoming arguments and store them straight back out for the asm kernel --
+ * 905 EIP samples, 1.098 ms of a 64.5 ms frame, over 15,270 gouraud triangles,
+ * i.e. ~201 cycles per triangle of pure argument marshalling and zero pixels.
+ */
+static void __attribute__((noinline))
+ToriDraw_TriangleGouraudRare(
     toripixel_t* RESTRICT pixel_buffer,
     int stride,
     int screen_width,
@@ -37,13 +47,6 @@ ToriDraw_TriangleGouraud(
     int color_c,
     int alpha)
 {
-    TORIDRAW_FACE_CENSUS_RECORD(
-        TORIDRAW_FACE_CENSUS_GOURAUD,
-        x1, y1,
-        x2, y2,
-        x3, y3,
-        screen_width * screen_height);
-
     if( TORIDRAW_SCANLINE_SELECTED() )
     {
         if( alpha == 0xFF )
@@ -84,9 +87,56 @@ ToriDraw_TriangleGouraud(
         return;
     }
 
-    if( alpha == 0xFF )
+    raster_gouraudhsllightness_screen_alpha_bary_branching_s4(
+        pixel_buffer,
+        stride,
+        screen_width,
+        screen_height,
+        x1,
+        x2,
+        x3,
+        y1,
+        y2,
+        y3,
+        color_a,
+        color_b,
+        color_c,
+        alpha);
+}
+
+/*
+ * Hot half. always_inline so the caller builds the asm kernel's frame once
+ * instead of storing eleven arguments, having a thunk reload fourteen and
+ * re-store thirteen. TORIDRAW_SCANLINE_SELECTED() is a plain read of a global
+ * int with no side effects, so testing it after `alpha` is order-safe and the
+ * four (scanline, alpha) cases select exactly the same kernel as before.
+ */
+static inline __attribute__((always_inline)) void
+ToriDraw_TriangleGouraud(
+    toripixel_t* RESTRICT pixel_buffer,
+    int stride,
+    int screen_width,
+    int screen_height,
+    int x1,
+    int x2,
+    int x3,
+    int y1,
+    int y2,
+    int y3,
+    int color_a,
+    int color_b,
+    int color_c,
+    int alpha)
+{
+    TORIDRAW_FACE_CENSUS_RECORD(
+        TORIDRAW_FACE_CENSUS_GOURAUD,
+        x1, y1,
+        x2, y2,
+        x3, y3,
+        screen_width * screen_height);
+
+    if( alpha == 0xFF && !TORIDRAW_SCANLINE_SELECTED() )
     {
-        // raster_gouraudhsllightness_screen_opaque_edge_sort_s4(
         TORIDRAW_GOURAUD_TRI_OPAQUE_S4(
             pixel_buffer,
             stride,
@@ -101,25 +151,24 @@ ToriDraw_TriangleGouraud(
             color_a,
             color_b,
             color_c);
+        return;
     }
-    else
-    {
-        raster_gouraudhsllightness_screen_alpha_bary_branching_s4(
-            pixel_buffer,
-            stride,
-            screen_width,
-            screen_height,
-            x1,
-            x2,
-            x3,
-            y1,
-            y2,
-            y3,
-            color_a,
-            color_b,
-            color_c,
-            alpha);
-    }
+
+    ToriDraw_TriangleGouraudRare(
+        pixel_buffer,
+        stride,
+        screen_width,
+        screen_height,
+        x1,
+        x2,
+        x3,
+        y1,
+        y2,
+        y3,
+        color_a,
+        color_b,
+        color_c,
+        alpha);
 }
 

diff --git a/src/platform/platform_sdl2_renderer_soft3d.c b/src/platform/platform_sdl2_renderer_soft3d.c
index de701e34e..90eb42c47 100644
--- a/src/platform/platform_sdl2_renderer_soft3d.c
+++ b/src/platform/platform_sdl2_renderer_soft3d.c
@@ -1607,7 +1607,20 @@ ToriRS_Soft3D_RenderFrame(
 #else
         uint32_t bg = (uint32_t)TORIRS_SOFT3D_BG;
 #endif
-        if( ToriDraw_FrameAbArm() )
+        /*
+         * The non-temporal clear is the DEFAULT arm now, not the A/B arm.
+         * Before this it was linked but unreachable without TORIDRAW_FRAME_AB
+         * in the environment, and the EIP profile proved it: 1002 of the 1021
+         * samples inside ToriRS_Soft3D_RenderFrame -- 1.216 ms of a 64.5 ms
+         * frame -- sat on ONE 16-byte bin holding the
+         * `movups %xmm0,(%ebx,%edx,1)` of the else-branch below, while the
+         * `call toridraw_fb_clear32_nt_asm` carried zero. 96,199 iterations in
+         * 3.405 Mcycles is 35.4 cycles per 16-byte store, 1.27 GB/s:
+         * read-for-ownership on 1.5 MB that is entirely overwritten. The A/B
+         * arm now selects the old loop so the pair stays measurable with
+         * TORIDRAW_FRAME_AB=1, sign reversed.
+         */
+        if( !ToriDraw_FrameAbArm() )
         {
             TORIDRAW_FB_CLEAR32(p, n, bg);
         }
diff --git a/src/world/world_cycle.c b/src/world/world_cycle.c
index 264877537..c562862ec 100644
--- a/src/world/world_cycle.c
+++ b/src/world/world_cycle.c
@@ -1517,6 +1517,33 @@ world_dyn_register_npcs(struct World* world, bool alwaysontop, int local_level)
     }
 }
 
+#ifndef NDEBUG
+/**
+ * @brief True when no live scenery entry carries the runtime_spawn bit.
+ *
+ * The verifier for the skip in World_CycleRegisterPainterDynamics. It lives
+ * inside assert() at the call site because OPT=1 defines NDEBUG, so the
+ * checked build pays the walk the fast build no longer does and a latch that
+ * ever went stale-clear stops the program where it happened.
+ */
+static int
+world_scenery_runtime_spawn_absent(struct World_EntityPool* pool)
+{
+    assert(pool);
+
+    for( int si = World_EntityPoolHead(pool); si != WORLD_ENTITY_NIL;
+         si = World_EntityPoolNext(pool, si) )
+    {
+        struct WorldEntity_Scenery* sc = World_EntityPoolGet(pool, si);
+        if( !sc )
+            continue;
+        if( sc->runtime_spawn )
+            return 0;
+    }
+    return 1;
+}
+#endif
+
 /* Dynamic entities re-register with the painter every cycle on top of the
  * static terrain/scenery set; without this pass they never produce
  * PNTR_CMD_ELEMENT commands and never draw (v1 world_cycle).
@@ -1542,50 +1569,71 @@ World_CycleRegisterPainterDynamics(struct World* world)
      * must be re-registered every cycle. Registered before the dynamics below so
      * they draw with the scenery (behind players/NPCs), matching a normal loc. */
     pool = &world->entities.scenery;
-    for( int si = World_EntityPoolHead(pool); si != WORLD_ENTITY_NIL;
-         si = World_EntityPoolNext(pool, si) )
+    /*
+     * Almost every scene has no runtime-spawned loc at all, and finding that
+     * out used to cost a full walk of the scenery pool every cycle: measured
+     * on the moving Lumbridge bench, 8,635 iterations per cycle and ZERO
+     * hits, each iteration an imul for the pool stride plus a load of one int
+     * at +0x11c of a >500-byte struct -- 8,635 strided misses over ~4.7 MB
+     * against a 1 MB L2. That single load carried 623 of the profile's EIP
+     * samples, 0.756 ms of a 64.5 ms frame, which is 245 cycles an iteration
+     * to learn nothing.
+     *
+     * The latch is set at the one place the bit is ever set (world_scenery.u.c)
+     * and never cleared, so this skip can only ever be taken when the walk
+     * would have found nothing.
+     */
+    if( world->entities.scenery_runtime_spawn_seen )
     {
-        struct WorldEntity_Scenery* sc = World_EntityPoolGet(pool, si);
-        if( !sc || !sc->runtime_spawn || sc->element_id < 0 )
-            continue;
-        int grid_x = sc->grid_position.x;
-        int grid_z = sc->grid_position.z;
-        int paint_level;
-        if( grid_x < 0 || grid_z < 0 || grid_x >= world->_scene_size ||
-            grid_z >= world->_scene_size )
-            continue;
-        /* The scenery pool holds cache levels; the painter wants the level the
-         * build's bridge push-down parked that tile on, which is the one the
-         * static locs beside this one ended up in. */
-        paint_level = World_LocPaintLevel(world, grid_x, grid_z, sc->grid_position.level);
-        /* Wall locs re-register with their recorded wallside so the painter
-         * orders them like a built wall (drawn on the correct side of the
-         * tile); the removal path released the tile slot and reset_to_static
-         * frees dynamic wall slots each frame, so the exclusive-slot claim is
-         * safe. Everything else draws as normal scenery. */
-        if( sc->painter_wall_ab >= 0 )
-            painter_add_wall(
-                world->painter, grid_x, grid_z, paint_level, sc->element_id,
-                sc->painter_wall_ab, sc->painter_wall_side);
-        /* Ground decor (shape 22) belongs in the tile's exclusive decor slot,
-         * not in its scenery chain. The slot is emitted in the tile's BASE
-         * step, ahead of every scenery element whose footprint covers the
-         * tile — which is the whole difference for a puddle spawned under a
-         * 5x5 boss: as scenery it sorted against him and won on any tile
-         * nearer the camera than his anchor. */
-        else if( sc->painter_ground_decor )
-            painter_add_ground_decor_dynamic(
-                world->painter, grid_x, grid_z, paint_level, sc->element_id);
-        else
-            painter_add_normal_scenery(
-                world->painter,
-                grid_x,
-                grid_z,
-                paint_level,
-                sc->element_id,
-                sc->size_x > 0 ? sc->size_x : 1,
-                sc->size_z > 0 ? sc->size_z : 1,
-                (world->scene ? ToriDraw_SceneElementOcclusionHeight(world->scene, sc->element_id) : 0));
+        for( int si = World_EntityPoolHead(pool); si != WORLD_ENTITY_NIL;
+             si = World_EntityPoolNext(pool, si) )
+        {
+            struct WorldEntity_Scenery* sc = World_EntityPoolGet(pool, si);
+            if( !sc || !sc->runtime_spawn || sc->element_id < 0 )
+                continue;
+            int grid_x = sc->grid_position.x;
+            int grid_z = sc->grid_position.z;
+            int paint_level;
+            if( grid_x < 0 || grid_z < 0 || grid_x >= world->_scene_size ||
+                grid_z >= world->_scene_size )
+                continue;
+            /* The scenery pool holds cache levels; the painter wants the level the
+             * build's bridge push-down parked that tile on, which is the one the
+             * static locs beside this one ended up in. */
+            paint_level = World_LocPaintLevel(world, grid_x, grid_z, sc->grid_position.level);
+            /* Wall locs re-register with their recorded wallside so the painter
+             * orders them like a built wall (drawn on the correct side of the
+             * tile); the removal path released the tile slot and reset_to_static
+             * frees dynamic wall slots each frame, so the exclusive-slot claim is
+             * safe. Everything else draws as normal scenery. */
+            if( sc->painter_wall_ab >= 0 )
+                painter_add_wall(
+                    world->painter, grid_x, grid_z, paint_level, sc->element_id,
+                    sc->painter_wall_ab, sc->painter_wall_side);
+            /* Ground decor (shape 22) belongs in the tile's exclusive decor slot,
+             * not in its scenery chain. The slot is emitted in the tile's BASE
+             * step, ahead of every scenery element whose footprint covers the
+             * tile — which is the whole difference for a puddle spawned under a
+             * 5x5 boss: as scenery it sorted against him and won on any tile
+             * nearer the camera than his anchor. */
+            else if( sc->painter_ground_decor )
+                painter_add_ground_decor_dynamic(
+                    world->painter, grid_x, grid_z, paint_level, sc->element_id);
+            else
+                painter_add_normal_scenery(
+                    world->painter,
+                    grid_x,
+                    grid_z,
+                    paint_level,
+                    sc->element_id,
+                    sc->size_x > 0 ? sc->size_x : 1,
+                    sc->size_z > 0 ? sc->size_z : 1,
+                    (world->scene ? ToriDraw_SceneElementOcclusionHeight(world->scene, sc->element_id) : 0));
+        }
+    }
+    else
+    {
+        assert(world_scenery_runtime_spawn_absent(pool));
     }
 
     /* Ground items render below entities (reference tile.groundObject draws in
diff --git a/src/world/world_entity.h b/src/world/world_entity.h
index 1cfa832a9..392d68ea1 100644
--- a/src/world/world_entity.h
+++ b/src/world/world_entity.h
@@ -21,6 +21,26 @@ struct World_EntityList
     struct World_EntityPool spotanim;
     struct World_EntityPool obj_stack;
     struct World_EntityPool plugin_object;
+
+    /*
+     * Set the first time any scenery entry is flagged runtime_spawn, and
+     * never cleared.
+     *
+     * world_cycle re-registers runtime-spawned locs with the painter every
+     * cycle, and the only way to find them was to walk the whole scenery
+     * pool. Measured on the moving Lumbridge bench that walk is 8,635
+     * iterations per cycle with ZERO hits -- every entry loads one int at
+     * +0x11c out of a >500-byte struct, so it is 8,635 strided misses across
+     * ~4.7 MB against a 1 MB L2, and it cost 623 of the run's EIP samples,
+     * 0.756 ms of a 64.5 ms frame, on that single load.
+     *
+     * A latch rather than a live count: it is monotonic, so a removal path
+     * that forgets to decrement cannot drop a registration -- the worst a
+     * stale 1 can do is pay for the scan that used to be unconditional. A
+     * count would have to be right on every removal path, and being wrong
+     * there means a spawned door stops drawing.
+     */
+    int scenery_runtime_spawn_seen;
 };
 

@@ -718,7 +718,10 @@ draw_texture_scanline_opaque_blend_branching_lerp8_v3_ordered(
     if( x1 >= screen_width )
         x1 = screen_width - 1;
     if( x0 >= x1 )
+    {
+        TORIDRAW_TEXSPAN_CENSUS_OROWEMPTY();
         return;
+    }
 
     int adjust = x0 - (screen_width >> 1);
     au += step_au_dx * adjust;
@@ -738,6 +741,7 @@ draw_texture_scanline_opaque_blend_branching_lerp8_v3_ordered(
     int remaining = steps & 7;
 
     TORIDRAW_TEXSPAN_CENSUS_SPAN(steps);
+    TORIDRAW_TEXSPAN_CENSUS_OSPAN(steps);
 
     /* Everything above is the per-span prologue -- clip, adjust, step. This
      * keeps it and drops the fill, the same cut TORIDRAW_ABLATE=1 makes in the
@@ -840,6 +844,8 @@ draw_texture_scanline_opaque_blend_branching_lerp8_v3_ordered(
             toridraw_wrap_add(shade8bit_ish8, toridraw_wrap_shl(step_shade8bit_dx_ish8, 3));
     }
 
+    if( !(remaining > 0 && (cw >> texture_shift) != 0) )
+        TORIDRAW_TEXSPAN_CENSUS_OTAIL(steps, remaining, 2);
     if( remaining > 0 && (cw >> texture_shift) != 0 )
     {
         int w = cw >> texture_shift;
@@ -865,6 +871,7 @@ draw_texture_scanline_opaque_blend_branching_lerp8_v3_ordered(
         if( w_n == 0 || !tex_span_lerp8_fits(cur_v, nxt_v, texture_width) )
         {
             TORIDRAW_TEXSPAN_CENSUS_EXACT(remaining);
+            TORIDRAW_TEXSPAN_CENSUS_OTAIL(steps, remaining, 1);
             tex_span_exact_block(
                 pixel_buffer,
                 offset,
@@ -890,6 +897,7 @@ draw_texture_scanline_opaque_blend_branching_lerp8_v3_ordered(
         int v_scan = tex_span_wrapped_scan_start(cur_v, texture_width, texture_shift);
 
         TORIDRAW_TEXSPAN_CENSUS_TAIL(remaining);
+        TORIDRAW_TEXSPAN_CENSUS_OTAIL(steps, remaining, 0);
         TORIDRAW_ABLATE_TEX_RETURN_IF(2);
         for( int i = 0; i < remaining; i++ )
         {

@@ -163,46 +159,30 @@
 .endm
 
 /*
- * flat_screen_fixed_edges_no_hclip, once per segment. Affine extrema on a
- * segment occur at its endpoints, so two evaluations settle every row of it.
- * Result written to \dstslot as 0 or 1. Clobbers %eax %ecx %edx.
+ * THERE IS NO flat_screen_fixed_edges_no_hclip HERE ANY MORE
+ *
+ * There used to be, and it decided once per segment whether any row of that
+ * segment could leave the viewport, so that the common case could run a row
+ * loop with the left/right clamps removed. The census says that trade is the
+ * wrong way round on this scene:
+ *
+ *   NOHCLIP, twice per triangle              ~50 instructions, 2 imul
+ *   the AC pre-step it needs for segment 2     4 instructions, 1 imul
+ *   `cmpl $0,nc; je`, twice                    4 instructions
+ *   ------------------------------------------------------------------
+ *   per triangle, 13,359 of them per frame    ~58 instructions, 3 imul
+ *
+ *   the clamps it saved                        6 instructions per row,
+ *                                              on the 79.9% of 82,863 rows
+ *                                              that were proved clip-free
+ *                                              = 6 x 6.203 x 0.799 per tri
+ *
+ * which is 58 removed against 30 added per triangle, plus three 10-cycle
+ * Prescott imuls, plus ~1,000 bytes of a 3,700-byte function that no longer
+ * competes for the trace cache. The clamped loop was always the general path;
+ * running it on every row cannot change a pixel, because on a row the deleted
+ * proof would have accepted, both clamps are no-ops by construction.
  */
-.macro	NOHCLIP ea0, sa, eb0, sb, cnt, dstslot
-	movl	\cnt(%esp), %ecx
-	testl	%ecx, %ecx
-	jle	8100f			/* n <= 0: vacuously true            */
-	decl	%ecx			/* n - 1                             */
-
-	movl	\sa(%esp), %eax
-	imull	%ecx, %eax
-	addl	\ea0(%esp), %eax	/* e_a_last                          */
-	movl	\ea0(%esp), %edx	/* e_a_first                         */
-	cmpl	%eax, %edx
-	jle	8000f
-	movl	%eax, %edx		/* min_e_a                           */
-8000:
-	testl	%edx, %edx
-	js	8200f			/* min_e_a < 0 -> clipping possible  */
-
-	movl	\sb(%esp), %eax
-	imull	%ecx, %eax
-	addl	\eb0(%esp), %eax	/* e_b_last                          */
-	movl	\eb0(%esp), %edx	/* e_b_first                         */
-	cmpl	%eax, %edx
-	jge	8050f
-	movl	%eax, %edx		/* max_e_b                           */
-8050:
-	movl	V_SCRW(%esp), %eax
-	shll	$16, %eax
-	cmpl	%eax, %edx
-	jge	8200f
-8100:
-	movl	$1, \dstslot(%esp)
-	jmp	8300f
-8200:
-	movl	$0, \dstslot(%esp)
-8300:
-.endm
 

+	 * All three reach `jge 5800f`, which is where the `je` went. */
 	sarl	$16, %ecx
 	movl	V_SCRW(%esp), %edx
 	cmpl	%edx, %ecx
@@ -345,13 +323,10 @@
 	addl	V_SYH(%esp), %ebp
 	movl	V_STRIDE(%esp), %eax
 	addl	%eax, V_OFF(%esp)
-	decl	V_CNT(%esp)
+	decl	\cnt(%esp)
 	jne	5500b
 
 5900:
-	movl	%ebx, V_EL(%esp)
-	movl	%esi, V_ER(%esp)
-	movl	%ebp, V_HSL(%esp)
 .endm
 
 /* Copy one of the six vertex orderings into the sorted slots. */

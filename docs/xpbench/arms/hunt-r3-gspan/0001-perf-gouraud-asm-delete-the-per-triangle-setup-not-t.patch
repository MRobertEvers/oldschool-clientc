-	SPANFILL 5400f
-5400:
-	addl	V_SYH(%esp), %ebp	/* every row, drawn or not           */
-	movl	V_STRIDE(%esp), %eax
-	addl	%eax, V_OFF(%esp)
-	decl	V_CNT(%esp)
-	jne	5000b
-	jmp	5900f
-
-	/* ---- may leave the viewport: clamp both ends ---- */
+	/* Every row clamps. See the note where NOHCLIP used to be. */
 	.p2align 4
 5500:
 	movl	%ebx, %eax
 	movl	%esi, %ecx
-	addl	V_STEPL(%esp), %ebx
-	addl	V_STEPR(%esp), %esi
+	addl	\sl(%esp), %ebx

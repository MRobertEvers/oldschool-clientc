+	 * times a frame -- every span under four pixels (59.1% of them) plus
+	 * every longer span whose length is not a multiple of four (28.2%) --
+	 * so the five are 208K instructions a frame. */
 	LOOKUP	%eax, %edx
-	xorl	%eax, %eax
-	cmpl	$2, %ecx
-	setge	%al			/* i1 = count > 1                    */
 	movl	%edx, (%edi)
+	movzbl	Ltail_i1(%ecx), %eax
 	movl	%edx, (%edi,%eax,4)
-	xorl	%eax, %eax
-	cmpl	$3, %ecx
-	setge	%al
-	addl	%eax, %eax		/* i2 = count > 2 ? 2 : 0            */
+	movzbl	Ltail_i2(%ecx), %eax
 	movl	%edx, (%edi,%eax,4)
 .endm
 
+	.section .rdata,"dr"
+	.p2align 3
+Ltail_i1:
+	.byte	0, 0, 1, 1		/* count > 1 ? 1 : 0                 */
+Ltail_i2:
+	.byte	0, 0, 0, 2		/* count > 2 ? 2 : 0                 */
+	.text

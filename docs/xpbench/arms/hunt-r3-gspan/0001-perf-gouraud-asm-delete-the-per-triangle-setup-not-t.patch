 /*
  * One trapezoid segment. %ebx left edge ish16, %esi right edge ish16,
  * %ebp colour ish8. The horizontal clamps are hoisted out of the loop: the
  * caller proved once per segment whether any row can leave the viewport, so
  * the common case runs a row loop with no clamping in it at all.
+ *
+ * WHY THE SLOTS ARE ARGUMENTS AND NOT COPIES
+ *
+ * The edges, the steps, the no-clip flag and the row count used to be copied
+ * into six generic frame slots before each of the four instantiations, so that
+ * one parameterless macro could serve both segments in both edge orientations.
+ * The gouraud walk census (300 frames, moving lumbridge camera) says that copy
+ * is not affordable: 13,359 triangles per frame reach the walks and each one
+ * paid 24 instructions of SETSEG, 3 redundant register loads, 6 instructions
+ * of write-back and 2 to hand the AC edge from the first segment to the second
+ * -- 35 instructions, every one of them a stack-to-stack move through %eax,
+ * i.e. twelve dependent load/store pairs on a core whose store-to-load forward
+ * is five cycles. Naming the real slots as macro arguments deletes all of it.
+ *
+ * \ldl and \ldr are omitted where the register already holds the right edge:
+ * AC is walked by BOTH segments, so it simply stays in %ebx (or %esi) across
+ * the segment boundary instead of being written out and read back.
  */
-.macro	SEGMENT
-	movl	V_EL(%esp), %ebx
-	movl	V_ER(%esp), %esi
-	movl	V_HSL(%esp), %ebp
-	movl	V_CNT(%esp), %eax
+.macro	SEGMENT sl, sr, cnt, ldl, ldr
+.ifnb \ldl
+	movl	\ldl(%esp), %ebx
+.endif
+.ifnb \ldr
+	movl	\ldr(%esp), %esi
+.endif
+	movl	\cnt(%esp), %eax
 	testl	%eax, %eax
 	jle	5900f
-	cmpl	$0, V_NC(%esp)
-	je	5500f
-
-	/* ---- proved inside the viewport: no left/right clamp ---- */
-	.p2align 4
-5000:
-	movl	%ebx, %eax
-	movl	%esi, %ecx

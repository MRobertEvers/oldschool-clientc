-	cmpl	%ecx, %eax
-	jge	5400f
-	subl	%eax, %ecx		/* pixel count                       */
-
-	movl	%eax, %edx
-	imull	V_SXH(%esp), %edx	/* x_start * step, low 32 bits only  */
-	addl	%ebp, %edx
-	addl	V_OFF(%esp), %eax
-	movl	V_PIX(%esp), %edi
-	leal	(%edi,%eax,4), %edi
-	movl	%edx, %eax

@@ -150,6 +150,29 @@ generate(struct tri* t, int kind)
         t->x[2] = range(-30, W + 30);
         t->y[2] = t->y[0] + range(1, 6);
         break;
+
+    default: /* tiny: the class the whole scene is actually made of. 73.06% of
+              * live gouraud triangles in a moving Lumbridge frame have
+              * |sarea| < 16, 27.49% of them draw no pixel at all, and 83.05%
+              * are eight rows or shorter. Case 0 almost never produces one and
+              * case 4 produces the tall kind, so the prologue short cuts --
+              * the zero-pixel reject, the power-of-two edge divide, the
+              * bbox-proves-no-clip test -- would otherwise be scored on a
+              * handful of accidents. The x range straddles both viewport
+              * edges on purpose: that is the boundary the bbox test decides
+              * on, and dy is drawn from the powers of two the shift divide
+              * claims plus the ones it must refuse. */
+    {
+        static const int dys[16] = { 0, 0, 1, 1, 1, 2, 2, 3, 3, 4, 5, 6,
+                                     7, 8, 12, 16 };
+        t->x[0] = range(-3, W + 2);
+        t->y[0] = range(-3, H + 2);
+        t->x[1] = t->x[0] + range(-4, 4);
+        t->y[1] = t->y[0] + dys[next() & 15];
+        t->x[2] = t->x[0] + range(-4, 4);

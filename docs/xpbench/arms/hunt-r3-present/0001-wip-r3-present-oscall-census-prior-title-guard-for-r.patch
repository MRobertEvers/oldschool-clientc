--- a/src/platform/platform_win32_timing.c
+++ b/src/platform/platform_win32_timing.c
@@ -28,6 +28,14 @@ struct Win32TimingState
 
 static struct Win32TimingState timing;
 
+#if defined(TORIRS_OSCALL_CENSUS)
+unsigned long g_osc_qpc = 0;
+unsigned long g_osc_gettick = 0;
+#  define OSCT(x) do { (x)++; } while(0)
+#else
+#  define OSCT(x) do { } while(0)
+#endif
+
 bool
 PlatformWin32Timing_Init(void)
 {
@@ -65,6 +73,7 @@ qpc_now_ms(void)
     uint64_t remainder;
     uint64_t frequency = (uint64_t)timing.qpc_frequency.QuadPart;
 
+    OSCT(g_osc_qpc);
     if( !QueryPerformanceCounter(&counter) || counter.QuadPart < 0 )
         return UINT64_MAX;
 
@@ -83,6 +92,7 @@ qpc_now_us(void)
     uint64_t remainder;
     uint64_t frequency = (uint64_t)timing.qpc_frequency.QuadPart;
 
+    OSCT(g_osc_qpc);
     if( !QueryPerformanceCounter(&counter) || counter.QuadPart < 0 )
         return UINT64_MAX;
 
@@ -96,7 +106,10 @@ qpc_now_us(void)
 static uint64_t
 fallback_now_ms(void)
 {
-    DWORD current = GetTickCount();
+    DWORD current;
+
+    OSCT(g_osc_gettick);
+    current = GetTickCount();
 
     /* GetTickCount is XP-safe but wraps every 49.7 days. Extend it to 64 bits
      * so a long-running client does not interpret the wrap as a huge frame. */
diff --git a/src/platform/platform_win32gdi.c b/src/platform/platform_win32gdi.c
index acc3de545..5c9d92845 100644
--- a/src/platform/platform_win32gdi.c
+++ b/src/platform/platform_win32gdi.c
@@ -39,6 +39,7 @@
 
 #include <assert.h>
 #include <stdint.h>
+#include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
 
@@ -52,6 +53,169 @@
 
 static const char RPD_WNDCLASS[] = "TorirsWin32GdiWindow";
 
+#if defined(TORIRS_OSCALL_CENSUS)
+/* CENSUS BUILD ONLY -- never timed. Counts every OS entry point the steady
+ * frame makes, so "the ntdll bucket is BitBlt plus SetWindowTextA" stops being
+ * an inference. Single-threaded through all of these, so plain adds. */
+unsigned long g_osc_frames = 0;
+unsigned long g_osc_bitblt = 0;
+unsigned long g_osc_stretchblt = 0;
+unsigned long g_osc_fillrect = 0;
+unsigned long g_osc_fillrect_skipped = 0;
+unsigned long g_osc_getclientrect = 0;
+unsigned long g_osc_settext = 0;
+unsigned long g_osc_settext_changed = 0;
+unsigned long g_osc_peekmsg = 0;
+unsigned long g_osc_dispatch = 0;
+unsigned long g_osc_poll = 0;
+unsigned long g_osc_blit_px = 0;
+
+/* Steady-state heap rate: the totals at exit are dominated by cache load, so
+ * the census brackets frames 11..N and reports the delta. */
+unsigned long g_osc_base_frame = 0;
+unsigned long g_osc_base_malloc = 0;
+unsigned long g_osc_base_calloc = 0;
+unsigned long g_osc_base_realloc = 0;
+unsigned long g_osc_base_free = 0;
+unsigned long g_osc_last_malloc = 0;
+unsigned long g_osc_last_calloc = 0;
+unsigned long g_osc_last_realloc = 0;
+unsigned long g_osc_last_free = 0;
+#if defined(TORIRS_MEMPROF)
+extern unsigned long g_mp_malloc;
+extern unsigned long g_mp_calloc;
+extern unsigned long g_mp_realloc;
+extern unsigned long g_mp_free;
+#endif
+
+/* How much of the presented canvas actually differs from the frame before it.
+ * A dirty-rect present can only ever save the complement of this, so measure
+ * it before proposing one. */
+static unsigned int* g_osc_shadow = NULL;
+static unsigned long g_osc_dirty_frames = 0;
+static double g_osc_dirty_bbox_px = 0.0;
+static double g_osc_dirty_rows_px = 0.0;
+static double g_osc_changed_px = 0.0;
+static unsigned long g_osc_dirty_full = 0;
+
+static void
+oscall_dirty_scan(const int* pixels, int w, int h)
+{
+    int y;
+    int x;
+    int min_y = h;
+    int max_y = -1;
+    int min_x = w;
+    int max_x = -1;
+    unsigned long changed = 0;
+
+    assert(pixels);
+    assert(w > 0);
+    assert(h > 0);
+    if( !g_osc_shadow )
+    {
+        g_osc_shadow = (unsigned int*)malloc((size_t)w * (size_t)h * 4u);
+        assert(g_osc_shadow);
+        memcpy(g_osc_shadow, pixels, (size_t)w * (size_t)h * 4u);
+        return;
+    }
+    for( y = 0; y < h; y++ )
+    {
+        const unsigned int* a = (const unsigned int*)pixels + (size_t)y * w;
+        const unsigned int* b = g_osc_shadow + (size_t)y * w;
+        int row_dirty = 0;
+        for( x = 0; x < w; x++ )
+        {
+            if( a[x] != b[x] )
+            {
+                changed++;
+                row_dirty = 1;
+                if( x < min_x )
+                    min_x = x;
+                if( x > max_x )
+                    max_x = x;
+            }
+        }
+        if( row_dirty )
+        {
+            if( y < min_y )
+                min_y = y;
+            max_y = y;
+        }
+    }
+    memcpy(g_osc_shadow, pixels, (size_t)w * (size_t)h * 4u);
+    g_osc_dirty_frames++;
+    g_osc_changed_px += (double)changed;
+    if( max_y >= 0 )
+    {
+        g_osc_dirty_bbox_px +=
+            (double)(max_x - min_x + 1) * (double)(max_y - min_y + 1);
+        g_osc_dirty_rows_px += (double)w * (double)(max_y - min_y + 1);
+        if( min_x == 0 && max_x == w - 1 && min_y == 0 && max_y == h - 1 )
+            g_osc_dirty_full++;
+    }
+}
+extern unsigned long g_osc_qpc;
+extern unsigned long g_osc_gettick;
+
+static void
+oscall_census_report(void)
+{
+    double f = g_osc_frames ? (double)g_osc_frames : 1.0;
+    double sf = (g_osc_frames > g_osc_base_frame)
+                    ? (double)(g_osc_frames - g_osc_base_frame)
+                    : 0.0;
+    double canvas = g_osc_bitblt ? (double)g_osc_blit_px / g_osc_bitblt
+                                 : 1.0;
+    fprintf(stderr,
+        "oscall_census: frames=%lu\n"
+        "oscall_census: bitblt=%lu (%.3f/f) stretchblt=%lu blit_px=%lu (%.0f/f)\n"
+        "oscall_census: fillrect_issued=%lu (%.3f/f) fillrect_skipped=%lu\n"
+        "oscall_census: getclientrect=%lu (%.3f/f)\n"
+        "oscall_census: settext_calls=%lu (%.3f/f) settext_distinct=%lu\n"
+        "oscall_census: peekmessage=%lu (%.3f/f) dispatched=%lu poll=%lu\n"
+        "oscall_census: qpc=%lu (%.3f/f) gettickcount=%lu (%.3f/f)\n"
+        "oscall_census: TOTAL_OS_CALLS_PER_FRAME=%.3f\n"
+        "oscall_census: steady_frames=%lu heap/frame malloc=%.1f calloc=%.1f realloc=%.1f free=%.1f\n"
+        "oscall_census: dirty_frames=%lu changed_px/frame=%.0f (%.1f%%) bbox_px/frame=%.0f (%.1f%%) rowband_px/frame=%.0f (%.1f%%) full_frame_dirty=%lu\n",
+        g_osc_frames,
+        g_osc_bitblt, g_osc_bitblt / f, g_osc_stretchblt, g_osc_blit_px,
+        g_osc_blit_px / f,
+        g_osc_fillrect, g_osc_fillrect / f, g_osc_fillrect_skipped,
+        g_osc_getclientrect, g_osc_getclientrect / f,
+        g_osc_settext, g_osc_settext / f, g_osc_settext_changed,
+        g_osc_peekmsg, g_osc_peekmsg / f, g_osc_dispatch, g_osc_poll,
+        g_osc_qpc, g_osc_qpc / f, g_osc_gettick, g_osc_gettick / f,
+        (double)(g_osc_bitblt + g_osc_stretchblt + g_osc_fillrect
+                 + g_osc_getclientrect + g_osc_settext + g_osc_peekmsg
+                 + g_osc_qpc + g_osc_gettick) / f,
+        (unsigned long)sf,
+        sf ? (double)(g_osc_last_malloc - g_osc_base_malloc) / sf : 0.0,
+        sf ? (double)(g_osc_last_calloc - g_osc_base_calloc) / sf : 0.0,
+        sf ? (double)(g_osc_last_realloc - g_osc_base_realloc) / sf : 0.0,
+        sf ? (double)(g_osc_last_free - g_osc_base_free) / sf : 0.0,
+        g_osc_dirty_frames,
+        g_osc_dirty_frames ? g_osc_changed_px / g_osc_dirty_frames : 0.0,
+        g_osc_dirty_frames
+            ? 100.0 * g_osc_changed_px / (g_osc_dirty_frames * canvas)
+            : 0.0,
+        g_osc_dirty_frames ? g_osc_dirty_bbox_px / g_osc_dirty_frames : 0.0,
+        g_osc_dirty_frames
+            ? 100.0 * g_osc_dirty_bbox_px / (g_osc_dirty_frames * canvas)
+            : 0.0,
+        g_osc_dirty_frames ? g_osc_dirty_rows_px / g_osc_dirty_frames : 0.0,
+        g_osc_dirty_frames
+            ? 100.0 * g_osc_dirty_rows_px / (g_osc_dirty_frames * canvas)
+            : 0.0,
+        g_osc_dirty_full);
+}
+#  define OSC(x) do { (x)++; } while(0)
+#  define OSC_ADD(x, n) do { (x) += (unsigned long)(n); } while(0)
+#else
+#  define OSC(x) do { } while(0)
+#  define OSC_ADD(x, n) do { } while(0)
+#endif
+
 struct PlatformSDL2
 {
     HWND    hwnd;
@@ -83,6 +247,16 @@ struct PlatformSDL2
     int     pending_resize_w;
     int     pending_resize_h;
     int     pending_repeat;
+
+    /* Last text handed to SetWindowTextA, so a per-frame caller does not repeat
+     * itself. The SDL backend has carried this since a browser trace charged
+     * 4.8% of main-thread time to re-setting a title that had not changed; this
+     * backend never got it, and on XP the repeat is worse than a strdup -- a
+     * WM_SETTEXT enters win32k, rewrites the window text and repaints the
+     * caption bar, all in kernel mode. Sized to hold main.c's readout whole: a
+     * title that overflowed would compare equal on its tail and stop updating.
+     */
+    char    title[256];
 #if defined(TORIRS_WIN32_GDI_TEST_API)
     uint32_t paint_count;
 #endif
@@ -225,7 +399,11 @@ gdi_fill_black(HDC dc, int left, int top, int right, int bottom)
 {
     RECT rect;
     if( right <= left || bottom <= top )
+    {
+        OSC(g_osc_fillrect_skipped);
         return;
+    }
+    OSC(g_osc_fillrect);
     rect.left = left;
     rect.top = top;
     rect.right = right;
@@ -248,6 +426,7 @@ gdi_paint_latest(struct PlatformSDL2* p, HDC dc)
         return;
     assert(dc);
 
+    OSC(g_osc_getclientrect);
     GetClientRect(p->hwnd, &client);
     win_w = client.right - client.left;
     win_h = client.bottom - client.top;
@@ -275,6 +454,9 @@ gdi_paint_latest(struct PlatformSDL2* p, HDC dc)
     {
         if( box.right == p->width && box.bottom == p->height )
         {
+            OSC(g_osc_bitblt);
+            OSC_ADD(g_osc_blit_px,
+                    (unsigned long)p->width * (unsigned long)p->height);
             BitBlt(dc, box.left, box.top, p->width, p->height, p->mem_dc, 0, 0, SRCCOPY);
             TORIRS_PERF_COUNT(TORIRS_PERF_CTR_PRESENT_BLIT_1TO1, 1);
         }
@@ -290,6 +472,9 @@ gdi_paint_latest(struct PlatformSDL2* p, HDC dc)
                 SetStretchBltMode(dc, HALFTONE);
                 SetBrushOrgEx(dc, box.left, box.top, NULL);
             }
+            OSC(g_osc_stretchblt);
+            OSC_ADD(g_osc_blit_px,
+                    (unsigned long)box.right * (unsigned long)box.bottom);
             StretchBlt(
                 dc, box.left, box.top, box.right, box.bottom,
                 p->mem_dc, 0, 0, p->width, p->height, SRCCOPY);
@@ -649,6 +834,36 @@ PlatformSDL2_Init(struct PlatformSDL2* p, int width, int height, char const* tit
 
     p->timing_active = PlatformWin32Timing_Init() ? 1 : 0;
 
+    /* Seed the title cache with what CreateWindowExA already put on the window,
+     * so the invariant PlatformSDL2_SetTitle maintains holds from frame zero. */
+    snprintf(p->title, sizeof(p->title), "%s", title ? title : "ToriRS");
+
+    /* One line, once, at init. It answers two questions that decide whether the
+     * per-frame BitBlt is a straight copy or a format conversion, and whether
+     * QueryPerformanceCounter on this box is the cheap TSC or the ~1 us ACPI PM
+     * timer -- neither is knowable from the host. Costs one WriteFile per
+     * process against a run of hundreds of frames. */
+    {
+        LARGE_INTEGER qpf;
+        qpf.QuadPart = 0;
+        QueryPerformanceFrequency(&qpf);
+        fprintf(
+            stderr,
+            "present_env: screen_bpp=%d planes=%d dib_bpp=32 canvas=%dx%d "
+            "stride_bytes=%d qpf_lo=%lu qpf_hi=%lu%s\n",
+            GetDeviceCaps(p->window_dc, BITSPIXEL),
+            GetDeviceCaps(p->window_dc, PLANES),
+            width,
+            height,
+            width * 4,
+            (unsigned long)(qpf.LowPart),
+            (unsigned long)(qpf.HighPart),
+            getenv("TORIRS_WIN32_HIDDEN") ? " hidden=1" : "");
+    }
+
+#if defined(TORIRS_OSCALL_CENSUS)
+    atexit(oscall_census_report);
+#endif
     ShowWindow(p->hwnd, getenv("TORIRS_WIN32_HIDDEN") ? SW_HIDE : SW_SHOW);
     UpdateWindow(p->hwnd);
     return true;
@@ -753,11 +968,62 @@ PlatformSDL2_QuitRequested(struct PlatformSDL2* p)
     return p->quit != 0;
 }
 
+#if !defined(NDEBUG)
+/* The maintained invariant, checked rather than assumed: p->title is what the
+ * window's text actually is. Nothing else in this backend calls SetWindowTextA
+ * on p->hwnd, and CreateWindowExA seeded the text before the first SetTitle --
+ * but "nothing else does" is exactly the kind of claim that rots. OPT=1 defines
+ * NDEBUG and compiles the whole check away. */
+static int
+gdi_title_cache_matches_window(struct PlatformSDL2* p)
+{
+    char actual[256];
+    int n;
+
+    assert(p);
+    assert(p->hwnd);
+    n = GetWindowTextA(p->hwnd, actual, (int)sizeof(actual));
+    if( n < 0 )
+        return 0;
+    return strncmp(actual, p->title, sizeof(actual) - 1) == 0;
+}
+#endif
+
+/*
+ * The window title, set only when it actually changed.
+ *
+ * main.c's update_window_title runs this once per frame with the same string
+ * in it -- measured over 300 frames of the moving-camera bench: 300 calls, 1
+ * distinct string. On Win32 SetWindowTextA does not compare; it sends
+ * WM_SETTEXT, and DefWindowProc's handler crosses into win32k to rewrite the
+ * text and then repaints the caption bar. Comparing first costs a strncmp of a
+ * 34-byte string that is already in L1.
+ */
 void
 PlatformSDL2_SetTitle(struct PlatformSDL2* p, char const* title)
 {
-    if( p->hwnd && title )
+    assert(p);
+    assert(title);
+    /* A window is not guaranteed yet: main.c sets a title on a platform whose
+     * Init has not run in some headless paths. That is a real runtime state,
+     * not a caller bug, so it stays a guard. */
+    if( !p->hwnd )
+        return;
+    assert(gdi_title_cache_matches_window(p));
+    OSC(g_osc_settext);
+    if( strncmp(p->title, title, sizeof(p->title) - 1) == 0 )
+    {
+#if defined(TORIRS_OSCALL_CENSUS)
+        /* The census must describe the CONTROL's call pattern, so the
+         * redundant call is still issued here; the counter above is what
+         * separates redundant from distinct. */
         SetWindowTextA(p->hwnd, title);
+#endif
+        return;
+    }
+    OSC(g_osc_settext_changed);
+    snprintf(p->title, sizeof(p->title), "%s", title);
+    SetWindowTextA(p->hwnd, title);
 }
 
 void
@@ -849,6 +1115,23 @@ PlatformSDL2_PollCommands(struct PlatformSDL2* p, struct ToriRS_CmdBus* bus)
     p->pending_resize_w = -1;
     p->pending_resize_h = -1;
 
+    OSC(g_osc_poll);
+#if defined(TORIRS_OSCALL_CENSUS)
+    for( ;; )
+    {
+        OSC(g_osc_peekmsg);
+        if( !PeekMessage(&msg, NULL, 0, 0, PM_REMOVE) )
+            break;
+        if( msg.message == WM_QUIT )
+        {
+            p->quit = 1;
+            continue;
+        }
+        OSC(g_osc_dispatch);
+        TranslateMessage(&msg);
+        DispatchMessage(&msg);
+    }
+#else
     while( PeekMessage(&msg, NULL, 0, 0, PM_REMOVE) )
     {
         if( msg.message == WM_QUIT )
@@ -859,6 +1142,7 @@ PlatformSDL2_PollCommands(struct PlatformSDL2* p, struct ToriRS_CmdBus* bus)
         TranslateMessage(&msg); /* WM_KEYDOWN -> WM_CHAR for typed characters */
         DispatchMessage(&msg);  /* routed to wnd_proc, which pushes to the bus */
     }
+#endif
 
     /* One coalesced resize per poll, after the input above -- a click seen at
      * the old size is applied at the old size, matching the SDL backend. */
@@ -881,6 +1165,25 @@ PlatformSDL2_Present(struct PlatformSDL2* p)
      * stays clear for D3D9, preventing repair paints from covering its surface
      * with the software buffer that renderer never populated. */
     p->gdi_frame_valid = 1;
+    OSC(g_osc_frames);
+#if defined(TORIRS_OSCALL_CENSUS)
+    if( !getenv("TORIRS_OSC_NODIRTY") )
+        oscall_dirty_scan(p->pixels, p->width, p->height);
+#  if defined(TORIRS_MEMPROF)
+    if( g_osc_frames == 11 )
+    {
+        g_osc_base_frame = g_osc_frames;
+        g_osc_base_malloc = g_mp_malloc;
+        g_osc_base_calloc = g_mp_calloc;
+        g_osc_base_realloc = g_mp_realloc;
+        g_osc_base_free = g_mp_free;
+    }
+    g_osc_last_malloc = g_mp_malloc;
+    g_osc_last_calloc = g_mp_calloc;
+    g_osc_last_realloc = g_mp_realloc;
+    g_osc_last_free = g_mp_free;
+#  endif
+#endif
 
     gdi_paint_latest(p, p->window_dc);
 }

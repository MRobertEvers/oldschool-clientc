 }
 
+static int
+memprof_site_churn_cmp(const void* a, const void* b)
+{
+    const struct MemProf_Site* sa = *(const struct MemProf_Site* const*)a;
+    const struct MemProf_Site* sb = *(const struct MemProf_Site* const*)b;
+
+    if( sa->total_count < sb->total_count )
+        return 1;
+    if( sa->total_count > sb->total_count )
+        return -1;
+    return 0;
+}
+
 /* Runtime address -> the address the linker gave the same instruction, which is
  * what addr2line wants. ASLR moves the image; the PE headers still carry the
  * base it was linked for. */
@@ -435,6 +459,30 @@ memprof_dump(const char* suffix, const char* label)
         i,
         (double)reported / (1024.0 * 1024.0),
         (double)g_live_bytes / (1024.0 * 1024.0));
+    fprintf(out,
+        "memprof: CALLS malloc=%lu calloc=%lu realloc=%lu free=%lu strdup=%lu\n",
+        g_mp_malloc, g_mp_calloc, g_mp_realloc, g_mp_free, g_mp_strdup);
+    /* Churn ranking: every site that ever allocated, ordered by call count.
+     * This is the RtlAllocateHeap bill, which the live-bytes ranking above
+     * cannot show because it drops every site whose live_bytes is 0. */
+    ranked_count = 0;
+    for( i = 0; i < MEMPROF_SITE_CAP; i++ )
+    {
+        if( g_sites[i].total_count > 0 )
+            ranked[ranked_count++] = &g_sites[i];
+    }
+    qsort(ranked, ranked_count, sizeof(*ranked), memprof_site_churn_cmp);
+    fprintf(out, "memprof: === churn by call site (%u sites) ===\n",
+            ranked_count);
+    for( i = 0; i < ranked_count && i < 48u; i++ )
+    {
+        fprintf(out,
+                "memprof: churn %2u calls=%lld bytes=%.2f MB ra=0x%08llx\n",
+                i,
+                (long long)ranked[i]->total_count,
+                (double)ranked[i]->total_bytes / (1024.0 * 1024.0),
+                (unsigned long long)((uintptr_t)ranked[i]->ra + bias));
+    }
     fprintf(out, "memprof: === end ===\n");
 
     fflush(out);

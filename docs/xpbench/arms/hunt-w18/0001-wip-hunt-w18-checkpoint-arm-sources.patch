+/**
+ * Carry the entry that answered the previous query and try it first.
+ * The four corners of a tile are 126 units apart and the census says 93.3%
+ * of the time the same plane hides the next one, so the hint turns a walk
+ * into a single range test. Lives for one frame only (see
+ * scene_occluders_select_for_camera) and is always confirmed by the exact
+ * test, so it cannot answer for a plane that is no longer there.
+ */
+#ifndef TORIDRAW_OCC_HINT
+#define TORIDRAW_OCC_HINT 0
+#endif
+
+/**
+ * Per-frame (x,z) footprint map of the four wall runs' shadows, so a query
+ * standing nowhere near a wall skips those runs instead of walking them.
+ * Built once per frame from the same active set the runs hold.
+ */

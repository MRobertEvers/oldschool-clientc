+#if TORIDRAW_OCC_SHADOWMAP
+/** OR the inclusive cell range [c0, c1] into one row of the shadow map. */
+static void
+occluder_shadow_mark_row(struct SceneOccluders* occ, int row, int c0, int c1)
+{
+    uint32_t* r = occ->shadow[row];
+    int w;
+
+    assert(row >= 0);
+    assert(row < OCC_SHADOW_DIM);
+    assert(c0 >= 0);
+    assert(c1 < OCC_SHADOW_DIM);
+
+    for( w = c0 >> 5; w <= (c1 >> 5); w++ )
+    {
+        int lo = w << 5;
+        int hi = lo + 31;
+        uint32_t mask;
+
+        if( lo < c0 )
+            lo = c0;
+        if( hi > c1 )
+            hi = c1;
+        mask = (hi - lo == 31) ? 0xffffffffu
+                               : ((1u << (hi - lo + 1)) - 1u) << (lo & 31);
+        r[w] |= mask;
+    }
+}
+
+/**
+ * Mark every cell one packed wall entry's shadow can reach.
+ *
+ * The entry hides (ca, cb) at depth d = key + step*u, where u runs along the
+ * axis the plane's depth grows on and ca along the other horizontal axis.
+ * Both a-bounds are `base + ((spread * d) >> 8)`, monotone in d, so the widest
+ * a-range over a whole cell of u is the wider of the cell's two endpoints.
+ * Taking that range and rounding it out to whole cells makes the marked
+ * footprint a superset of every point the run can hide, which is what lets a
+ * clear cell stand as a proof that the run will miss.
+ */
+static void
+occluder_shadow_mark_entry(
+    struct SceneOccluders* occ,
+    const struct SceneOccluderPacked* e,
+    int step,
+    int free_is_z)
+{
+    int u_lo = 0;
+    int u_hi = (OCC_SHADOW_DIM << OCC_SHADOW_CELL_SHIFT) - 1;
+    int c;
+    int c_lo;
+    int c_hi;
+
+    assert(occ);
+    assert(e);
+
+    /* d > 0 is the run's own gate; outside it the entry hides nothing. */
+    if( step < 0 )
+    {
+        if( e->key - 1 < u_hi )
+            u_hi = e->key - 1;
+    }
+    else
+    {
+        if( 1 - e->key > u_lo )
+            u_lo = 1 - e->key;
+    }
+    if( u_hi < u_lo )
+        return;
+
+    c_lo = u_lo >> OCC_SHADOW_CELL_SHIFT;
+    c_hi = u_hi >> OCC_SHADOW_CELL_SHIFT;
+
+    for( c = c_lo; c <= c_hi; c++ )
+    {
+        int p0 = c << OCC_SHADOW_CELL_SHIFT;
+        int p1 = p0 + (1 << OCC_SHADOW_CELL_SHIFT) - 1;
+        int d0;
+        int d1;
+        int t;
+        int a0;
+        int a1;
+        int ac0;
+        int ac1;
+
+        if( p0 < u_lo )
+            p0 = u_lo;
+        if( p1 > u_hi )
+            p1 = u_hi;
+        d0 = e->key + step * p0;
+        d1 = e->key + step * p1;
+        if( d0 > d1 )
+        {
+            t = d0;
+            d0 = d1;
+            d1 = t;
+        }
+
+        a0 = e->lo_a + ((e->spread_lo_a * d0) >> 8);
+        t = e->lo_a + ((e->spread_lo_a * d1) >> 8);
+        if( t < a0 )
+            a0 = t;
+        a1 = e->hi_a + ((e->spread_hi_a * d0) >> 8);
+        t = e->hi_a + ((e->spread_hi_a * d1) >> 8);
+        if( t > a1 )
+            a1 = t;
+
+        if( a1 < 0 )
+            continue;
+        if( a0 < 0 )
+            a0 = 0;
+        ac0 = a0 >> OCC_SHADOW_CELL_SHIFT;
+        ac1 = a1 >> OCC_SHADOW_CELL_SHIFT;
+        if( ac0 >= OCC_SHADOW_DIM )
+            continue;
+        if( ac1 >= OCC_SHADOW_DIM )
+            ac1 = OCC_SHADOW_DIM - 1;
+
+        if( free_is_z )
+        {
+            occluder_shadow_mark_row(occ, c, ac0, ac1);
+        }
+        else
+        {
+            for( t = ac0; t <= ac1; t++ )
+                occluder_shadow_mark_row(occ, t, c, c);
+        }
+    }
+}
+
+/**
+ * Rebuild the wall runs' (x, z) footprint for this frame.
+ *
+ * Only the four wall runs go in. The BELOW run is left out on purpose: its
+ * planes sit at floor level, so the d > 0 gate already stops a ground query
+ * after a step or two, and folding their footprints in would set most of the
+ * map and cost the other four runs their reject.
+ */
+static void
+occluder_build_shadow_map(struct SceneOccluders* occ)
+{
+    /* Indexed by enum OccluderHides. */
+    static const int shadow_step[6] = { 0, -1, 1, -1, 1, 0 };
+    static const int shadow_free_is_z[6] = { 0, 0, 0, 1, 1, 0 };
+    int h;
+
+    assert(occ);
+    memset(occ->shadow, 0, sizeof(occ->shadow));
+
+    for( h = OCCLUDER_HIDES_WEST_OF_PLANE; h <= OCCLUDER_HIDES_NORTH_OF_PLANE;
+         h++ )
+    {
+        int i;
+
+        for( i = occ->run_start[h]; i < occ->run_end[h]; i++ )
+            occluder_shadow_mark_entry(
+                occ, &occ->packed[i], shadow_step[h], shadow_free_is_z[h]);
+    }
+}

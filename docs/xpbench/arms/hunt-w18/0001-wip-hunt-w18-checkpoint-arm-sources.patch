+/** Corner probe: also asks whether the entry that answered the previous
+ *  corner is the one that answered this one. */
+static bool
+occ_census_corner(
+    struct SceneOccluders* occ,
+    int x,
+    int y,
+    int z)
+{
+    bool hit;
+    g_scene_occluder_census.tile_corner_tests++;
+    hit = scene_occluders_point_hidden(occ, x, y, z);
+    if( hit )
+    {
+        if( g_occ_census_prev_hit >= 0 )
+        {
+            g_scene_occluder_census.tile_repeat_probe++;
+            if( g_scene_occluder_hit_idx == g_occ_census_prev_hit )
+                g_scene_occluder_census.tile_repeat_same++;
+        }
+        g_occ_census_prev_hit = g_scene_occluder_hit_idx;
+    }
+    return hit;
+}
+#define OCC_TILE_CORNER(o, x, y, z) occ_census_corner((o), (x), (y), (z))
+#else
+#define OCC_CENSUS_INC(field) ((void)0)
+#define OCC_CENSUS_TILE_BEGIN() ((void)0)
+#define OCC_CENSUS_TILE_END() ((void)0)
+#define OCC_CENSUS_SRC(v) ((void)0)
+#define OCC_TILE_CORNER(o, x, y, z) scene_occluders_point_hidden((o), (x), (y), (z))
+#endif

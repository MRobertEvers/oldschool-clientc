+/** Scene units per shadow-map cell — 512 is four tiles. */
+#define OCC_SHADOW_CELL_SHIFT 9
+/** Cells per axis; covers a scene of 256 tiles a side. */
+#define OCC_SHADOW_DIM 64
+#define OCC_SHADOW_WORDS (OCC_SHADOW_DIM / 32)

From e14ffaf2716301a79cbe0a8c7043c72e5a394fde Mon Sep 17 00:00:00 2001
From: hunt-w11 <agent@local>
Date: Mon, 24 Aug 2026 23:08:21 -0500
Subject: [PATCH 1/3] perf(world): walk a runtime-spawn list instead of the
 whole scenery pool

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 src/engine/world_builder/world_scenery.u.c |  3 ++
 src/world/world.c                          | 34 ++++++++++++++++++++++
 src/world/world.h                          | 20 +++++++++++++
 src/world/world_cycle.c                    | 25 +++++++++++++---
 4 files changed, 78 insertions(+), 4 deletions(-)

diff --git a/src/engine/world_builder/world_scenery.u.c b/src/engine/world_builder/world_scenery.u.c
index e58e6d3bd..3dbc17f35 100644
--- a/src/engine/world_builder/world_scenery.u.c
+++ b/src/engine/world_builder/world_scenery.u.c
@@ -1102,7 +1102,10 @@ scenery_load_model(
                  * build-time static registration below, which
                  * painter_reset_to_static truncates. */
                 if( builder->scenery_runtime_spawn )
+                {
                     sc->runtime_spawn = 1;
+                    World_SceneryRuntimeSpawnTrack(world, pool_idx);
+                }
                 scenery_debug_record(
                     builder, sc, map_tile, config_loc, model, element_id, pool_idx, size_x,
                     size_z);
diff --git a/src/world/world.c b/src/world/world.c
index 96a03d4ac..dd7b3f640 100644
--- a/src/world/world.c
+++ b/src/world/world.c
@@ -55,6 +55,7 @@ World_Free(struct World* world)
     free(world->tile_last_occupied_cycle);
     free(world->mapscenes);
     free(world->area_sounds);
+    free(world->runtime_scenery);
     World_EntityListFree(&world->entities);
     free(world);
 }
@@ -441,6 +442,9 @@ World_ResetSceneAlloc(
      * elements' reused ids. Movers/objstacks stay: the rebuild shift
      * relocates them (Client-TS keeps entity slots across a rebuild). */
     World_EntityPoolReset(&world->entities.scenery);
+    /* The reset drops the pool count to 0, so every tracked runtime-spawn
+     * index now names a slot that does not exist. */
+    world->runtime_scenery_count = 0;
     world->scenery_pick_count = 0;
     /* Pending EntityRemoved must be drained (SceneElementRemove) before a
      * scene reset — wiping the queue here would orphan DYNAMIC elements. */
@@ -2669,6 +2673,36 @@ World_SceneryFindByLocId(
     return NULL;
 }
 
+void
+World_SceneryRuntimeSpawnTrack(
+    struct World* world,
+    int idx)
+{
+    assert(world);
+    assert(idx >= 0);
+
+    /* A released slot the painter walk has not pruned yet can be handed straight
+     * back by the pool and spawned on again; tracked twice, the loc would
+     * register twice. The list holds one entry per runtime spawn alive in the
+     * scene -- a handful of open doors -- so the linear check is cheaper than
+     * any index that would avoid it. */
+    for( int i = 0; i < world->runtime_scenery_count; i++ )
+        if( world->runtime_scenery[i] == idx )
+            return;
+
+    if( world->runtime_scenery_count >= world->runtime_scenery_capacity )
+    {
+        int new_cap =
+            world->runtime_scenery_capacity ? world->runtime_scenery_capacity * 2 : 32;
+        int* grown =
+            (int*)realloc(world->runtime_scenery, (size_t)new_cap * sizeof(*grown));
+        assert(grown);
+        world->runtime_scenery = grown;
+        world->runtime_scenery_capacity = new_cap;
+    }
+    world->runtime_scenery[world->runtime_scenery_count++] = idx;
+}
+
 void
 World_SceneryRemove(
     struct World* world,
diff --git a/src/world/world.h b/src/world/world.h
index c9a4f4975..7953cfdbd 100644
--- a/src/world/world.h
+++ b/src/world/world.h
@@ -249,6 +249,17 @@ struct World
     struct World_SceneryPick scenery_picks[WORLD_SCENERY_PICK_MAX];
     int scenery_pick_count;
 
+    /* Scenery pool indices of runtime-spawned locs (zone LOC_ADD_CHANGE). The
+     * per-frame painter re-registration walks this instead of the whole
+     * scenery pool: a scene holds thousands of baked locs and normally not one
+     * of them is runtime-spawned, so that scan streamed the entire pool every
+     * rendered frame to find nothing. Self-healing -- an index whose slot was
+     * released or reset drops out when the walk next sees it, so a removal
+     * path that forgets to untrack costs a stale frame, not a phantom loc. */
+    int* runtime_scenery;
+    int runtime_scenery_count;
+    int runtime_scenery_capacity;
+
     World_HeightFn height_fn;
     void* height_userdata;
 
@@ -1184,6 +1195,15 @@ World_SceneryFindByLocId(
     int level,
     int loc_id);
 
+/** Record scenery pool index `idx` as a runtime-spawned loc so the per-frame
+ * painter dynamics pass finds it without scanning the whole scenery pool.
+ * Idempotent: an index already tracked is not added twice, which is what keeps
+ * a released-then-respawned slot from registering its loc twice. */
+void
+World_SceneryRuntimeSpawnTrack(
+    struct World* world,
+    int idx);
+
 /** LOC_DEL: remove the scenery entity + its scene element (event emitted). */
 void
 World_SceneryRemove(
diff --git a/src/world/world_cycle.c b/src/world/world_cycle.c
index 264877537..a82b1d023 100644
--- a/src/world/world_cycle.c
+++ b/src/world/world_cycle.c
@@ -1542,11 +1542,27 @@ World_CycleRegisterPainterDynamics(struct World* world)
      * must be re-registered every cycle. Registered before the dynamics below so
      * they draw with the scenery (behind players/NPCs), matching a normal loc. */
     pool = &world->entities.scenery;
-    for( int si = World_EntityPoolHead(pool); si != WORLD_ENTITY_NIL;
-         si = World_EntityPoolNext(pool, si) )
+    /* world->runtime_scenery, not the pool: the pool is every loc the build
+     * baked -- thousands of entries, none of them runtime-spawned in a scene
+     * nobody has opened a door in -- and walking it read the whole (multi-MB)
+     * item array every rendered frame to reach `continue` on every entry.
+     * Registration order is preserved because the pool appends an allocation
+     * at its tail, so pool order and spawn order are the same order. */
+    int keep = 0;
+    for( int li = 0; li < world->runtime_scenery_count; li++ )
     {
-        struct WorldEntity_Scenery* sc = World_EntityPoolGet(pool, si);
-        if( !sc || !sc->runtime_spawn || sc->element_id < 0 )
+        int si = world->runtime_scenery[li];
+        struct WorldEntity_Scenery* sc;
+        /* Prune: a slot released (LOC_DEL) or wiped by a scene reset since it
+         * was tracked drops out of the list here rather than obliging every
+         * removal path to untrack. */
+        if( si >= pool->count || !World_EntityPoolIsActive(pool, si) )
+            continue;
+        sc = World_EntityPoolGet(pool, si);
+        if( !sc->runtime_spawn )
+            continue;
+        world->runtime_scenery[keep++] = si;
+        if( sc->element_id < 0 )
             continue;
         int grid_x = sc->grid_position.x;
         int grid_z = sc->grid_position.z;
@@ -1587,6 +1603,7 @@ World_CycleRegisterPainterDynamics(struct World* world)
                 sc->size_z > 0 ? sc->size_z : 1,
                 (world->scene ? ToriDraw_SceneElementOcclusionHeight(world->scene, sc->element_id) : 0));
     }
+    world->runtime_scenery_count = keep;
 
     /* Ground items render below entities (reference tile.groundObject draws in
      * the tile's base step, before any dynamic sprite). Only the local plane —

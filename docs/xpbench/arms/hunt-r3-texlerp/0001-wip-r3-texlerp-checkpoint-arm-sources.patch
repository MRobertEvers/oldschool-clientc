+++ b/3rd/toridraw/graphics/raster/span_census.c
@@ -158,3 +158,112 @@ ToriDraw_SpanCensusDump(void)
 }
 
 #endif
+
+#include "graphics/raster/texlerp_census.h"
+
+#if defined(TORIDRAW_TEXLERP_CENSUS) && TORIDRAW_TEXLERP_CENSUS
+
+struct ToriDraw_TexLerpCensus g_toridraw_texlerp_census;
+struct ToriDraw_TexLerpCensus g_toridraw_texlerp_census_trans;
+struct ToriDraw_TexLerpCensus* g_toridraw_texlerp_cur = &g_toridraw_texlerp_census;
+
+static void
+toridraw_texlerp_dump_one(FILE* out, char const* tag, struct ToriDraw_TexLerpCensus const* c)
+{
+    double frames;
+    char const* fs = getenv("TORIRS_MAX_FRAMES");
+
+    if( c->spans == 0.0 )
+        return;
+    frames = fs ? atof(fs) : 1.0;
+    if( frames <= 0.0 )
+        frames = 1.0;
+
+    fprintf(out, "== texlerp %s (per frame over %.0f frames) ==\n", tag, frames);
+    fprintf(
+        out,
+        "spans %.1f  pixels %.1f  px/span %.3f\n",
+        c->spans / frames,
+        c->pixels / frames,
+        c->pixels / c->spans);
+    fprintf(
+        out,
+        "noblock spans %.1f (%.2f%%)  their pixels %.1f (%.2f%% of px)\n",
+        c->spans_noblock / frames,
+        100.0 * c->spans_noblock / c->spans,
+        c->pixels_noblock / frames,
+        100.0 * c->pixels_noblock / c->pixels);
+    fprintf(
+        out,
+        "pairs %.1f  pairs/span %.3f  pairs/pixel %.4f\n",
+        c->pairs / frames,
+        c->pairs / c->spans,
+        c->pairs / c->pixels);
+    fprintf(
+        out,
+        "v-slow (idivl) %.1f  = %.3f%% of pairs, %.4f per span\n",
+        c->vslow / frames,
+        100.0 * c->vslow / c->pairs,
+        c->vslow / c->spans);
+    fprintf(
+        out,
+        "u clamp lo %.1f (%.2f%%) hi %.1f (%.2f%%)\n",
+        c->uclamp_lo / frames,
+        100.0 * c->uclamp_lo / c->pairs,
+        c->uclamp_hi / frames,
+        100.0 * c->uclamp_hi / c->pairs);
+    fprintf(
+        out,
+        "blocks lerp8 %.1f  exact %.1f (%.1f px)  w0-skipped %.1f\n",
+        c->blk_lerp8 / frames,
+        c->blk_exact / frames,
+        c->px_exact / frames,
+        c->blk_w0 / frames);
+    fprintf(
+        out,
+        "tail lerp px %.1f (%.2f%% of px)  spans with remain>=4 %.1f (%.2f%%)\n",
+        c->px_tail_lerp / frames,
+        100.0 * c->px_tail_lerp / c->pixels,
+        c->tails_ge4 / frames,
+        100.0 * c->tails_ge4 / c->spans);
+    fprintf(out, "spans whose pixel-0 w==0 %.1f (%.2f%%)\n",
+        c->spans_w0 / frames, 100.0 * c->spans_w0 / c->spans);
+    fprintf(out, "remain,spans,pct\n");
+    for( int i = 0; i < 8; i++ )
+        fprintf(out, "%d,%.1f,%.2f\n", i, c->remain[i] / frames,
+                100.0 * c->remain[i] / c->spans);
+    fprintf(out, "len,spans,span_cum_pct,pixel_cum_pct\n");
+    {
+        double srun = 0.0, prun = 0.0;
+        for( int i = 0; i <= TORIDRAW_TEXLERP_LENMAX; i++ )
+        {
+            if( c->len[i] == 0.0 )
+                continue;
+            srun += c->len[i];
+            prun += c->len[i] * (double)i;
+            fprintf(out, "%d,%.1f,%.2f,%.2f\n", i, c->len[i] / frames,
+                    100.0 * srun / c->spans, 100.0 * prun / c->pixels);
+        }
+    }
+    fflush(out);
+}
+
+void
+ToriDraw_TexLerpCensusDump(void)
+{
+    char const* path = getenv("TORIDRAW_TEXLERP_CENSUS_FILE");
+    FILE* out = stderr;
+
+    if( path )
+    {
+        FILE* f = fopen(path, "wb");
+        if( f )
+            out = f;
+    }
+    toridraw_texlerp_dump_one(out, "OPAQUE", &g_toridraw_texlerp_census);
+    toridraw_texlerp_dump_one(out, "TRANSPARENT", &g_toridraw_texlerp_census_trans);
+    if( out != stderr )
+        fclose(out);
+}
+
+#endif
diff --git a/3rd/toridraw/graphics/raster/texlerp_census.h b/3rd/toridraw/graphics/raster/texlerp_census.h
new file mode 100644
index 000000000..2086fc077
--- /dev/null
+++ b/3rd/toridraw/graphics/raster/texlerp_census.h
@@ -0,0 +1,111 @@
+#ifndef TORIDRAW_RASTER_TEXLERP_CENSUS_H
+#define TORIDRAW_RASTER_TEXLERP_CENSUS_H
+
+/*
+ * The perspective texture span, counted at the granularity the KERNEL pays at.
+ *
+ * The existing texspan census answers "how many blocks per span". This one
+ * answers the question that decides whether the per-span prologue is the cost:
+ * how many QUOTIENT PAIRS -- a reciprocal, a clamped u convert and a wrapped v
+ * convert -- are computed per span, against how many pixels that span draws,
+ * and how often the wrapped convert has to fall through to an idivl.
+ *
+ * Never built into a timed binary. -DTORIDRAW_TEXLERP_CENSUS=1 alongside
+ * -DTORIDRAW_SPAN_CENSUS=1 (which is what withdraws the asm kernels so the C
+ * twin -- the thing these hooks live in -- actually runs).
+ */
+
+#if defined(TORIDRAW_TEXLERP_CENSUS) && TORIDRAW_TEXLERP_CENSUS
+
+#include <stdio.h>
+#include <stdlib.h>
+
+#define TORIDRAW_TEXLERP_LENMAX 40
+
+struct ToriDraw_TexLerpCensus
+{
+    double spans;
+    double pixels;
+    /* Span length histogram, exact 0..39 then one overflow bucket. */
+    double len[TORIDRAW_TEXLERP_LENMAX + 1];
+    /* Spans that run no 8-pixel block at all, and the pixels they draw. */
+    double spans_noblock;
+    double pixels_noblock;
+    /* remaining (steps & 7) histogram. */
+    double remain[8];
+    /* Quotient pairs computed: one reciprocal + one u convert + one v convert. */
+    double pairs;
+    /* Of those, the v convert that had to divide instead. */
+    double vslow;
+    /* u converts that clamped rather than converting. */
+    double uclamp_lo;
+    double uclamp_hi;
+    /* Blocks. */
+    double blk_lerp8;
+    double blk_exact8;
+    double blk_exact_tail;
+    double px_exact;
+    /* Tail. */
+    double px_tail_lerp;
+    double tails_lerp;
+    double tails_ge4;
+    /* Spans whose first block has w == 0 (nothing to draw from pixel 0). */
+    double spans_w0;
+    /* Blocks skipped entirely because w == 0. */
+    double blk_w0;
+};
+
+extern struct ToriDraw_TexLerpCensus g_toridraw_texlerp_census;
+extern struct ToriDraw_TexLerpCensus g_toridraw_texlerp_census_trans;
+extern struct ToriDraw_TexLerpCensus* g_toridraw_texlerp_cur;
+
+void
+ToriDraw_TexLerpCensusDump(void);
+
+static inline void
+toridraw_texlerp_select(int transparent)
+{
+    if( g_toridraw_texlerp_census.spans == 0.0 &&
+        g_toridraw_texlerp_census_trans.spans == 0.0 )
+        atexit(ToriDraw_TexLerpCensusDump);
+    g_toridraw_texlerp_cur =
+        transparent ? &g_toridraw_texlerp_census_trans : &g_toridraw_texlerp_census;
+}
+
+static inline void
+toridraw_texlerp_span(int steps)
+{
+    struct ToriDraw_TexLerpCensus* c = g_toridraw_texlerp_cur;
+    int i = steps;
+    if( i < 0 )
+        i = 0;
+    if( i > TORIDRAW_TEXLERP_LENMAX )
+        i = TORIDRAW_TEXLERP_LENMAX;
+    c->spans += 1.0;
+    c->pixels += (double)steps;
+    c->len[i] += 1.0;
+    c->remain[steps & 7] += 1.0;
+    if( (steps >> 3) == 0 )
+    {
+        c->spans_noblock += 1.0;
+        c->pixels_noblock += (double)steps;
+    }
+    if( (steps & 7) >= 4 )
+        c->tails_ge4 += 1.0;
+}
+
+#define TORIDRAW_TEXLERP_SELECT(t) toridraw_texlerp_select((t))
+#define TORIDRAW_TEXLERP_SPAN(steps) toridraw_texlerp_span((steps))
+#define TORIDRAW_TEXLERP_BUMP(field) (g_toridraw_texlerp_cur->field += 1.0)
+#define TORIDRAW_TEXLERP_ADD(field, n) (g_toridraw_texlerp_cur->field += (double)(n))
+
+#else
+
+#define TORIDRAW_TEXLERP_SELECT(t) ((void)0)
+#define TORIDRAW_TEXLERP_SPAN(steps) ((void)0)
+#define TORIDRAW_TEXLERP_BUMP(field) ((void)0)
+#define TORIDRAW_TEXLERP_ADD(field, n) ((void)0)
+
+#endif
+
+#endif

                 tex_span_exact_block(
                     pixel_buffer,
                     offset,
@@ -1039,6 +1055,7 @@ draw_texture_scanline_transparent_blend_branching_lerp8_v3_ordered(
         }
         else
         {
+            TORIDRAW_TEXLERP_BUMP(blk_w0);
             have_cur = 0;
         }
         au += step_au8;
@@ -1074,6 +1091,8 @@ draw_texture_scanline_transparent_blend_branching_lerp8_v3_ordered(
         if( w_n == 0 || !tex_span_lerp8_fits(cur_v, nxt_v, texture_width) )

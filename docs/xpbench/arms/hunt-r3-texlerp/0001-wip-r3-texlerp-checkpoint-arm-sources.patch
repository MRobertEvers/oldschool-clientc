diff --git a/3rd/toridraw/graphics/raster/texture/span/tex.span_uv.h b/3rd/toridraw/graphics/raster/texture/span/tex.span_uv.h
index f7970afa8..f7a0c0e34 100644
--- a/3rd/toridraw/graphics/raster/texture/span/tex.span_uv.h
+++ b/3rd/toridraw/graphics/raster/texture/span/tex.span_uv.h
@@ -6,6 +6,7 @@
 #include "graphics/raster/raster_ablate.h"
 #include "graphics/shade.h"
 #include "graphics/shared_tables.h"
+#include "graphics/raster/texlerp_census.h"
 
 #include <stdint.h>
 
@@ -57,6 +58,7 @@ tex_span_wrapped_quotient(int n, int w, float inv_w)
     if( quotient > -TEX_SPAN_RECIPROCAL_EXACT_LIMIT &&
         quotient < TEX_SPAN_RECIPROCAL_EXACT_LIMIT )
         return (int)quotient;
+    TORIDRAW_TEXLERP_BUMP(vslow);
     return n / w;
 }
 
@@ -77,10 +79,17 @@ static inline int
 tex_span_u_quotient(int au, float inv_w, int texture_width)
 {
     float quotient = (float)au * inv_w;
+    TORIDRAW_TEXLERP_BUMP(pairs);
     if( quotient <= 0.0f )
+    {
+        TORIDRAW_TEXLERP_BUMP(uclamp_lo);
         return 0;
+    }
     if( quotient >= (float)(texture_width - 1) )
+    {
+        TORIDRAW_TEXLERP_BUMP(uclamp_hi);
         return texture_width - 1;
+    }
     return (int)quotient;
 }
 

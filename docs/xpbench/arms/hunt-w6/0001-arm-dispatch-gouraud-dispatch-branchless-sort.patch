 #include "graphics/raster/face_census.h"
 // clang-format on
 
-static inline void
-ToriDraw_TriangleGouraud(
+/**
+ * The dispatcher's two cold destinations, out of line.
+ *
+ * ToriDraw_TriangleGouraud is written `static inline` and gcc outlines it
+ * anyway: _ToriDraw_TriangleGouraud.lto_priv.0 is a real symbol in the
+ * shipping win32 binary and the EIP profile charges it 1.15 ms of a 64 ms
+ * frame, about 199 cycles across the 15-16k gouraud faces the face census
+ * counts. Size is why. The body held four separate thirteen- and
+ * fourteen-argument calls, and its own fourteen arguments arrive as stack
+ * slots -- every call site sits inside a function that already carries twenty
+ * or more parameters of its own -- so each argument costs a load and a store
+ * to marshal. Outlined, a face pays that marshalling TWICE: once into the
+ * dispatcher and once back out of it into the kernel, roughly fifty-six memory
+ * accesses to move values that were already in memory.
+ *
+ * Moving the scanline family and the alpha kernel behind one noinline call
+ * leaves the hot path a single test and a single call. `noinline` is
+ * load-bearing in the other direction too: without it gcc pulls these bodies
+ * back into the caller and restores exactly the size that refused the inline.
+ *
+ * Four of the five call sites are cold regardless -- the two near-clip
+ * builders and the S1 family -- so the growth lands where nothing runs. The
+ * one that matters is ToriDraw_TriangleFaceGouraud's straight-through path.
+ */
+__attribute__((noinline))
+static void
+toridraw_triangle_gouraud_cold(
     toripixel_t* RESTRICT pixel_buffer,
     int stride,
     int screen_width,
@@ -37,13 +62,6 @@ ToriDraw_TriangleGouraud(
     int color_c,
     int alpha)
 {
-    TORIDRAW_FACE_CENSUS_RECORD(
-        TORIDRAW_FACE_CENSUS_GOURAUD,
-        x1, y1,
-        x2, y2,
-        x3, y3,
-        screen_width * screen_height);
-
     if( TORIDRAW_SCANLINE_SELECTED() )
     {
         if( alpha == 0xFF )
@@ -84,7 +102,51 @@ ToriDraw_TriangleGouraud(
         return;
     }
 
-    if( alpha == 0xFF )
+    raster_gouraudhsllightness_screen_alpha_bary_branching_s4(
+        pixel_buffer,
+        stride,
+        screen_width,
+        screen_height,
+        x1,
+        x2,
+        x3,
+        y1,
+        y2,
+        y3,
+        color_a,
+        color_b,
+        color_c,
+        alpha);
+}

-	movl	A(4 + \ia), %eax
-	movl	%eax, V_X0(%esp)
-	movl	A(4 + \ib), %eax
-	movl	%eax, V_X1(%esp)
-	movl	A(4 + \ic), %eax
-	movl	%eax, V_X2(%esp)
-	movl	A(7 + \ia), %eax
-	movl	%eax, V_Y0(%esp)
-	movl	A(7 + \ib), %eax
-	movl	%eax, V_Y1(%esp)
-	movl	A(7 + \ic), %eax
-	movl	%eax, V_Y2(%esp)
-	movl	A(10 + \ia), %eax
-	movl	%eax, V_C0(%esp)
-	movl	A(10 + \ib), %eax
-	movl	%eax, V_C1(%esp)
-	movl	A(10 + \ic), %eax
-	movl	%eax, V_C2(%esp)
-.endm

 /* Load the generic segment slots for one segment. */
 .macro	SETSEG el, er, sl, sr, nc, cnt
 	movl	\el(%esp), %eax
@@ -415,61 +393,90 @@ _toridraw_gouraud_tri_opaque_s4_asm:
 	movl	A(3), %eax
 	movl	%eax, V_SCRH(%esp)
 
-	/* ---- sort the three vertices by y, with the same early-outs ---- */
-	movl	A(7), %eax		/* y0 */
-	movl	A(8), %ecx		/* y1 */
-	movl	A(9), %edx		/* y2 */
+	/* ---- sort the three vertices by y, branchlessly ----
+	 *
+	 * The six-way branch tree this replaces was the only unpredictable branch
+	 * left in the kernel. Its inputs are three screen-space y values in
+	 * whatever order the model's face list happened to store them, so the
+	 * three or four conditional jumps it took to reach a store were coin
+	 * flips, and a Prescott pays twenty to thirty cycles plus a trace cache
+	 * refill for each one it calls wrong.
+	 *
+	 * So the ordering is computed instead of jumped to. Four signed
+	 * comparisons -- and the pair (y0 <= y2, y2 <= y0) comes out of ONE cmp,
+	 * because both are wanted and they are not complements when the two are
+	 * equal -- pack into a four bit key, and three sixteen byte tables turn
+	 * the key into the three source vertex indices. One store site, indexed,
+	 * replaces the six the tree jumped to.
+	 *
+	 * The tables are transcribed from the branch tree case by case, ties
+	 * included. That matters: the reference does NOT sort stably --
+	 * y1 < y0 == y2 yields 1,2,0 and not 1,0,2 -- and which of two equal-y
+	 * vertices lands in B decides which trapezoid segment is the empty one,
+	 * so the tie rules are visible output. Seven of the sixteen keys are
+	 * unreachable (y0 <= y2 and y2 <= y0 cannot both be false; y0 <= y1 and
+	 * y1 <= y2 force y0 <= y2); they hold whatever the same decision
+	 * procedure gives, and are never read.
+	 *
+	 * The two early-outs move BELOW the store instead of being replicated six
+	 * ways. Both are pure returns with nothing observable in between, and
+	 * after the store the smallest y is in V_Y0 and the largest in V_Y2 by
+	 * construction, so the pair of tests is the pair the tree ran -- only now
+	 * heavily biased, and predicted. The cost is that a wholly off-screen
+	 * triangle marshals nine slots it will not use; anything that reached
+	 * this kernel already survived the model's own bounds test, so that case
+	 * is rare.
+	 */
+#define AR(n, r) (180 + 4 * (n))(%esp, r, 4)
+
+	movl	A(7), %ebx		/* y0 */
+	movl	A(8), %esi		/* y1 */
+	movl	A(9), %edi		/* y2 */
 
-	cmpl	%ecx, %eax
-	jg	Lsort_b
-	cmpl	%edx, %eax
-	jg	Lsort_b
+	xorl	%eax, %eax
+	xorl	%ecx, %ecx
+	xorl	%edx, %edx
+	cmpl	%esi, %ebx
+	setle	%al			/* y0 <= y1 -> bit 0                 */
+	cmpl	%edi, %ebx
+	setle	%cl			/* y0 <= y2 -> bit 1                 */
+	setge	%dl			/* y2 <= y0 -> bit 3                 */
+	leal	(%eax,%ecx,2), %eax
+	leal	(%eax,%edx,8), %eax
+	xorl	%ecx, %ecx
+	cmpl	%edi, %esi
+	setle	%cl			/* y1 <= y2 -> bit 2                 */
+	leal	(%eax,%ecx,4), %eax	/* the key, in [0, 16)               */
+
+	movzbl	Lperm_b(%eax), %edx
+	movzbl	Lperm_c(%eax), %ecx
+	movzbl	Lperm_a(%eax), %eax
+
+	movl	AR(4, %eax), %ebx
+	movl	%ebx, V_X0(%esp)
+	movl	AR(7, %eax), %ebx
+	movl	%ebx, V_Y0(%esp)
+	movl	AR(10, %eax), %ebx
+	movl	%ebx, V_C0(%esp)
+	movl	AR(4, %edx), %ebx
+	movl	%ebx, V_X1(%esp)
+	movl	AR(7, %edx), %ebx
+	movl	%ebx, V_Y1(%esp)
+	movl	AR(10, %edx), %ebx
+	movl	%ebx, V_C1(%esp)
+	movl	AR(4, %ecx), %ebx
+	movl	%ebx, V_X2(%esp)
+	movl	AR(7, %ecx), %ebx
+	movl	%ebx, V_Y2(%esp)
+	movl	AR(10, %ecx), %ebx
+	movl	%ebx, V_C2(%esp)
+
+	movl	V_Y0(%esp), %eax	/* smallest y, by construction       */
 	cmpl	V_SCRH(%esp), %eax
 	jg	Lret
-	cmpl	%edx, %ecx
-	jg	Lsort_a2
-	testl	%edx, %edx
-	js	Lret
-	SORTSTORE 0, 1, 2
-	jmp	Lsorted
-Lsort_a2:
-	testl	%ecx, %ecx
-	js	Lret
-	SORTSTORE 0, 2, 1
-	jmp	Lsorted
+	cmpl	$0, V_Y2(%esp)		/* largest y, by construction        */
+	jl	Lret
 
-Lsort_b:
-	cmpl	%edx, %ecx
-	jg	Lsort_c
-	cmpl	V_SCRH(%esp), %ecx
-	jg	Lret
-	cmpl	%eax, %edx
-	jg	Lsort_b2
-	testl	%eax, %eax
-	js	Lret
-	SORTSTORE 1, 2, 0
-	jmp	Lsorted
-Lsort_b2:
-	testl	%edx, %edx
-	js	Lret
-	SORTSTORE 1, 0, 2
-	jmp	Lsorted
-
-Lsort_c:
-	cmpl	V_SCRH(%esp), %edx
-	jg	Lret
-	cmpl	%ecx, %eax
-	jg	Lsort_c2
-	testl	%ecx, %ecx
-	js	Lret
-	SORTSTORE 2, 0, 1
-	jmp	Lsorted
-Lsort_c2:
-	testl	%eax, %eax
-	js	Lret
-	SORTSTORE 2, 1, 0
-
-Lsorted:
 	/* ---- per-triangle prologue ---- */
 	movl	V_Y2(%esp), %eax
 	subl	V_Y0(%esp), %eax	/* dy_AC */
@@ -756,3 +763,18 @@ Lret:
 	popl	%edi
 	popl	%ebp
 	ret
+
+
+/* ---- the y-order tables ----------------------------------------------
+ * key = (y0<=y1) | (y0<=y2)<<1 | (y1<=y2)<<2 | (y2<=y0)<<3, and each entry is
+ * the vertex index the branch tree would have copied into that sorted slot.
+ * Forty-eight bytes on one line, so the three lookups are one miss at worst.
+ */
+	.section .rdata,"dr"
+	.p2align 6
+Lperm_a:
+	.byte	2,2,2,0, 1,1,1,0, 2,2,2,0, 1,1,1,0
+Lperm_b:
+	.byte	1,0,1,2, 0,0,0,1, 1,0,1,2, 2,2,2,1
+Lperm_c:
+	.byte	0,1,0,1, 2,2,2,2, 0,1,0,1, 0,0,0,2

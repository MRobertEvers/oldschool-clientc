     {
         // raster_gouraudhsllightness_screen_opaque_edge_sort_s4(
         TORIDRAW_GOURAUD_TRI_OPAQUE_S4(
@@ -101,25 +163,24 @@ ToriDraw_TriangleGouraud(
             color_a,
             color_b,
             color_c);
+        return;
     }

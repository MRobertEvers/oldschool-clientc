diff --git a/src/world/world_cycle.c b/src/world/world_cycle.c
index 264877537..a53646db2 100644
--- a/src/world/world_cycle.c
+++ b/src/world/world_cycle.c
@@ -1,3 +1,4 @@
+#include "hunt_r4.h"
 #include "world.h"
 
 #include "entity_facets.h"
@@ -1528,6 +1529,23 @@ world_dyn_register_npcs(struct World* world, bool alwaysontop, int local_level)
  * scenery_head->next), so earlier tiers sit behind later ones; combined with
  * the tile-claim dedup this reproduces which single entity wins a stacked
  * tile. */
+/** How many scenery entries carry runtime_spawn. Only the assert above uses
+ *  it, so it costs nothing under OPT=1 (-DNDEBUG). */
+static int
+world_scenery_runtime_spawn_scan(const struct World_EntityPool* pool)
+{
+    int n = 0;
+    assert(pool);
+    for( int si = World_EntityPoolHead(pool); si != WORLD_ENTITY_NIL;
+         si = World_EntityPoolNext(pool, si) )
+    {
+        const struct WorldEntity_Scenery* sc = World_EntityPoolGet(pool, si);
+        if( sc && sc->runtime_spawn )
+            n++;
+    }
+    return n;
+}
+
 static void
 World_CycleRegisterPainterDynamics(struct World* world)
 {
@@ -1542,7 +1560,57 @@ World_CycleRegisterPainterDynamics(struct World* world)
      * must be re-registered every cycle. Registered before the dynamics below so
      * they draw with the scenery (behind players/NPCs), matching a normal loc. */
     pool = &world->entities.scenery;
-    for( int si = World_EntityPoolHead(pool); si != WORLD_ENTITY_NIL;
+    /*
+     * TORIRS_R4_DYNSTAT=1: one line, once, naming what this walk costs --
+     * how many entries it visits and how many bytes of pool that touches.
+     */
+    HUNT_R4_KNOB(r4_dynstat, "TORIRS_R4_DYNSTAT")
+    if( r4_dynstat )
+    {
+        static int once = 0;
+        if( !once )
+        {
+            int n = 0;
+            int spawns = 0;
+            for( int si = World_EntityPoolHead(pool); si != WORLD_ENTITY_NIL;
+                 si = World_EntityPoolNext(pool, si) )
+            {
+                struct WorldEntity_Scenery* s = World_EntityPoolGet(pool, si);
+                n++;
+                if( s && s->runtime_spawn )
+                    spawns++;
+            }
+            fprintf(
+                stderr,
+                "r4_dynstat: scenery walk=%d entries runtime_spawn=%d elem=%d B "
+                "span=%d KB | obj_stack=%d projectile=%d spotanim=%d
+",
+                n,
+                spawns,
+                (int)sizeof(struct WorldEntity_Scenery),
+                (int)((size_t)n * sizeof(struct WorldEntity_Scenery) / 1024u),
+                world->entities.obj_stack.active_count,
+                world->entities.projectile.active_count,
+                world->entities.spotanim.active_count);
+            once = 1;
+        }
+    }

diff --git a/src/platform/torirs_heapcount.c b/src/platform/torirs_heapcount.c
new file mode 100644
index 000000000..d841dcf8c
--- /dev/null
+++ b/src/platform/torirs_heapcount.c
@@ -0,0 +1,222 @@
+/*
+ * torirs_heapcount.c -- COUNT-ONLY instrument for the XP frame hunt.
+ *
+ * NOT SHIPPABLE and NEVER TIMED. It answers one question the hunt has never
+ * asked: how many heap calls, and how many getenv calls, does a steady-state
+ * frame make, and from where?
+ *
+ * Unlike torirs_memprof_win32.c it stores nothing in the block, so the program
+ * it measures allocates exactly what it would have. Every hook is a counter
+ * increment plus the real call.
+ *
+ * Counts are split at TORIRS_HEAPCOUNT_WARM frames (default 100) so boot
+ * allocation does not drown the steady state, which is the only part a
+ * 900-frame bench spends its time in.
+ */
+#if defined(TORIRS_HEAPCOUNT)
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+extern void* __real_malloc(size_t size);
+extern void* __real_calloc(size_t nmemb, size_t size);
+extern void* __real_realloc(void* ptr, size_t size);
+extern void __real_free(void* ptr);
+extern char* __real_strdup(const char* str);
+extern char* __real_getenv(const char* name);
+
+extern long g_torirs_frame_no;
+
+#define HC_SITE_BITS 14u
+#define HC_SITE_CAP (1u << HC_SITE_BITS)
+
+struct HC_Site
+{
+    void* ra;
+    long calls;
+};
+
+static struct HC_Site g_site[HC_SITE_CAP];
+static long g_site_collisions;
+
+static long g_calls[6];      /* malloc calloc realloc free strdup getenv */
+static long g_calls_warm[6]; /* snapshot taken at the warm frame */
+static long g_bytes;
+static long g_bytes_warm;
+static long g_warm_frame_seen;
+static long g_last_frame;
+static long g_frames_counted;
+
+static long
+hc_warm(void)
+{
+    static long w = -1;
+    if( w < 0 )
+    {
+        const char* e = __real_getenv("TORIRS_HEAPCOUNT_WARM");
+        w = e ? atol(e) : 100;
+    }
+    return w;
+}
+
+/* Called on every hooked entry: notices the first frame past the warm line and
+ * snapshots the totals there, so steady-state = total - snapshot. */
+static void
+hc_tick(void)
+{
+    if( g_torirs_frame_no != g_last_frame )
+    {
+        g_last_frame = g_torirs_frame_no;
+        if( g_torirs_frame_no == hc_warm() && !g_warm_frame_seen )
+        {
+            g_warm_frame_seen = 1;
+            memcpy(g_calls_warm, g_calls, sizeof(g_calls));
+            g_bytes_warm = g_bytes;
+        }
+    }
+}
+
+static void
+hc_site(void* ra)
+{
+    uint32_t slot = ((uint32_t)(uintptr_t)ra * 2654435761u) >> (32u - HC_SITE_BITS);
+    uint32_t probe;
+    if( !g_warm_frame_seen )
+        return; /* steady state only */
+    for( probe = 0; probe < 8u; probe++ )
+    {
+        struct HC_Site* s = &g_site[(slot + probe) & (HC_SITE_CAP - 1u)];
+        if( s->ra == NULL )
+        {
+            s->ra = ra;
+            s->calls = 1;
+            return;
+        }
+        if( s->ra == ra )
+        {
+            s->calls++;
+            return;
+        }
+    }
+    g_site_collisions++;
+}
+
+static int g_report_armed;
+
+static void
+hc_report(void)
+{
+    FILE* f;
+    const char* out = __real_getenv("TORIRS_HEAPCOUNT_OUT");
+    long frames;
+    int i;
+    static const char* names[6] = {
+        "malloc", "calloc", "realloc", "free", "strdup", "getenv"
+    };
+
+    f = out ? fopen(out, "w") : stderr;
+    if( !f )
+        f = stderr;
+
+    frames = g_torirs_frame_no - hc_warm();
+    if( frames < 1 )
+        frames = 1;
+    g_frames_counted = frames;
+
+    fprintf(f, "heapcount warm_frame=%ld last_frame=%ld steady_frames=%ld\n",
+            hc_warm(), g_torirs_frame_no, frames);
+    for( i = 0; i < 6; i++ )
+        fprintf(f, "%-8s total=%-10ld steady=%-10ld per_frame=%.2f\n",
+                names[i], g_calls[i], g_calls[i] - g_calls_warm[i],
+                (double)(g_calls[i] - g_calls_warm[i]) / (double)frames);
+    fprintf(f, "bytes    total=%-10ld steady=%-10ld per_frame=%.1f\n",
+            g_bytes, g_bytes - g_bytes_warm,
+            (double)(g_bytes - g_bytes_warm) / (double)frames);
+    fprintf(f, "site_collisions %ld\n", g_site_collisions);
+
+    /* Steady-state alloc sites, unsorted (the off-line reader sorts). Link-time
+     * addresses: addr2line -f -C -i -e torirs.exe <addr> names them. */
+    for( i = 0; i < (int)HC_SITE_CAP; i++ )
+        if( g_site[i].ra && g_site[i].calls > 0 )
+            fprintf(f, "S %08lx %ld %.3f\n",
+                    (unsigned long)(uintptr_t)g_site[i].ra,
+                    g_site[i].calls,
+                    (double)g_site[i].calls / (double)frames);
+    if( f != stderr )
+        fclose(f);
+}
+
+static void
+hc_arm(void)
+{
+    if( g_report_armed )
+        return;
+    g_report_armed = 1;
+    atexit(hc_report);
+}
+
+void*
+__wrap_malloc(size_t size)
+{
+    hc_arm();
+    hc_tick();
+    g_calls[0]++;
+    g_bytes += (long)size;
+    hc_site(__builtin_return_address(0));
+    return __real_malloc(size);
+}
+
+void*
+__wrap_calloc(size_t nmemb, size_t size)
+{
+    hc_arm();
+    hc_tick();
+    g_calls[1]++;
+    g_bytes += (long)(nmemb * size);
+    hc_site(__builtin_return_address(0));
+    return __real_calloc(nmemb, size);
+}
+
+void*
+__wrap_realloc(void* ptr, size_t size)
+{
+    hc_arm();
+    hc_tick();
+    g_calls[2]++;
+    g_bytes += (long)size;
+    hc_site(__builtin_return_address(0));
+    return __real_realloc(ptr, size);
+}
+
+void
+__wrap_free(void* ptr)
+{
+    hc_arm();
+    hc_tick();
+    g_calls[3]++;
+    __real_free(ptr);
+}
+
+char*
+__wrap_strdup(const char* str)
+{
+    hc_arm();
+    hc_tick();
+    g_calls[4]++;
+    hc_site(__builtin_return_address(0));
+    return __real_strdup(str);
+}
+
+char*
+__wrap_getenv(const char* name)
+{
+    hc_arm();
+    hc_tick();
+    g_calls[5]++;
+    hc_site(__builtin_return_address(0));
+    return __real_getenv(name);
+}
+
+#endif /* TORIRS_HEAPCOUNT */
diff --git a/src/render/torirs_frame.c b/src/render/torirs_frame.c
index ca7a84f48..7f262a3ad 100644
--- a/src/render/torirs_frame.c
+++ b/src/render/torirs_frame.c
@@ -1,3 +1,4 @@
+#include "hunt_r4.h"
 #include "render/torirs_frame.h"
 
 #include "painters/painters.h"
@@ -1929,6 +1930,69 @@ frame_only_loc_allows(
     return false;
 }
 
+/*
+ * R4 nonrender: software prefetch for the world emit loop.
+ *
+ * Every painter command resolves to a scene element through two dependent
+ * loads that both miss: scene->elements.nodes[id] (a 12-byte node in a ~90 KB
+ * array, indexed by an id with no locality at all) and then node.data, which
+ * points at an individually allocated ToriDraw_SceneElement somewhere else
+ * again. Nothing in the loop hides them, so on the Pentium 4 target the emit
+ * loop is a pointer chase two levels deep, once per command, ~2582 times a
+ * frame.
+ *
+ * The ids are known ahead of time -- they sit in the command array, which is
+ * sequential and already in cache -- so the chase can be run early. Two
+ * distances: the far one pulls the node in, the near one is far enough behind
+ * it that node.data is a hit and its target can be prefetched in turn.
+ */
+#define R4_EMITPF_FAR  12
+#define R4_EMITPF_NEAR 4
+
+static inline void
+r4_emit_prefetch(struct ToriRS_Frame* frame, int index)
+{
+    const struct ToriDraw_IntrusiveNode* nodes = frame->scene->elements.nodes;
+    int live = frame->scene->elements.count;
+    int total = frame->painters->command_count;
+    int i;
+    int id;
+
+    if( !nodes )
+        return;
+
+    i = index + R4_EMITPF_FAR;
+    if( i < total )
+    {
+        const struct PaintersElementCommand* c = &frame->painters->commands[i];
+        if( c->_bf_kind == PNTR_CMD_ELEMENT )
+        {
+            id = (int)c->_entity._bf_entity;
+            if( id >= 0 && id < live )
+                __builtin_prefetch(&nodes[id], 0, 1);
+        }
+    }
+
+    i = index + R4_EMITPF_NEAR;
+    if( i < total )
+    {
+        const struct PaintersElementCommand* c = &frame->painters->commands[i];
+        if( c->_bf_kind == PNTR_CMD_ELEMENT )
+        {
+            id = (int)c->_entity._bf_entity;
+            if( id >= 0 && id < live )
+            {
+                const char* d = (const char*)nodes[id].data;
+                if( d )
+                {
+                    __builtin_prefetch(d, 0, 1);
+                    __builtin_prefetch(d + 64, 0, 1);
+                }
+            }
+        }
+    }
+}
+
 static bool
 try_emit_world_draw_model(
     struct ToriRS_Frame* frame,
@@ -1948,10 +2012,14 @@ try_emit_world_draw_model(
      * names the same command on every frame of the same scene. */
     paint_limit = ToriRS_Frame_PaintLimitGet();
 
+    HUNT_R4_KNOB(r4_emitpf, "TORIRS_R4_EMITPF")
+
     while( frame->painters_index < frame->painters->command_count )
     {
         if( paint_limit >= 0 && frame->painters_index >= paint_limit )
             break;
+        if( r4_emitpf )
+            r4_emit_prefetch(frame, frame->painters_index);
         struct PaintersElementCommand* cmd =
             &frame->painters->commands[frame->painters_index++];
         int element_id = -1;

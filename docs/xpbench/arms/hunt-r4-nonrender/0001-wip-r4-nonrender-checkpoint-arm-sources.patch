diff --git a/src/hunt_r4.h b/src/hunt_r4.h
new file mode 100644
index 000000000..bcd422c50
--- /dev/null
+++ b/src/hunt_r4.h
@@ -0,0 +1,32 @@
+#ifndef HUNT_R4_H
+#define HUNT_R4_H
+
+/*
+ * R4 "nonrender" hunt knobs.
+ *
+ * One binary, several runtime arms. Every knob is read exactly once per
+ * process into a function-local static, so the steady-state cost of a knob is
+ * a load and a perfectly-predicted branch -- not a getenv on the frame path.
+ *
+ * Knobs are OFF by default, so the same binary with no environment set is the
+ * control arm.
+ */
+
+#include <stdlib.h>
+
+static inline int
+hunt_r4_read(const char* name)
+{
+    const char* v = getenv(name);
+    if( !v )
+        return 0;
+    return atoi(v);
+}
+
+/* Declare + initialise a cached knob in the enclosing scope. */
+#define HUNT_R4_KNOB(var, name)          \
+    static int var = -1;                 \
+    if( var < 0 )                        \
+        var = hunt_r4_read(name);
+
+#endif /* HUNT_R4_H */
diff --git a/src/makefile b/src/makefile
index ce14e6b3e..f9aa897f6 100644
--- a/src/makefile
+++ b/src/makefile
@@ -438,6 +438,28 @@ LDFLAGS += -Wl,--wrap=malloc -Wl,--wrap=calloc -Wl,--wrap=realloc \
 	-Wl,--wrap=free -Wl,--wrap=strdup
 endif
 
+# --- Per-frame heap/getenv call counting (HEAPCOUNT=1) --------------------
+# COUNT ONLY. Never time a binary built with this: every hooked call gains a
+# counter increment. It exists to answer "how many mallocs does a steady frame
+# make, and from where", which no profile in this hunt has measured.
+ifeq ($(HEAPCOUNT),1)
+ifeq ($(MEMPROF),1)
+$(error HEAPCOUNT=1 and MEMPROF=1 both define __wrap_malloc - pick one)
+endif
+ifeq ($(MEMTRACE),1)
+$(error HEAPCOUNT=1 and MEMTRACE=1 both define __wrap_malloc - pick one)
+endif
+HEAPCOUNT_CFLAGS := -DTORIRS_HEAPCOUNT=1 \
+	-fno-builtin-malloc -fno-builtin-calloc -fno-builtin-realloc -fno-builtin-free
+CFLAGS          += $(HEAPCOUNT_CFLAGS)
+RSCACHE_CFLAGS  += $(HEAPCOUNT_CFLAGS)
+RSPROT_CFLAGS   += $(HEAPCOUNT_CFLAGS)
+COMPRESS_CFLAGS += $(HEAPCOUNT_CFLAGS)
+TORIDRAW_CFLAGS += $(HEAPCOUNT_CFLAGS)
+LDFLAGS += -Wl,--wrap=malloc -Wl,--wrap=calloc -Wl,--wrap=realloc \
+	-Wl,--wrap=free -Wl,--wrap=strdup -Wl,--wrap=getenv
+endif
+
 # platform/platform_sdl2*.c is shared (emscripten ports SDL2); the IO, audio
 # and 3D-renderer backends are per-platform and come in via $(PLATFORM_SRCS).
 SRCS = main.c executor_config.c app.c $(PLATFORM_WINDOW_SRC) $(PLATFORM_CHROME_EXEC_SRC) \
@@ -605,6 +627,9 @@ endif
 ifeq ($(MEMPROF),1)
 SRCS += platform/torirs_memprof_win32.c
 endif
+ifeq ($(HEAPCOUNT),1)
+SRCS += platform/torirs_heapcount.c
+endif
 
 # Defined up here, above both the EMBED_SERVER block and the $(TARGET) rule.
 # $(TARGET): $(OBJS) expands its prerequisites when the makefile is *read*,

+ * whole cost of the pick. One pass over the pools now answers every hit in the
+ * frame.
+ */
 
 void
 ToriRS_PickHitsReset(struct ToriRS_PickHits* hits)
@@ -195,6 +147,28 @@ ToriRS_PickHitsClassify(
     if( !world )
         return;
 
+    /* Gather first, resolve once. A terrain hit carries its tile in the hit
+     * and never touches a pool, so a frame that only picks ground still walks
+     * nothing. */
+    struct World_PickResolve resolve[WORLD_PICK_RESOLVE_MAX];
+    short resolve_of_hit[TORIRS_PICK_HITS_MAX];
+    int resolve_count = 0;
+
+    for( int i = 0; i < hits->count; i++ )
+    {
+        resolve_of_hit[i] = -1;
+        if( hits->items[i].is_terrain )
+            continue;
+        if( hits->items[i].element_id < 0 )
+            continue;
+        if( resolve_count >= WORLD_PICK_RESOLVE_MAX )
+            break;
+        resolve[resolve_count].element_id = hits->items[i].element_id;
+        resolve_of_hit[i] = (short)resolve_count;
+        resolve_count++;
+    }
+    World_PickResolveBatch(world, resolve, resolve_count);
+
     for( int i = 0; i < hits->count; i++ )
     {
         struct ToriRS_PickHit const* hit = &hits->items[i];
@@ -242,13 +216,14 @@ ToriRS_PickHitsClassify(
         }

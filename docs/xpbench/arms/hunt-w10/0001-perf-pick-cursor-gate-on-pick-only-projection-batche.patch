 }
 
+void
+ToriDraw_ScenePickReject(
+    struct ToriDraw_Scene* scene,
+    int screen_x,
+    int screen_y)
+{
+    assert(scene);
+    scene->pick_reject_enabled = true;
+    scene->pick_reject_x = screen_x;
+    scene->pick_reject_y = screen_y;
+}
+
+void
+ToriDraw_ScenePickRejectClear(struct ToriDraw_Scene* scene)
+{
+    assert(scene);
+    scene->pick_reject_enabled = false;
+}

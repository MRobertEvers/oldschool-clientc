@@ -15840,7 +15840,12 @@ app_world_pick_finish(
         app->world_hover_tile_z = -1;
     }
 
-    if( getenv("TORIRS_WORLD_PICK_DEBUG") )
+    /* Cached: this runs every frame, and getenv walks the environment block.

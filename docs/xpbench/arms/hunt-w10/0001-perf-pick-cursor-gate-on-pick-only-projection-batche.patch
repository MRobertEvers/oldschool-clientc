+/*
+ * Open-addressed element_id -> batch slot, linear probing, sized so a full
+ * batch leaves it half empty. Small on purpose: at 512 slots the keys are 2 KB
+ * and stay in L1 across the pool walks, which is the entire point -- the walks
+ * already pay two cache lines a node and cannot afford to miss on the lookup
+ * as well.
+ */
+#define WORLD_PICK_INDEX_SLOTS (WORLD_PICK_RESOLVE_MAX * 2)
+#define WORLD_PICK_INDEX_EMPTY (-1)
+
+struct World_PickIndex
+{
+    int keys[WORLD_PICK_INDEX_SLOTS];
+    short items[WORLD_PICK_INDEX_SLOTS];
+};
+
+static inline int
+World_PickIndexHome(int element_id)
+{
+    /* Knuth multiplicative; the high bits are the mixed ones. Element ids are
+     * dense scene-element indices, so the low bits alone would collide in
+     * runs. */
+    unsigned int h = (unsigned int)element_id * 2654435761u;
+    return (int)((h >> 20) & (WORLD_PICK_INDEX_SLOTS - 1));
+}
+
+static struct World_PickResolve*
+World_PickIndexFind(
+    const struct World_PickIndex* index,
+    struct World_PickResolve* items,
+    int element_id)
+{
+    assert(index);
+    assert(items);
+
+    for( int slot = World_PickIndexHome(element_id);
+         index->keys[slot] != WORLD_PICK_INDEX_EMPTY;
+         slot = (slot + 1) & (WORLD_PICK_INDEX_SLOTS - 1) )
+    {
+        if( index->keys[slot] == element_id )
+            return &items[index->items[slot]];
+    }
+    return NULL;
+}
+
+void
+World_PickResolveBatch(
+    struct World* world,
+    struct World_PickResolve* items,
+    int count)
+{
+    struct World_PickIndex index;
+    struct World_EntityPool* pool;
+
+    assert(world);
+    assert(count >= 0);
+    assert(count <= WORLD_PICK_RESOLVE_MAX);
+
+    if( count == 0 )
+        return;
+    assert(items);
+
+    /* -1 in every byte is -1 in every int. */
+    memset(index.keys, 0xFF, sizeof(index.keys));
+
+    for( int i = 0; i < count; i++ )
+    {
+        /* A scene element id, so never negative -- and the empty marker is -1,
+         * so a negative key would read as an empty slot. */
+        assert(items[i].element_id >= 0);
+
+        items[i].owned = false;
+        items[i].resolved = false;
+
+        int slot = World_PickIndexHome(items[i].element_id);
+        while( index.keys[slot] != WORLD_PICK_INDEX_EMPTY &&
+               index.keys[slot] != items[i].element_id )
+            slot = (slot + 1) & (WORLD_PICK_INDEX_SLOTS - 1);
+        /* A repeated id keeps its first slot: the second hit on the same loc
+         * wants the same answer, and it is copied across at the end. */
+        if( index.keys[slot] == WORLD_PICK_INDEX_EMPTY )
+        {
+            index.keys[slot] = items[i].element_id;
+            index.items[slot] = (short)i;
+        }
+    }
+
+    pool = &world->entities.npc;
+    for( int i = World_EntityPoolHead(pool); i != WORLD_ENTITY_NIL;
+         i = World_EntityPoolNext(pool, i) )
+    {
+        struct WorldEntity_NPC* npc = World_EntityPoolGet(pool, i);
+        if( !npc )
+            continue;
+        struct World_PickResolve* item = World_PickIndexFind(&index, items, npc->element_id);
+        if( !item || item->owned )
+            continue;
+        item->owned = true;
+        item->resolved = true;
+        item->type = WORLD_PICK_NPC;
+        item->tile_x = npc->grid_position.x;
+        item->tile_z = npc->grid_position.z;
+        item->tile_level = npc->grid_position.level;
+    }
+
+    pool = &world->entities.player;
+    for( int i = World_EntityPoolHead(pool); i != WORLD_ENTITY_NIL;
+         i = World_EntityPoolNext(pool, i) )
+    {
+        struct WorldEntity_Player* player = World_EntityPoolGet(pool, i);
+        if( !player )
+            continue;
+        struct World_PickResolve* item = World_PickIndexFind(&index, items, player->element_id);
+        if( !item || item->owned )
+            continue;
+        item->owned = true;
+        item->resolved = true;
+        item->type = WORLD_PICK_PLAYER;
+        item->tile_x = player->grid_position.x;
+        item->tile_z = player->grid_position.z;
+        item->tile_level = player->grid_position.level;
+    }
+
+    pool = &world->entities.scenery;
+    for( int i = World_EntityPoolHead(pool); i != WORLD_ENTITY_NIL;
+         i = World_EntityPoolNext(pool, i) )
+    {
+        struct WorldEntity_Scenery* scenery = World_EntityPoolGet(pool, i);
+        if( !scenery )
+            continue;
+        struct World_PickResolve* item =
+            World_PickIndexFind(&index, items, scenery->element_id);
+        if( !item || item->owned )
+            continue;
+        /* Owned either way: the LocType.active gate makes a loc pick as
+         * nothing, it does not hand the id on to the obj stacks. See
+         * ToriRS_PickHitsClassify for why the gate is there. */
+        item->owned = true;
+        if( !scenery->interactive && !WorldEntity_SceneryPickInactive() )
+            continue;
+        item->resolved = true;
+        item->type = WORLD_PICK_SCENERY;
+        item->tile_x = scenery->grid_position.x;
+        item->tile_z = scenery->grid_position.z;
+        item->tile_level = scenery->grid_position.level;
+    }
+
+    pool = &world->entities.obj_stack;
+    for( int i = World_EntityPoolHead(pool); i != WORLD_ENTITY_NIL;
+         i = World_EntityPoolNext(pool, i) )
+    {
+        struct WorldEntity_ObjStack* stack = World_EntityPoolGet(pool, i);
+        if( !stack )
+            continue;
+        struct World_PickResolve* item = World_PickIndexFind(&index, items, stack->element_id);
+        if( !item || item->owned )
+            continue;
+        item->owned = true;
+        item->resolved = true;
+        item->type = WORLD_PICK_OBJSTACK;
+        item->tile_x = stack->grid_position.x;
+        item->tile_z = stack->grid_position.z;
+        item->tile_level = stack->grid_position.level;
+    }
+
+    /* Repeated ids share the one resolution their first slot collected. */
+    for( int i = 0; i < count; i++ )
+    {
+        struct World_PickResolve* first =
+            World_PickIndexFind(&index, items, items[i].element_id);
+        assert(first);
+        if( first != &items[i] )
+        {
+            items[i].owned = first->owned;
+            items[i].resolved = first->resolved;
+            items[i].type = first->type;
+            items[i].tile_x = first->tile_x;
+            items[i].tile_z = first->tile_z;
+            items[i].tile_level = first->tile_level;
+        }
+    }
+}

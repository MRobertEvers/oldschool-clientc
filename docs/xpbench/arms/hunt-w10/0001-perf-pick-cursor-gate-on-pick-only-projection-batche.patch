     struct ToriDraw_ModelHandle hnd,
diff --git a/3rd/toridraw/toridraw.h b/3rd/toridraw/toridraw.h
index 372d5679e..fe27bf7e7 100644
--- a/3rd/toridraw/toridraw.h
+++ b/3rd/toridraw/toridraw.h
@@ -113,6 +113,23 @@ ToriDraw_RenderZBuffered(
     toripixel_t* pixel_buffer,
     bool smooth);
 
+/** Arm the cursor gate for the models projected next: ToriDraw_Project answers
+ *  TORIDRAW_CULL_PICK_MISS, without projecting a single vertex, for any model
+ *  whose bounds cannot reach (screen_x, screen_y).
+ *
+ *  Only legitimate for PICK-ONLY geometry — a model whose projection nothing
+ *  but the pick walk will read. Anything that rasterizes must be projected
+ *  whether or not the cursor is over it. */
+void
+ToriDraw_ScenePickReject(
+    struct ToriDraw_Scene* scene,
+    int screen_x,
+    int screen_y);
+
+/** Disarm it. Must be paired with every ToriDraw_ScenePickReject. */
+void
+ToriDraw_ScenePickRejectClear(struct ToriDraw_Scene* scene);
+
 /** Bounding-box hit test against the last projected model (reference
  *  Model.useAABBMouseCheck). Cheaper and far more forgiving than the per-face
  *  test — the reference uses it for npcs, players and ground objs. */
diff --git a/3rd/toridraw/toridraw_render.u.c b/3rd/toridraw/toridraw_render.u.c
index e1fa5cda1..3a84fc79d 100644
--- a/3rd/toridraw/toridraw_render.u.c
+++ b/3rd/toridraw/toridraw_render.u.c
@@ -2661,6 +2661,119 @@ toridraw_project_vertices_parallel_noclip(
     }
 }
 
+/*
+ * Can the armed pick cursor be over this model at all?
+ *
+ * The only consumer of a pick-only model's projection is the pick walk, and
+ * that walk's own first act is ToriDraw_ProjectedModelContainsAabb against the
+ * 8-point box (toridraw_projected_model_hit_face). So the box below has one
+ * obligation and one only: CONTAIN THAT 8-POINT BOX. It does not have to bound
+ * the silhouette, and it deliberately does not try to -- a superset of the box
+ * the real gate uses is exactly as correct and far cheaper to build.
+ *
+ * The bound is a sphere, not the cylinder FastCull uses, because a sphere is
+ * the one shape that survives an unknown rotation. Every one of the eight box
+ * corners lies within sqrt(2*radius^2 + max|y|^2) of the model origin, and
+ * bc->min_z_depth_any_rotation is already >= sqrt(radius^2 + max|y|^2)
+ * (toridraw_model_transform.c), so sqrt(2) * that value bounds all eight. A
+ * rotation about the model origin -- model pitch/yaw/roll -- preserves that
+ * distance outright; a rotation about the CAMERA origin preserves it too,
+ * because it rotates the corner and the origin together and this is a
+ * difference of the two. Hence no trig here at all.
+ *
+ * Camera roll is the one rotation excluded, and not for the corners' sake:
+ * project_orthographic_fast never applied it to `center`, so under roll the
+ * centre this works from is not the centre the 8-point kernel projects around.
+ *
+ * Two slacks, and they are not interchangeable. The WORLD one has to be: the
+ * ball argument above is exact in real arithmetic, but both the corner and the
+ * centre arrive through truncating fixed-point rotations -- at most two shifts
+ * each, so under two units of camera-space error per axis apiece. Absorbing
+ * that in world space is the only spelling that stays sound at short range,
+ * because the divide magnifies it by 512/z: four units at z=200 is ten pixels,
+ * and a fixed pixel slack that covers it there is enormous at z=2000. Inflating
+ * the radius instead lets the same divide shrink the margin with distance.
+ * The SCREEN one is left over for the two truncations in project_divide itself,
+ * which happen after the divide and so really are a pixel or two flat.
+ */
+#define TORIDRAW_PICK_REJECT_WORLD_SLACK 8
+#define TORIDRAW_PICK_REJECT_SLACK 4
+/* sqrt(2) in 15.15, rounded UP: 46341/32768 = 1.4142151 > 1.4142136. */
+#define TORIDRAW_SQRT2_15 46341
+/* Above this the sqrt(2) multiply below leaves 32 bits. No real model is
+ * anywhere near it -- the world coordinate space is +/-32k -- so the test is a
+ * guard rail rather than a case. */
+#define TORIDRAW_PICK_REJECT_MAX_RADIUS 40000
+
+static inline bool
+toridraw_pick_cursor_misses_cylinder(
+    struct ToriDraw_Scene* scene,
+    struct ToriDraw_ViewPort* view_port,
+    struct ToriDraw_Camera* camera,
+    const struct ToriDraw_BoundsCylinder* bc,
+    const struct ProjectedVertex* center)
+{
+    assert(scene);
+    assert(view_port);
+    assert(camera);
+    assert(center);
+
+    if( !bc )
+        return false;
+    if( toridraw_proj_is_parallel(camera->proj_mode) )
+        return false;
+    if( ToriDraw_NormalizeAngle(camera->roll) != 0 )
+        return false;
+    if( bc->min_z_depth_any_rotation > TORIDRAW_PICK_REJECT_MAX_RADIUS )
+        return false;
+
+    int const corner_radius = ((bc->min_z_depth_any_rotation * TORIDRAW_SQRT2_15) >> 15) + 1 +
+                              TORIDRAW_PICK_REJECT_WORLD_SLACK;
+    int const z_near = center->z - corner_radius;
+    int const z_far = center->z + corner_radius;
+
+    /*
+     * Bail rather than clamp. A corner behind the near plane comes back from
+     * the clipping kernel as the -5000 sentinel with its y left undivided, and
+     * the 8-point sweep then reports a box no analytic bound describes. Above
+     * the plane there is no sentinel and the box is an honest projection.
+     */
+    if( camera->near_plane_z < 1 )
+        return false;
+    if( z_near <= camera->near_plane_z )
+        return false;
+
+    int const cot16 = toridraw_proj_cot16(
+        camera->proj_mode, camera->proj_scale, camera->fov_rpi2048);
+
+    /* p/z is increasing as z shrinks for p >= 0 and decreasing for p < 0, so
+     * each extreme picks the depth that pushes it further out. */
+    int const x_hi = center->x + corner_radius;
+    int const x_lo = center->x - corner_radius;
+    int const y_hi = center->y + corner_radius;
+    int const y_lo = center->y - corner_radius;
+
+    int const max_sx = project_divide(x_hi, x_hi >= 0 ? z_near : z_far, cot16) +
+                       view_port->x_center + TORIDRAW_PICK_REJECT_SLACK;
+    if( scene->pick_reject_x > max_sx )
+        return true;
+    int const min_sx = project_divide(x_lo, x_lo >= 0 ? z_far : z_near, cot16) +
+                       view_port->x_center - TORIDRAW_PICK_REJECT_SLACK;
+    if( scene->pick_reject_x < min_sx )
+        return true;
+
+    int const max_sy = project_divide(y_hi, y_hi >= 0 ? z_near : z_far, cot16) +
+                       view_port->y_center + TORIDRAW_PICK_REJECT_SLACK;
+    if( scene->pick_reject_y > max_sy )
+        return true;
+    int const min_sy = project_divide(y_lo, y_lo >= 0 ? z_far : z_near, cot16) +
+                       view_port->y_center - TORIDRAW_PICK_REJECT_SLACK;
+    if( scene->pick_reject_y < min_sy )
+        return true;
+
+    return false;
+}
+
 static inline int
 ToriDraw_Project(
     struct ToriDraw_Scene* scene,
@@ -2758,12 +2871,33 @@ ToriDraw_Project(
 
     scene->projected_vertex = center_projection;
 
+    /* Pick-only geometry, cursor demonstrably elsewhere: skip the 8-point box
+     * and the per-vertex projection both. Nothing downstream reads either --
+     * the caller returns without sorting or rastering, and the next model
+     * overwrites the scratch. */
+    if( scene->pick_reject_enabled &&
+        toridraw_pick_cursor_misses_cylinder(
+            scene, view_port, camera, model_bounds_cylinder(hnd), &center_projection) )
+        return TORIDRAW_CULL_PICK_MISS;
+
     ToriDraw_CalculateCylinderAabb8point(&scene->aabb, hnd, position, view_port, camera);
 
     cull = ToriDraw_AabbCull(&scene->aabb, view_port, camera);
     if( cull != TORIDRAW_CULL_VISIBLE )
         return cull;
 
+    /* Same question, now against the very box the pick walk itself gates on,
+     * so this arm of the test is not conservative -- it is the identical
+     * comparison (ToriDraw_ProjectedModelContainsAabb, spelled out because
+     * that one is defined further down this unit), moved ahead of the work its
+     * answer makes pointless. */
+    if( scene->pick_reject_enabled &&
+        (scene->pick_reject_x < scene->aabb.min_screen_x ||
+         scene->pick_reject_x > scene->aabb.max_screen_x ||
+         scene->pick_reject_y < scene->aabb.min_screen_y ||
+         scene->pick_reject_y > scene->aabb.max_screen_y) )
+        return TORIDRAW_CULL_PICK_MISS;
+
     int const model_pitch = ToriDraw_NormalizeAngle(position->pitch);
     int const model_yaw = ToriDraw_NormalizeAngle(position->yaw);
     int const model_roll = ToriDraw_NormalizeAngle(position->roll);
diff --git a/3rd/toridraw/toridraw_types.h b/3rd/toridraw/toridraw_types.h
index 375b5bbea..20d646f28 100644
--- a/3rd/toridraw/toridraw_types.h
+++ b/3rd/toridraw/toridraw_types.h
@@ -602,6 +602,22 @@ struct ToriDraw_Scene
     struct ToriDraw_AABB aabb;
     struct ToriDraw_AABB cylinder_fast_aabb;
 
+    /*
+     * Cursor gate for pick-only models -- geometry emitted purely so a tile
+     * stays clickable under a hidden roof, which never reaches the raster.
+     *
+     * Set by the executor for exactly those commands (ToriDraw_ScenePickReject
+     * / ...Clear). ToriDraw_Project then answers "can this model possibly
+     * contain the cursor" from the two bounding boxes it already builds, and
+     * returns TORIDRAW_CULL_PICK_MISS instead of projecting every vertex --
+     * which is what the pick walk would have thrown away one AABB test later.
+     * Exactly one of the several hundred such tiles in a frame can hold the
+     * cursor.
+     */
+    bool pick_reject_enabled;
+    int pick_reject_x;
+    int pick_reject_y;
+
     /*
      * Whether the model ToriDraw_Project last projected could reach behind the
      * near plane, and so whether screen_vertices_x may hold
@@ -735,6 +751,10 @@ struct ToriDraw_Scene
 #define TORIDRAW_CULL_FAST 1
 #define TORIDRAW_CULL_AABB 2
 #define TORIDRAW_CULL_ERROR 3
+/* Not a visibility verdict: the model is on screen, but the pick cursor the
+ * caller armed cannot be over it, so its per-vertex projection was skipped.
+ * Only ever returned when scene->pick_reject_enabled. */
+#define TORIDRAW_CULL_PICK_MISS 4
 
 static inline int*
 ToriDraw_FaceOrder(struct ToriDraw_Scene* scene)

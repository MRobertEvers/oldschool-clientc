+/**
+ * One element id on the way in, what the entity pools say it is on the way out.
+ * `owned` and `resolved` are separate answers: a loc the LocType.active gate
+ * refuses is owned by the scenery pool and picks as nothing, which is not the
+ * same as an id no pool claims.
+ */
+struct World_PickResolve
+{
+    int element_id; /* in */
+
+    bool owned;    /* out: some pool holds this id */
+    bool resolved; /* out: ...and it may be picked, so type/tile are set */
+    enum World_PickType type;
+    int tile_x;
+    int tile_z;
+    int tile_level;
+};
+
+/** Upper bound on one World_PickResolveBatch call; the index it builds is
+ *  sized to stay half empty at this many keys. */
+#define WORLD_PICK_RESOLVE_MAX 256
+
+/**
+ * Resolve a whole batch of element ids in ONE pass over the entity pools.
+ *
+ * The four World_*GetByElementId walks this replaces are each a traversal of an
+ * intrusive live list -- two cache lines per node, since nodes[] and items[]
+ * are separate arrays -- and the pick classifier ran up to four of them PER
+ * HIT. At a few thousand live locs that is the whole cost of the pick, and
+ * none of it is the hit tests.
+ *
+ * Priority is preserved because the pools are walked in the classifier's own
+ * short-circuit order -- npc, player, scenery, objstack -- and an id already
+ * claimed is never overwritten.
+ */
+void
+World_PickResolveBatch(
+    struct World* world,
+    struct World_PickResolve* items,
+    int count);

+    static int pick_debug = -1;
+    if( pick_debug < 0 )
+        pick_debug = getenv("TORIRS_WORLD_PICK_DEBUG") != NULL;
+    if( pick_debug )
     {
         fprintf(
             stderr,
diff --git a/src/platform/platform_sdl2_renderer_soft3d.c b/src/platform/platform_sdl2_renderer_soft3d.c
index de701e34e..d85dd8f2a 100644
--- a/src/platform/platform_sdl2_renderer_soft3d.c
+++ b/src/platform/platform_sdl2_renderer_soft3d.c
@@ -940,12 +940,31 @@ soft3d_draw_model(
                  cmd->model.u.model.model &&
                  cmd->model.u.model.model->vertex_count >= trace_min;
 
+    /*
+     * A pick-only command is ground kept clickable under a hidden roof: it
+     * never rasterizes, so its ENTIRE cost is the one hittest below, and only
+     * the model actually under the cursor can answer yes. Hand the cursor to
+     * the projection so it can refuse the per-vertex work for the several
+     * hundred tiles that cannot -- the same AABB question the hittest asks,
+     * asked before the work rather than after it.
+     *
+     * `pickable` and a live element id gate it because the hittest does: a
+     * pick-only command failing either produces nothing at all, and the whole
+     * projection is then dead either way.
+     */
+    bool const pick_gate = cmd->pick_only && soft->pick_enabled && cmd->pickable &&
+                           cmd->element_id >= 0;
+    if( pick_gate )
+        ToriDraw_ScenePickReject(soft->scene, soft->pick_mouse_x, soft->pick_mouse_y);
+
     position = cmd->position;
     TORIRS_PERF_SCOPE(TORIRS_PERF_STAGE_R_PROJECT)
     {
         cull = ToriDraw_RenderModel1Project(
             cmd->model, soft->scene, &position, &soft->view_port_3d, &soft->camera_3d);
     }
+    if( pick_gate )
+        ToriDraw_ScenePickRejectClear(soft->scene);
     if( trace_this && cull != g_draw_trace_last_cull )
     {
         struct ToriDraw_Model const* m = cmd->model.u.model.model;
diff --git a/src/render/test/pick_level_test.c b/src/render/test/pick_level_test.c
index a678cf24d..6bae0530b 100644
--- a/src/render/test/pick_level_test.c
+++ b/src/render/test/pick_level_test.c
@@ -215,6 +215,68 @@ main(void)
         CHECK(pickset.count == 1, "and is clickable once you are standing up there");
     }
 
+    printf("TEST: a frame's worth of hits resolved in one pass\n");
+    {
+        /* The classifier resolves element ids in a BATCH now -- one walk of the
+         * entity pools for every hit in the frame, not four walks per hit -- so
+         * the shapes a per-hit lookup could not get wrong are exactly the ones
+         * worth pinning: several hits at once, the same id twice, and an id no
+         * pool owns sitting between two that are. */
+        struct ToriRS_PickHits hits;
+        struct World_PickSet pickset;
+        struct ToriRS_PickResult result;
+
+        ToriRS_PickHitsReset(&hits);
+        ToriRS_PickHitsAdd(&hits, 71, /* is_terrain */ false, -1, -1, -1);
+        ToriRS_PickHitsAdd(&hits, 70, /* is_terrain */ false, -1, -1, -1);   /* inactive */
+        ToriRS_PickHitsAdd(&hits, 4242, /* is_terrain */ false, -1, -1, -1); /* nobody's */
+        ToriRS_PickHitsAdd(&hits, 71, /* is_terrain */ false, -1, -1, -1);   /* repeat */
+        ToriRS_PickHitsAdd(&hits, flat_x, /* is_terrain */ true, flat_x, flat_z, 0);
+        ToriRS_PickHitsClassify(world, &hits, /* player_level */ 0, &pickset, &result);
+
+        /* Two, not three: World_PickSetAdd folds the repeated barrier, which is
+         * the point -- the repeat must resolve to the SAME loc and be dropped
+         * as a duplicate, not resolve to nothing and vanish for the wrong
+         * reason. */
+        CHECK(pickset.count == 2, "five hits, two distinct targets");
+        CHECK(pickset.items[0].element_id == 71 && pickset.items[0].type == WORLD_PICK_SCENERY,
+              "the barrier resolves out of a mixed batch");
+        CHECK(pickset.items[0].tile_x == bridge_x && pickset.items[0].tile_z == bridge_z,
+              "and carries its own tile, not a neighbour's");
+        CHECK(pickset.items[1].element_id == flat_x &&
+                  pickset.items[1].type == WORLD_PICK_TERRAIN,
+              "render order survives the batch");
+        CHECK(result.hover_tile_valid && result.hover_tile_x == flat_x,
+              "the terrain hit still sets the hover tile");
+
+        /* The inactive wall and the unowned id are both absent, and for
+         * different reasons -- owned-but-refused versus never claimed. */
+        for( int i = 0; i < pickset.count; i++ )
+        {
+            CHECK(pickset.items[i].element_id != 70, "the inactive wall stays out");
+            CHECK(pickset.items[i].element_id != 4242, "and so does an id no pool owns");
+        }
+    }
+
+    printf("TEST: a saturated hit list\n");
+    {
+        /* A full frame must reach the resolver intact: TORIRS_PICK_HITS_MAX and
+         * WORLD_PICK_RESOLVE_MAX are equal today, so this is exactly the
+         * boundary where an off-by-one would either assert or truncate. */
+        struct ToriRS_PickHits hits;
+        struct World_PickSet pickset;
+        struct ToriRS_PickResult result;
+
+        ToriRS_PickHitsReset(&hits);
+        for( int i = 0; i < TORIRS_PICK_HITS_MAX; i++ )
+            ToriRS_PickHitsAdd(&hits, (i & 1) ? 4242 : 71, /* is_terrain */ false, -1, -1, -1);
+        CHECK(hits.count == TORIRS_PICK_HITS_MAX, "the hit list filled");
+
+        ToriRS_PickHitsClassify(world, &hits, /* player_level */ 0, &pickset, &result);
+        CHECK(pickset.count == 1 && pickset.items[0].element_id == 71,
+              "a saturated frame still finds the one real target");
+    }
+
     World_Free(world);
 
     if( g_failures )

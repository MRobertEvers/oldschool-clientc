+/* #region agent log */
+#ifdef HUNTABL_NOTEX
+/* XP frame-hunt ABLATION LADDER. Not shippable: the frame is wrong on purpose.
+ *
+ * HUNTABL_NOTEX_LEVEL is read once and selects how much of the TEXTURED draw is
+ * thrown away at the raster dispatch. Everything upstream -- projection, the
+ * back-face cull, the depth bucket sort, the painter -- is untouched at every
+ * level, so a delta is draw work and only draw work.
+ *
+ *   0  nothing skipped. The same binary acting as its own control, so the cost
+ *      of the switch itself is measured instead of assumed.
+ *   1  skip ToriDraw_TriangleFaceTextureBlendOpaque, the sole caller of
+ *      toridraw_textri_opaque_lerp8_v3_asm (EIP-credited 16.27 ms, 25.2%).
+ *   2  level 1 plus the transparent and affine textured draws, gouraud- and
+ *      flat-shaded: every textured pixel in the frame.
+ *   3  level 2 plus the texture-map lookup and the PNM coord resolution -- the
+ *      whole textured face, dropped on entry to ToriDraw_RasterModelFace.
+ *
+ * The level is a RUNTIME read on purpose. A compile-time #if would let gcc
+ * delete the inlined kernel bodies and re-lay-out the dispatch function, and
+ * the resulting code-size / I-cache win would be banked as part of the bound.
+ */
+static int g_huntabl_notex_level = -1;
+
+static inline int
+huntabl_notex_level(void)
+{
+    if( g_huntabl_notex_level < 0 )
+    {
+        const char* raw = getenv("HUNTABL_NOTEX_LEVEL");
+        g_huntabl_notex_level = raw ? atoi(raw) : 0;
+    }
+    return g_huntabl_notex_level;
+}
+#endif
+/* #endregion */
+
 enum DashModelRasterFlags
 {
     RASTER_FLAG_GOURAUD_SMOOTH = 1 << 0,

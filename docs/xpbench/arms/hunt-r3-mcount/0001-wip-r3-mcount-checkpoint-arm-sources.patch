diff --git a/3rd/toridraw/graphics/raster/model_census.c b/3rd/toridraw/graphics/raster/model_census.c
new file mode 100644
index 000000000..98f594b44
--- /dev/null
+++ b/3rd/toridraw/graphics/raster/model_census.c
@@ -0,0 +1,247 @@
+#include "model_census.h"
+
+#if defined(TORIDRAW_MODEL_CENSUS) && TORIDRAW_MODEL_CENSUS
+
+#include <assert.h>
+#include <string.h>
+
+struct ToriDraw_ModelCensus g_toridraw_model_census;
+
+void
+toridraw_model_census_register(void)
+{
+    if( g_toridraw_model_census.registered )
+        return;
+    g_toridraw_model_census.registered = 1;
+    atexit(ToriDraw_ModelCensusDump);
+}
+
+double
+toridraw_model_census_clipped_area(
+    double x0, double y0, double x1, double y1, double x2, double y2,
+    double w, double h)
+{
+    /* Sutherland-Hodgman against four half planes; a triangle clipped by four
+     * lines has at most 7 vertices. */
+    double px[16];
+    double py[16];
+    double qx[16];
+    double qy[16];
+    int n = 3;
+    int edge;
+    double area;
+
+    px[0] = x0;
+    py[0] = y0;
+    px[1] = x1;
+    py[1] = y1;
+    px[2] = x2;
+    py[2] = y2;
+
+    for( edge = 0; edge < 4; edge++ )
+    {
+        int m = 0;
+        int i;
+        for( i = 0; i < n; i++ )
+        {
+            double ax = px[i];
+            double ay = py[i];
+            double bx = px[(i + 1) % n];
+            double by = py[(i + 1) % n];
+            double da;
+            double db;
+
+            switch( edge )
+            {
+            case 0:
+                da = ax;
+                db = bx;
+                break; /* x >= 0 */
+            case 1:
+                da = w - ax;
+                db = w - bx;
+                break; /* x <= w */
+            case 2:
+                da = ay;
+                db = by;
+                break; /* y >= 0 */
+            default:
+                da = h - ay;
+                db = h - by;
+                break; /* y <= h */
+            }
+
+            if( da >= 0.0 )
+            {
+                qx[m] = ax;
+                qy[m] = ay;
+                m++;
+            }
+            if( (da >= 0.0) != (db >= 0.0) )
+            {
+                double t = da / (da - db);
+                qx[m] = ax + t * (bx - ax);
+                qy[m] = ay + t * (by - ay);
+                m++;
+            }
+        }
+        n = m;
+        if( n == 0 )
+            return 0.0;
+        assert(n <= 16);
+        memcpy(px, qx, (size_t)n * sizeof(double));
+        memcpy(py, qy, (size_t)n * sizeof(double));
+    }
+
+    area = 0.0;
+    {
+        int i;
+        for( i = 0; i < n; i++ )
+        {
+            int j = (i + 1) % n;
+            area += px[i] * py[j] - px[j] * py[i];
+        }
+    }
+    if( area < 0.0 )
+        area = -area;
+    return area * 0.5;
+}
+
+static void
+dump_table(
+    FILE* f,
+    char const* title,
+    double const* models,
+    double const* faces,
+    double const* vertices,
+    double const* covered,
+    double frames)
+{
+    int i;
+    double tm = 0.0;
+    double tf = 0.0;
+    double tv = 0.0;
+    double tc = 0.0;
+    double cm = 0.0;
+    double cf = 0.0;
+    double cv = 0.0;
+    double cc = 0.0;
+
+    for( i = 0; i < TORIDRAW_MODEL_CENSUS_BUCKETS; i++ )
+    {
+        tm += models[i];
+        tf += faces[i];
+        tv += vertices[i];
+        tc += covered[i];
+    }
+    if( tm <= 0.0 )
+        return;
+
+    fprintf(f, "\n%s\n", title);
+    fprintf(
+        f,
+        "  %-14s %10s %7s %10s %7s %12s %7s %12s\n",
+        "area <",
+        "models/f",
+        "cum%",
+        "faces/f",
+        "cum%",
+        "verts/f",
+        "cum%",
+        "px/f cum%");
+    for( i = 0; i < TORIDRAW_MODEL_CENSUS_BUCKETS; i++ )
+    {
+        char label[32];
+        if( i == 0 )
+            snprintf(label, sizeof(label), "0");
+        else
+            snprintf(label, sizeof(label), "%.0f", (double)(1u << (i - 1)) * 2.0);
+        cm += models[i];
+        cf += faces[i];
+        cv += vertices[i];
+        cc += covered[i];
+        if( models[i] <= 0.0 )
+            continue;
+        fprintf(
+            f,
+            "  %-14s %10.1f %6.2f%% %10.1f %6.2f%% %12.1f %6.2f%% %11.3f%%\n",
+            label,
+            models[i] / frames,
+            100.0 * cm / tm,
+            faces[i] / frames,
+            100.0 * cf / tf,
+            vertices[i] / frames,
+            100.0 * cv / tv,
+            100.0 * cc / tc);
+    }
+    fprintf(
+        f,
+        "  TOTAL          %10.1f          %10.1f          %12.1f     %11.1f px/f\n",
+        tm / frames,
+        tf / frames,
+        tv / frames,
+        tc / frames);
+}
+
+void
+ToriDraw_ModelCensusDump(void)
+{
+    struct ToriDraw_ModelCensus* c = &g_toridraw_model_census;
+    FILE* f = stderr;
+    char const* path = getenv("TORIDRAW_MODEL_CENSUS_FILE");
+    double frames = c->frames > 0.0 ? c->frames : 1.0;
+
+    if( path && *path )
+    {
+        FILE* out = fopen(path, "w");
+        if( out )
+            f = out;
+    }
+
+    fprintf(f, "=== TORIDRAW MODEL CENSUS (%.0f frames) ===\n", frames);
+    fprintf(f, "per frame:\n");
+    fprintf(f, "  ToriDraw_Project calls        %10.1f\n", c->project_calls / frames);
+    fprintf(f, "    cull: scratch capacity      %10.1f\n", c->cull_capacity / frames);
+    fprintf(f, "    cull: fast near plane       %10.1f\n", c->cull_fast_near / frames);
+    fprintf(f, "    cull: fast far plane        %10.1f\n", c->cull_fast_far / frames);
+    fprintf(f, "    cull: fast x extent         %10.1f\n", c->cull_fast_x / frames);
+    fprintf(f, "    cull: fast y extent         %10.1f\n", c->cull_fast_y / frames);
+    fprintf(f, "    cull: fast error            %10.1f\n", c->cull_fast_error / frames);
+    fprintf(f, "  Aabb8point calls              %10.1f\n", c->aabb8_calls / frames);
+    fprintf(f, "    cull: 8-point AABB          %10.1f\n", c->cull_aabb8 / frames);
+    fprintf(f, "  projected VISIBLE             %10.1f\n", c->project_visible / frames);
+    fprintf(f, "  raster dispatches             %10.1f\n", c->raster_calls / frames);
+    fprintf(f, "    with zero ordered faces     %10.1f\n", c->raster_zero_faces / frames);
+    fprintf(f, "  PICK-ONLY commands            %10.1f\n", c->pickonly_models / frames);
+    fprintf(f, "    their vertices projected    %10.1f\n", c->pickonly_verts / frames);
+    fprintf(f, "    their model faces           %10.1f\n", c->pickonly_faces / frames);
+    fprintf(f, "  vertex-box wholly offscreen   %10.1f models\n",
+            c->vertbox_outside_models / frames);
+    fprintf(f, "    their ordered faces         %10.1f\n", c->vertbox_outside_faces / frames);
+    fprintf(f, "    their vertices              %10.1f\n", c->vertbox_outside_verts / frames);
+    fprintf(f, "  ordered-face box offscreen    %10.1f models\n",
+            c->orderbox_outside_models / frames);
+    fprintf(f, "    their ordered faces         %10.1f\n", c->orderbox_outside_faces / frames);
+    fprintf(f, "  ordered faces                 %10.1f\n", c->ordered_faces / frames);
+    fprintf(f, "    degenerate (zero raw area)  %10.1f  (%.2f%%)\n",
+            c->ordered_faces_degenerate / frames,
+            100.0 * c->ordered_faces_degenerate / (c->ordered_faces > 0 ? c->ordered_faces : 1.0));
+    fprintf(f, "    clipped away entirely       %10.1f  (%.2f%%)\n",
+            c->ordered_faces_offscreen / frames,
+            100.0 * c->ordered_faces_offscreen / (c->ordered_faces > 0 ? c->ordered_faces : 1.0));
+
+    dump_table(
+        f,
+        "BY EXACT COVERED SCREEN AREA (viewport-clipped triangle area, sum over dispatched faces)",
+        c->models, c->faces, c->vertices, c->covered, frames);
+    dump_table(
+        f,
+        "BY SCREEN-AABB AREA (what a size threshold can actually test)",
+        c->abmodels, c->abfaces, c->abvertices, c->abcovered, frames);
+
+    fflush(f);
+    if( f != stderr )
+        fclose(f);
+}
+
+#endif
diff --git a/3rd/toridraw/graphics/raster/model_census.h b/3rd/toridraw/graphics/raster/model_census.h
new file mode 100644
index 000000000..1bd26add8
--- /dev/null
+++ b/3rd/toridraw/graphics/raster/model_census.h
@@ -0,0 +1,129 @@
+#ifndef TORIDRAW_RASTER_MODEL_CENSUS_H
+#define TORIDRAW_RASTER_MODEL_CENSUS_H
+
+/**
+ * Where do the 1,326 drawn models per frame go, and how big are they?
+ *
+ * Every model pays a fixed toll -- a fast cull, an eight-point screen AABB, a
+ * full vertex projection, a bucket sort and a raster dispatch -- before a
+ * single pixel is decided. If most of those models cover a handful of pixels
+ * the toll is the frame, not the fill. This counts, per frame:
+ *
+ *   - the cull funnel, split by which test rejected the model, so the work
+ *     performed BEFORE the earliest possible reject is visible;
+ *   - for every model that reaches the rasterizer, the EXACT viewport-clipped
+ *     screen area of the triangles it actually dispatches (Sutherland-Hodgman
+ *     against the four viewport edges, then shoelace), bucketed by size;
+ *   - alongside it the model's screen-AABB area, because a size threshold can
+ *     only test the AABB -- the covered area is what the threshold would cost.
+ *
+ * Compile-time gated, dumped at exit. A census build is never timed, so the
+ * clipper here is written for clarity, not speed.
+ */
+
+#if defined(TORIDRAW_MODEL_CENSUS) && TORIDRAW_MODEL_CENSUS
+
+#include <stdio.h>
+#include <stdlib.h>
+
+enum
+{
+    /* bucket i holds area in [2^(i-1), 2^i); bucket 0 is exactly zero. */
+    TORIDRAW_MODEL_CENSUS_BUCKETS = 22
+};
+
+struct ToriDraw_ModelCensus
+{
+    double project_calls;
+    double cull_capacity;
+    double cull_fast_near;
+    double cull_fast_far;
+    double cull_fast_x;
+    double cull_fast_y;
+    double cull_fast_error;
+    double aabb8_calls;
+    double cull_aabb8;
+    double project_visible;
+
+    double raster_calls;
+    double raster_zero_faces;
+    /* Models whose TRUE projected-vertex screen AABB is wholly outside the
+     * viewport -- i.e. the 8-point cylinder box passed, but nothing the model
+     * actually contains can reach a pixel. Exact and conservative: no triangle
+     * can cross an edge that all three of its vertices are on the far side of. */
+    double vertbox_outside_models;
+    double vertbox_outside_faces;
+    double vertbox_outside_verts;
+    /* Same test applied only to the ORDERED (front-facing, sorted) faces. */
+    double orderbox_outside_models;
+    double orderbox_outside_faces;
+    /* Ordered faces by why they cover nothing. */
+    double ordered_faces;
+    double ordered_faces_degenerate;   /* zero area before clipping */
+    double ordered_faces_offscreen;    /* nonzero area, clipped to nothing */
+    /* Pick-only commands: full projection, never rasterized. */
+    double pickonly_models;
+    double pickonly_verts;
+    double pickonly_faces;
+
+    /* Indexed by covered-area bucket. */
+    double models[TORIDRAW_MODEL_CENSUS_BUCKETS];
+    double faces[TORIDRAW_MODEL_CENSUS_BUCKETS];
+    double vertices[TORIDRAW_MODEL_CENSUS_BUCKETS];
+    double covered[TORIDRAW_MODEL_CENSUS_BUCKETS];
+    double aabb_area[TORIDRAW_MODEL_CENSUS_BUCKETS];
+
+    /* Indexed by screen-AABB-area bucket: what a real threshold would test. */
+    double abmodels[TORIDRAW_MODEL_CENSUS_BUCKETS];
+    double abfaces[TORIDRAW_MODEL_CENSUS_BUCKETS];
+    double abvertices[TORIDRAW_MODEL_CENSUS_BUCKETS];
+    double abcovered[TORIDRAW_MODEL_CENSUS_BUCKETS];
+
+    double frames;
+    int registered;
+};
+
+extern struct ToriDraw_ModelCensus g_toridraw_model_census;
+
+void
+ToriDraw_ModelCensusDump(void);
+
+void
+toridraw_model_census_register(void);
+
+static inline int
+toridraw_model_census_bucket(double area)
+{
+    int b = 1;
+    double edge = 1.0;
+    if( area <= 0.0 )
+        return 0;
+    while( b < TORIDRAW_MODEL_CENSUS_BUCKETS - 1 && area >= edge * 2.0 )
+    {
+        b++;
+        edge *= 2.0;
+    }
+    return b;
+}
+
+/** Area of the triangle clipped to [0,w) x [0,h), exact, no 64-bit math kept
+ *  live -- doubles, because this is a census. */
+double
+toridraw_model_census_clipped_area(
+    double x0, double y0, double x1, double y1, double x2, double y2,
+    double w, double h);
+
+#define TORIDRAW_MODEL_CENSUS_COUNT(field)                                                \
+    do                                                                                    \
+    {                                                                                     \
+        toridraw_model_census_register();                                                 \
+        g_toridraw_model_census.field += 1.0;                                             \
+    } while( 0 )
+
+#else
+
+#define TORIDRAW_MODEL_CENSUS_COUNT(field) ((void)0)
+
+#endif
+
+#endif
diff --git a/3rd/toridraw/toridraw_raster.u.c b/3rd/toridraw/toridraw_raster.u.c
index 43197f782..2f18c85b6 100644
--- a/3rd/toridraw/toridraw_raster.u.c
+++ b/3rd/toridraw/toridraw_raster.u.c
@@ -6,6 +6,7 @@
 #include "toridraw_model_internal.h"
 #include "toridraw_types.h"
 #include "graphics/winding.h"
+#include "graphics/raster/model_census.h"
 
 #include <assert.h>
 #include <stdbool.h>
@@ -1372,6 +1373,159 @@ ToriDraw_RasterWithFaceIndices(
         }
     }
 
+#if defined(TORIDRAW_MODEL_CENSUS) && TORIDRAW_MODEL_CENSUS
+    {
+        struct ToriDraw_ModelCensus* mc = &g_toridraw_model_census;
+        double covered = 0.0;
+        double aabb_w;
+        double aabb_h;
+        double aabb;
+        int b;
+        int ab;
+        int lo;
+        int hi;
+
+        toridraw_model_census_register();
+        mc->raster_calls += 1.0;
+        if( scene->tmp_face_order_count <= 0 )
+            mc->raster_zero_faces += 1.0;
+
+        int vminx = 1 << 28;
+        int vmaxx = -(1 << 28);
+        int vminy = 1 << 28;
+        int vmaxy = -(1 << 28);
+        int ominx = 1 << 28;
+        int omaxx = -(1 << 28);
+        int ominy = 1 << 28;
+        int omaxy = -(1 << 28);
+        int nc = 0;
+
+        for( int v = 0; v < ctx.num_vertices; v++ )
+        {
+            int vx;
+            int vy;
+            if( ctx.near_clipped && ctx.vertex_x[v] == TORIDRAW_SCREEN_X_NEAR_CLIPPED )
+            {
+                nc = 1;
+                continue;
+            }
+            vx = ctx.vertex_x[v] + ctx.offset_x;
+            vy = ctx.vertex_y[v] + ctx.offset_y;
+            if( vx < vminx )
+                vminx = vx;
+            if( vx > vmaxx )
+                vmaxx = vx;
+            if( vy < vminy )
+                vminy = vy;
+            if( vy > vmaxy )
+                vmaxy = vy;
+        }
+
+        for( int i = 0; i < scene->tmp_face_order_count; i++ )
+        {
+            int face = scene->tmp_face_order[i];
+            int a = ctx.face_indices_a[face];
+            int bb = ctx.face_indices_b[face];
+            int cc = ctx.face_indices_c[face];
+            double raw;
+            double ax;
+            double ay;
+            double bx;
+            double by;
+            double cx2;
+            double cy2;
+            mc->ordered_faces += 1.0;
+            if( ctx.near_clipped &&
+                (ctx.vertex_x[a] == TORIDRAW_SCREEN_X_NEAR_CLIPPED ||
+                 ctx.vertex_x[bb] == TORIDRAW_SCREEN_X_NEAR_CLIPPED ||
+                 ctx.vertex_x[cc] == TORIDRAW_SCREEN_X_NEAR_CLIPPED) )
+                continue;
+            ax = (double)(ctx.vertex_x[a] + ctx.offset_x);
+            ay = (double)(ctx.vertex_y[a] + ctx.offset_y);
+            bx = (double)(ctx.vertex_x[bb] + ctx.offset_x);
+            by = (double)(ctx.vertex_y[bb] + ctx.offset_y);
+            cx2 = (double)(ctx.vertex_x[cc] + ctx.offset_x);
+            cy2 = (double)(ctx.vertex_y[cc] + ctx.offset_y);
+            {
+                int lo;
+                lo = (int)ax;
+                if( lo < ominx ) ominx = lo;
+                if( lo > omaxx ) omaxx = lo;
+                lo = (int)bx;
+                if( lo < ominx ) ominx = lo;
+                if( lo > omaxx ) omaxx = lo;
+                lo = (int)cx2;
+                if( lo < ominx ) ominx = lo;
+                if( lo > omaxx ) omaxx = lo;
+                lo = (int)ay;
+                if( lo < ominy ) ominy = lo;
+                if( lo > omaxy ) omaxy = lo;
+                lo = (int)by;
+                if( lo < ominy ) ominy = lo;
+                if( lo > omaxy ) omaxy = lo;
+                lo = (int)cy2;
+                if( lo < ominy ) ominy = lo;
+                if( lo > omaxy ) omaxy = lo;
+            }
+            raw = (bx - ax) * (cy2 - ay) - (cx2 - ax) * (by - ay);
+            if( raw < 0.0 )
+                raw = -raw;
+            {
+                double clipped = toridraw_model_census_clipped_area(
+                    ax, ay, bx, by, cx2, cy2,
+                    (double)ctx.screen_width, (double)ctx.screen_height);
+                covered += clipped;
+                if( clipped <= 0.0 )
+                {
+                    if( raw <= 0.0 )
+                        mc->ordered_faces_degenerate += 1.0;
+                    else
+                        mc->ordered_faces_offscreen += 1.0;
+                }
+            }
+        }
+
+        if( !nc && vmaxx >= vminx &&
+            (vmaxx < 0 || vminx >= ctx.screen_width || vmaxy < 0 ||
+             vminy >= ctx.screen_height) )
+        {
+            mc->vertbox_outside_models += 1.0;
+            mc->vertbox_outside_faces += (double)scene->tmp_face_order_count;
+            mc->vertbox_outside_verts += (double)ctx.num_vertices;
+        }
+        if( !nc && scene->tmp_face_order_count > 0 && omaxx >= ominx &&
+            (omaxx < 0 || ominx >= ctx.screen_width || omaxy < 0 ||
+             ominy >= ctx.screen_height) )
+        {
+            mc->orderbox_outside_models += 1.0;
+            mc->orderbox_outside_faces += (double)scene->tmp_face_order_count;
+        }
+
+        lo = scene->aabb.min_screen_x < 0 ? 0 : scene->aabb.min_screen_x;
+        hi = scene->aabb.max_screen_x > view_port->width ? view_port->width
+                                                         : scene->aabb.max_screen_x;
+        aabb_w = hi > lo ? (double)(hi - lo) : 0.0;
+        lo = scene->aabb.min_screen_y < 0 ? 0 : scene->aabb.min_screen_y;
+        hi = scene->aabb.max_screen_y > view_port->height ? view_port->height
+                                                          : scene->aabb.max_screen_y;
+        aabb_h = hi > lo ? (double)(hi - lo) : 0.0;
+        aabb = aabb_w * aabb_h;
+
+        b = toridraw_model_census_bucket(covered);
+        mc->models[b] += 1.0;
+        mc->faces[b] += (double)scene->tmp_face_order_count;
+        mc->vertices[b] += (double)ctx.num_vertices;
+        mc->covered[b] += covered;
+        mc->aabb_area[b] += aabb;
+
+        ab = toridraw_model_census_bucket(aabb);
+        mc->abmodels[ab] += 1.0;
+        mc->abfaces[ab] += (double)scene->tmp_face_order_count;
+        mc->abvertices[ab] += (double)ctx.num_vertices;
+        mc->abcovered[ab] += covered;
+    }
+#endif
+
     if( ctx.raster_debug )
         toridraw_raster_debug_print(ctx.raster_debug, &ctx, (void*)model_as_full(hnd));
 }
diff --git a/3rd/toridraw/toridraw_render.u.c b/3rd/toridraw/toridraw_render.u.c

+/*
+ * r3-mcount route: switches over the per-model setup cost. Read once, from the
+ * environment, so one binary carries the whole ladder.
+ *
+ *   TORIRS_MC_OFFBOX=1     after projection, before the face sort, reject a
+ *                          model whose projected vertices all lie beyond one
+ *                          viewport edge. Provably zero-coverage: a triangle is
+ *                          the convex hull of its three vertices, so if every
+ *                          vertex has x >= width no point of any face has
+ *                          x < width. Rendering is unchanged.
+ *   TORIRS_MC_VAABB=1      stop building the 8-point cylinder AABB and use the
+ *                          projected-vertex box in its place. That box is only
+ *                          ever read by the model AABB cull -- which OFFBOX
+ *                          then subsumes, more tightly -- and by the coarse
+ *                          pick bound. CHANGES THE PICK BOUND (it becomes the
+ *                          exact projected extent instead of the projected
+ *                          cylinder); rendering is unchanged. Needs OFFBOX.
+ *   TORIRS_MC_TINY=<area>  OUTPUT-CHANGING. Skip a model whose viewport-clipped
+ *                          projected-vertex box covers fewer than <area>
+ *                          pixels. 0 disables.
+ */
+static int g_mc_offbox = -1;
+static int g_mc_vaabb = 0;
+static int g_mc_tiny = 0;
+
+static void
+soft3d_mc_flags_init(void)
+{
+    char const* e;
+
+    if( g_mc_offbox >= 0 )
+        return;
+
+    e = getenv("TORIRS_MC_OFFBOX");
+    g_mc_offbox = (e && e[0] && e[0] != '0') ? 1 : 0;
+
+    e = getenv("TORIRS_MC_VAABB");
+    g_mc_vaabb = (e && e[0] && e[0] != '0') ? 1 : 0;
+
+    e = getenv("TORIRS_MC_TINY");
+    g_mc_tiny = (e && e[0]) ? atoi(e) : 0;
+    if( g_mc_tiny < 0 )
+        g_mc_tiny = 0;
+}
+
+struct Soft3DProjBox
+{
+    int minx;
+    int maxx;
+    int miny;
+    int maxy;
+    int screen_w;
+    int screen_h;
+};
+
+/*
+ * Fills `box` with the projected screen extent of the model ToriDraw_Project
+ * just finished, in the viewport-CENTRED space the raster works in: the
+ * triangle dispatchers add ctx->offset_x = screen_width>>1 before touching a
+ * pixel, so these are the coordinates before that shift.
+ *
+ * Returns false for a near-clipped model. That family parks
+ * TORIDRAW_SCREEN_X_NEAR_CLIPPED in screen x and leaves screen y undivided, so
+ * the sweep would be reading sentinels; scene->near_clipped is exactly the flag
+ * ToriDraw_Project records for it.
+ */
+static bool
+soft3d_projected_box(
+    struct ToriRS_Soft3D* soft,
+    struct ToriRS_RenderCommand_Model const* cmd,
+    struct Soft3DProjBox* box)
+{
+    struct ToriDraw_Scene* scene;
+    struct ToriDraw_ViewPort const* vp;
+    int const* xs;
+    int const* ys;
+    int n;
+    int i;
+    int minx;
+    int maxx;
+    int miny;
+    int maxy;
+    int clip_left;
+    int clip_top;
+    int clip_right;
+    int clip_bottom;
+
+    assert(soft);
+    assert(cmd);
+    assert(box);
+    scene = soft->scene;
+    assert(scene);
+
+    if( scene->near_clipped )
+        return false;
+
+    n = ToriDraw_ModelGetVertexCount(cmd->model);
+    if( n <= 0 )
+        return false;
+
+    xs = scene->screen_vertices_x;
+    ys = scene->screen_vertices_y;
+    assert(xs);
+    assert(ys);
+
+    minx = maxx = xs[0];
+    miny = maxy = ys[0];
+    for( i = 1; i < n; i++ )
+    {
+        int const x = xs[i];
+        int const y = ys[i];
+        if( x < minx )
+            minx = x;
+        else if( x > maxx )
+            maxx = x;
+        if( y < miny )
+            miny = y;
+        else if( y > maxy )
+            maxy = y;
+    }
+
+    /* Same screen extent ToriDrawModelRasterContext derives, so "off screen"
+     * here means the same thing it means to the rasterizer. */
+    vp = &soft->view_port_3d;
+    clip_left = vp->clip_left < 0 ? 0 : vp->clip_left;
+    clip_top = vp->clip_top < 0 ? 0 : vp->clip_top;
+    clip_right = vp->clip_right > 0 ? vp->clip_right : vp->width;
+    clip_bottom = vp->clip_bottom > 0 ? vp->clip_bottom : vp->height;
+    if( clip_right < clip_left )
+        clip_right = clip_left;
+    if( clip_bottom < clip_top )
+        clip_bottom = clip_top;
+
+    box->minx = minx;
+    box->maxx = maxx;
+    box->miny = miny;
+    box->maxy = maxy;
+    box->screen_w = clip_right - clip_left;
+    box->screen_h = clip_bottom - clip_top;
+    return true;
+}

+/* True when the box cannot paint a pixel, or -- only when tiny_area > 0 --
+ * when its viewport-clipped area is under tiny_area. */
+static bool
+soft3d_box_reject(struct Soft3DProjBox const* box, int tiny_area)
+{
+    int ox;
+    int oy;
+    int minx;
+    int maxx;
+    int miny;
+    int maxy;
+
+    assert(box);
+    ox = box->screen_w >> 1;
+    oy = box->screen_h >> 1;
+    minx = box->minx + ox;
+    maxx = box->maxx + ox;
+    miny = box->miny + oy;
+    maxy = box->maxy + oy;
+
+    if( maxx < 0 || minx >= box->screen_w || maxy < 0 || miny >= box->screen_h )
+        return true;
+
+    if( tiny_area > 0 )
+    {
+        int const lox = minx < 0 ? 0 : minx;
+        int const hix = maxx > box->screen_w ? box->screen_w : maxx;
+        int const loy = miny < 0 ? 0 : miny;
+        int const hiy = maxy > box->screen_h ? box->screen_h : maxy;
+        int const bw = hix - lox;
+        int const bh = hiy - loy;
+        if( bw <= 0 || bh <= 0 )
+            return true;
+        if( bw * bh < tiny_area )
+            return true;
+    }
+
+    return false;
+}

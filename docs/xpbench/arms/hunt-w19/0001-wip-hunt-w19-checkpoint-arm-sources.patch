diff --git a/3rd/toridraw/graphics/proj_census.h b/3rd/toridraw/graphics/proj_census.h
index abad940eb..b3abf2620 100644
--- a/3rd/toridraw/graphics/proj_census.h
+++ b/3rd/toridraw/graphics/proj_census.h
@@ -1,115 +1,78 @@
-#ifndef TORIDRAW_GRAPHICS_PROJ_CENSUS_H
-#define TORIDRAW_GRAPHICS_PROJ_CENSUS_H
+#ifndef TORIDRAW_PROJ_CENSUS_H
+#define TORIDRAW_PROJ_CENSUS_H
 
 /**
- * Which projection kernel actually runs, and over how many vertices?
+ * What is ToriDraw_Project's per-model cost actually spent on?
  *
- * The perspective dispatch picks one of eight kernels per model -- three
- * rotation shapes (6DOF, pitch+yaw, yaw-only) crossed with textured/untextured
- * and clip/noclip -- and the SSE2 file behind them is 2400 lines. Any decision
- * about hand-writing one of those is a decision about which of the eight a real
- * scene reaches, and how long its vertex arrays are. Guessing gets this wrong
- * the same way "models average 19 faces" got span length wrong: the dispatch
- * key is a property of the MODEL, and a scene is not a uniform sample of models.
+ * The EIP map attributes 1.87 ms/frame to ToriDraw_Project and a separate
+ * 2.03 ms to the per-vertex kernel it calls, so the 1.87 is all driver: the
+ * capacity gate, the two culls, the near-clip decision and the family
+ * dispatch. Sizing any of those needs the branch counts, not a share of a
+ * symbol -- how many models reach the divides in ToriDraw_FastCull, how many
+ * are thrown away before them, and which of the eight projection families the
+ * survivors go to.
  *
- * Compile-time gated, like the span census next door, and for the same reason:
- * this sits per-model on the render path, and a runtime branch there would tax
- * the measurement it exists to take.
- *
- *   -DTORIDRAW_PROJ_CENSUS=1   per-kernel model and vertex counts, plus the
- *                              vertex-count histogram that says whether a
- *                              4-wide kernel ever gets a full second block.
- *                              TORIDRAW_PROJ_CENSUS_FILE=<path> redirects it.
+ * Compile-time gated with -DTORIDRAW_PROJ_CENSUS=1 so a timed build has no
+ * branch here. This is NOT a flag the makefile's asm-withdrawal gate reads,
+ * but a census build is for counting only and never for timing.
  */
 
 #if defined(TORIDRAW_PROJ_CENSUS) && TORIDRAW_PROJ_CENSUS
 
-#include <assert.h>
 #include <stdio.h>
 #include <stdlib.h>
 
-enum
-{
-    TORIDRAW_PROJ_K_6DOF_TEX,
-    TORIDRAW_PROJ_K_6DOF_NOTEX,
-    TORIDRAW_PROJ_K_PITCHYAW_TEX,
-    TORIDRAW_PROJ_K_PITCHYAW_NOTEX,
-    TORIDRAW_PROJ_K_YAW_TEX,
-    TORIDRAW_PROJ_K_YAW_NOTEX,
-    TORIDRAW_PROJ_KIND_COUNT
-};
-
-/** Exact for 0..63 vertices, then power-of-two up to >= 4096. */
-#define TORIDRAW_PROJ_CENSUS_EXACT 64
-#define TORIDRAW_PROJ_CENSUS_BUCKETS (TORIDRAW_PROJ_CENSUS_EXACT + 8)
-
 struct ToriDraw_ProjCensus
 {
-    /** Models projected by each kernel, split by whether it clips. */
-    unsigned int models[TORIDRAW_PROJ_KIND_COUNT][2];
-    /** Vertices those models carried -- the quantity the kernel loops over. */
-    double vertices[TORIDRAW_PROJ_KIND_COUNT][2];
-    /** Vertex counts, so the 4-wide block/tail split is a number not a guess. */
-    unsigned int hist[TORIDRAW_PROJ_CENSUS_BUCKETS];
-    /** Vertices landing in the scalar tail of a 4-wide kernel (count & 3). */
-    double vertices_tail;
-    /** Set once, by the first record, so the dump is registered exactly once. */
-    int installed;
+    double calls;
+    double capacity_reject;
+    double fastcull_no_bounds;
+    double fastcull_near_reject;   /**< max_z < near_plane_z */
+    double fastcull_far_reject;    /**< mid_z past the 3500 far plane */
+    double fastcull_x_reject;      /**< after the first two divides */
+    double fastcull_y_reject;      /**< after all four divides */
+    double fastcull_pass;
+    double aabb_reject;
+
+    double divides;                /**< project_divide calls inside FastCull */
+
+    double may_clip;
+    double no_clip;
+    double parallel;
+
+    /* Family split of the perspective dispatch, [clip][pitchyaw][tex]. */
+    double family[2][2][2];
+    double family_vertices[2][2][2];
+
+    double vertices;               /**< vertices handed to a projection kernel */
+    int registered;
 };
 
 extern struct ToriDraw_ProjCensus g_toridraw_proj_census;
 
-static inline int
-toridraw_proj_census_bucket(int n)
-{
-    int bucket = TORIDRAW_PROJ_CENSUS_EXACT;
-    int edge = TORIDRAW_PROJ_CENSUS_EXACT;
-
-    if( n < 0 )
-        n = 0;
-    if( n < TORIDRAW_PROJ_CENSUS_EXACT )
-        return n;
-    while( bucket < TORIDRAW_PROJ_CENSUS_BUCKETS - 1 && n >= edge * 2 )
-    {
-        bucket++;
-        edge *= 2;
-    }
-    return bucket;
-}
-
 void
-ToriDraw_ProjCensusDump(void);
+toridraw_proj_census_dump(void);
 
 static inline void
-toridraw_proj_census_record(int kind, int clipped, int num_vertices)
+toridraw_proj_census_register(void)
 {
-    struct ToriDraw_ProjCensus* c = &g_toridraw_proj_census;
-
-    assert(kind >= 0);
-    assert(kind < TORIDRAW_PROJ_KIND_COUNT);
-    assert(num_vertices >= 0);
-
-    /* An empty model is a legitimate runtime state, not a contract violation. */
-    if( num_vertices == 0 )
+    if( g_toridraw_proj_census.registered )
         return;
-    if( !c->installed )
-    {
-        c->installed = 1;
-        atexit(ToriDraw_ProjCensusDump);
-    }
-    c->models[kind][clipped ? 1 : 0] += 1;
-    c->vertices[kind][clipped ? 1 : 0] += (double)num_vertices;
-    c->hist[toridraw_proj_census_bucket(num_vertices)] += 1;
-    c->vertices_tail += (double)(num_vertices & 3);
+    g_toridraw_proj_census.registered = 1;
+    atexit(toridraw_proj_census_dump);
 }
 
-#define TORIDRAW_PROJ_CENSUS_RECORD(kind, clipped, n) \
-    toridraw_proj_census_record((kind), (clipped), (n))
+#define TORIDRAW_PROJ_CENSUS_BUMP(field_, by_)                  \
+    do                                                          \
+    {                                                           \
+        toridraw_proj_census_register();                        \
+        g_toridraw_proj_census.field_ += (double)(by_);          \
+    } while( 0 )
 
 #else
 
-#define TORIDRAW_PROJ_CENSUS_RECORD(kind, clipped, n) ((void)0)
+#define TORIDRAW_PROJ_CENSUS_BUMP(field_, by_) ((void)0)
 
-#endif /* TORIDRAW_PROJ_CENSUS */
+#endif
 
-#endif /* TORIDRAW_GRAPHICS_PROJ_CENSUS_H */
+#endif
diff --git a/3rd/toridraw/toridraw_render.u.c b/3rd/toridraw/toridraw_render.u.c
index e1fa5cda1..d50c1452b 100644
--- a/3rd/toridraw/toridraw_render.u.c
+++ b/3rd/toridraw/toridraw_render.u.c
@@ -1,6 +1,8 @@
 #include <stdint.h>
 #include <stdlib.h>
 #include "graphics/dash_restrict.h"
+#include "w19_arm.h"
+#include "graphics/proj_census.h"
 #include "graphics/projection.h"
 #include "graphics/winding.h"
 #include "toridraw_math.h"
@@ -758,6 +760,52 @@ ToriDraw_AabbCull(
     return TORIDRAW_CULL_VISIBLE;
 }
 
+/**
+ * The two ends of a cylinder extent against a viewport half-size, without
+ * project_divide's divide.
+ *
+ * project_divide finishes in ToriDraw_ScaleUnitDiv's truncating `v * 512 / z`,
+ * and C truncates toward zero, so at z > 0 and a non-negative bound E the
+ * quotient clears the bound exactly when the dividend reaches the next
+ * multiple of z:
+ *
+ *     v*512 / z >  E   <=>   v*512 >=  (E+1)*z   <=>   v >=  ceil((E+1)*z/512)
+ *     v*512 / z < -E   <=>   v*512 <= -(E+1)*z   <=>   v <= -ceil((E+1)*z/512)
+ *
+ * One threshold therefore answers both ends, and neither end needs a divide of
+ * its own. `v` is computed the way project_divide computes it -- same product,
+ * same arithmetic shift -- so the verdict is the one the four divides gave.
+ *
+ * The wide cases fall back to the real divide: ScaleUnitDiv widens to 64 bits
+ * past +/-2^22, and (E+1)*z has to stay inside a signed int.
+ */
+static inline bool
+toridraw_fastcull_extent_rejects(
+    int ortho_min,
+    int ortho_max,
+    int mid_z,
+    int camera_cot16,
+    int screen_edge)
+{
+    assert(mid_z > 0);
+    assert(screen_edge >= 0);
+
+    int const cot_half = camera_cot16 >> 1;
+    int const v_min = (ortho_min * cot_half) >> 15;
+    int const v_max = (ortho_max * cot_half) >> 15;
+
+    if( mid_z > (1 << 20) || screen_edge >= (1 << 10) || v_min <= -(1 << 22) ||
+        v_min >= (1 << 22) || v_max <= -(1 << 22) || v_max >= (1 << 22) )
+        return project_divide(ortho_min, mid_z, camera_cot16) > screen_edge ||
+               project_divide(ortho_max, mid_z, camera_cot16) < -screen_edge;
+
+    {
+        int const threshold =
+            (((screen_edge + 1) * mid_z) + (UNIT_SCALE - 1)) >> UNIT_SCALE_SHIFT;
+        return v_min >= threshold || v_max <= -threshold;
+    }
+}
+
 static inline int
 ToriDraw_FastCull(
     struct ToriDraw_AABB* aabb,
@@ -782,6 +830,36 @@ ToriDraw_FastCull(
     int cull_mz = 0;
     assert(ToriDraw_ModelKindIsFull(hnd.kind));
 
+#if W19_FCNODIV
+    /*
+     * The cull centre is the model origin, so cull_mx/my/mz are zero and the
+     * model-yaw rotation folds away: what is left is the camera's yaw then its
+     * pitch, applied to the world position. Spelled out rather than called
+     * because project_orthographic_fast reaches the tables through a
+     * ToriDrawTrigFns struct built on the stack, and the indirect calls stop
+     * the compiler both from folding the dead rotation and from keeping the
+     * four table reads in registers across them. Same products, same order,
+     * same arithmetic shift.
+     */
+    {
+        int const cos_camera_pitch = ToriDraw_ReadCosTable(camera_pitch);
+        int const sin_camera_pitch = ToriDraw_ReadSinTable(camera_pitch);
+        int const cos_camera_yaw = ToriDraw_ReadCosTable(camera_yaw);
+        int const sin_camera_yaw = ToriDraw_ReadSinTable(camera_yaw);
+
+        int const x_rotated = cull_mx + scene_x;
+        int const y_rotated = cull_my + scene_y;
+        int const z_rotated = cull_mz + scene_z;
+
+        int const x_scene = (x_rotated * cos_camera_yaw + z_rotated * sin_camera_yaw) >> 16;
+        int const z_scene = (z_rotated * cos_camera_yaw - x_rotated * sin_camera_yaw) >> 16;
+
+        projected_vertex->x = x_scene;
+        projected_vertex->y = (y_rotated * cos_camera_pitch - z_scene * sin_camera_pitch) >> 16;
+        projected_vertex->z = (y_rotated * sin_camera_pitch + z_scene * cos_camera_pitch) >> 16;
+    }
+    (void)model_yaw;
+#else
     project_orthographic_fast(
         projected_vertex,
         cull_mx,
@@ -793,23 +871,113 @@ ToriDraw_FastCull(
         scene_z,
         camera_pitch,
         camera_yaw);
+#endif
 
     const struct ToriDraw_BoundsCylinder* bc = model_bounds_cylinder(hnd);
     if( !bc )
+    {
+        TORIDRAW_PROJ_CENSUS_BUMP(fastcull_no_bounds, 1);
         return TORIDRAW_CULL_ERROR;
+    }
 
     int model_edge_radius = bc->radius;
 
     int mid_z = projected_vertex->z;
     int max_z = model_edge_radius + mid_z;
     if( max_z < near_plane_z )
+    {
+        TORIDRAW_PROJ_CENSUS_BUMP(fastcull_near_reject, 1);
         return TORIDRAW_CULL_FAST;
+    }
 
     /* worldRender culls midZ>=3500; objRender / inventory icons do not.
      * Icon cameras already use near_plane_z=1 (world uses 50). */
     if( near_plane_z >= 50 && mid_z > TORIDRAW_CYLINDER_FAR_PLANE_Z )
+    {
+        TORIDRAW_PROJ_CENSUS_BUMP(fastcull_far_reject, 1);
         return TORIDRAW_CULL_FAST;
+    }
 
+#if W19_FCNODIV
+    int mid_x = projected_vertex->x;
+    int mid_y = projected_vertex->y;
+
+    bool const parallel = toridraw_proj_is_parallel(camera->proj_mode);
+    int const zoom16 = camera->parallel_zoom16 ? camera->parallel_zoom16 : TORIDRAW_ORTHO_ZOOM_UNIT;
+
+    /* Depth only reaches the perspective extents through the divide; a parallel
+     * projection's screen size is the same at any depth, so the clamp below --
+     * which exists purely to keep that divisor off the near plane -- would be
+     * meaningless there. */
+    if( !parallel && mid_z < near_plane_z )
+        mid_z = near_plane_z;
+
+    int const cot16 =
+        toridraw_proj_cot16(camera->proj_mode, camera->proj_scale, camera->fov_rpi2048);
+
+    int ortho_screen_x_min = mid_x - model_edge_radius;
+    int ortho_screen_x_max = mid_x + model_edge_radius;
+    int screen_edge_width = view_port->width >> 1;
+
+    if( parallel )
+    {
+        int const screen_x_min_unoffset =
+            (ortho_screen_x_min * zoom16) >> TORIDRAW_ORTHO_ZOOM_SHIFT;
+        int const screen_x_max_unoffset =
+            (ortho_screen_x_max * zoom16) >> TORIDRAW_ORTHO_ZOOM_SHIFT;
+        if( screen_x_min_unoffset > screen_edge_width ||
+            screen_x_max_unoffset < -screen_edge_width )
+        {
+            TORIDRAW_PROJ_CENSUS_BUMP(fastcull_x_reject, 1);
+            return TORIDRAW_CULL_FAST;
+        }
+    }
+    else if( toridraw_fastcull_extent_rejects(
+                 ortho_screen_x_min, ortho_screen_x_max, mid_z, cot16, screen_edge_width) )
+    {
+        TORIDRAW_PROJ_CENSUS_BUMP(fastcull_x_reject, 1);
+        return TORIDRAW_CULL_FAST;
+    }
+
+    int model_center_to_top_edge = bc->center_to_top_edge;
+
+    int model_center_to_bottom_edge =
+        (bc->center_to_bottom_edge * ToriDraw_ReadCosTable(camera_pitch) >> 16) +
+        (model_edge_radius * ToriDraw_ReadSinTable(camera_pitch) >> 16);
+
+    int ortho_screen_y_min = mid_y - abs(model_center_to_bottom_edge);
+    int ortho_screen_y_max = mid_y + abs(model_center_to_top_edge);
+    int screen_edge_height = view_port->height >> 1;
+
+    if( parallel )
+    {
+        int const screen_y_min_unoffset =
+            (ortho_screen_y_min * zoom16) >> TORIDRAW_ORTHO_ZOOM_SHIFT;
+        int const screen_y_max_unoffset =
+            (ortho_screen_y_max * zoom16) >> TORIDRAW_ORTHO_ZOOM_SHIFT;
+        if( screen_y_min_unoffset > screen_edge_height ||
+            screen_y_max_unoffset < -screen_edge_height )
+        {
+            TORIDRAW_PROJ_CENSUS_BUMP(fastcull_y_reject, 1);
+            return TORIDRAW_CULL_FAST;
+        }
+    }
+    else if( toridraw_fastcull_extent_rejects(
+                 ortho_screen_y_min, ortho_screen_y_max, mid_z, cot16, screen_edge_height) )
+    {
+        TORIDRAW_PROJ_CENSUS_BUMP(fastcull_y_reject, 1);
+        return TORIDRAW_CULL_FAST;
+    }
+
+    /* `aabb` is the scene's cylinder_fast_aabb. Nothing in the renderer reads
+     * it -- the visible path recomputes an eight-point box in
+     * ToriDraw_CalculateCylinderAabb8point and culls against that -- so the
+     * four screen coordinates it used to hold were the only reason this
+     * function divided at all. */
+    (void)aabb;
+
+    TORIDRAW_PROJ_CENSUS_BUMP(fastcull_pass, 1);

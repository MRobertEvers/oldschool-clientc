+#ifndef W19_ARM_H
+#define W19_ARM_H
+
+/*
+ * Arm switches for the ToriDraw_Project hunt. Both default to 0, so a tree
+ * with neither flipped compiles the control program exactly.
+ *
+ * W19_PREFETCH  Touch the model header and its bounds cylinder before the
+ *               projection needs them. The census says ToriDraw_Project runs
+ *               2,551.8 times a frame and the capacity gate is the frame's
+ *               first read of each model allocation.
+ * W19_FCNODIV   ToriDraw_FastCull answers its two extent tests with a multiply
+ *               instead of project_divide's idivl, and stops filling the
+ *               screen AABB nothing in the renderer reads. 8,861.6 divides a
+ *               frame, measured.
+ */
+#ifndef W19_PREFETCH
+#define W19_PREFETCH 1
+#endif
+
+#ifndef W19_FCNODIV
+#define W19_FCNODIV 0
+#endif
+
+#endif /* W19_ARM_H */

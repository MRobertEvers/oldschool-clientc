diff --git a/3rd/toridraw/toridraw_floor.c b/3rd/toridraw/toridraw_floor.c
new file mode 100644
index 000000000..3403070e7
--- /dev/null
+++ b/3rd/toridraw/toridraw_floor.c
@@ -0,0 +1,46 @@
+/* ABLATION FLOOR LADDER -- measurement only. See toridraw_floor.h. */
+#include "toridraw_floor.h"
+
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+int g_torirs_floor_level = -1;
+int g_torirs_floor_stat = 0;
+long g_torirs_floor_hits[8];
+
+void
+torirs_floor_resolve(void)
+{
+    char const* s = getenv("TORIRS_FLOOR");
+    char const* t = getenv("TORIRS_FLOOR_STAT");
+    int level = s ? atoi(s) : 0;
+
+    if( level < 0 )
+        level = 0;
+    if( level > 7 )
+        level = 7;
+    g_torirs_floor_stat = (t && t[0] == '1') ? 1 : 0;
+    g_torirs_floor_level = level;
+    if( g_torirs_floor_stat )
+        atexit(torirs_floor_report);
+
+    /* Once, to stderr, before any frame: a ladder whose knob never reached the
+     * binary is the one failure mode that reads as "the floor is the whole
+     * frame". The run log has to be able to say which rung it ran. */
+    fprintf(stderr, "floor: level=%d stat=%d\n", level, g_torirs_floor_stat);
+    fflush(stderr);
+}
+
+void
+torirs_floor_report(void)
+{
+    int i;
+    if( !g_torirs_floor_stat )
+        return;
+    fprintf(stderr, "floor_hits: level=%d", g_torirs_floor_level);
+    for( i = 1; i <= 7; i++ )
+        fprintf(stderr, " r%d=%ld", i, g_torirs_floor_hits[i]);
+    fprintf(stderr, "\n");
+    fflush(stderr);
+}
diff --git a/3rd/toridraw/toridraw_floor.h b/3rd/toridraw/toridraw_floor.h
new file mode 100644
index 000000000..7a6270f3b
--- /dev/null
+++ b/3rd/toridraw/toridraw_floor.h
@@ -0,0 +1,73 @@
+#ifndef TORIDRAW_FLOOR_H
+#define TORIDRAW_FLOOR_H
+
+/*
+ * ABLATION FLOOR LADDER -- measurement only, never shippable.
+ *
+ * One binary, one runtime knob, seven strictly nested rungs. TORIRS_FLOOR=<n>
+ * (0 = full render, the self-control) selects how much of the frame is
+ * removed. Every gate is written `if( torirs_floor() >= N )`, so rung N+1
+ * necessarily fires every gate rung N fires -- monotonicity is structural, not
+ * something the reader has to audit call site by call site.
+ *
+ *   0  full render. Codegen-identical to every rung above it, so a delta
+ *      against rung 1 cannot be a code-layout artefact of a different build.
+ *   1  the eight ToriDraw_TriangleFace* entry points return at once. Per-face
+ *      dispatch, texture lookup and argument marshalling all still run; not
+ *      one span is walked and not one pixel is written by model geometry.
+ *   2  ToriDraw_RasterWithFaceIndices returns at once: no raster context, no
+ *      ordered-face walk, no per-face setup.
+ *   3  ToriDraw_RenderModel2SortFaces returns 0: the face sorter is gone.
+ *   4  soft3d_draw_model / soft3d_draw_model_widget return at entry: the
+ *      per-model projection, transform and cull are gone. The frame command
+ *      stream is still generated and the 2D UI still draws.
+ *   5  the frame's command walk is skipped entirely: no command stream, no
+ *      sprites, no fonts, no rects. The full-screen clear still runs.
+ *   6  app_world_paint's painter/bucket/occluder/cull work is skipped. THE
+ *      FLOOR: game logic, UI tree, clear and present, and nothing else.
+ *   7  the present BitBlt and the per-frame SetWindowTextA are skipped too.
+ *      Below the floor -- what the floor costs minus the window system.
+ *
+ * TORIRS_FLOOR_STAT=1 tallies how often each gate fired and prints the tally
+ * at exit. It is a predicted not-taken branch when unset, and it is unset for
+ * every timed run.
+ */
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* -1 until the environment has been read; torirs_floor() resolves on first
+ * use. A sentinel rather than a plain 0 default so a build where the resolve
+ * never ran is a level that never changes rather than a ladder that silently
+ * reports the control at every rung. */
+extern int g_torirs_floor_level;
+extern int g_torirs_floor_stat;
+extern long g_torirs_floor_hits[8];
+
+void
+torirs_floor_resolve(void);
+
+void
+torirs_floor_report(void);
+
+static inline int
+torirs_floor(void)
+{
+    if( g_torirs_floor_level < 0 )
+        torirs_floor_resolve();
+    return g_torirs_floor_level;
+}
+
+static inline void
+torirs_floor_hit(int rung)
+{
+    if( g_torirs_floor_stat )
+        g_torirs_floor_hits[rung]++;
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* TORIDRAW_FLOOR_H */

+/* Index of the highest set bit. Only ever called on a word the caller has
+ * already found non-zero -- a zero word has no highest bit and __builtin_clz
+ * is undefined on it, so that is a contract violation, not a case to handle. */
+static inline int
+toridraw_bsr32(uint32_t w)
+{
+    assert(w != 0);
+#if defined(__GNUC__) || defined(__clang__)
+    return 31 - __builtin_clz(w);
+#else
+    int b = 0;
+    while( w >>= 1 )
+        b++;
+    return b;
+#endif
+}

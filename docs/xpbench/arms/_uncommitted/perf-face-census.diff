+/*
+ * Copy every script's name into one block and point the entries at it.
+ *
+ * The names have to outlive the bodies: SSVM_ProviderGetByName confirms a hash
+ * match with a strcmp, and after SSVM_ProviderCompact there is no decoded
+ * script left to compare against. One block rather than 29,520 also takes an
+ * allocation header off each of them, which at ~30 bytes a name is most of what
+ * a name costs.
+ */
+static void
+intern_names(struct SSVM_Provider* provider)
+{
+    size_t total = 0;
+    size_t used = 0;
+    int32_t i;
+
+    assert(provider);
+
+    for( i = 0; i < provider->count; i++ )
+    {
+        if( provider->scripts[i].op_count != 0 && provider->scripts[i].name )
+            total += strlen(provider->scripts[i].name) + 1;
+    }
+    if( total == 0 )
+        return;
+
+    provider->name_pool = (char*)malloc(total);
+    assert(provider->name_pool);
+
+    for( i = 0; i < provider->count; i++ )
+    {
+        size_t length;
+
+        if( provider->scripts[i].op_count == 0 || !provider->scripts[i].name )
+            continue;
+        length = strlen(provider->scripts[i].name) + 1;
+        memcpy(provider->name_pool + used, provider->scripts[i].name, length);
+        provider->entries[i].name = provider->name_pool + used;
+        used += length;
+    }
+}
+
+/*
+ * Put a compacted script back.
+ *
+ * The const cast is the honest spelling of what this is: memoising a decode the
+ * eager load already did once, so that a lookup stays a lookup from the
+ * caller's side. Nothing observable about the provider changes — the same id
+ * yields the same script, before and after.
+ */
+static struct SSVM_Script*
+provider_body(const struct SSVM_Provider* readonly, int32_t id)
+{
+    struct SSVM_Provider* provider = (struct SSVM_Provider*)readonly;
+    struct SSVM_ProviderEntry* entry;
+    struct SSVM_Error err;
+    uint8_t* body;
+
+    assert(provider);
+
+    if( !provider->scripts || !provider->entries )
+        return NULL;
+    if( id < 0 || id >= provider->count )
+        return NULL;
+
+    entry = &provider->entries[id];
+    if( entry->decoded )
+        return &provider->scripts[id];
+    if( entry->size == 0 )
+        return NULL;
+
+    /* Only a compacted provider gets here, and compaction requires the file. */
+    assert(provider->dat_file);
+
+    body = (uint8_t*)malloc(entry->size);
+    assert(body);
+
+    SSVM_ErrorClear(&err);
+    if( fseek(provider->dat_file, (long)entry->offset, SEEK_SET) != 0 ||
+        fread(body, 1, entry->size, provider->dat_file) != entry->size ||
+        !SSVM_ScriptDecode(id, body, entry->size, &provider->scripts[id], &err) )
+    {
+        /*
+         * The bytes decoded once already, at load. Failing now means the file
+         * is no longer the file that was loaded — which cannot be recovered
+         * from here and must not be papered over, because every script after
+         * the one that moved would decode into something plausible.
+         */
+        fprintf(
+            stderr, "ssvm: script %d (offset %u, %u bytes) will not decode: %s\n", id,
+            entry->offset, entry->size, err.message);
+        abort();
+    }
+
+    free(body);
+    entry->decoded = 1;
+    provider->resident++;
+    return &provider->scripts[id];
+}

+{
+    /** Nothing has stated one yet. @see ToriRS_PluginApi::lane. */
+    TORIRS_PLUGIN_GAME_UNKNOWN = 0,
+    TORIRS_PLUGIN_GAME_OLDSCHOOL = 1,

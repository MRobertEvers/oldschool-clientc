+/* --------------------------------------------------------------------------
+ * Round-4 XP hunt, route "sort": runtime arm selector for painter_paint_bucket.
+ * TORIRS_PB_MODE   0 = base (unmodified control)
+ *                  1 = fix   (classify level-defer + push-time level gate
+ *                             + cullspan test hoisted above the tiles[] read)
+ *                  2 = cls2  (INFLATION: classify scan run twice)
+ *                  3 = gate2 (INFLATION: four-direction gate run twice)
+ * TORIRS_PB_HASH=1 accumulate an FNV-1a hash of the emitted command stream and
+ *                  dump it, with pop/push/level-reject counts, at exit.
+ * ------------------------------------------------------------------------ */
+static int
+pb_mode(void)
+{
+    static int cached = -1;
+    if( cached < 0 )
+    {
+        const char* s = getenv("TORIRS_PB_MODE");
+        cached = s ? atoi(s) : 0;
+    }
+    return cached;
+}
+
+static volatile int g_pb_sink;
+
+static unsigned g_pb_hash = 2166136261u;
+static unsigned long g_pb_cmds;
+static unsigned long g_pb_frames;
+static unsigned long g_pb_pops;
+static unsigned long g_pb_lvlrej;
+static unsigned long g_pb_lvldefer;
+static int g_pb_hash_on = -1;
+
+static void
+pb_hash_dump(void)
+{
+    fprintf(
+        stderr,
+        "PB_STATS mode=%d frames=%lu cmds=%lu hash=%08x pops=%lu "
+        "lvlrej=%lu lvldefer=%lu\n",
+        pb_mode(),
+        g_pb_frames,
+        g_pb_cmds,
+        g_pb_hash,
+        g_pb_pops,
+        g_pb_lvlrej,
+        g_pb_lvldefer);
+}
+
+static int
+pb_hash_on(void)
+{
+    if( g_pb_hash_on < 0 )
+    {
+        const char* s = getenv("TORIRS_PB_HASH");
+        g_pb_hash_on = s ? atoi(s) : 0;
+        if( g_pb_hash_on )
+            atexit(pb_hash_dump);
+    }
+    return g_pb_hash_on;
+}

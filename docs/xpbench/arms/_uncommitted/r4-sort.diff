+/* Round-4 route "sort": bucket_push_if_active plus the level gate the drain
+ * would otherwise apply after the pop. `gate_lvl` is (paintgrid_level > 0) for
+ * the completing tile; its in-plane neighbours share that slot. A refused tile
+ * is not lost: the tile below it pushes it from the completion path the moment
+ * it turns DONE (`paintgrid_level < levels - 1` up-push), and the perimeter
+ * seed generator is the standing liveness fallback either way. */
+static inline int
+bucket_push_if_active_lvl(
+    struct PainterBucketCtx* w,
+    struct TilePaint* paints,
+    int ti,
+    int dist,
+    int gate_lvl,
+    int level_stride,
+    int64_t* perf_pushes,
+    int64_t* perf_push_dedup)
+{
+    if( paints[ti].in_queue )
+    {
+        BUCKET_PERF_INCREMENT(*perf_push_dedup);
+        return 0;
+    }
+    if( paints[ti].step == PAINT_STEP_DONE )
+        return 0;
+    if( gate_lvl && paints[ti - level_stride].step != PAINT_STEP_DONE )
+    {
+        if( g_pb_hash_on > 0 )
+            g_pb_lvldefer++;
+        return 0;
+    }
+    bucket_push(w, paints, ti, dist);
+    BUCKET_PERF_INCREMENT(*perf_pushes);
+    if( painter_wedgelog_armed() )
+    {
+        char extra[32];
+        snprintf(extra, sizeof(extra), "d=%d", dist);
+        painter_wedgelog_event(ti, "PUSH", extra);
+    }
+    return 1;
+}

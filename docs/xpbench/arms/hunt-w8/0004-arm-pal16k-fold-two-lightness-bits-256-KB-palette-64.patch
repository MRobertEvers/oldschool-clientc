@@ -73,11 +73,11 @@
 static inline int
 toridraw_gouraud_span_index(int color_hsl16_ish8)
 {
-    int hsl16 = color_hsl16_ish8 >> 8;
+    int index = color_hsl16_ish8 >> (8 + TORIDRAW_HSL16_PAL_SHIFT);
 
-    if( (unsigned)hsl16 > 0xFFFFu )
-        hsl16 = hsl16 < 0 ? 0 : 0xFFFF;
-    return hsl16;
+    if( (unsigned)index > (unsigned)(TORIDRAW_HSL16_PAL_LEN - 1) )
+        index = index < 0 ? 0 : TORIDRAW_HSL16_PAL_LEN - 1;
+    return index;
 }
 
 /**
@@ -195,7 +195,7 @@ toridraw_gouraud_span_fill_run(

-            pixel_buffer + offset, blocks << 2, g_hsl16_to_rgb_table[index]);
+            pixel_buffer + offset, blocks << 2, g_hsl16_to_rgb_lq14[index]);
         offset += blocks << 2;
     }
 
diff --git a/3rd/toridraw/graphics/raster/gouraudhsllightness/gouraud_tri_i686.S b/3rd/toridraw/graphics/raster/gouraudhsllightness/gouraud_tri_i686.S
index 974877e12..b09fc57ea 100644
--- a/3rd/toridraw/graphics/raster/gouraudhsllightness/gouraud_tri_i686.S
+++ b/3rd/toridraw/graphics/raster/gouraudhsllightness/gouraud_tri_i686.S
@@ -150,16 +150,16 @@
  */
 .macro	LOOKUP src, dst
 	movl	\src, \dst
-	sarl	$20, \dst		/* ABLATION: was $8. One palette line. */
-	cmpl	$0xFFFF, \dst
+	sarl	$10, \dst		/* >> 8 to hsl16, >> 2 to the lq14 index */
+	cmpl	$0x3FFF, \dst
 	jbe	7000f
 	/* Out of range. Negative -> 0, positive -> 0xFFFF, branchlessly:
 	 * sar 31 gives -1 or 0, not gives 0 or -1, mask gives 0 or 0xFFFF. */
 	sarl	$31, \dst
 	notl	\dst
-	andl	$0xFFFF, \dst
+	andl	$0x3FFF, \dst
 7000:
-	movl	_g_hsl16_to_rgb_table(,\dst,4), \dst
+	movl	_g_hsl16_to_rgb_lq14(,\dst,4), \dst
 .endm
 

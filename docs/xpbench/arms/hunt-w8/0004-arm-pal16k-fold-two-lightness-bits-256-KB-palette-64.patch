diff --git a/3rd/toridraw/graphics/shared_tables.h b/3rd/toridraw/graphics/shared_tables.h
index f3feb1637..c9676752e 100644
--- a/3rd/toridraw/graphics/shared_tables.h
+++ b/3rd/toridraw/graphics/shared_tables.h
@@ -1,6 +1,7 @@
 #ifndef SHARED_TABLES_H
 #define SHARED_TABLES_H
 
+#include <assert.h>
 #include <math.h>
 #include <stdint.h>
 
@@ -26,12 +27,38 @@ typedef TORIDRAW_PIXEL_T toripixel_t;
 //   This tool renders a color palette using jagex's 16-bit HSL, 6 bits
 //             for hue, 3 for saturation and 7 for lightness, bitpacked and
 //             represented as a short.
+/*
+ * The palette carries one entry per FOUR lightness steps, not one per step.
+ *
+ * A full hsl16 palette is 65,536 entries of 4 bytes -- 256 KB, sixteen times
+ * the P4's 16 KB L1D and a quarter of its 1 MB L2, streamed against a 1.5 MB
+ * frame buffer.  Within one triangle only lightness moves, so the live slice
+ * is small; ACROSS triangles hue and saturation move and the index walks the
+ * whole 256 KB.  Folding the low two lightness bits away costs 128 shades per
+ * hue/saturation pair instead of 128 -- VISIBLE banding on a long gradient --
+ * and buys a 64 KB table.  This is an arm of the cache experiment, not a
+ * shipping decision; g_hsl16_to_rgb_lq14 is deliberately a NEW name so that
+ * any consumer left indexing the old table fails to link rather than reading
+ * four times past the end.
+ */
+#define TORIDRAW_HSL16_PAL_SHIFT 2
+#define TORIDRAW_HSL16_PAL_STEP  (1 << TORIDRAW_HSL16_PAL_SHIFT)
+#define TORIDRAW_HSL16_PAL_LEN   (65536 >> TORIDRAW_HSL16_PAL_SHIFT)
+
 #ifdef TORIDRAW_PIXEL16
-extern TORIDRAW_TABLE_QUAL uint16_t g_hsl16_to_rgb_table[65536];
+extern TORIDRAW_TABLE_QUAL uint16_t g_hsl16_to_rgb_lq14[TORIDRAW_HSL16_PAL_LEN];
 #else
-extern TORIDRAW_TABLE_QUAL int g_hsl16_to_rgb_table[65536];
+extern TORIDRAW_TABLE_QUAL int g_hsl16_to_rgb_lq14[TORIDRAW_HSL16_PAL_LEN];
 #endif
 
+/** One hsl16, already known to be in range, to its palette entry. */
+static inline int
+ToriDraw_Hsl16PalRgb(int hsl16)
+{
+    assert((unsigned)hsl16 <= 0xFFFFu);
+    return g_hsl16_to_rgb_lq14[hsl16 >> TORIDRAW_HSL16_PAL_SHIFT];
+}
+
 /*
  * Gouraud rasterizers carry packed HSL16 in 8.8 fixed point while walking a
  * span.  A triangle edge can land one subpixel past its last vertex after the
@@ -44,10 +71,10 @@ extern TORIDRAW_TABLE_QUAL int g_hsl16_to_rgb_table[65536];
 static inline int
 ToriDraw_Hsl16Ish8ToRgb(int hsl16_ish8)
 {
-    int hsl16 = hsl16_ish8 >> 8;
-    if( (unsigned)hsl16 > 0xFFFFu )
-        hsl16 = hsl16 < 0 ? 0 : 0xFFFF;
-    return g_hsl16_to_rgb_table[hsl16];
+    int index = hsl16_ish8 >> (8 + TORIDRAW_HSL16_PAL_SHIFT);
+    if( (unsigned)index > (unsigned)(TORIDRAW_HSL16_PAL_LEN - 1) )
+        index = index < 0 ? 0 : TORIDRAW_HSL16_PAL_LEN - 1;
+    return g_hsl16_to_rgb_lq14[index];
 }
 
 extern const int* g_sin_table;
diff --git a/3rd/toridraw/toridraw_hsl16.h b/3rd/toridraw/toridraw_hsl16.h
index 2405aec5c..63168a4c8 100644

+/**
+ * One face's contribution to the priority partition.
+ *
+ * Extracted so the depth-bucket walk and the packed-key walk cannot drift
+ * apart. They visit the same faces in the same order -- back to front, face
+ * index ascending inside a depth -- and this is the only place that decides
+ * what visiting one means.
+ */
+#if defined(__GNUC__) || defined(__clang__)
+__attribute__((always_inline))
+#endif
+static inline void
+accumulate_face_by_priority(
+    faceint_t* face_priority_buckets,
+    faceint_t* face_priority_bucket_counts,
+    int* priority_depths,
+    int* flex_prio11_face_to_depth,
+    int* flex_prio12_face_to_depth,
+    int* counts,
+    int priority_stride,
+    int flex_capacity,
+    int model_face_count,
+    const uint8_t* face_priorities,
+    faceint_t face_idx,
+    int depth)
+{
+    int prio = faceprio_unpack(face_priorities, face_idx);
+    int n;
+
+    assert(face_idx >= 0);
+    assert(face_idx < model_face_count);
+    assert(prio >= 0);
+    assert(prio < 12 && "face priority indexes counts[12]");
+
+    n = counts[prio];
+    /* Same shape of hazard as the depth buckets: the twelve priority runs are
+     * slices of one block, so overflowing one silently rewrites the next
+     * priority's faces. */
+    assert(n >= 0);
+    assert(n < priority_stride);
+
+    face_priority_buckets[prio * priority_stride + n] = face_idx;
+
+    if( prio < 10 )
+    {
+        priority_depths[prio] += depth;
+    }
+    else
+    {
+        /* depth occupies the low 16 bits and the face index the high 16, so
+         * both have to be representable or the pair decodes as a different
+         * face at a different depth. */
+        assert(depth >= 0);
+        assert(depth <= 0xFFFF);
+        assert(n < flex_capacity);
+
+        if( prio == 10 )
+            flex_prio11_face_to_depth[n] = depth | (face_idx << 16);
+        else
+            flex_prio12_face_to_depth[n] = depth | (face_idx << 16);
+    }
+
+    counts[prio] = n + 1;
+    face_priority_bucket_counts[prio] = (faceint_t)(n + 1);
+}

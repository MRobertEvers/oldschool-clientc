+/* #region packed-key face order */
+/*
+ * Two independent experiments over the face sort, each gated so a build can
+ * carry one without the other and the measurement can attribute the delta.
+ *
+ * TORIDRAW_W13_FASTPATH: choose the loop-invariants of the per-face cull ONCE
+ * instead of per face.
+ * TORIDRAW_W13_KSORT: order a small model's faces with a packed-key insertion
+ * sort instead of the dense depth-bucket table.
+ */
+#ifndef TORIDRAW_W13_FASTPATH
+#define TORIDRAW_W13_FASTPATH 1
+#endif
+#ifndef TORIDRAW_W13_KSORT
+#define TORIDRAW_W13_KSORT 1
+#endif
+
+/*
+ * The depth bucket table is 512 faces wide per depth LEVEL, so two adjacent
+ * depths sit 1 KB apart. A model whose bounding sphere is 300 units spans 600
+ * levels of it, so bucketing that model's median ~15 faces scatters 15 stores
+ * across 600 KB, walks all 600 levels back to read them out, and then zeroes
+ * the 600 counts it dirtied. The faces are the small part of that: the
+ * per-model cost is the WIDTH of the depth span, not the number of faces in
+ * it, which is the same shape of bug the CSR sorter had before it was
+ * windowed (docs: scene-small-csr-sorter-slower).
+ *
+ * A model small enough that an insertion sort beats that span does not need
+ * the table at all. Pack (depth, face) into one int and sort the handful:
+ * one cache line, no table, no clear, no scan over empty levels.
+ *
+ * `0x7FFF - depth` in the high half keeps the key POSITIVE -- depth is under
+ * 16384, so the high half lands in 0x4000..0x7FFF -- and reverses the depth
+ * order, so ASCENDING key order is descending depth with the face index
+ * ascending inside a depth. That is precisely what the table emits: it appends
+ * within a level in face order and is walked from max depth down. A STABLE
+ * sort of these keys is therefore order-IDENTICAL to the table rather than
+ * merely equivalent to it.
+ */
+#define TORIDRAW_ORDER_KEY_DEPTH_BASE 0x7FFF
+
+/* Faces the packed-key path is used for, and the stack array that holds them.
+ *
+ * The cap is what the array costs; the default is where the two costs cross.
+ * Insertion sort is ~n^2/4 compares against a bucket walk that is ~2*radius
+ * levels plus n scattered stores, and 64 is roughly break-even for the ~300
+ * unit radius typical of scenery. It is also why the small path cannot
+ * disagree with the table about which faces survive: 64 faces cannot fill a
+ * 512-wide depth level, so the table's overflow drop at `count >=
+ * depth_stride` is unreachable below the threshold. */
+#define TORIDRAW_ORDER_KEY_SORT_CAP 256
+#define TORIDRAW_ORDER_KEY_SORT_MAX 64
+
+/** TORIDRAW_ORDER_KEY_MAX overrides that threshold for a measurement; 0 turns
+ *  the packed-key path off entirely, so one binary can be benchmarked against
+ *  itself with and without it. */
+static int
+toridraw_order_key_max(void)
+{
+    static int cached = -1;
+    if( cached < 0 )
+    {
+        const char* v = getenv("TORIDRAW_ORDER_KEY_MAX");
+        int n = TORIDRAW_ORDER_KEY_SORT_MAX;
+        if( v && v[0] != '\0' )
+            n = atoi(v);
+        if( n < 0 )
+            n = 0;
+        if( n > TORIDRAW_ORDER_KEY_SORT_CAP )
+            n = TORIDRAW_ORDER_KEY_SORT_CAP;
+        cached = n;
+    }
+    return cached;
+}
+
+static inline int
+order_key_make(int depth, int face)
+{
+    assert(depth >= 0);
+    assert(depth <= TORIDRAW_ORDER_KEY_DEPTH_BASE);
+    assert(face >= 0);
+    assert(face <= 0xFFFF);
+    return ((TORIDRAW_ORDER_KEY_DEPTH_BASE - depth) << 16) | face;
+}
+
+static inline int
+order_key_depth(int key)
+{
+    return TORIDRAW_ORDER_KEY_DEPTH_BASE - (key >> 16);
+}
+
+static inline int
+order_key_face(int key)
+{
+    return key & 0xFFFF;
+}
+
+/**
+ * Stable ascending insertion sort of the packed keys.
+ *
+ * Stability is load-bearing, not incidental: faces that quantise to the same
+ * depth must stay in face order, because that is the order the bucket table
+ * appended them in and the order the raster consumed them in. Linear rather
+ * than binary insertion on purpose -- the inner scan mispredicts once per
+ * element where a binary search mispredicts log2(n) times, and on a 31-stage
+ * pipeline that is the whole difference.
+ */
+static inline void
+order_keys_sort(int* RESTRICT keys, int count)
+{
+    assert(keys);
+    assert(count >= 0);
+
+    for( int i = 1; i < count; i++ )
+    {
+        int const key = keys[i];
+        int j = i - 1;
+        while( j >= 0 && keys[j] > key )
+        {
+            keys[j + 1] = keys[j];
+            j--;
+        }
+        keys[j + 1] = key;
+    }
+}
+/* #endregion */
+
+/*
+ * The same per-face cull the bucket sort runs, emitting packed order keys into
+ * a compact array instead of a table slice. Split on `depth_shift` for the
+ * reason the bucket sort is, and on `near_clipped` and the debug pointer for
+ * the same reason once more: the loop body is far past the size
+ * -funswitch-loops will hoist a condition out of, so anything left as a
+ * runtime value here is tested once per face forever.
+ */
+#if defined(__GNUC__) || defined(__clang__)
+__attribute__((always_inline))
+#endif
+static inline int
+classify_faces_to_order_keys_impl(
+    int* RESTRICT keys,
+    int depth_levels,
+    int depth_shift,
+    struct ToriDraw_FaceSortDebugStats* debug_stats,
+    bool near_clipped,
+    int model_min_depth,
+    int num_faces,
+    const int* RESTRICT vx,
+    const int* RESTRICT vy,
+    const int* RESTRICT vz,
+    const faceint_t* RESTRICT face_a,
+    const faceint_t* RESTRICT face_b,
+    const faceint_t* RESTRICT face_c)
+{
+#if TORIDRAW_W13_FASTPATH
+    /* Once per model, not once per face. This is a lazy getenv behind a
+     * function-local static, so leaving it in the loop costs a load, a test
+     * and a branch the compiler cannot hoist across the call it guards. */
+    bool const flip_winding = toridraw_flip_winding();
+#endif
+    int n = 0;
+
+    for( int f = 0; f < num_faces; f++ )
+    {
+        const uint32_t a = face_a[f];
+        const uint32_t b = face_b[f];
+        const uint32_t c = face_c[f];
+
+        bool const clip_candidate =
+            near_clipped &&
+            (vx[a] == TORIDRAW_SCREEN_X_NEAR_CLIPPED ||
+             vx[b] == TORIDRAW_SCREEN_X_NEAR_CLIPPED ||
+             vx[c] == TORIDRAW_SCREEN_X_NEAR_CLIPPED);
+        long long winding = 1;
+        if( !clip_candidate )
+            winding = toridraw_winding_2d(
+                vx[a], vy[a], vx[b], vy[b], vx[c], vy[c]);
+
+        /* Same rule as the bucket sort: a clipped vertex has no screen-space
+         * winding yet, so the triangle is kept and tested after the near-plane
+         * polygon exists. */
+#if TORIDRAW_W13_FASTPATH
+        if( clip_candidate || (flip_winding ? (winding < 0) : (winding > 0)) )
+#else
+        if( clip_candidate || toridraw_winding_front_facing(winding) )
+#endif
+        {
+            int z_sum = vz[a] + vz[b] + vz[c];
+            int depth_avg = (div3_fast_fixedpoint(z_sum) + model_min_depth) >> depth_shift;
+
+            if( debug_stats )
+            {
+                debug_stats->front_facing++;
+                if( clip_candidate )
+                    debug_stats->near_clip_candidates++;
+                if( depth_avg < debug_stats->min_depth_seen )
+                    debug_stats->min_depth_seen = depth_avg;
+                if( depth_avg > debug_stats->max_depth_seen )
+                    debug_stats->max_depth_seen = depth_avg;
+            }
+
+            if( (unsigned int)depth_avg < (unsigned int)depth_levels )
+            {
+                /* No capacity test, and none is possible to need: the caller
+                 * only reaches this path for a model whose face count fits the
+                 * key array outright, so `n` cannot pass `num_faces`. */
+                assert(n < num_faces || num_faces == 0);
+                keys[n++] = order_key_make(depth_avg, f);
+
+                if( debug_stats )
+                    debug_stats->accepted++;
+            }
+            else if( debug_stats )
+            {
+                if( depth_avg < 0 )
+                    debug_stats->depth_out_low++;
+                else
+                    debug_stats->depth_out_high++;
+                if( debug_stats->first_depth_out_face < 0 )
+                {
+                    debug_stats->first_depth_out_face = f;
+                    debug_stats->first_depth_out_value = depth_avg;
+                }
+            }
+        }
+        else if( debug_stats )
+        {
+            if( winding == 0 )
+                debug_stats->degenerate++;
+            else
+                debug_stats->back_facing++;
+        }
+    }
+
+    if( debug_stats )
+        assert(
+            debug_stats->front_facing ==
+            debug_stats->accepted + debug_stats->depth_out_low +
+                debug_stats->depth_out_high + debug_stats->bucket_overflow);
+
+    return n;
+}
+
+/** The early switch, as for the bucket sort. */
+static inline int
+classify_faces_to_order_keys(
+    int* RESTRICT keys,
+    int depth_levels,
+    int depth_shift,
+    struct ToriDraw_FaceSortDebugStats* debug_stats,
+    bool near_clipped,
+    int model_min_depth,
+    int num_faces,
+    const int* RESTRICT vx,
+    const int* RESTRICT vy,
+    const int* RESTRICT vz,
+    const faceint_t* RESTRICT face_a,
+    const faceint_t* RESTRICT face_b,
+    const faceint_t* RESTRICT face_c)
+{
+#if TORIDRAW_W13_FASTPATH
+    if( !debug_stats && depth_shift == 0 )
+    {
+        if( !near_clipped )
+            return classify_faces_to_order_keys_impl(
+                keys, depth_levels, 0, NULL, false, model_min_depth,
+                num_faces, vx, vy, vz, face_a, face_b, face_c);
+        return classify_faces_to_order_keys_impl(
+            keys, depth_levels, 0, NULL, true, model_min_depth,
+            num_faces, vx, vy, vz, face_a, face_b, face_c);
+    }
+#endif
+    if( depth_shift == 0 )
+        return classify_faces_to_order_keys_impl(
+            keys, depth_levels, 0, debug_stats, near_clipped, model_min_depth, num_faces, vx, vy, vz, face_a, face_b, face_c);
+    return classify_faces_to_order_keys_impl(
+        keys, depth_levels, depth_shift, debug_stats, near_clipped, model_min_depth, num_faces, vx, vy, vz, face_a, face_b, face_c);
+}
+
 /*
  * Split so the shift is chosen ONCE, not per face.
  *
@@ -1069,6 +1348,12 @@ bucket_sort_by_average_depth_impl(

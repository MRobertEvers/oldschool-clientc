diff --git a/3rd/toridraw/test/aabb8_cyl_compare_test.c b/3rd/toridraw/test/aabb8_cyl_compare_test.c
new file mode 100644
index 000000000..4ad3abd9c
--- /dev/null
+++ b/3rd/toridraw/test/aabb8_cyl_compare_test.c
@@ -0,0 +1,120 @@
+/*
+ * Compare-mode test for the eight-corner cylinder AABB kernel.
+ *
+ * Runs toridraw_aabb8_cyl_sse2 against its scalar twin over a randomised
+ * sweep of every input that reaches it, plus the boundary cases the range
+ * test is there to exclude. The kernel claims to be bit-exact, not close, so
+ * the only accepted result is all four screen extents equal on every trial.
+ */
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "../graphics/projection.h"
+#include "../graphics/sse2_41compat.h"
+
+#define mullo_epi32_sse mullo_epi32_sse2
+
+#include "../graphics/projection_zdiv_simd.sse2.u.c"
+
+#include "../graphics/aabb8_cyl_sse2.h"
+
+static int g_sin_tab[2048];
+static int g_cos_tab[2048];
+
+static void
+tables_build(void)
+{
+    for( int i = 0; i < 2048; i++ )
+    {
+        g_sin_tab[i] = (int)(sin((double)i * 0.0030679615) * (double)(1 << 16));
+        g_cos_tab[i] = (int)(cos((double)i * 0.0030679615) * (double)(1 << 16));
+    }
+}
+
+static unsigned g_rng = 0x1234567u;
+
+static unsigned
+rng_next(void)
+{
+    g_rng ^= g_rng << 13;
+    g_rng ^= g_rng >> 17;
+    g_rng ^= g_rng << 5;
+    return g_rng;
+}
+
+static int
+rng_range(int lo, int hi)
+{
+    return lo + (int)(rng_next() % (unsigned)(hi - lo + 1));
+}
+
+int
+main(void)
+{
+    long trials = 0;
+    long taken = 0;
+    long rejected = 0;
+    long clipped_seen = 0;
+
+    tables_build();
+
+    for( long t = 0; t < 4000000L; t++ )
+    {
+        int radius = rng_range(0, 6000);
+        int min_y = rng_range(-6000, 0);
+        int max_y = rng_range(0, 6000);
+        int sx = rng_range(-14000, 14000);
+        int sy = rng_range(-14000, 14000);
+        int sz = rng_range(-14000, 14000);
+        int myaw = rng_range(0, 2047);
+        int cyaw = rng_range(0, 2047);
+        int cpitch = rng_range(0, 2047);
+        int near_z = rng_range(1, 60);
+        int cot15 = rng_range(1000, 200000);
+
+        struct ToriDraw_Aabb8Screen fast;
+        struct ToriDraw_Aabb8Screen twin;
+
+        trials++;
+
+        if( !toridraw_aabb8_cyl_sse2_fits(radius, min_y, max_y, sx, sy, sz) )
+        {
+            rejected++;
+            continue;
+        }
+        taken++;
+
+        toridraw_aabb8_cyl_sse2(
+            &fast, radius, min_y, max_y, g_cos_tab[myaw], g_sin_tab[myaw], sx, sy, sz, near_z,
+            cot15, g_cos_tab[cpitch], g_sin_tab[cpitch], g_cos_tab[cyaw], g_sin_tab[cyaw]);
+        toridraw_aabb8_cyl_ref(
+            &twin, radius, min_y, max_y, g_cos_tab[myaw], g_sin_tab[myaw], sx, sy, sz, near_z,
+            cot15, g_cos_tab[cpitch], g_sin_tab[cpitch], g_cos_tab[cyaw], g_sin_tab[cyaw]);
+
+        if( fast.min_sx == TORIDRAW_SCREEN_X_NEAR_CLIPPED )
+            clipped_seen++;
+
+        if( fast.min_sx != twin.min_sx || fast.max_sx != twin.max_sx ||
+            fast.min_sy != twin.min_sy || fast.max_sy != twin.max_sy )
+        {
+            printf(
+                "MISMATCH trial=%ld r=%d miny=%d maxy=%d s=(%d,%d,%d) myaw=%d cyaw=%d "
+                "cpitch=%d near=%d cot15=%d\n",
+                t, radius, min_y, max_y, sx, sy, sz, myaw, cyaw, cpitch, near_z, cot15);
+            printf(
+                "  fast x[%d..%d] y[%d..%d]\n", fast.min_sx, fast.max_sx, fast.min_sy,
+                fast.max_sy);
+            printf(
+                "  twin x[%d..%d] y[%d..%d]\n", twin.min_sx, twin.max_sx, twin.min_sy,
+                twin.max_sy);
+            return 1;
+        }
+    }
+
+    printf(
+        "aabb8_cyl compare: trials=%ld in-range=%ld rejected=%ld near-clipped=%ld  ALL EXACT\n",
+        trials, taken, rejected, clipped_seen);
+    return 0;
+}
diff --git a/3rd/toridraw/test/madd16_fused_translate_test.c b/3rd/toridraw/test/madd16_fused_translate_test.c
new file mode 100644
index 000000000..84e9c3f27
--- /dev/null
+++ b/3rd/toridraw/test/madd16_fused_translate_test.c
@@ -0,0 +1,137 @@
+/*
+ * Compare-mode test for the fused camera-yaw translate.
+ *
+ * The claim the projection kernels now rest on is an identity, not a bound:
+ *
+ *   ((x + sx)*cos + (z + sz)*sin) >> 16
+ *       == ((x*cos + z*sin) + (sx*cos + sz*sin)) >> 16
+ *
+ * over int32, wraparound included, with the left side the shipping scalar
+ * expression and the right side what toridraw_madd16 plus a broadcast constant
+ * computes. This sweeps the full int16 vertex range against the whole trig
+ * table and every scene offset the engine can produce, and accepts only exact
+ * equality on all four lanes.
+ */
+
+#include <math.h>
+#include <stdio.h>
+
+#include <emmintrin.h>
+
+#include "../graphics/madd16_sse2.h"
+
+static int g_sin_tab[2048];
+static int g_cos_tab[2048];
+
+static void
+tables_build(void)
+{
+    for( int i = 0; i < 2048; i++ )
+    {
+        g_sin_tab[i] = (int)(sin((double)i * 0.0030679615) * (double)(1 << 16));
+        g_cos_tab[i] = (int)(cos((double)i * 0.0030679615) * (double)(1 << 16));
+    }
+}
+
+static unsigned g_rng = 0x9e3779b9u;
+
+static unsigned
+rng_next(void)
+{
+    g_rng ^= g_rng << 13;
+    g_rng ^= g_rng >> 17;
+    g_rng ^= g_rng << 5;
+    return g_rng;
+}
+
+int
+main(void)
+{
+    long trials = 0;
+    long extreme = 0;
+
+    tables_build();
+
+    for( long t = 0; t < 3000000L; t++ )
+    {
+        int yaw = (int)(rng_next() % 2048u);
+        int c = g_cos_tab[yaw];
+        int s = g_sin_tab[yaw];
+        int sx = (int)(rng_next() % 65536u) - 32768;
+        int sz = (int)(rng_next() % 65536u) - 32768;
+        short vx[4];
+        short vz[4];
+        int ref_x[4];
+        int ref_z[4];
+        int got_x[4];
+        int got_z[4];
+
+        __m128i xv16;
+        __m128i zv16;
+        __m128i tx;
+        __m128i tz;
+        __m128i rx;
+        __m128i rz;
+
+        for( int k = 0; k < 4; k++ )
+        {
+            unsigned r = rng_next();
+            /* bias hard toward the int16 extremes, where the wraparound lives */
+            if( (r & 3u) == 0u )
+            {
+                vx[k] = (short)((r & 4u) ? 32767 : -32768);
+                vz[k] = (short)((r & 8u) ? 32767 : -32768);
+                extreme++;
+            }
+            else
+            {
+                vx[k] = (short)(r & 0xFFFFu);
+                vz[k] = (short)((r >> 16) & 0xFFFFu);
+            }
+            ref_x[k] = (((int)vx[k] + sx) * c + ((int)vz[k] + sz) * s) >> 16;
+            ref_z[k] = (((int)vz[k] + sz) * c - ((int)vx[k] + sx) * s) >> 16;
+        }
+
+        xv16 = _mm_loadl_epi64((__m128i*)vx);
+        zv16 = _mm_loadl_epi64((__m128i*)vz);
+        tx = _mm_set1_epi32(sx * c + sz * s);
+        tz = _mm_set1_epi32(sz * c - sx * s);
+
+        rx = _mm_srai_epi32(
+            _mm_add_epi32(
+                toridraw_madd16(
+                    _mm_unpacklo_epi16(xv16, zv16), toridraw_m16_hi(c, s),
+                    toridraw_m16_lo(c, s)),
+                tx),
+            16);
+        rz = _mm_srai_epi32(
+            _mm_add_epi32(
+                toridraw_madd16(
+                    _mm_unpacklo_epi16(zv16, xv16), toridraw_m16_hi(c, -s),
+                    toridraw_m16_lo(c, -s)),
+                tz),
+            16);
+
+        _mm_storeu_si128((__m128i*)got_x, rx);
+        _mm_storeu_si128((__m128i*)got_z, rz);
+        trials++;
+
+        for( int k = 0; k < 4; k++ )
+        {
+            if( got_x[k] != ref_x[k] || got_z[k] != ref_z[k] )
+            {
+                printf(
+                    "MISMATCH trial=%ld lane=%d yaw=%d c=%d s=%d v=(%d,%d) scene=(%d,%d)\n", t, k,
+                    yaw, c, s, (int)vx[k], (int)vz[k], sx, sz);
+                printf("  ref x=%d z=%d\n", ref_x[k], ref_z[k]);
+                printf("  got x=%d z=%d\n", got_x[k], got_z[k]);
+                return 1;
+            }
+        }
+    }
+
+    printf(
+        "madd16 fused translate: trials=%ld lanes=%ld int16-extreme lanes=%ld  ALL EXACT\n",
+        trials, trials * 4, extreme);
+    return 0;
+}

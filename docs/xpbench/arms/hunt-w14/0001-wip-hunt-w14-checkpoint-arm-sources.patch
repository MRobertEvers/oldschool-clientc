+            }
+            if( !scene_occluders_point_hidden(occ, scene_x, y1, scene_z) )
+                return false;
+            return scene_occluders_point_hidden(occ, scene_x + 128, y1, scene_z);
+        }
+    }
+
+    if( !scene_occluders_point_hidden(occ, scene_x + 64, y2, scene_z + 64) )

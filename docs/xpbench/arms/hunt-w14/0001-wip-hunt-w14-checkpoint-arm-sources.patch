+#if defined(TORIDRAW_OCC_CENSUS) && TORIDRAW_OCC_CENSUS
+static bool
+scene_occluders_wall_hidden_impl(
+    struct SceneOccluders* occ,
+    int level,
+    int x,
+    int z,
+    int wall_side)
+{
+    int scene_x;
+    int scene_z;
+    int scene_y;
+    int y0;
+    int y1;
+    int y2;
+
+    assert(occ);
+    if( occ->active_count == 0 )
+        return false;
+    if( !scene_occluders_ground_tile_hidden(occ, level, x, z) )
+        return false;

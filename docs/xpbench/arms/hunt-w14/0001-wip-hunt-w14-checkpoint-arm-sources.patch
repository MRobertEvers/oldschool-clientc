+#if defined(TORIDRAW_OCC_CENSUS) && TORIDRAW_OCC_CENSUS
+static bool
+scene_occluders_footprint_hidden_impl(
+    struct SceneOccluders* occ,
+    int level,
+    int sx,
+    int sz,
+    int size_x,
+    int size_z,
+    int model_min_y)
+{
+    int min_x;
+    int max_x;
+    int min_z;
+    int max_z;
+    int x;
+    int z;
+    int px;
+    int pz;
+    int y0;
+    int x1;
+    int z1;
+
+    assert(occ);
+    if( occ->active_count == 0 )
+        return false;
+
+    assert(size_x >= 1);
+    assert(size_z >= 1);
+    min_x = sx;
+    min_z = sz;
+    max_x = sx + size_x - 1;
+    max_z = sz + size_z - 1;
+
+    if( min_x != max_x || min_z != max_z )
+    {
+        for( x = min_x; x <= max_x; x++ )
+            for( z = min_z; z <= max_z; z++ )
+            {
+                int idx;
+                if( x < 0 || z < 0 || x >= occ->width || z >= occ->height )
+                    return false;
+                idx = tile_cycle_idx(occ, level, x, z);
+                if( occ->tile_cycle[idx] == -occ->frame_no )
+                    return false;
+            }
+
+        px = (min_x << 7) + 1;
+        pz = (min_z << 7) + 2;
+        y0 = scene_occluders_ground_height(occ, min_x, min_z, level) - model_min_y;
+        if( !scene_occluders_point_hidden(occ, px, y0, pz) )
+            return false;
+        x1 = (max_x << 7) - 1;
+        if( !scene_occluders_point_hidden(occ, x1, y0, pz) )
+            return false;
+        z1 = (max_z << 7) - 1;
+        if( !scene_occluders_point_hidden(occ, px, y0, z1) )
+            return false;
+        return scene_occluders_point_hidden(occ, x1, y0, z1);
+    }
+
+    return scene_occluders_column_hidden(occ, level, min_x, min_z, model_min_y);
+}
 
+/* Counting wrapper: the yield of this predicate is the number that
+ * decides whether the analytic occluders are already doing the job a
+ * screen-space pre-pass would duplicate. */
+bool
+scene_occluders_footprint_hidden(
+    struct SceneOccluders* occ,
+    int level,
+    int sx,
+    int sz,
+    int size_x,
+    int size_z,
+    int model_min_y)
+{
+    bool hit;
+    g_scene_occluder_census.footprint_calls++;
+    hit = scene_occluders_footprint_hidden_impl(occ, level, sx, sz, size_x, size_z, model_min_y);
+    if( hit )
+        g_scene_occluder_census.footprint_hits++;
+    return hit;
+}
+#else
 bool
 scene_occluders_footprint_hidden(
     struct SceneOccluders* occ,
@@ -918,3 +1225,5 @@ scene_occluders_footprint_hidden(
 
     return scene_occluders_column_hidden(occ, level, min_x, min_z, model_min_y);
 }
+#endif

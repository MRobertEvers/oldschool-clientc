+#if defined(TORIDRAW_CMDCULL_CENSUS) && TORIDRAW_CMDCULL_CENSUS
+/*
+ * Whole-command rejection, measured but NOT acted on.
+ *
+ * The question this answers, and which no existing counter does: if the
+ * renderer walked the command buffer front-to-back and dropped every command
+ * whose screen AABB was already fully covered, how many commands would go?
+ * A dropped command takes its projection, its face sort, its span setup and
+ * its fill with it, so the answer scales the whole share of frame that the two
+ * raster kernels plus the sorter occupy.
+ *
+ * Two variants are counted because they bracket the truth:
+ *
+ *   opt   coverage is stamped from every cell a drawn command's AABB TOUCHES.
+ *         A model does not fill its AABB, so this over-states coverage; it is
+ *         an upper bound on what any AABB-granular scheme can ever reach, and
+ *         therefore the number that kills the route if it comes back small.
+ *   cons  coverage is stamped only from the cells an AABB covers ENTIRELY.
+ *         Still optimistic -- the model does not fill those cells either --
+ *         but it is the tighter of the two bounds.
+ *
+ * Rejection in both variants requires every cell the candidate AABB touches to
+ * be covered, which is the conservative direction.
+ *
+ * Counting only: commands are recorded as they draw and the backwards walk
+ * runs at END_3D, so the rendered frame is identical to the uninstrumented
+ * build.
+ */
+#define CMDCULL_MAX_CMDS 8192
+#define CMDCULL_CELL_SHIFT 3
+#define CMDCULL_MAX_CELLS 8192
+
+struct CmdCullRec
+{
+    short min_x;
+    short min_y;
+    short max_x;
+    short max_y;
+    int faces;
+};
+
+static struct CmdCullRec g_cmdcull_rec[CMDCULL_MAX_CMDS];
+static int g_cmdcull_n;
+static unsigned char g_cmdcull_opt[CMDCULL_MAX_CELLS];
+static unsigned char g_cmdcull_cons[CMDCULL_MAX_CELLS];
+
+static struct
+{
+    unsigned long long frames;
+    unsigned long long cmds;
+    unsigned long long culled;
+    unsigned long long sort_empty;
+    unsigned long long drawn;
+    unsigned long long faces;
+    unsigned long long overflow;
+    unsigned long long opt_hidden;
+    unsigned long long opt_hidden_faces;
+    unsigned long long cons_hidden;
+    unsigned long long cons_hidden_faces;
+    /* Extent of the 8-point AABB for the models that sort to zero faces, so
+     * the "43.6 models project and sort and draw nothing" line can be blamed
+     * on -- or cleared of -- a degenerate screen box. */
+    unsigned long long empty_w[6];
+    unsigned long long empty_h[6];
+} g_cmdcull;
+
+static int
+cmdcull_bucket(int v)
+{
+    if( v <= 0 )
+        return 0;
+    if( v == 1 )
+        return 1;
+    if( v == 2 )
+        return 2;
+    if( v < 4 )
+        return 3;
+    if( v < 8 )
+        return 4;
+    return 5;
+}
+
+static void
+cmdcull_dump(void)
+{
+    const char* path = getenv("TORIDRAW_CMDCULL_FILE");
+    FILE* f = path ? fopen(path, "w") : stderr;
+    double frames = (double)(g_cmdcull.frames ? g_cmdcull.frames : 1);
+    double drawn = (double)(g_cmdcull.drawn ? g_cmdcull.drawn : 1);
+    double faces = (double)(g_cmdcull.faces ? g_cmdcull.faces : 1);
+    int i;
+
+    assert(f);
+    fprintf(f, "command-cull census over %llu frames\n", g_cmdcull.frames);
+    fprintf(f, "  model commands       %.1f/frame\n", (double)g_cmdcull.cmds / frames);
+    fprintf(f, "  projection-culled    %.1f/frame\n", (double)g_cmdcull.culled / frames);
+    fprintf(f, "  sorted to zero faces %.1f/frame\n",
+            (double)g_cmdcull.sort_empty / frames);
+    fprintf(f, "  rasterizing          %.1f/frame  (%.1f faces/frame)\n",
+            drawn / frames, faces / frames);
+    fprintf(f, "  record overflow      %llu\n", g_cmdcull.overflow);
+    fprintf(f, "  OPT  fully covered   %llu (%.2f%% of rasterizing, %.2f%% of faces)\n",
+            g_cmdcull.opt_hidden, 100.0 * (double)g_cmdcull.opt_hidden / drawn,
+            100.0 * (double)g_cmdcull.opt_hidden_faces / faces);
+    fprintf(f, "  CONS fully covered   %llu (%.2f%% of rasterizing, %.2f%% of faces)\n",
+            g_cmdcull.cons_hidden, 100.0 * (double)g_cmdcull.cons_hidden / drawn,
+            100.0 * (double)g_cmdcull.cons_hidden_faces / faces);
+    fprintf(f, "  sort-empty AABB width  buckets (0,1,2,3,4-7,8+):");
+    for( i = 0; i < 6; i++ )
+        fprintf(f, " %llu", g_cmdcull.empty_w[i]);
+    fprintf(f, "\n  sort-empty AABB height buckets (0,1,2,3,4-7,8+):");
+    for( i = 0; i < 6; i++ )
+        fprintf(f, " %llu", g_cmdcull.empty_h[i]);
+    fprintf(f, "\n");
+    if( path )
+        fclose(f);
+}
+
+static void
+cmdcull_arm(void)
+{
+    static int armed;
+    if( armed )
+        return;
+    armed = 1;
+    atexit(cmdcull_dump);
+}
+
+static void
+cmdcull_record(struct ToriRS_Soft3D* soft, int faces)
+{
+    struct CmdCullRec* r;
+    const struct ToriDraw_AABB* a = &soft->scene->aabb;
+
+    if( g_cmdcull_n >= CMDCULL_MAX_CMDS )
+    {
+        g_cmdcull.overflow++;
+        return;
+    }
+    r = &g_cmdcull_rec[g_cmdcull_n++];
+    r->min_x = (short)(a->min_screen_x < -4096 ? -4096 : a->min_screen_x);
+    r->min_y = (short)(a->min_screen_y < -4096 ? -4096 : a->min_screen_y);
+    r->max_x = (short)(a->max_screen_x > 4096 ? 4096 : a->max_screen_x);
+    r->max_y = (short)(a->max_screen_y > 4096 ? 4096 : a->max_screen_y);
+    r->faces = faces;
+}
+
+static void
+cmdcull_flush(struct ToriRS_Soft3D* soft)
+{
+    int w = soft->view_port_3d.width;
+    int h = soft->view_port_3d.height;
+    int cw = (w + 7) >> CMDCULL_CELL_SHIFT;
+    int ch = (h + 7) >> CMDCULL_CELL_SHIFT;
+    int i;
+
+    cmdcull_arm();
+    g_cmdcull.frames++;
+    if( cw <= 0 || ch <= 0 || cw * ch > CMDCULL_MAX_CELLS )
+    {
+        g_cmdcull_n = 0;
+        return;
+    }
+    memset(g_cmdcull_opt, 0, (size_t)(cw * ch));
+    memset(g_cmdcull_cons, 0, (size_t)(cw * ch));
+
+    /* Backwards over the recorded draw order is front-to-back. */
+    for( i = g_cmdcull_n - 1; i >= 0; i-- )
+    {
+        struct CmdCullRec* r = &g_cmdcull_rec[i];
+        int x0 = r->min_x < 0 ? 0 : r->min_x;
+        int y0 = r->min_y < 0 ? 0 : r->min_y;
+        int x1 = r->max_x >= w ? w - 1 : r->max_x;
+        int y1 = r->max_y >= h ? h - 1 : r->max_y;
+        int cx0;
+        int cx1;
+        int cy0;
+        int cy1;
+        int cx;
+        int cy;
+        int opt_cov = 1;
+        int cons_cov = 1;
+
+        if( x1 < x0 || y1 < y0 )
+            continue;
+        cx0 = x0 >> CMDCULL_CELL_SHIFT;
+        cx1 = x1 >> CMDCULL_CELL_SHIFT;
+        cy0 = y0 >> CMDCULL_CELL_SHIFT;
+        cy1 = y1 >> CMDCULL_CELL_SHIFT;
+
+        for( cy = cy0; cy <= cy1 && (opt_cov || cons_cov); cy++ )
+            for( cx = cx0; cx <= cx1; cx++ )
+            {
+                if( !g_cmdcull_opt[cy * cw + cx] )
+                    opt_cov = 0;
+                if( !g_cmdcull_cons[cy * cw + cx] )
+                    cons_cov = 0;
+                if( !opt_cov && !cons_cov )
+                    break;
+            }
+        if( opt_cov )
+        {
+            g_cmdcull.opt_hidden++;
+            g_cmdcull.opt_hidden_faces += (unsigned)r->faces;
+        }
+        if( cons_cov )
+        {
+            g_cmdcull.cons_hidden++;
+            g_cmdcull.cons_hidden_faces += (unsigned)r->faces;
+        }
+
+        for( cy = cy0; cy <= cy1; cy++ )
+            for( cx = cx0; cx <= cx1; cx++ )
+                g_cmdcull_opt[cy * cw + cx] = 1;
+
+        /* Interior cells only: cell c spans pixels [8c, 8c+7]. */
+        {
+            int ix0 = (x0 + 7) >> CMDCULL_CELL_SHIFT;
+            int iy0 = (y0 + 7) >> CMDCULL_CELL_SHIFT;
+            int ix1 = x1 >= 7 ? (x1 - 7) >> CMDCULL_CELL_SHIFT : -1;
+            int iy1 = y1 >= 7 ? (y1 - 7) >> CMDCULL_CELL_SHIFT : -1;
+            for( cy = iy0; cy <= iy1; cy++ )
+                for( cx = ix0; cx <= ix1; cx++ )
+                    g_cmdcull_cons[cy * cw + cx] = 1;
+        }
+    }
+    g_cmdcull_n = 0;
+}
+#endif

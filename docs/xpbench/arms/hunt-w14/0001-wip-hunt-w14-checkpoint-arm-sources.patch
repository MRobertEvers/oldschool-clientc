+/*
+ * Merge-area histogram at the two build gates.
+ *
+ * OCCLUDER_WALL_MIN_TILE_AREA / OCCLUDER_FLOOR_MIN_TILE_AREA are the reference
+ * client's 8 and 4, and nobody had checked what they throw away on this map.
+ * Index is (levels x tiles) clamped to 15; the two gates are counted
+ * separately, once per run at the run's origin tile so a rejected run -- whose
+ * marks are deliberately left set -- is not counted once per tile it covers.
+ */
+unsigned g_occ_build_wall_area_hist[16];
+unsigned g_occ_build_floor_area_hist[16];
+#define OCC_BUILD_HIST(h, a) ((h)[(a) < 15 ? (a) : 15]++)
+#else
+#define OCC_BUILD_HIST(h, a) ((void)0)
+#endif
+
 #define OCCLUDER_TILE_SIZE 128
 
 static inline int
@@ -264,6 +282,8 @@ occluder_buildmap_build_occluders(
                         }
 
                         area = (max_level + 1 - min_level) * (max_tz + 1 - min_tile_z);
+                        if( tile_z == min_tile_z && level == min_level )
+                            OCC_BUILD_HIST(g_occ_build_wall_area_hist, area);
                         if( area >= OCCLUDER_WALL_MIN_TILE_AREA )
                         {
                             int min_y =
@@ -351,6 +371,8 @@ occluder_buildmap_build_occluders(
                         }
 
                         area = (max_level + 1 - min_level) * (max_tx + 1 - min_tile_x);
+                        if( tile_x == min_tile_x && level == min_level )
+                            OCC_BUILD_HIST(g_occ_build_wall_area_hist, area);
                         if( area >= OCCLUDER_WALL_MIN_TILE_AREA )
                         {
                             int min_y =
@@ -436,6 +458,10 @@ occluder_buildmap_build_occluders(
                             max_tx++;
                         }
 
+                        if( tile_x == min_tile_x && tile_z == min_tile_z )
+                            OCC_BUILD_HIST(
+                                g_occ_build_floor_area_hist,
+                                (max_tx + 1 - min_tile_x) * (max_tz + 1 - min_tile_z));
                         if( (max_tx + 1 - min_tile_x) * (max_tz + 1 - min_tile_z) >=
                             OCCLUDER_FLOOR_MIN_TILE_AREA )
                         {
@@ -463,4 +489,27 @@ occluder_buildmap_build_occluders(
             }
         }
     }
+
+#if defined(TORIDRAW_OCC_CENSUS) && TORIDRAW_OCC_CENSUS
+    {
+        int a;
+        fprintf(stderr, "occluder build: per-level counts");
+        for( a = 0; a < map->levels; a++ )
+            fprintf(stderr, " L%d=%d", a, out->level_occluder_count[a]);
+        fprintf(stderr, "\n");
+        fprintf(stderr, "occluder build: wall merge areas (gate >= %d)\n",
+                OCCLUDER_WALL_MIN_TILE_AREA);
+        for( a = 1; a < 16; a++ )
+            if( g_occ_build_wall_area_hist[a] )
+                fprintf(stderr, "  area %2d%s : %u runs\n", a, a == 15 ? "+" : " ",
+                        g_occ_build_wall_area_hist[a]);
+        fprintf(stderr, "occluder build: floor merge areas (gate >= %d)\n",
+                OCCLUDER_FLOOR_MIN_TILE_AREA);
+        for( a = 1; a < 16; a++ )
+            if( g_occ_build_floor_area_hist[a] )
+                fprintf(stderr, "  area %2d%s : %u runs\n", a, a == 15 ? "+" : " ",
+                        g_occ_build_floor_area_hist[a]);
+        fflush(stderr);
+    }
+#endif
 }

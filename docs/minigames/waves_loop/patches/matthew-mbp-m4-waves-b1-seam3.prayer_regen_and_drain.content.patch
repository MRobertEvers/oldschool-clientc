@@ -146,16 +146,43 @@ return(false);
 // calling a drain proc, which is the engine scheduling a game rule. The
 // reference sets its own timer from here for exactly this reason.
 //
-// One tick rather than the reference's five, because this server's drain
-// accumulator is per-tick — see [timer,prayer_drain] for the arithmetic. The
-// timer is cleared when nothing is on, so an idle player runs no script.
+// The drain is per tick (wiki Prayer rev 15358187, Prayer:459: the total drain
+// effect "is added to an internal prayer drain counter each game tick") — see
+// [timer,prayer_drain] for the arithmetic. The timer is cleared when nothing is
+// on, so an idle player runs no script.
+//
+// Two modern rules decide WHEN it is armed, and neither may touch the counter
+// (waves seam pass 3, prayer_regen_and_drain):
+//
+// - "the game does not drain prayer for prayers on the tick they are
+//   activated ... 1-tick flicking works because ... the game also thinks
+//   those prayers were just activated when you get to the end of each tick so
+//   prayer is never drained" (Prayer:528), and a protection prayer turned off
+//   "within the next tick" consumes nothing (Prayer:503). A press reaches this
+//   server between ticks with `map_clock` = c and is in force from tick c+1's
+//   npc phase; the real game's drain for that activation tick runs AFTER the
+//   next tick's input, which here is tick c+2's timer phase. So the first
+//   drain is armed two ticks out, and only when nothing was draining before
+//   (`$was` = 0 after any conflicting prayer came off): a prayer already
+//   draining keeps its every-tick timer untouched, so a switch never costs a
+//   held prayer a tick either.
+// - The counter is "a fraction" that "can be reset through a rejuvenation
+//   pool, the Falador shield prayer recharge, or dying. Drinking a Prayer
+//   potion will NOT reset it" (Prayer:35). Turning the last prayer off is not
+//   in that list, so it no longer zeroes the counter.
+//
+// Open: a prayer lit while another is ALREADY draining is charged on its
+// activation tick (the timer cannot tell it apart without a per-prayer
+// "lit since the last drain" mask, i.e. a new temp varp in prayers.varp).
 [proc,prayer_switched](int $drain_delta)
-%varp6297_prayer_drain_effect = max(0, calc(%varp6297_prayer_drain_effect + $drain_delta));
+def_int $was = %varp6297_prayer_drain_effect;
+%varp6297_prayer_drain_effect = max(0, calc($was + $drain_delta));
 if (%varp6297_prayer_drain_effect > 0) {
-    settimer(prayer_drain, 1);
+    if ($was <= 0) {
+        settimer(prayer_drain, 2);
+    }
 } else {
     cleartimer(prayer_drain);
-    %varp6296_prayer_drain_counter = 0;
 }
 ~player_combat_stat;
 
@@ -329,8 +356,11 @@ def_dbrow $data = ~get_prayer_data($prayer);
 %varp6297_prayer_drain_effect = max(0, calc(%varp6297_prayer_drain_effect - db_getfield($data, prayer_table:drain, 0)));
 sound_synth(cancel_prayer, 1, 0);
 
-// Everything off, and the counters with it. Called on death and when the
-// last prayer point goes.
+// Everything off. Called on death, when the last prayer point goes, by the
+// quick-prayer orb and by every forced deactivation. The drain COUNTER is

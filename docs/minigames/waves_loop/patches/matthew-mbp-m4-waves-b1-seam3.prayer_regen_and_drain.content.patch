+// reset belongs to its caller (player/death.rs2), which knows it is a death.
 [proc,prayer_deactivate_all]
 def_int $prayer = 0;
 while ($prayer < ^prayer_count) {
@@ -339,7 +369,6 @@ while ($prayer < ^prayer_count) {
 }
 headicons_set(0);
 %varp6297_prayer_drain_effect = 0;
-%varp6296_prayer_drain_counter = 0;

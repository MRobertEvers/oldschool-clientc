diff --git a/osrs239-content/server/scripts/player/scripts/stat_restore.rs2 b/osrs239-content/server/scripts/player/scripts/stat_restore.rs2
index a1651c71f7..450b1c5106 100644
--- a/osrs239-content/server/scripts/player/scripts/stat_restore.rs2
+++ b/osrs239-content/server/scripts/player/scripts/stat_restore.rs2
@@ -8,7 +8,8 @@
 // Wiki: every boosted or drained stat moves one level toward its base once a
 // minute (100 ticks), independent of the others. Hitpoints are NOT handled here
 // — `[timer,health_regen]` owns them and has its own interval, doubled by Rapid
-// Heal and by the Hitpoints cape.
+// Heal and by the Hitpoints cape. Drained Prayer is not restored either (see
+// the drained branch below): prayer points do not regenerate.
 //
 // A stat can be addressed by index here, unlike a varbit: `stat`, `stat_base`,
 // `stat_heal` and `stat_sub` all take the stat from the stack rather than from
@@ -40,8 +41,21 @@ while ($stat < ^stat_count) {
         if ($now > $base) {
             // Boosted: one level off the top.
             stat_sub($stat, 1, 0);
-        } else if ($now < $base) {
+        } else if ($now < $base & $stat ! 5) {
             // Drained: one level back on. `stat_heal` clamps at base.
+            //
+            // Not Prayer (stat 5, the engine's index: attack 0, defence 1,
+            // strength 2, hitpoints 3, ranged 4, prayer 5). Drained prayer
+            // points are spent points, and they stay spent: "Unlike Hitpoints,
+            // prayer points do not regenerate over time (outside of the
+            // Demonic Ruins) and can only be restored by praying at an altar,
+            // consuming potions, or using certain Special attacks" (wiki
+            // Combat rev 15270648, docs/minigames/inferno/sources/wiki/
+            // wiki_Combat.wikitext:82). A prayer BOOST above base (an altar
+            // that recharges past the maximum) still decays with every other
+            // boost, which is the boost rule of wiki Temporary skill boost:46.
+            // Measured before this line: 82 -> 84 over 222 ticks with nothing
+            // lit (waves seam pass 3, build/quest_gate/prd_a_before).
             stat_heal($stat, 1, 0);
         }
     }
diff --git a/osrs239-content/server/scripts/skill_prayer/scripts/prayer.rs2 b/osrs239-content/server/scripts/skill_prayer/scripts/prayer.rs2

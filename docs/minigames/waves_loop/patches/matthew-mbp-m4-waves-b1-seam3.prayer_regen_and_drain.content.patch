@@ -538,7 +567,9 @@ if (^curses_enabled = 1 & ~curses_book_open = true) {
 //
 // `60 + 2 * prayerbonus` is the one place the equipment screen's "Prayer: +N"
 // has a mechanical effect. The floor of 60 is deliberate — a negative prayer
-// bonus does not make prayers drain faster than bare hands.
+// bonus does not make prayers drain faster than bare hands. (Open: the wiki's
+// formula, Prayer:463 "drain_resistance = 2 x bonus + 60", states no floor, and
+// no pinned source says what a negative bonus does; left as it was.)
 //
 // A TIMER, not a proc the engine calls. `~prayer_switched` starts it when the
 // first prayer goes on and stops it when the last goes off, so the engine
@@ -550,10 +581,12 @@ if (^curses_enabled = 1 & ~curses_book_open = true) {
 // the engine has to compute is an argument the engine has to know about.
 [timer,prayer_drain]
 if (%varp6297_prayer_drain_effect <= 0) {
-    %varp6296_prayer_drain_counter = 0;
     cleartimer(prayer_drain);
     return;
 }
+// `~prayer_switched` arms the first drain two ticks out (the activation tick

diff --git a/osrs239-content/server/scripts/player/scripts/consumption/consume_shared.rs2 b/osrs239-content/server/scripts/player/scripts/consumption/consume_shared.rs2
new file mode 100644
index 0000000000..7e362a2199
--- /dev/null
+++ b/osrs239-content/server/scripts/player/scripts/consumption/consume_shared.rs2
@@ -0,0 +1,171 @@
+// The consume timers every food, potion and mix shares.
+//
+// An eat or a drink is a set of clocks and never a park: no consume script
+// `p_delay`s. Anything queued on the player -- every scripted npc hit rides
+// `queue(combat_damage_player, ...)`, and the engine drains no queue while
+// the player is delayed (torirs_server_scripts.c drain_queue /
+// player_can_access) -- therefore lands on its own tick while the player
+// eats. This tree used to `p_delay(^eat_delay)` after every bite and
+// `p_delay(1)` after every sip, which held every queued hit for the park
+// (measured on waves seam pass 3's HEAD, build/quest_gate/eat3_before: a
+// young dark wizard's spell cast on 36 landed on 38 and one cast on 52 on 55,
+// against +1 for every uneaten cast). OldSchool has no such park: "Tick-eating
+// is the act of eating a piece of food between the time a monster's attack
+// calculates its damage and when it hits the player" (wiki Tick eating), and
+// "A player can combo eat by clicking a regular food and then a combo food
+// later in the same tick; both items will be consumed and apply their healing
+// in one game tick" (wiki Food/Fast foods), which a parked player could not do.
+//
+// The numbers. Every quote is from a page pinned under
+// docs/minigames/inferno/sources/wiki/ on 2026-10-03 (rows in
+// docs/minigames/inferno/sources/LEDGER_wiki.md):
+//
+//   - food (Food/Fast foods, revid 15360001): "Standard food, when eaten, adds
+//     a 3 tick penalty to when a player may eat again." Encoded as a clock:
+//     the timer holds the last map_clock on which the next bite is still
+//     refused, so `^eat_delay` = 2 is a 3-tick gap.
+//   - attack (same page): "If the player has attacked recently and is
+//     currently waiting on a weapon delay to attack again, this also adds a
+//     3 tick delay before that attack." "Foods only add to an existing attack
+//     delay between weapon attacks. If your weapon is ready to attack again
+//     then eating does not add any new delay." Karambwan and halibut "have a
+//     2 tick attack delay"; stacked: "eating a shark with a karambwan results
+//     in a 3 + 2 = 5 tick attack delay". The weapon delay is
+//     `%varp5732_action_delay`, the clock `[label,player_melee_attack]` waits
+//     on (skill_combat/combat.rs2).
+//   - combo food (Food/Fast foods; Cooked karambwan, revid 15358532): "combo
+//     foods do not respect the eat delay incurred by other foods"; a karambwan
+//     after another food works, "this does not work if the karambwan is eaten
+//     first, and does not work when eating two karambwan in a row." So a combo
+//     food checks its own timer, not the food timer, and sets both.
+//   - potions (Potions, revid 15351958): "drinking a non-barbarian potion will
+//     delay your next potion consumption by 3 ticks (1.8 seconds). Notably,
+//     food and potions do not share the same timer ... Note that drinking
+//     barbarian mixes use the same timer that eating food does." (Food/Fast
+//     foods): "Potions do not incur the standard 3 tick (1.8 second) attack or
+//     eat delay."
+//
+// And no consume `p_stopaction`s any more. Every one of these scripts ended in
+// one, which cleared the player's target and step queue: the eater stopped
+// fighting, and an Attack pressed with a drink was wiped (measured,
+// eat3_before: an Attack pressed with a sip from idle never swung). The wiki's
+// eat delay is a delay "before that attack" -- the fight goes on through the
+// eat, which is how "players utilising these faster foods can expect an
+// additional attack for every 4 food consumed" (Food/Fast foods). This
+// engine's OPHELD clears nothing (torirs_server_world.c), so dropping the
+// content call is the whole change.
+//
+// Each kind is two calls: a READY test at the top of the consume script, before
+// anything is spent, and a TAKEN call where the effect lands (where the old
+// p_delay was). The split keeps a refusal that the script itself makes (an
+// overload refused below 51 hitpoints, an NMZ potion outside a dream) from
+// spending the timer -- nothing suspends between the two calls, so they are
+// one tick's work either way.
+
+// ---------------------------------------------------------------- food
+[proc,consume_food_ready](boolean $combo)(boolean)
+if ($combo = true) {
+    if (%varp7223_consume_combo_delay >= map_clock) {
+        return(false);
+    }
+    return(true);
+}
+if (%varp7224_consume_food_delay >= map_clock) {
+    return(false);
+}
+return(true);
+
+// `$eat_delay` in the clock encoding above (2 = the standard 3-tick gap; a
+// pie's first bite passes 0, a 1-tick gap). `$attack_delay` is the ticks added to a
+// weapon delay that is still running: 3 for standard food, 2 for combo food.
+[proc,consume_food_taken](int $eat_delay, int $attack_delay, boolean $combo)
+%varp7224_consume_food_delay = calc(map_clock + $eat_delay);
+if ($combo = true) {
+    %varp7223_consume_combo_delay = calc(map_clock + $eat_delay);
+}
+~consume_attack_delay($attack_delay);
+
+// The OldSchool combo foods this tree can eat through general/scripts/food.rs2
+// (wiki Template:Fast_foods_table: attack delay 2, eat delay 3, combo yes).
+[proc,consume_combo_food](obj $food)(boolean)
+if ($food = tbwt_cooked_karambwan | $food = halibut) {
+    return(true);
+}
+return(false);
+
+// ---------------------------------------------------------------- attack
+[proc,consume_attack_delay](int $ticks)
+if ($ticks > 0 & %varp5732_action_delay > map_clock) {
+    %varp5732_action_delay = add(%varp5732_action_delay, $ticks);
+}
+
+// ---------------------------------------------------------------- potions
+[proc,consume_potion_ready]()(boolean)
+if (%varp7225_consume_potion_delay >= map_clock) {
+    return(false);
+}
+return(true);
+
+// The 3-tick potion gap, in the same encoding as `^eat_delay`. No attack delay.
+[proc,consume_potion_taken]
+%varp7225_consume_potion_delay = calc(map_clock + 2);
+
+// ---------------------------------------------------------------- test affordances
+// A test drives an eat through the backpack (t.player.inv_op), and that verb
+// settles for three ticks, so no test can press twice inside one food delay.
+// These two are the readouts that let a test see the clocks anyway. Neither
+// eats, drinks or attacks.
+
+// `::eatdelay` -- the three consume timers and the weapon delay, each as
+// "refused through tick N" against the current map_clock.
+[debugproc,eatdelay]
+mes("eatdelay: clock <tostring(map_clock)> food <tostring(%varp7224_consume_food_delay)> combo <tostring(%varp7223_consume_combo_delay)> potion <tostring(%varp7225_consume_potion_delay)> action <tostring(%varp5732_action_delay)>");
+
+// `::eatgate` -- the gate procs this file exports, run in one tick in the order
+// a combo eat runs them (food, a second food, a combo food, a second combo
+// food, a potion, a second potion; then the weapon delay ready and running),
+// each answer printed 1/0. Every clock is put back afterwards.
+[debugproc,eatgate]
+def_int $food = %varp7224_consume_food_delay;
+def_int $combo = %varp7223_consume_combo_delay;
+def_int $potion = %varp7225_consume_potion_delay;
+def_int $action = %varp5732_action_delay;
+%varp7224_consume_food_delay = 0;
+%varp7223_consume_combo_delay = 0;
+%varp7225_consume_potion_delay = 0;
+%varp5732_action_delay = 0;
+def_string $line = "eatgate:";
+$line = append($line, " food <tostring(~consume_bit(~consume_food_ready(false)))>");
+~consume_food_taken(^eat_delay, 3, false);
+$line = append($line, " food-after-food <tostring(~consume_bit(~consume_food_ready(false)))>");
+$line = append($line, " combo-after-food <tostring(~consume_bit(~consume_food_ready(true)))>");
+~consume_food_taken(^eat_delay, 2, true);
+$line = append($line, " combo-after-combo <tostring(~consume_bit(~consume_food_ready(true)))>");
+$line = append($line, " potion-after-food <tostring(~consume_bit(~consume_potion_ready))>");
+~consume_potion_taken;
+$line = append($line, " potion-after-potion <tostring(~consume_bit(~consume_potion_ready))>");
+// Two lines: one would pass the 199 characters a chat line renders (trap 27).
+mes($line);
+$line = "eatgate+:";
+$line = append($line, " food-refused-through +<tostring(sub(%varp7224_consume_food_delay, map_clock))>");
+$line = append($line, " potion-refused-through +<tostring(sub(%varp7225_consume_potion_delay, map_clock))>");
+// weapon ready (delay = now): an eat adds nothing
+%varp5732_action_delay = map_clock;
+~consume_attack_delay(3);
+$line = append($line, " attack-ready +<tostring(sub(%varp5732_action_delay, map_clock))>");
+// weapon running (2 ticks left): a shark then a karambwan add 3 + 2
+%varp5732_action_delay = add(map_clock, 2);
+~consume_attack_delay(3);
+~consume_attack_delay(2);
+$line = append($line, " attack-running-2 +<tostring(sub(%varp5732_action_delay, map_clock))>");
+%varp7224_consume_food_delay = $food;
+%varp7223_consume_combo_delay = $combo;
+%varp7225_consume_potion_delay = $potion;
+%varp5732_action_delay = $action;
+mes($line);
+
+[proc,consume_bit](boolean $b)(int)
+if ($b = true) {
+    return(1);
+}
+return(0);
diff --git a/osrs239-content/server/scripts/player/configs/consumption/consume_delay.varp b/osrs239-content/server/scripts/player/configs/consumption/consume_delay.varp
new file mode 100644
index 0000000000..700af75d60
--- /dev/null
+++ b/osrs239-content/server/scripts/player/configs/consumption/consume_delay.varp
@@ -0,0 +1,28 @@
+// The three consume timers (player/scripts/consumption/consume_shared.rs2).
+//
+// Each holds the last map_clock on which the next consume of its kind is still
+// refused: a consume is refused while the timer >= map_clock, then sets it to
+// map_clock + its delay. `scope=temp` because a timer is not account state;
+// `transmit=no` because nothing client-side reads it. Three timers and not one,
+// because OldSchool keeps three: food, potions (wiki Potions: "food and
+// potions do not share the same timer") and combo food (wiki Cooked karambwan:
+// a karambwan "may be consumed after other foods without delay; this does not
+// work if the karambwan is eaten first, and does not work when eating two
+// karambwan in a row"). Pages pinned under docs/minigames/inferno/sources/wiki/.
+// Ids 7223-7225: the raid branch allocated the same names as 7218-7220, which
+// this branch's v3 already uses (docs/minigames/waves_loop/MERGE_CHECKLIST.md).
+
+[varp7223_consume_combo_delay]
+transmit=no
+scope=temp
+protect=no
+
+[varp7224_consume_food_delay]
+transmit=no
+scope=temp
+protect=no
+
+[varp7225_consume_potion_delay]
+transmit=no
+scope=temp
+protect=no

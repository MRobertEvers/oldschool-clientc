-[opheld1,_vegetable] @eat_food(last_slot, last_item);
-[opheld1,_cake] @eat_food(last_slot, last_item);
+// The last two arguments are the bite's eat delay in the clock encoding of
+// player/scripts/consumption/consume_shared.rs2 (a gap of N ticks is N - 1):
+// the first while bites remain, the second on the last bite. Standard food is
+// `^eat_delay` (2, a 3-tick gap) both times. The rest are the "Eat delay
+// (ticks)" column of the wiki's Template:Fast foods table (revid 15316794,
+// pinned under docs/minigames/inferno/sources/wiki/): cakes 2,2,3 (1 then 2),
+// pizzas 1,2 (0 then 1), redberry, meat and apple pies 1,2 (0 then 1), and the
+// dragonfruit, wild and summer pies 1,1 (`~food_pie_fast_half` below).
+[opheld1,_cooked_meat] @eat_food(last_slot, last_item, ^eat_delay, ^eat_delay);
+[opheld1,_cooked_fish] @eat_food(last_slot, last_item, ^eat_delay, ^eat_delay);

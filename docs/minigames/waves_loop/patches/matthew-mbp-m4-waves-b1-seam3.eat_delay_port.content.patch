+// The eat gate (consume_shared.rs2): a bite inside the food timer is refused
+// silently. A combo food (karambwan, halibut) answers to its own timer
+// instead, so it can follow another food on the same tick (wiki Food/Fast
+// foods: "combo foods do not respect the eat delay incurred by other foods").
+def_boolean $combo = ~consume_combo_food($food);
+if (~consume_food_ready($combo) = false) {
+    return;
+}
+def_int $eat_delay = $delay_last;
+if ($next ! null) {
+    $eat_delay = $delay_more;
+} else if (~food_pie_fast_half($food) = true) {
+    $eat_delay = 0;
+}
+def_int $attack_delay = 3;
+if ($combo = true) {
+    $attack_delay = 2;
+}
+
 mes("You eat the <oc_name($food)>.");
 anim(human_eat, 0);
 // A food with a next stage leaves that behind in the same slot; everything
@@ -95,5 +137,8 @@ if ($next ! null) {

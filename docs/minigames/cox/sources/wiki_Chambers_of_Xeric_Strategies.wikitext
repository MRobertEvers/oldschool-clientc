|style = Guardians
|weapon1 = {{plink|Crystal pickaxe}}<ref name=crystal>The crystal pickaxe is lighter than the dragon pickaxe, but this is the only way in which it is better</ref>
|weapon2 = {{plink|Dragon pickaxe}}
|weapon3 = {{plink|Rune pickaxe}}

}}

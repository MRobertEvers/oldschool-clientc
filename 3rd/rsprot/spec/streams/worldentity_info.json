              "name": "ext_payload",
              "params": "RsprotBuf *b, int32_t flags, RsprotInfoWeExt *e",
              "body": [
                "    e->flags = flags;",
                "    if (flags & 0x2) {",
                "        e->has_sequence = 1;",
                "        e->sequence_id = rsprot_g2_alt2(b);",
                "        e->sequence_delay = rsprot_g1_alt3(b);",
                "    }",
                "    if (flags & 0x1) {",
                "        e->has_ops = 1;",
                "        e->ops = rsprot_g1(b);",

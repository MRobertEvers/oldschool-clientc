.env
build/
build_*/
build_opt/
cache/
.codex_tmp_live_projection*/*
.mta_restore_backup*/*
.tmp_*/
# ...but src/cache/ is source, not cache data: rscache_io.h is included by every
# engine/dat2 loader. The bare `cache/` rule above matched it, so it was never
# tracked, and a fresh clone or `git worktree add` could not build the targets
# that include it — `fatal error: 'cache/rscache_io.h' file not found`. Two
# separate pieces of work lost time to this independently before anyone noticed
# the file was simply absent rather than the build being wrong.
!src/cache/
cache254/
cacheosrs/
memtrace*
cache245_2/
cachers2
cache.*/
.DS_Store
runelite
all_tiles.json
symbols.txt
# Root-level CMake/out dirs only (unanchored "build*/" would ignore tools/ci/build_host)
/build*/
public/cache/
.cache/
emsdk/
android/.idea/

package_build_*.zip
/package_build_winxp

# Local WinXP CI env files + outputs (see tools/ci/.env.example)
tools/ci/build_host/.env.build_host
tools/ci/runner/.env.xp_runner
tools/ci/client/.env.trigger
tools/ci/build_host/artifacts/
tools/ci/build_host/results/

debug.keystore
gradle.properties

lib/python*
.venve

*.out
*.dSYM
*.o
.last_build
.tmp
out/

# Generated painters cullmap blobs (see tools/gen_painters_cullmap)
revconfig/cullmaps/*.bin

# Browser (Emscripten) intermediate build output
src2/programs/browser/browser_build/

# Memtrace tooling dependencies and generated traces
tools/memtrace/node_modules/
tools/memtrace/bins/

# ui_tree test BMP output
test/ui_tree/output/

# Compiled editor binary + BMP snapshots (rebuilt in place)
/src/torirs
/src/torirs_*
!/src/torirs_env.h
/src/build_*/
/src/torirs_mt
/dist/win64/
/interfacex_*.bmp

# poser-gl writes its settings into the working directory, as the reference does
poser-gl.settings

# The client's own device settings (audio volumes, CS2 options), written into
# the working directory for the same reason. See src/game/rs_prefs.h.
preferences.ini
preferences.ini.tmp

# Python bytecode from tools/ (tools are run as scripts, never imported).
__pycache__/
*.pyc

# Build artifacts - Windows executables
src/*.exe
3rd/rscache/tools/cachepack/*.exe

# Claude Code local overrides
.claude/settings.local.json
.claude/worktrees/

# Build-flavor stamp: records which OBJ_DIR last linked src/torirs so a
# debug/release swap forces a relink. Purely local state (src/makefile:632).
src/.last_flavor

# Extracted toolchains. The zips in lib/ are the checked-in form -- these
# directories are what unzipping them produces (~2 GB) and must never be
# committed. See tools/toolchain/README.md.
/toolchains/mingw32/
/toolchains/mingw64/
/toolchains/webview2-*/
/toolchains/emsdk-win64/

# Same rule for the XP profiler tooling: lib/cv2pdb-0.54-win32.zip and
# lib/verysleepy-0.7.2-win32.zip are the checked-in form; these are the
# unpacked trees and the installer they produce. See
# toolchains/winxp_profiles/README.md.
/toolchains/winxp_profiles/cv2pdb-0.54/
/toolchains/winxp_profiles/verysleepy_0_7/
/toolchains/winxp_profiles/verysleepy_0_7_exact/
/toolchains/winxp_profiles/verysleepy_0_7_setup.exe
/tmp/verysleepy-0.7.2-source/

# Staged build output.
/dist/

# The NDJSON anomaly log (3rd/toridraw/toridraw_debug_log.h) default path.
toridraw-debug.ndjson

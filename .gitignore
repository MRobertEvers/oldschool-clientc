.env
build/
build_*/
build_opt/
cache/
.codex_tmp_live_projection*/*
.mta_restore_backup*/*
.tmp_*/
# ...but src/cache/ is source, not cache data: rscache_io.h is included by every
# engine/dat2 loader. The bare `cache/` rule above matched it, so it was never
# tracked, and a fresh clone or `git worktree add` could not build the targets
# that include it — `fatal error: 'cache/rscache_io.h' file not found`. Two
# separate pieces of work lost time to this independently before anyone noticed
# the file was simply absent rather than the build being wrong.
!src/cache/
cache254/
cacheosrs/
memtrace*
cache245_2/
cachers2
cache.*/
.DS_Store
runelite
all_tiles.json
symbols.txt
# Root-level CMake/out dirs only (unanchored "build*/" would ignore tools/ci/build_host)
/build*/
public/cache/
.cache/
emsdk/
android/.idea/

package_build_*.zip
/package_build_winxp

# Local WinXP CI env files + outputs (see tools/ci/.env.example)
tools/ci/build_host/.env.build_host
tools/ci/runner/.env.xp_runner
tools/ci/client/.env.trigger
tools/ci/build_host/artifacts/
tools/ci/build_host/results/

debug.keystore
gradle.properties

lib/python*
.venve

*.out
*.dSYM
*.o
.last_build
.tmp
out/

# Generated painters cullmap blobs (see tools/gen_painters_cullmap)
revconfig/cullmaps/*.bin

# Browser (Emscripten) intermediate build output
src2/programs/browser/browser_build/

# Memtrace tooling dependencies and generated traces
tools/memtrace/node_modules/
tools/memtrace/bins/

# ui_tree test BMP output
test/ui_tree/output/

# Compiled editor binary + BMP snapshots (rebuilt in place)
#
# The binaries have no extension and the build makes several of them
# (torirs_opt, torirs_embed, and a per-worker torirs_<name> during parallel
# work), so the wildcard is the only way to catch them all. Source that
# happens to share the prefix is NOT one of them -- negated by extension
# rather than one file at a time, which is what this was doing before and is
# a trap every new torirs_*.c walks into silently.
/src/torirs
/src/torirs_*
!/src/torirs_*.c
!/src/torirs_*.h
/src/build_*/
/src/torirs_mt
/dist/win64/
/interfacex_*.bmp

# poser-gl writes its settings into the working directory, as the reference does
poser-gl.settings

# The client's own device settings (audio volumes, CS2 options), written into
# the working directory for the same reason. See src/game/rs_prefs.h.
preferences.ini
preferences.ini.tmp

# The manifest a gate rewrites for its own run: manifests/manifest_*.ini with
# dir= pointed at this checkout's cache and transport=embed. Every quest-gate
# run writes one (tools/quest_gate/conformance.py), and it must never be
# committed -- the committed manifests point at the shipped cache.
manifests/.*.ini

# Python bytecode from tools/ (tools are run as scripts, never imported).
__pycache__/
*.pyc

# Build artifacts - Windows executables
src/*.exe
3rd/rscache/tools/cachepack/*.exe

# Claude Code local overrides
.claude/settings.local.json
.claude/worktrees/

# Build-flavor stamp: records which OBJ_DIR last linked src/torirs so a
# debug/release swap forces a relink. Purely local state (src/makefile:632).
src/.last_flavor

# Extracted toolchains. The zips in lib/ are the checked-in form -- these
# directories are what unzipping them produces (~2 GB) and must never be
# committed. See tools/toolchain/README.md.
/toolchains/mingw32/
/toolchains/mingw64/
/toolchains/webview2-*/
/toolchains/emsdk-win64/

# Same rule for the XP profiler tooling: lib/cv2pdb-0.54-win32.zip and
# lib/verysleepy-0.7.2-win32.zip are the checked-in form; these are the
# unpacked trees and the installer they produce. See
# toolchains/winxp_profiles/README.md.
/toolchains/winxp_profiles/cv2pdb-0.54/
/toolchains/winxp_profiles/verysleepy_0_7/
/toolchains/winxp_profiles/verysleepy_0_7_exact/
/toolchains/winxp_profiles/verysleepy_0_7_setup.exe
/tmp/verysleepy-0.7.2-source/

# Same rule for the Java toolchain: toolchains/java-toolchain-osrs239.zip is
# the checked-in form; run-runelite.sh unpacks it here. See
# toolchains/README.md.
/toolchains/unpacked/

# Staged build output.
/dist/

# The NDJSON anomaly log (3rd/toridraw/toridraw_debug_log.h) default path.
toridraw-debug.ndjson

# PokeSprite store (deprecated/pokesprite): the runtime state io_server kept
# for the offline generator, never checked in.
deprecated/pokesprite/assets/missing.db
deprecated/pokesprite/assets/*.db-wal
deprecated/pokesprite/assets/*.db-shm

# What a running client or server writes, never source: character saves and
# account data (a deployment's live saves are its own, ~/torirs/live/saves on
# the NUC), the client's plugin settings, and its plugin output (screenshots,
# the loot and xp trackers' state).
/saves/
/plugin_prefs.ini
/plugin_assets/
# Playwright MCP session output (snapshots, console logs, screenshots).
/.playwright-mcp/

# Build outputs, never checked in: the tools, tests, benchmarks and servers
# the makefiles link (a binary checked in on one OS is a wrong-format file on
# the others, and make, seeing a fresh checkout time, never relinks it).
# Vendored third-party binaries (lib/, blobs/, the SDL2 DLLs) stay tracked.
/3rd/rscache/tools/anim_compare/anim_compare
/3rd/rscache/tools/audioprobe/audioprobe
/3rd/rscache/tools/audioprobe/audioprobe.exe
/3rd/rscache/tools/cachepack/cachepack
/3rd/rscache/tools/cs2/cs2
/3rd/rscache/tools/cs2/cs2.exe

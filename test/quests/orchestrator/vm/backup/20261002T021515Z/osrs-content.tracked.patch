+// The compass direction of a move, for the exact-move facing.
+[proc,doh_dir_to](coord $from, coord $to)(int)
+def_int $dx = calc(coordx($to) - coordx($from));
+def_int $dz = calc(coordz($to) - coordz($from));
+def_int $ax = $dx;
+def_int $az = $dz;
+if ($dx < 0) {
+    $ax = calc(0 - $dx);
+}
+if ($dz < 0) {
+    $az = calc(0 - $dz);
+}
+if ($ax >= $az) {
+    if ($dx > 0) {
+        return(^exact_east);
     }
+    return(^exact_west);
+}
+if ($dz > 0) {
+    return(^exact_north);
+}
+return(^exact_south);

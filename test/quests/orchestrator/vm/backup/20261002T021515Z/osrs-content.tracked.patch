+// Where an edge-wall (crawl-under wall, door) takes you: the loc's own tile is
+// one side and the tile across its edge the other. Loc angles 0..3 put the
+// wall on the west, north, east, south edge of its tile.
+[proc,doh_edge_dest](coord $loc, int $angle, coord $from)(coord)
+if ($from ! $loc) {
+    return($loc);
+}
+if ($angle = 0) {
+    return(movecoord($loc, -1, 0, 0));
+}
+if ($angle = 1) {
+    return(movecoord($loc, 0, 0, 1));

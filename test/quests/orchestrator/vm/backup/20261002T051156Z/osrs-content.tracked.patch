 // The host commands store bounded integers only. Room definitions, positions,
 // defaults and every gameplay decision remain here and in cache DB rows.
 
+// Names a room or furniture DB row where nothing else types the position.
+// 102+ POH rows share their name with the room/furniture obj (`poh_dummy_garden`
+// is obj 8415 and dbrow 4167), and since the compiler gave dbrows their own
+// symbol kind (37f8b2a84) a bare name in an untyped position -- a command
+// argument such as poh_room_add's, the right side of `poh_room_get(...) =` --
+// compiles to the OBJ: the house then stored obj 8415 as its garden row and
+// db_getfield read a sailing row instead (sscompile's "nothing here says
+// which" warning). A dbrow-typed parameter is a typed position, so passing the
+// name through here compiles the row.
+[proc,poh_row](dbrow $row)(dbrow)
+return($row);
+
 [proc,poh_state_create_starter](int $location, int $style)(int)
 poh_state_reset;
 if (poh_state_set(^poh_state_owns, 1) = 0) return(0);
 if (poh_state_set(^poh_state_location, $location) = 0) return(0);
 if (poh_state_set(^poh_state_style, $style) = 0) return(0);
 if (poh_state_set(^poh_state_grid_size, 3) = 0) return(0);
-if (poh_room_add(poh_dummy_garden, ^poh_garden_grid_x, ^poh_garden_grid_z, ^poh_ground_level, ^map_instance_turn_none, ^poh_starter_garden_doors) < 0) {
+if (poh_room_add(~poh_row(poh_dummy_garden), ^poh_garden_grid_x, ^poh_garden_grid_z, ^poh_ground_level, ^map_instance_turn_none, ^poh_starter_garden_doors) < 0) {
     poh_state_reset;
     return(0);
 }
-if (poh_room_add(poh_dummy_parlour, ^poh_parlour_grid_x, ^poh_parlour_grid_z, ^poh_ground_level, ^map_instance_turn_none, ^poh_starter_parlour_doors) < 0) {

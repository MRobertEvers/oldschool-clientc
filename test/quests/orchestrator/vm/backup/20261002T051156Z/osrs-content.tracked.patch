@@ -130,3 +130,83 @@ if (%varb3293_peng_quest >= ^coldwar_complete) {
 } else {
     mes("cwrun FAIL: complete=<tostring(%varb3293_peng_quest)>");
 }
+
+// Prerequisite staging, not quest work: Cold War's "Additional access" is a
+// player-owned house with a Crafting table 3 or 4 (docs/quests/cold_war.md
+// section 2; Quest Helper ColdWar.java enterPoh "Travel to your POH or another
+// POH with a Crafting table 3 or 4", general requirement Construction 34).
+// Building that table is Construction training (table 1 -> 2 -> 3, the last an
+// upgrade costing 2 molten glass), never a Cold War step, so a test stages it
+// here the way it stages a skill level -- and then makes the clockwork and
+// the suit itself at the bench (poh_workshop_functions.rs2,
+// [oploc1,poh_clockmaking_3]). The house is the Rimmington starter house plus
+// one Workshop east of the Parlour, laid out exactly as
+// ~poh_build_room_from_door lays a room built from the Parlour's east door;
+// the table is recorded exactly as ~poh_build_single records it. The player is
+// left beside the Rimmington portal, outside the house.
+[debugproc,coldwarpoh]
+if (%varp5925_map_instance_handle ! ^map_instance_none) {
+    mes("Cold War POH: leave your house first (::pohleave).");
+    return;
+}
+if (~poh_has_house = 0) {
+    %varb2187_poh_house_location = ^poh_loc_rimmington;
+    %varb2188_poh_house_style = 0;
+}
+if (~poh_state_ensure = 0) {
+    mes("Cold War POH: the house record could not be created.");
+    return;
+}
+def_dbrow $workshop_row = ~poh_row(poh_dummy_workshop);
+def_dbrow $table3 = ~poh_row(poh_crafting_table_3);
+def_dbrow $table4 = ~poh_row(poh_crafting_table_4);
+def_int $workshop = -1;
+def_int $index = 0;
+while ($index < poh_room_count) {
+    if (poh_room_get($index, ^poh_room_dbrow) = $workshop_row) {
+        $workshop = $index;
+    }
+    $index = calc($index + 1);
+}
+if ($workshop < 0) {
+    def_int $parlour = ~poh_room_at(^poh_parlour_grid_x, ^poh_parlour_grid_z, ^poh_ground_level);
+    if ($parlour < 0) {
+        mes("Cold War POH: the house has no starter Parlour to extend.");
+        return;
+    }
+    def_int $target_x = calc(^poh_parlour_grid_x + 1);
+    if (~poh_room_at($target_x, ^poh_parlour_grid_z, ^poh_ground_level) >= 0) {
+        mes("Cold War POH: the space east of the Parlour is already built on.");
+        return;
+    }
+    // Parlour door east (^loc_east); the Workshop's first doorway (west) is
+    // the shared wall, so it is placed unrotated.
+    def_int $needed_door = modulo(calc(^loc_east + 2), 4);
+    def_int $source_door = db_getfield($workshop_row, poh_room:door_locations, 0);
+    def_int $rotation = modulo(calc($needed_door - $source_door + 4), 4);
+    poh_room_set($parlour, ^poh_room_door_mask,
+        setbit(poh_room_get($parlour, ^poh_room_door_mask), ^loc_east));
+    $workshop = poh_room_add($workshop_row, $target_x, ^poh_parlour_grid_z,
+        ^poh_ground_level, $rotation, ~poh_door_mask($needed_door));
+    if ($workshop < 0) {
+        mes("Cold War POH: the Workshop could not be added.");
+        return;
+    }
+    poh_state_set(^poh_state_grid_size,
+        max(poh_state_get(^poh_state_grid_size), ~poh_room_dimension(stat_base(construction))));
+}
+// Slot 1 is the Workshop's crafting-table space (poh_build.rs2
+// [oploc5,poh_workshop_2] -> crafting_table_hotspot, slot 1).
+if (poh_decor_get($workshop, 1, ^poh_decor_furniture) ! $table3 &
+    poh_decor_get($workshop, 1, ^poh_decor_furniture) ! $table4) {
+    if (poh_decor_set($workshop, 1, $table3, 0, 0) = 0) {
+        mes("Cold War POH: the Crafting table 3 could not be recorded.");
+        return;
+    }
+}
+if (poh_state_commit = 0) {
+    mes("Cold War POH: the house could not be saved.");
+    return;
+}
+p_teleport(^poh_rimmington_exit);
+mes("Cold War POH: Rimmington house with a Workshop and a Crafting table 3.");

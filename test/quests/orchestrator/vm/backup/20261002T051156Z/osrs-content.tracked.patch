+            return;
+        }
         ~chatnpc("Well done soldier! You've successfully completed the physical. You're free to do as you like.");
         ~chatplayer("What do I do now?");
+        // The varbit goes back to the Icelord count it also carries (state 125).
+        %varb3305_peng_agility_state = 0;
         %varb3293_peng_quest = ^coldwar_army_report;
     } else {
         ~chatnpc("Well done soldier! You can come back whenever you like to tone up your body.");

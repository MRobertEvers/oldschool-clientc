// Mage Training Arena — Rewards Guardian + magictraining_shop (IF 197).
// Authority: OSRS wiki rewards table + cache enum_2753..2759 / CS2 magic_training_*.
// Client reads %if1=tele %if2=alch %if3=enchant %if4=grave, %makexcrafting=qty,
// %magictraining_shop=selected slot (63 = none).

[proc,mta_shop_sync_points]
// CS2 magic_training_costs: if1 tele, if2 alch, if3 enchant, if4 grave.
%if1 = %mta_pizazz_tele;
%if2 = %mta_pizazz_alch;
%if3 = %mta_pizazz_enchant;
%if4 = %mta_pizazz_grave;

[proc,mta_shop_open]
~mta_shop_sync_points;
%magictraining_shop = ^mta_shop_none;
%makexcrafting = 1;
if_openmain(magictraining_shop);

[proc,mta_shop_can_afford](int $t, int $a, int $e, int $g)(int)
if (%mta_pizazz_tele < $t) {
    return(0);
}
if (%mta_pizazz_alch < $a) {
    return(0);
}
if (%mta_pizazz_enchant < $e) {
    return(0);
}
if (%mta_pizazz_grave < $g) {
    return(0);
}
return(1);

[proc,mta_shop_pay](int $t, int $a, int $e, int $g)
~mta_sub_points(^mta_room_tele, $t);
~mta_sub_points(^mta_room_alchem, $a);
~mta_sub_points(^mta_room_enchant, $e);
~mta_sub_points(^mta_room_grave, $g);
~mta_shop_sync_points;

[proc,mta_shop_prices](namedobj $item)(int, int, int, int)
// enum_2755 tele, 2758 alch, 2757 enchant, 2756 grave (CS2 labels).
return(enum(obj, int, enum_2755, $item), enum(obj, int, enum_2758, $item), enum(obj, int, enum_2757, $item), enum(obj, int, enum_2756, $item));

[proc,mta_shop_buy_one](namedobj $item)
if ($item = null) {
    return;
}
def_int $t;
def_int $a;
def_int $e;
def_int $g;
$t, $a, $e, $g = ~mta_shop_prices($item);
if (~mta_shop_can_afford($t, $a, $e, $g) = 0) {
    mes("You can't afford that.");
    return;
}
// Bones to Peaches unlock (cache obj magictraining_peachspell).
if ($item = magictraining_peachspell) {
    if (%magictraining_bonespeaches = 1) {
        mes("You already know Bones to Peaches.");
        return;
    }
    ~mta_shop_pay($t, $a, $e, $g);
    %magictraining_bonespeaches = 1;
    ~mesbox("The guardian teaches you how to use the Bones to Peaches spell!");
    return;
}
// Rune pouch (enum slot 11 → bh_rune_pouch).
if ($item = bh_rune_pouch) {
    if (inv_total(inv, bh_rune_pouch) > 0 | inv_total(bank, bh_rune_pouch) > 0) {
        mes("You already own a rune pouch.");
        return;
    }
}
// Wand upgrades require previous tier (enum_2759).
def_namedobj $prev = enum(obj, namedobj, enum_2759, $item);
if ($prev ! null) {
    if (inv_total(inv, $prev) < 1 & inv_total(inv, magictraining_wand_master) < 1) {
        mes("You need a <oc_name($prev)> to upgrade.");
        return;
    }
}
if (inv_freespace(inv) < 1 & ($prev = null | inv_total(inv, $prev) < 1)) {
    mes("You don't have enough inventory space.");
    return;
}
if ($prev ! null & inv_total(inv, $prev) > 0) {
    inv_del(inv, $prev, 1);
}
~mta_shop_pay($t, $a, $e, $g);
inv_add(inv, $item, 1);
mes("You buy a <oc_name($item)>.");

[proc,mta_shop_confirm]
def_int $slot = %magictraining_shop;
if ($slot = ^mta_shop_none | $slot < 0) {
    mes("Select a reward first.");
    return;
}
def_namedobj $item = enum(int, namedobj, enum_2753, $slot);
if ($item = null) {
    mes("Select a reward first.");
    return;
}
def_int $qty = %makexcrafting;
if ($qty < 1) {
    $qty = 1;
}
def_int $i = 0;
while ($i < $qty) {
    ~mta_shop_buy_one($item);
    $i = calc($i + 1);
}

[if_button1,magictraining_shop:make1]
%makexcrafting = 1;
~mta_shop_sync_points;

[if_button1,magictraining_shop:make5]
%makexcrafting = 5;
~mta_shop_sync_points;

[if_button1,magictraining_shop:make10]
%makexcrafting = 10;
~mta_shop_sync_points;

[if_button1,magictraining_shop:makeall]
%makexcrafting = 28;
~mta_shop_sync_points;

[if_button1,magictraining_shop:confirm]
~mta_shop_confirm;

// Talk-to: dialogue then open shop. Trade-with: open shop directly.
[opnpc1,magictraining_guard_rewards]
if (%magictraining_entra_noob = 0) {
    ~chatnpc("Greetings. Have you spoken to my fellow Guardian downstairs?");
    ~chatplayer("Nope.");
    ~chatnpc("Well, you need to talk to him first.");
    return;
}
~chatplayer("Hi.");
~chatnpc("Greetings. What wisdom do you seek?");
def_int $c = ~p_choice3("Who are you?", 1, "Can I trade my Pizazz Points please?", 2, "Thanks, bye!", 3);
if ($c = 3) {
    return;
}
if ($c = 1) {
    ~chatplayer("Who are you?");
    ~chatnpc("Me? I'm here to grant you rewards for any of the Pizazz Points you may have earned in this training arena.");
    ~chatplayer("I see.");
    ~chatnpc("Would you like to trade your Pizazz Points?");
    def_int $t = ~p_choice2("Yes please.", 1, "No thanks.", 2);
    if ($t = 1) {
        ~mta_shop_open;
    }
    return;
}
~chatplayer("Can I trade my Pizazz Points please?");
~chatnpc("Why of course.");
~mta_shop_open;

[opnpc4,magictraining_guard_rewards]
if (%magictraining_entra_noob = 0) {
    ~chatnpc("Greetings. Have you spoken to my fellow Guardian downstairs?");
    ~chatplayer("Nope.");
    ~chatnpc("Well, you need to talk to him first.");
    return;
}
~mta_shop_open;

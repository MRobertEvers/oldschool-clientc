// Mage Training Arena — Alchemists' Playground.
// Authority: OSRS wiki Mage_Training_Arena/Alchemist's_Playground (May 2024).
// Cache overlay: magictraining_alchem (IF 194). Cupboard op2=Take-5.

[proc,mta_alchem_item](int $idx)(namedobj)
switch_int ($idx) {
    case 1 : return(magictraining_leather_boots);
    case 2 : return(magictraining_adamant_kiteshield);
    case 3 : return(magictraining_adamant_med_helm);
    case 4 : return(magictraining_emerald);
    case 5 : return(magictraining_rune_longsword);
}
return(null);

[proc,mta_alchem_cost_of](int $idx)(int)
if ($idx = 1) {
    return(%mta_alch_cost1);
}
if ($idx = 2) {
    return(%mta_alch_cost2);
}
if ($idx = 3) {
    return(%mta_alch_cost3);
}
if ($idx = 4) {
    return(%mta_alch_cost4);
}
if ($idx = 5) {
    return(%mta_alch_cost5);
}
return(0);

[proc,mta_alchem_item_index](obj $item)(int)
if ($item = magictraining_leather_boots) {
    return(1);
}
if ($item = magictraining_adamant_kiteshield) {
    return(2);
}
if ($item = magictraining_adamant_med_helm) {
    return(3);
}
if ($item = magictraining_emerald) {
    return(4);
}
if ($item = magictraining_rune_longsword) {
    return(5);
}
return(0);

[proc,mta_alchem_shuffle_costs]
// Wiki: values 1, 5, 8, 15, 30 (one each for the five items).
def_int $r = random(5);
if ($r = 0) {
    %mta_alch_cost1 = 1;
    %mta_alch_cost2 = 5;
    %mta_alch_cost3 = 8;
    %mta_alch_cost4 = 15;
    %mta_alch_cost5 = 30;
} else if ($r = 1) {
    %mta_alch_cost1 = 30;
    %mta_alch_cost2 = 1;
    %mta_alch_cost3 = 5;
    %mta_alch_cost4 = 8;
    %mta_alch_cost5 = 15;
} else if ($r = 2) {
    %mta_alch_cost1 = 15;
    %mta_alch_cost2 = 30;
    %mta_alch_cost3 = 1;
    %mta_alch_cost4 = 5;
    %mta_alch_cost5 = 8;
} else if ($r = 3) {
    %mta_alch_cost1 = 8;
    %mta_alch_cost2 = 15;
    %mta_alch_cost3 = 30;
    %mta_alch_cost4 = 1;
    %mta_alch_cost5 = 5;
} else {
    %mta_alch_cost1 = 5;
    %mta_alch_cost2 = 8;
    %mta_alch_cost3 = 15;
    %mta_alch_cost4 = 30;
    %mta_alch_cost5 = 1;
}
if (random(3) = 0) {
    %mta_alch_free = calc(1 + random(5));
} else {
    %mta_alch_free = 0;
}
%mta_alch_indexer = calc(modulo(calc(%mta_alch_indexer + 1), 6));
~mta_overlay_update;

[proc,mta_alchem_on_enter]
%magictraining_alchem_coinreward = 0;
%mta_alch_indexer = 0;
~mta_alchem_shuffle_costs;
softtimer(mta_alchem_pulse, ^mta_alch_pulse_ticks);

[softtimer,mta_alchem_pulse]
if (%mta_room ! ^mta_room_alchem) {
    return;
}
~mta_alchem_shuffle_costs;
mes("The costs are changing!");
softtimer(mta_alchem_pulse, ^mta_alch_pulse_ticks);

[proc,mta_alchem_cupboard_index](loc $type)(int)
if ($type = magictraining_alchem_cupboard0 | $type = magictraining_alchem_cupboard0_open) {
    return(0);
}
if ($type = magictraining_alchem_cupboard1 | $type = magictraining_alchem_cupboard1_open) {
    return(1);
}
if ($type = magictraining_alchem_cupboard2 | $type = magictraining_alchem_cupboard2_open) {
    return(2);
}
if ($type = magictraining_alchem_cupboard3 | $type = magictraining_alchem_cupboard3_open) {
    return(3);
}
if ($type = magictraining_alchem_cupboard4 | $type = magictraining_alchem_cupboard4_open) {
    return(4);
}
if ($type = magictraining_alchem_cupboard5 | $type = magictraining_alchem_cupboard5_open) {
    return(5);
}
return(-1);

[proc,mta_alchem_search](loc $type, int $qty)
def_int $cup = ~mta_alchem_cupboard_index($type);
if ($cup < 0) {
    return;
}
anim(human_pickuptable, 0);
def_int $slot = calc(modulo(calc(%mta_alch_indexer + $cup), 6));
if ($slot = 5) {
    mes("The cupboard is empty.");
    return;
}
def_namedobj $item = ~mta_alchem_item(calc($slot + 1));
def_int $taken = 0;
while ($taken < $qty & inv_freespace(inv) > 0) {
    inv_add(inv, $item, 1);
    $taken = calc($taken + 1);
}
if ($taken < 1) {
    mes("You have no free space to hold any more items.");
    return;
}
if ($taken = 1) {
    mes("You found: <oc_name($item)>.");
} else {
    mes("You take <tostring($taken)> x <oc_name($item)>.");
}

[oploc1,magictraining_alchem_cupboard0]
[oploc1,magictraining_alchem_cupboard0_open]
~mta_alchem_search(loc_type, 1);

[oploc1,magictraining_alchem_cupboard1]
[oploc1,magictraining_alchem_cupboard1_open]
~mta_alchem_search(loc_type, 1);

[oploc1,magictraining_alchem_cupboard2]
[oploc1,magictraining_alchem_cupboard2_open]
~mta_alchem_search(loc_type, 1);

[oploc1,magictraining_alchem_cupboard3]
[oploc1,magictraining_alchem_cupboard3_open]
~mta_alchem_search(loc_type, 1);

[oploc1,magictraining_alchem_cupboard4]
[oploc1,magictraining_alchem_cupboard4_open]
~mta_alchem_search(loc_type, 1);

[oploc1,magictraining_alchem_cupboard5]
[oploc1,magictraining_alchem_cupboard5_open]
~mta_alchem_search(loc_type, 1);

[oploc2,magictraining_alchem_cupboard0]
[oploc2,magictraining_alchem_cupboard0_open]
~mta_alchem_search(loc_type, 5);

[oploc2,magictraining_alchem_cupboard1]
[oploc2,magictraining_alchem_cupboard1_open]
~mta_alchem_search(loc_type, 5);

[oploc2,magictraining_alchem_cupboard2]
[oploc2,magictraining_alchem_cupboard2_open]
~mta_alchem_search(loc_type, 5);

[oploc2,magictraining_alchem_cupboard3]
[oploc2,magictraining_alchem_cupboard3_open]
~mta_alchem_search(loc_type, 5);

[oploc2,magictraining_alchem_cupboard4]
[oploc2,magictraining_alchem_cupboard4_open]
~mta_alchem_search(loc_type, 5);

[oploc2,magictraining_alchem_cupboard5]
[oploc2,magictraining_alchem_cupboard5_open]
~mta_alchem_search(loc_type, 5);

[proc,mta_alchem_try_alch](obj $item)(int)
if (%mta_room ! ^mta_room_alchem) {
    return(0);
}
def_int $idx = ~mta_alchem_item_index($item);
if ($idx < 1) {
    return(0);
}
def_int $cost = ~mta_alchem_cost_of($idx);
def_int $free = 0;
if (%mta_alch_free = $idx) {
    $free = 1;
}
if (calc(inv_total(inv, magictraining_coins) + $cost) > 10000) {
    mes("You can't hold that many arena coins.");
    return(1);
}
return(calc(2 + $free));

[proc,mta_alchem_finish_alch](obj $item, int $free)
def_int $idx = ~mta_alchem_item_index($item);
def_int $cost = ~mta_alchem_cost_of($idx);
inv_del(inv, $item, 1);
inv_add(inv, magictraining_coins, $cost);
if ($free = 1) {
    mes("You convert the item for free!");
}

// Wiki: 1 pt / 100 coins; remainder % chance of +1; 2 Magic XP / coin; bank 10 coins / point.
[proc,mta_alchem_deposit](int $deposit)
if ($deposit < 1) {
    return;
}
inv_del(inv, magictraining_coins, $deposit);
def_int $earn = divide($deposit, 100);
def_int $rem = modulo($deposit, 100);
if ($rem > 0 & random(100) < $rem) {
    $earn = calc($earn + 1);
}
def_int $exp = calc($deposit * 2);
def_int $taking = %magictraining_alchem_coinreward;
if ($earn > 0) {
    $taking = calc($taking + calc($earn * 10));
    %magictraining_alchem_coinreward = $taking;
    ~mta_add_points(^mta_room_alchem, $earn);
}
stat_advance(magic, calc($exp * 10));
~mesbox("You've just deposited <tostring($deposit)> coins, earning you <tostring($earn)> Alchemist Pizazz|Points and <tostring($exp)> magic XP. So far you're taking <tostring($taking)> coins as a|reward when you leave!");

[oploc1,magictraining_coin_collector]
if (%mta_room ! ^mta_room_alchem) {
    return;
}
def_int $deposit = inv_total(inv, magictraining_coins);
if ($deposit < 1) {
    ~mesbox("You don't have any coins to deposit.");
    return;
}
~mta_alchem_deposit($deposit);

// Auto-deposit remaining arena coins on leave (wiki) — silent (no mesbox).
[proc,mta_alchem_leave_deposit]
def_int $deposit = inv_total(inv, magictraining_coins);
if ($deposit < 1) {
    return;
}
inv_del(inv, magictraining_coins, $deposit);
def_int $earn = divide($deposit, 100);
def_int $rem = modulo($deposit, 100);
if ($rem > 0 & random(100) < $rem) {
    $earn = calc($earn + 1);
}
def_int $exp = calc($deposit * 2);
def_int $taking = %magictraining_alchem_coinreward;
if ($earn > 0) {
    $taking = calc($taking + calc($earn * 10));
    %magictraining_alchem_coinreward = $taking;
    ~mta_add_points(^mta_room_alchem, $earn);
}
stat_advance(magic, calc($exp * 10));

// --- Alchemy Guardian ---

[opnpc1,magictraining_guard_alchem]
~chatplayer("Hi.");
@mta_alchem_menu;

[label,mta_alchem_menu]
def_int $c = ~p_choice4("What do I have to do in this room?", 1, "What are the rewards?", 2, "Got any tips that may help me?", 3, "Thanks, bye!", 4);
if ($c = 4) {
    return;
}
if ($c = 1) {
    ~chatplayer("What do I have to do in this room?");
    ~chatnpc("Search the cupboards for items, then convert them to gold with Low or High Level Alchemy. Deposit the coins in the collector for Alchemist Pizazz Points.");
    ~chatnpc("Keep an eye on each item's value — costs and cupboard positions change every minute. Occasionally an item converts for free.");
    @mta_alchem_menu;
    return;
}
if ($c = 2) {
    ~chatplayer("What are the rewards?");
    ~chatnpc("You get Magic experience from alchemy spells, 1 Alchemist Pizazz Point per 100 coins deposited, and 10% of deposited coins paid into your bank when you leave.");
    @mta_alchem_menu;
    return;
}
~chatplayer("Got any tips that may help me?");
~chatnpc("Watch the costs carefully. Right-click Take-5 to grab several items at once. If you have 190 coins, why not get an extra 10?");
~chatplayer("I see.");
@mta_alchem_menu;

// Mage Training Arena — LIVE. DO NOT .rs2.skip / park this tree for other-lane compiles.
// Shared lobby, points, overlays, enter/leave.
// Authority: OSRS wiki Mage_Training_Arena (+ May 2024). Cache IFs 194–198 + 553.
// LostCity: none (post-2004). Dialogue trees from 2009scape, rules from wiki.

[proc,mta_has_hat]()(int)
if (inv_total(inv, magictraining_proghat_dull) > 0) {
    return(1);
}
if (inv_total(inv, magictraining_proghat_energised) > 0) {
    return(1);
}
if (inv_total(inv, magictraining_proghat_full) > 0) {
    return(1);
}
if (inv_total(worn, magictraining_proghat_dull) > 0) {
    return(1);
}
if (inv_total(worn, magictraining_proghat_energised) > 0) {
    return(1);
}
if (inv_total(worn, magictraining_proghat_full) > 0) {
    return(1);
}
return(0);

[proc,mta_give_hat]
if (~mta_has_hat = 1) {
    return;
}
if (inv_freespace(inv) < 1) {
    mes("You need some free inventory space for a Progress hat.");
    return;
}
%magictraining_entra_noob = 1;
inv_add(inv, magictraining_proghat_dull, 1);

[proc,mta_pizazz](int $room)(int)
if ($room = ^mta_room_tele) {
    return(%mta_pizazz_tele);
}
if ($room = ^mta_room_alchem) {
    return(%mta_pizazz_alch);
}
if ($room = ^mta_room_enchant) {
    return(%mta_pizazz_enchant);
}
if ($room = ^mta_room_grave) {
    return(%mta_pizazz_grave);
}
return(0);

[proc,mta_pizazz_cap](int $room)(int)
if ($room = ^mta_room_tele) {
    return(^mta_cap_tele);
}
if ($room = ^mta_room_alchem) {
    return(^mta_cap_alch);
}
if ($room = ^mta_room_enchant) {
    return(^mta_cap_enchant);
}
if ($room = ^mta_room_grave) {
    return(^mta_cap_grave);
}
return(0);

[proc,mta_set_pizazz](int $room, int $value)
if ($room = ^mta_room_tele) {
    %mta_pizazz_tele = $value;
} else if ($room = ^mta_room_alchem) {
    %mta_pizazz_alch = $value;
} else if ($room = ^mta_room_enchant) {
    %mta_pizazz_enchant = $value;
} else if ($room = ^mta_room_grave) {
    %mta_pizazz_grave = $value;
}

[proc,mta_add_points](int $room, int $n)
if ($n < 1) {
    return;
}
def_int $cap = ~mta_pizazz_cap($room);
def_int $cur = ~mta_pizazz($room);
def_int $next = calc($cur + $n);
if ($next > $cap) {
    $next = $cap;
}
~mta_set_pizazz($room, $next);
~mta_overlay_update;

[proc,mta_sub_points](int $room, int $n)
def_int $cur = ~mta_pizazz($room);
if ($n >= $cur) {
    ~mta_set_pizazz($room, 0);
} else {
    ~mta_set_pizazz($room, calc($cur - $n));
}
~mta_overlay_update;

// Room overlays 194–198; lobby HUD 553 (wiki May 2024).
[proc,mta_overlay_open]
if (%mta_room = ^mta_room_tele) {
    if_opensub(toplevel_osrs_stretch:overlay_hud, magictraining_tele, 1);
} else if (%mta_room = ^mta_room_alchem) {
    if_opensub(toplevel_osrs_stretch:overlay_hud, magictraining_alchem, 1);
} else if (%mta_room = ^mta_room_enchant) {
    if_opensub(toplevel_osrs_stretch:overlay_hud, magictraining_encha, 1);
} else if (%mta_room = ^mta_room_grave) {
    if_opensub(toplevel_osrs_stretch:overlay_hud, magictraining_grave, 1);
} else {
    if_opensub(toplevel_osrs_stretch:overlay_hud, magictraining_main, 1);
}
~mta_overlay_update;

[proc,mta_overlay_close]
if_closesub(toplevel_osrs_stretch:overlay_hud);

[proc,mta_overlay_update]
if (%mta_room = ^mta_room_tele) {
    if_settext(magictraining_tele:magictrain_tele_pts, tostring(%mta_pizazz_tele));
    if_settext(magictraining_tele:magictrain_maze_number, tostring(%magictraining_mazesolved));
} else if (%mta_room = ^mta_room_alchem) {
    if_settext(magictraining_alchem:magictrain_alchem_pts, tostring(%mta_pizazz_alch));
    if_settext(magictraining_alchem:magictrain_alchem_cost1, tostring(%mta_alch_cost1));
    if_settext(magictraining_alchem:magictrain_alchem_cost2, tostring(%mta_alch_cost2));
    if_settext(magictraining_alchem:magictrain_alchem_cost3, tostring(%mta_alch_cost3));
    if_settext(magictraining_alchem:magictrain_alchem_cost4, tostring(%mta_alch_cost4));
    if_settext(magictraining_alchem:magictrain_alchem_cost5, tostring(%mta_alch_cost5));
} else if (%mta_room = ^mta_room_enchant) {
    if_settext(magictraining_encha:magictrain_encha_pts, tostring(%mta_pizazz_enchant));
    ~mta_enchant_bonus_hide;
} else if (%mta_room = ^mta_room_grave) {
    if_settext(magictraining_grave:magictrain_grave_pts, tostring(%mta_pizazz_grave));
} else {
    if_settext(magictraining_main:magictrain_tele_points, tostring(%mta_pizazz_tele));
    if_settext(magictraining_main:magictrain_alch_points, tostring(%mta_pizazz_alch));
    if_settext(magictraining_main:magictrain_ench_points, tostring(%mta_pizazz_enchant));
    if_settext(magictraining_main:magictrain_grave_points, tostring(%mta_pizazz_grave));
}

[proc,mta_strip_inv](obj $item)
def_int $n = inv_total(inv, $item);
if ($n > 0) {
    inv_del(inv, $item, $n);
}

[proc,mta_strip_room_items]
if (%mta_room = ^mta_room_alchem) {
    ~mta_strip_inv(magictraining_coins);
    ~mta_strip_inv(magictraining_leather_boots);
    ~mta_strip_inv(magictraining_adamant_kiteshield);
    ~mta_strip_inv(magictraining_adamant_med_helm);
    ~mta_strip_inv(magictraining_emerald);
    ~mta_strip_inv(magictraining_rune_longsword);
} else if (%mta_room = ^mta_room_enchant) {
    ~mta_strip_inv(magictraining_enchan_cube);
    ~mta_strip_inv(magictraining_enchan_cylinder);
    ~mta_strip_inv(magictraining_enchan_icosahendron);
    ~mta_strip_inv(magictraining_enchan_pentamid);
    ~mta_strip_inv(magictraining_enchan_shapeorb);
    ~mta_strip_inv(magictraining_dragonstone);
} else if (%mta_room = ^mta_room_grave) {
    ~mta_strip_inv(magictraining_bones1);
    ~mta_strip_inv(magictraining_bones2);
    ~mta_strip_inv(magictraining_bones3);
    ~mta_strip_inv(magictraining_bones4);
    ~mta_strip_inv(banana);
    ~mta_strip_inv(peach);
}

[proc,mta_cap_warn](int $room)
def_int $cap = ~mta_pizazz_cap($room);
if (~mta_pizazz($room) >= $cap) {
    ~mesbox("You have the maximum Pizazz Points for this room.|You may still enter, but you will not earn more points.");
}

// Wiki May 2024: progress hat no longer required to enter rooms.
[proc,mta_enter_room](int $room, coord $start)
~mta_cap_warn($room);
%mta_room = $room;
p_teleport($start);
~mta_overlay_open;
mes("You've entered the training arena.");

[proc,mta_leave_room]
def_coord $pad = ^mta_lobby;
if (%mta_room = ^mta_room_enchant) {
    $pad = ^mta_exit_enchant;
    clearsofttimer(mta_enchant_bonus);
    ~mta_enchant_claim_runes;
} else if (%mta_room = ^mta_room_alchem) {
    $pad = ^mta_exit_alchem;
    clearsofttimer(mta_alchem_pulse);
    ~mta_alchem_leave_deposit;
    def_int $earn = %magictraining_alchem_coinreward;
    if ($earn > 0) {
        inv_add(bank, coins, $earn);
        ~mesbox("You've been awarded <tostring($earn)> coins straight into your bank as a reward!");
        %magictraining_alchem_coinreward = 0;
    }
} else if (%mta_room = ^mta_room_grave) {
    $pad = ^mta_exit_grave;
    clearsofttimer(mta_grave_hazard);
    ~mta_grave_claim_runes;
} else if (%mta_room = ^mta_room_tele) {
    $pad = ^mta_exit_tele;
    ~mta_tele_cam_reset;
    ~mta_tele_clear_nodes;
}
~mta_strip_room_items;
~mta_overlay_close;
def_int $was_tele = 0;
def_int $tele_handle = %mta_tele_handle;
if (%mta_room = ^mta_room_tele) {
    $was_tele = 1;
}
%mta_room = ^mta_room_none;
p_teleport($pad);
~mta_overlay_open;
if ($was_tele = 1 & $tele_handle ! ^map_instance_none) {
    map_instance_free($tele_handle);
    if (%map_instance_handle = $tele_handle) {
        %map_instance_handle = ^map_instance_none;
    }
    %mta_tele_handle = ^map_instance_none;
    %mta_tele_sliding = 0;
}

// --- Guild doorway (Magic 7) ---

[oploc1,magictraining_temple_door]
if (stat(magic) < ^mta_magic_guild) {
    ~mesbox("You need a Magic level of at least <tostring(^mta_magic_guild)> to enter the guild.");
    return;
}
def_int $dir = ~coord_direction(coord, loc_coord);
p_teleport(~movecoord_indirection(coord, $dir, 2));
%mta_room = ^mta_room_none;
~mta_overlay_open;

// --- Room portals ---

[oploc1,magictraining_teledoor]
if (stat(magic) < ^mta_magic_tele) {
    ~mesbox("You need to be able to cast the Telekinetic Grab spell in order to|enter.");
    return;
}
~mta_cap_warn(^mta_room_tele);
~mta_tele_enter;

[oploc1,magictraining_enchantdoor]
if (stat(magic) < ^mta_magic_enchant) {
    ~mesbox("You need to be able to cast the Lvl-1 Enchant spell in order to|enter.");
    return;
}
~mta_enter_room(^mta_room_enchant, ^mta_start_enchant);
~mta_enchant_on_enter;

[oploc1,magictraining_alchemdoor]
if (stat(magic) < ^mta_magic_alchem) {
    ~mesbox("You need to be able to cast the Low Level Alchemy spell in order to|enter.");
    return;
}
if (inv_total(inv, coins) > 0) {
    ~mesbox("You cannot take money into the Alchemists' Playground.");
    return;
}
~mta_enter_room(^mta_room_alchem, ^mta_start_alchem);
~mta_alchem_on_enter;

[oploc1,magictraining_gravedoor]
if (stat(magic) < ^mta_magic_grave) {
    ~mesbox("You need to be able to cast the Bones to Bananas spell in order to|enter.");
    return;
}
if (inv_total(inv, banana) > 0 | inv_total(inv, peach) > 0) {
    ~mesbox("You can't take bananas or peaches into the arena.");
    return;
}
~mta_enter_room(^mta_room_grave, ^mta_start_grave);
~mta_grave_on_enter;

[oploc1,magictraining_returndoor]
~mta_leave_room;

// --- Entrance Guardian (2009scape EntranceGuardianDialogue + wiki hat-optional) ---

[opnpc1,magictraining_guard_entrance]
~chatplayer("Hi.");
~chatnpc("Greetings. What wisdom do you seek?");
if (%magictraining_entra_noob = 1) {
    @mta_entrance_menu;
    return;
}
def_int $opt = ~p_choice2("I'm new to this place. Where am I?", 1, "None, I don't really care.", 2);
if ($opt = 2) {
    return;
}
~chatplayer("I'm new to this place. Where am I?");
~chatnpc("Well young one, you have entered the Magic Training Arena. It was built at the start of the Fifth Age, when runestones were first discovered.");
~chatnpc("It was made because of the many pointless accidents caused by inexperienced mages.");
~chatplayer("Who created it?");
~chatnpc("It was originally made by the ancestors of the wizards in the Wizards' Tower. Warriors destroyed it; recently the Tower resurrected the arena and its Guardians.");
~chatplayer("Interesting. So what can I do here?");
~chatnpc("Train through the portals at the back of this hall. Each room awards unique Pizazz Points you can spend upstairs with the Rewards Guardian.");
~chatplayer("How do you record the points I have earned?");
~chatnpc("You can take a Pizazz Progress Hat if you wish — talk to it for your totals. The hat is optional to enter the rooms.");
~chatplayer("Yes please!");
~mta_give_hat;
~chatnpc("Here you go. Talk to the hat to find out your current Pizazz Points totals.");
~chatplayer("Talk to it?");
~chatnpc("Well of course, it's a magic Pizazz Progress Hat! Mind your manners though, hats have feelings too!");
~chatnpc("Should you leave a room by any method other than the exit portals, room items will be removed.");

[label,mta_entrance_menu]
def_int $choice = ~p_choice4("Can you tell me about this place again?", 1, "Can you explain the different portals?", 2, "About the progress hat...", 3, "Thanks, bye!", 4);
if ($choice = 4) {
    return;
}
if ($choice = 1) {
    ~chatplayer("Can you tell me about this place again?");
    ~chatnpc("This is the Magic Training Arena. Portals lead to four practice rooms that award Pizazz Points for the Rewards Guardian upstairs.");
    @mta_entrance_menu;
    return;
}
if ($choice = 2) {
    ~chatplayer("Can you explain the different portals?");
    ~chatnpc("They lead to four areas: The Telekinetic Theatre, The Alchemists' Playground, The Enchanting Chamber, and The Creature Graveyard.");
    @mta_portal_detail;
    return;
}
if (~mta_has_hat = 0) {
    ~chatnpc("You want another one don't you.");
    ~chatplayer("Sorry, can I?");
    ~mta_give_hat;
    ~chatnpc("Here you go. Talk to the hat to find out your current Pizazz Point totals.");
} else {
    ~chatnpc("Which you have stored somewhere I'm sure. Collect Pizazz Points and talk to the Rewards Guardian upstairs.");
}
@mta_entrance_menu;

[label,mta_portal_detail]
def_int $p = ~p_choice5("What's the Telekinetic Theatre?", 1, "What's the Alchemists' Playground?", 2, "What's the Enchanting Chamber?", 3, "What's the Creature Graveyard?", 4, "Thanks, bye!", 5);
if ($p = 5) {
    return;
}
if ($p = 1) {
    ~chatnpc("Use Telekinetic Grab to slide a stone Guardian through a maze to the exit square. Each maze awards Telekinetic Pizazz Points.");
} else if ($p = 2) {
    ~chatnpc("Search cupboards for items, alchemise them into arena coins, and deposit them for Alchemist Pizazz Points.");
} else if ($p = 3) {
    ~chatnpc("Enchant shapes into orbs and deposit them in the centre hole for Enchantment Pizazz Points.");
} else {
    ~chatnpc("Convert bones into fruit and deposit them in the wall holes for Graveyard Pizazz Points. Watch out for falling bones!");
}
@mta_portal_detail;

// --- Progress hat ---

[opheld1,magictraining_proghat_dull]
[opheld1,magictraining_proghat_energised]
[opheld1,magictraining_proghat_full]
~mesbox("Telekinetic: <tostring(%mta_pizazz_tele)>|Alchemist: <tostring(%mta_pizazz_alch)>|Enchantment: <tostring(%mta_pizazz_enchant)>|Graveyard: <tostring(%mta_pizazz_grave)>");

[opheld5,magictraining_proghat_dull]
[opheld5,magictraining_proghat_energised]
[opheld5,magictraining_proghat_full]
def_int $d = ~p_choice2("Yes, destroy it.", 1, "No, keep it.", 2);
if ($d = 1) {
    inv_del(inv, last_item, 1);
    mes("You destroy the Progress hat.");
}

[debugproc,mta]
%magictraining_entra_noob = 1;
if (~mta_has_hat = 0 & inv_freespace(inv) > 0) {
    inv_add(inv, magictraining_proghat_dull, 1);
}
%mta_room = ^mta_room_none;
p_teleport(^mta_lobby);
~mta_overlay_open;
mes("MTA lobby — portals + Entrance Guardian + Rewards upstairs.");

[debugproc,mta_shop]
%magictraining_entra_noob = 1;
if (~mta_has_hat = 0 & inv_freespace(inv) > 0) {
    inv_add(inv, magictraining_proghat_dull, 1);
}
p_teleport(0_52_51_35_54);
mes("MTA upstairs — Rewards Guardian + bank chest.");
~mta_shop_open;

[debugproc,mta_tele]
%magictraining_entra_noob = 1;
if (~mta_has_hat = 0 & inv_freespace(inv) > 0) {
    inv_add(inv, magictraining_proghat_dull, 1);
}
~mta_tele_enter;

[debugproc,mta_points]
%mta_pizazz_tele = 500;
%mta_pizazz_alch = 500;
%mta_pizazz_enchant = 6000;
%mta_pizazz_grave = 500;
~mta_overlay_update;
mes("Granted shop-ready Pizazz totals.");

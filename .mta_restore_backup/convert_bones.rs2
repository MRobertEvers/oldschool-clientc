// Bones to Bananas (+ MTA bones / Bones to Peaches unlock).
// From LostCity convert_bones.rs2 + 2009scape ModernListeners.boneConvert.

[if_button,magic_spellbook:bones_bananas] @magic_spell_convert_bones(^bones_to_bananas);

[label,magic_spell_convert_bones](int $spell)
if (p_finduid(uid) = true) {
    def_dbrow $spell_data = ~get_spell_data($spell);
    if (~check_spell_requirements($spell_data) = false) {
        return;
    }
    def_namedobj $product;
    def_seq $anim;
    def_spotanim $spotanim;
    $product, $anim, $spotanim = ~magic_spell_search_convertobj($spell_data, null);
    // Unlocked Bones to Peaches → peaches product.
    if (%magictraining_bonespeaches = 1) {
        $product = peach;
    }
    def_int $mta_bones = calc(inv_total(inv, magictraining_bones1) + inv_total(inv, magictraining_bones2) + inv_total(inv, magictraining_bones3) + inv_total(inv, magictraining_bones4));
    def_int $total_bones = inv_total(inv, bones);
    if ($total_bones < 1 & $mta_bones < 1) {
        mes("You aren't holding any bones!");
        return;
    }
    if (%mta_room = ^mta_room_grave) {
        ~mta_grave_convert($product);
    } else {
        if ($total_bones > 0) {
            inv_del(inv, bones, $total_bones);
            inv_add(inv, $product, $total_bones);
        }
        if ($mta_bones > 0) {
            ~mta_grave_convert($product);
        }
    }
    anim($anim, 0);
    spotanim_pl($spotanim, 92, 0);
    ~delete_spell_runes($spell_data);
    ~give_spell_xp($spell_data);
    p_delay(2);
}

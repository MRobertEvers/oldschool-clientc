// Low / high alchemy. From LostCity skill_magic/scripts/spells/alchemy.rs2.
//
// IF: magic:lowlvl_alchemy/highlvl_alchemy → magic_spellbook:low_alchemy /
// high_alchemy. Era: drop sound_synth / afk_event / wealth_event /
// if_settabactive(^tab_magic). Engine gap: oc_cost not decoded yet — cast will
// hit the VM stub until Mock230ObjInfo grows cost. Category kitten/cat/etc
// checks dropped (cats not allocated).
// MTA Alchemists' Playground: arena coins at session costs.

[opheldt,magic_spellbook:high_alchemy] @magic_spell_high_alch(^highlvl_alchemy, last_item);
[opheldt,magic_spellbook:low_alchemy] @magic_spell_low_alch(^lowlvl_alchemy, last_item);

[label,magic_spell_high_alch](int $spell, obj $item)
if_close;
def_dbrow $spell_data = ~get_spell_data($spell);
if (~check_spell_requirements($spell_data) = false) {
    return;
}
if (~is_alchable($item, $spell_data) = false) {
    return;
}
// Mage Training Arena Alchemists' Playground.
if (%mta_room = ^mta_room_alchem & ~mta_alchem_item_index($item) > 0) {
    def_int $idx = ~mta_alchem_item_index($item);
    def_int $free = 0;
    if (%mta_alch_free = $idx) {
        $free = 1;
    }
    def_int $cost = ~mta_alchem_cost_of($idx);
    if (calc(inv_total(inv, magictraining_coins) + $cost) > 10000) {
        mes("You can't hold that many arena coins.");
        return;
    }
    anim(human_casthighlvlalchemy, 0);
    spotanim_pl(highlvlalchemy_casting, 92, 0);
    if ($free = 0) {
        ~delete_spell_runes($spell_data);
    }
    ~give_spell_xp($spell_data);
    ~mta_alchem_finish_alch($item, $free);
    p_delay(3);
    return;
}
anim(human_casthighlvlalchemy, 0);
spotanim_pl(highlvlalchemy_casting, 92, 0);
~delete_spell_runes($spell_data);
~give_spell_xp($spell_data);
def_int $profit = max(scale(6, 10, oc_cost($item)), 1);
inv_del(inv, $item, 1);
inv_add(inv, coins, $profit);
p_delay(3);

[label,magic_spell_low_alch](int $spell, obj $item)
if_close;
def_dbrow $spell_data = ~get_spell_data($spell);
if (~check_spell_requirements($spell_data) = false) {
    return;
}
if (~is_alchable($item, $spell_data) = false) {
    return;
}
if (%mta_room = ^mta_room_alchem & ~mta_alchem_item_index($item) > 0) {
    def_int $idx = ~mta_alchem_item_index($item);
    def_int $free = 0;
    if (%mta_alch_free = $idx) {
        $free = 1;
    }
    def_int $cost = ~mta_alchem_cost_of($idx);
    if (calc(inv_total(inv, magictraining_coins) + $cost) > 10000) {
        mes("You can't hold that many arena coins.");
        return;
    }
    anim(human_castlowlvlalchemy, 0);
    spotanim_pl(lowlvlalchemy_casting, 92, 0);
    if ($free = 0) {
        ~delete_spell_runes($spell_data);
    }
    ~give_spell_xp($spell_data);
    ~mta_alchem_finish_alch($item, $free);
    p_delay(1);
    return;
}
anim(human_castlowlvlalchemy, 0);
spotanim_pl(lowlvlalchemy_casting, 92, 0);
~delete_spell_runes($spell_data);
~give_spell_xp($spell_data);
def_int $profit = max(scale(4, 10, oc_cost($item)), 1);
inv_del(inv, $item, 1);
inv_add(inv, coins, $profit);
p_delay(1);

[proc,is_alchable](obj $item, dbrow $spell_data)(boolean)
def_namedobj $rune1;
def_int $rune_count1;
def_namedobj $rune2;
def_int $rune_count2;
def_namedobj $rune3;
def_int $rune_count3;
$rune1, $rune_count1, $rune2, $rune_count2, $rune3, $rune_count3 = ~staff_runes($spell_data);
switch_obj($item) {
    case naturerune :
        if (sub(inv_total(inv, naturerune), $rune_count1) < 1) {
            mes("You do not have enough Nature Runes to cast this spell.");
            return(false);
        }
    case firerune :
        if (sub(inv_total(inv, firerune), $rune_count2) < 1) {
            mes("You do not have enough Fire Runes to cast this spell.");
            return(false);
        }
    case coins :
        mes("Coins are already made of gold.");
        return(false);
    case default :
        if (oc_param($item, no_alchemy) = ^true) {
            mes("You cannot use alchemy on that item.");
            return(false);
        }
}
return(true);

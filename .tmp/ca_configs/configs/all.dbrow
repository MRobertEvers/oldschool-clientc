columndef=6:ending_port,dbrow
values=6:0:8613
columndef=16:cargo,namedobj,int
values=16:0:32957,7
columndef=23:task_board_graphic,model
values=23:0:57816
columndef=24:flavour_text,string
values=24:0:The dwarves at Deepfin Point have asked us to send some planks down to them. Looking for a reliable courier to make the delivery.<br>- Sawmill Operator

[port_task_prifddinas_courier_10]
columns=25
table=port_task
columndef=0:task_id,int
values=0:0:372
columndef=1:name,string
values=1:0:Prifddinas ore delivery
columndef=2:task_type,int
values=2:0:0
columndef=3:level_required,int
values=3:0:70
columndef=4:starting_port,dbrow

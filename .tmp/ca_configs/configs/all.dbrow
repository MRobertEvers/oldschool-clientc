columndef=6:ending_port,dbrow
values=6:0:8596
columndef=16:cargo,namedobj,int
values=16:0:32455,9
columndef=23:task_board_graphic,model
values=23:0:57810
columndef=24:flavour_text,string
values=24:0:We've got some jewellery here that's meant to be in Ardougne. I need someone to take it over there.<br>- Prifddinas Port Master

[port_task_prifddinas_courier_9]
columns=25
table=port_task
columndef=0:task_id,int
values=0:0:371
columndef=1:name,string
values=1:0:Deepfin Point plank delivery
columndef=2:task_type,int
values=2:0:0
columndef=3:level_required,int

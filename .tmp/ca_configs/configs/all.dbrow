columndef=23:task_board_graphic,model
values=23:0:57830
columndef=24:flavour_text,string
values=24:0:I've made arrangements to buy some pest remains from the Void Knights for some experiments of mine. I need someone to go and pick them up. Pointless questions are not required.<br>- Wizard Grayzag

[port_task_the_pandemonium_courier_0]
columns=25

columndef=23:task_board_graphic,model
values=23:0:57825
columndef=24:flavour_text,string
values=24:0:Thanks to some top parleying\\, I've got my hands on some steel bars. They're coming through Port Sarim so I need someone to pick them up there and bring them to the Pandemonium.<br>- Parleying Preston

[port_task_the_pandemonium_courier_2]
columns=25

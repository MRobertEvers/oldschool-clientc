values=23:0:57830
columndef=24:flavour_text,string
values=24:0:I've got some jewellery acquired through entirely legitimate means. I need someone to deliver it to Port Sarim for me.<br>- One Eyed Rosalee

[port_task_the_pandemonium_courier_1]
columns=25

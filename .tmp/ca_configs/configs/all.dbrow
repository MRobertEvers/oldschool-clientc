values=23:0:57826
columndef=24:flavour_text,string
values=24:0:Some outerlanders at Piscatoris want to see what proper fur feels like. I need someone to take some to them.<br>- Rellekka Fur Trader

[port_task_rellekka_courier_12]
columns=25

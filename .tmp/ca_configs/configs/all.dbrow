columndef=0:id,int
values=0:0:686
columndef=1:difficulty,int
values=1:0:4
columndef=2:clue_text,string
values=2:0:You were 3 and I was the 6th. Come speak to me.
columndef=3:target,dbrow
values=3:0:948
columndef=10:region,int
values=10:0:1

[cluehelper_cryptic_elite_kamfreena]
columns=15

values=16:0:32490,1
columndef=23:task_board_graphic,model
values=23:0:57813
columndef=24:flavour_text,string
values=24:0:Yo ho ho! I need a top sailor to set out on a pirate adventure for me. I have some grog that need taking to Catherby. Hoist your anchor and get to it!<br>- Steve Beanie

[port_task_the_pandemonium_courier_10]
columns=25
table=port_task
columndef=0:task_id,int
values=0:0:30
columndef=1:name,string
values=1:0:Pandemonium arrowtip delivery
columndef=2:task_type,int

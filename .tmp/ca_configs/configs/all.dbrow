values=16:0:32501,2
columndef=23:task_board_graphic,model
values=23:0:57814
columndef=24:flavour_text,string
values=24:0:New trade opportunities with the west means new books for our library. I've agreed to a book exchange with the museum over in Fortis. I now need someone to take some books over to them.<br>- Lutwidge

[port_task_corsair_cove_courier_18]
columns=25
table=port_task

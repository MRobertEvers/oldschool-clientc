values=23:0:57834
columndef=24:flavour_text,string
values=24:0:Rowdy revellers keep getting into fights and punching holes in the walls. I need some planks collecting to have them fixed.<br>- Thora the Barkeep

[port_task_rellekka_courier_11]
columns=25

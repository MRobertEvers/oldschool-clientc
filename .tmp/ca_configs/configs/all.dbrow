[league_relic_endless_harvest_toggle_bank]
columns=7
table=league_relic_effect_toggle
columndef=0:toggle_debugname,string
values=0:0:Endless harvest bank toggle
columndef=1:toggle_relic,struct
values=1:0:1722
columndef=2:toggle_desc,string
values=2:0:All resources gathered will be sent to the bank.
columndef=3:toggle_on_message,string
values=3:0:All resources gathered will now be put into your bank.
columndef=4:toggle_off_message,string
values=4:0:All resources gathered will now be put into your inventory.
columndef=6:toggle_bit,int
values=6:0:0

[league_relic_barbarian_gathering_toggle_dispose_effect]
columns=7
table=league_relic_effect_toggle
columndef=0:toggle_debugname,string
values=0:0:Barbarian Gathering dispose toggle
columndef=1:toggle_relic,struct
values=1:0:6441
columndef=2:toggle_desc,string
values=2:0:Dispose option will ask what to destroy.
columndef=3:toggle_on_message,string
values=3:0:Dispose option will ask what you want to destroy.
columndef=4:toggle_off_message,string
values=4:0:Dispose option will always destroy everything.
columndef=6:toggle_bit,int
values=6:0:1

[league_relic_abundance_toggle_coins_inv]
columns=7
table=league_relic_effect_toggle
columndef=0:toggle_debugname,string
values=0:0:Abundance coin inv toggle
columndef=1:toggle_relic,struct
values=1:0:6445
columndef=2:toggle_desc,string
values=2:0:Coins generated will be put into your inventory.
columndef=3:toggle_on_message,string
values=3:0:Coins generated will now be put into your inventory.
columndef=4:toggle_off_message,string
values=4:0:Coins generated will now be put into your bank.
columndef=6:toggle_bit,int
values=6:0:2

[league_relic_woodsman_toggle_bank]
columns=7
table=league_relic_effect_toggle
columndef=0:toggle_debugname,string
values=0:0:Woodsman bank toggle
columndef=1:toggle_relic,struct
values=1:0:6440
columndef=2:toggle_desc,string
values=2:0:Hunter traps harvest directly to your bank.
columndef=3:toggle_on_message,string
values=3:0:When harvesting a hunter trap the contents will be put into your bank.
columndef=4:toggle_off_message,string
values=4:0:When harvesting a hunter trap the contents will be put into your inventory.
columndef=6:toggle_bit,int
values=6:0:3

[league_relic_woodsman_toggle_burn]
columns=7
table=league_relic_effect_toggle
columndef=0:toggle_debugname,string
values=0:0:Woodsman burn toggle
columndef=1:toggle_relic,struct
values=1:0:6440
columndef=2:toggle_desc,string
values=2:0:Logs chopped will be automatically burned.
columndef=3:toggle_on_message,string
values=3:0:When chopping logs they will automatically be burned for firemaking XP.
columndef=4:toggle_off_message,string
values=4:0:When chopping logs they will no longer be automatically burned.
columndef=6:toggle_bit,int
values=6:0:4

[league_relic_transmutation_alchemy_toggle]
columns=7
table=league_relic_effect_toggle
columndef=0:toggle_debugname,string
values=0:0:Transmutation alchemy toggle
columndef=1:toggle_relic,struct
values=1:0:6446
columndef=2:toggle_desc,string
values=2:0:Alchemic spells transmute items.
columndef=3:toggle_on_message,string
values=3:0:Alchemic spells will now transmute certain items.
columndef=4:toggle_off_message,string
values=4:0:Alchemic spells will now turn items into gold like normal Alchemy spells.
columndef=6:toggle_bit,int
values=6:0:5

[league_relic_transmutation_bank_toggle]

values=5:0:8616
columndef=6:ending_port,dbrow
values=6:0:8607
columndef=16:cargo,namedobj,int
values=16:0:32803,6
columndef=23:task_board_graphic,model
values=23:0:57838
columndef=24:flavour_text,string
values=24:0:Some human knights are dealing with some sort of pest problem. They must be quite the pests as apparently they need lots of runes to do so. Could someone take some over to them?<br>- Efa

[port_task_prifddinas_courier_18]
columns=25
table=port_task
columndef=0:task_id,int
values=0:0:380
columndef=1:name,string
values=1:0:Prifddinas book delivery
columndef=2:task_type,int
values=2:0:0
columndef=3:level_required,int

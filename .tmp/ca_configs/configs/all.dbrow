columndef=24:flavour_text,string
values=24:0:There's some teak logs sat at Etceteria that are meant to be here. I need someone to go and fetch them.<br>- Rellekka Port Master

[port_task_rellekka_courier_2]
columns=25
table=port_task
columndef=0:task_id,int
values=0:0:383
columndef=1:name,string
values=1:0:Neitiznot coal delivery

columndef=5:cargo_port,dbrow
values=5:0:8610
columndef=6:ending_port,dbrow
values=6:0:8615
columndef=16:cargo,namedobj,int
values=16:0:32605,6
columndef=23:task_board_graphic,model
values=23:0:57824
columndef=24:flavour_text,string
values=24:0:I've got some sand here that I need sending over to Neitiznot before someone there starts complaining\\, and believe me\\, that lot love complaining.<br>- Sigmund the Merchant

[port_task_rellekka_courier_8]
columns=25
table=port_task
columndef=0:task_id,int
values=0:0:389
columndef=1:name,string
values=1:0:Sunset Coast fish delivery

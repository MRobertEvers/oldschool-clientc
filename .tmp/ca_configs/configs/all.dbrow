values=23:0:57835
columndef=24:flavour_text,string
values=24:0:I've got an order of runes that I need picking up from Port Sarim. We need any edge we can find when it comes to dealing with the Tempoross.<br>- Captain Dudi

[port_task_ruins_of_unkah_courier_2]
columns=25
table=port_task

columndef=1:toggle_relic,struct
values=1:0:6447
columndef=2:toggle_desc,string
values=2:0:All dropped bones and ashes will be turned into Soul Shards.
columndef=3:toggle_on_message,string
values=3:0:All dropped bones and ashes will be turned into Soul Shards and put into your inventory.
columndef=4:toggle_off_message,string
values=4:0:All dropped bones and ashes will be dropped as normal.

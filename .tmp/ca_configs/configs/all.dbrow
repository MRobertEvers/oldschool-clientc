values=10:0:4

[cluehelper_cryptic_elite_gypsy_aris]
columns=15
table=cluehelper_clue_cryptic
columndef=0:id,int
values=0:0:691
columndef=1:difficulty,int
values=1:0:4
columndef=2:clue_text,string
values=2:0:Varrock is where I reside\\, not the land of the dead\\, but I am so old\\, I should be there instead. Let's hope your reward is as good as it says\\, just 1 gold one and you can have it read.
columndef=3:target,dbrow
values=3:0:981
columndef=10:region,int
values=10:0:1

[cluehelper_cryptic_elite_daga]
columns=15

columndef=23:task_board_graphic,model
values=23:0:57827
columndef=24:flavour_text,string
values=24:0:I've got an order of swamp tar that needs delivering to the general store in Port Khazard. Looking for someone to take it over there.<br>- Tarquin\\, Tar merchant

[port_task_port_sarim_courier_12]

values=23:0:57825
columndef=24:flavour_text,string
values=24:0:I need someone to deliver this armour to the Pandemonium for me. Some legitimate businessmen there wish to use it for their adventures at sea.<br>- Horvik

[port_task_port_sarim_courier_1]
columns=25
table=port_task

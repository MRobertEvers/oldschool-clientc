columndef=23:task_board_graphic,model
values=23:0:57825
columndef=24:flavour_text,string
values=24:0:One of my usual captains has fallen ill so I need someone to quickly step in. I've got some pineapples in Brimhaven that need collecting and bringing back here.<br>- Fiora

[port_task_the_pandemonium_courier_6]
columns=25
table=port_task
columndef=0:task_id,int

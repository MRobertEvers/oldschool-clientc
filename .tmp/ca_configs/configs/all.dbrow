columndef=5:cargo_port,dbrow
values=5:0:8588
columndef=6:ending_port,dbrow
values=6:0:8601
columndef=16:cargo,namedobj,int
values=16:0:32530,3
columndef=23:task_board_graphic,model
values=23:0:57815
columndef=24:flavour_text,string
values=24:0:We're running low on shipbuilding materials here\\, but Jim over at the Pandemonium always has extra. I need someone to go and collect some for me.<br>- Shipwright Soraya

[port_task_corsair_cove_courier_17]
columns=25
table=port_task
columndef=0:task_id,int
values=0:0:151
columndef=1:name,string
values=1:0:Civitas illa Fortis book delivery

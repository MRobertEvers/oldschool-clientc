columndef=5:cargo_port,dbrow
values=5:0:8616
columndef=6:ending_port,dbrow
values=6:0:8610
columndef=16:cargo,namedobj,int
values=16:0:32743,7
columndef=23:task_board_graphic,model
values=23:0:57834
columndef=24:flavour_text,string
values=24:0:Got another order of planks. These ones are for Rellekka. I hear the humans there aren't always keen on outsiders so need someone who can make a good impression.<br>- Sawmill Operator

[port_task_prifddinas_courier_17]
columns=25
table=port_task
columndef=0:task_id,int
values=0:0:379
columndef=1:name,string
values=1:0:Void Knights' Outpost rune delivery

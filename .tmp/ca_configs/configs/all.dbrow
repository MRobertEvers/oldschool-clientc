columndef=23:task_board_graphic,model
values=23:0:57824
columndef=24:flavour_text,string
values=24:0:Neitiznot need coal and they're probably too proud to just get some from Jatizso. We have plenty though. Just need someone to get it over there.<br>- Sigmund the Merchant

[port_task_rellekka_courier_3]
columns=25
table=port_task
columndef=0:task_id,int
values=0:0:384
columndef=1:name,string

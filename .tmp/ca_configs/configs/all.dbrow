values=16:0:32760,6
columndef=23:task_board_graphic,model
values=23:0:57837
columndef=24:flavour_text,string
values=24:0:Sounds like those westerners don't fish anywhere near as good as we do. I need someone to take some fish over to the Sunset Coast so they can find out what a true catch tastes like.<br>- Rellekka Fishmonger

[port_task_rellekka_courier_9]
columns=25
table=port_task
columndef=0:task_id,int
values=0:0:390
columndef=1:name,string
values=1:0:Port Roberts fish delivery

[deadman_points_info]
columns=1
table=fsw_points_info_table
columndef=0:info,graphic,int,int,int,string,string,string
values=0:0:1096,25,0,-3,Breaches,1,Awarded per point of damage dealt to any boss spawned from a Breach.<br>Cap of 75\\,000 points from breach bosses.<br>Cap of 5\\,000 points per day.<br>Daily cap is cumulative\\, meaning day 5\\, if you received no points day 1-4\\, you could obtain 25\\,000 points day 5.
values=0:1:3387,16,-4,-3,Levels,5,5 points awarded per level.<br>5 additional points awarded per level from level 50 onwards.<br>300 bonus points is awarded for each 99.
values=0:2:3390,20,-4,-3,Collection Log,10,Awarded per collection log.
values=0:3:2534,20,0,-3,Clues,Beginner = 5<br>Easy = 8<br>Medium = 15<br>Hard = 20<br>Elite = 30<br>Master = 55,Awarded per clue completion.<br>5x multiplier for the first clue completion per tier.<br>No points for clue completions beyond the 100th.
values=0:4:836,20,-2,0,Achievement Diary<br> - Task,Easy = 15<br>Medium = 25<br>Hard = 40<br>Elite = 60,Awarded per task completion.
values=0:5:4059,20,-4,0,Boss<br> - Kill,#,Gained per boss kill.<br>5x multiplier for the first kill of the boss.<br>No points for a kill beyond the 100th.
values=0:6:3400,20,-2,0,Combat Achievement<br> - Task,Easy = 10<br>Medium = 15<br>Hard = 25<br>Elite = 35<br>Master = 50<br>Grandmaster = 75,Awarded per task completion.


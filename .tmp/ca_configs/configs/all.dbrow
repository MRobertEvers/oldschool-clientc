columndef=16:cargo,namedobj,int
values=16:0:32792,2
columndef=23:task_board_graphic,model
values=23:0:57836
columndef=24:flavour_text,string
values=24:0:Had a request to send some sandstone over to the Great Conch. Apparently the tortugans there think they can use it to defend against gryphons in some way.<br>- Drew

[port_task_ruins_of_unkah_courier_3]
columns=25
table=port_task
columndef=0:task_id,int
values=0:0:156
columndef=1:name,string
values=1:0:Ruin of Unkah coral delivery
columndef=2:task_type,int

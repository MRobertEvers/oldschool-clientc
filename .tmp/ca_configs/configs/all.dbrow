columndef=6:ending_port,dbrow
values=6:0:8597
columndef=16:cargo,namedobj,int
values=16:0:32618,2
columndef=23:task_board_graphic,model
values=23:0:57827
columndef=24:flavour_text,string
values=24:0:Had a request for some crab paste to be send over to Port Khazard. One of the adult tortugans has apparently been telling them how good it is for making potions. I need someone to take it for me.<br>- Elder Strom

[port_task_the_summer_shore_courier_17]
columns=25
table=port_task
columndef=0:task_id,int

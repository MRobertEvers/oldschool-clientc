columndef=5:cargo_port,dbrow
values=5:0:8610
columndef=6:ending_port,dbrow
values=6:0:8608
columndef=16:cargo,namedobj,int
values=16:0:32976,5
columndef=23:task_board_graphic,model
values=23:0:57829
columndef=24:flavour_text,string
values=24:0:I've got fish to spare and there are plenty of outerlanders who love them. I need someone to take them to Port Roberts to be sold there.<br>- Rellekka Fishmonger

[port_task_rellekka_courier_10]
columns=25
table=port_task
columndef=0:task_id,int
values=0:0:391

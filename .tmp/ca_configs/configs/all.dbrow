values=24:0:The soldiers on the frontline need feeding. I need someone to collect some veg from Hosidius for them.<br>- Captain Sdiar

[port_task_lands_end_courier_2]
columns=25
table=port_task
columndef=0:task_id,int
values=0:0:231
columndef=1:name,string
values=1:0:Port Piscarilius plank delivery
columndef=2:task_type,int
values=2:0:0

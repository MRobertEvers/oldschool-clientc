columndef=23:task_board_graphic,model
values=23:0:57825
columndef=24:flavour_text,string
values=24:0:I took a trip to the Pandemonium but found their stew to be so bland that even the rats wouldn't touch it. I need someone to take some spices over so they can try making a proper one.<br>- Gnocci

[port_task_corsair_cove_courier_16]
columns=25
table=port_task
columndef=0:task_id,int
values=0:0:150
columndef=1:name,string
values=1:0:Corsair Cove ship part delivery
columndef=2:task_type,int

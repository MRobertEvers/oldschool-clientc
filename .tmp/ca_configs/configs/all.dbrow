values=16:0:32679,1
columndef=23:task_board_graphic,model
values=23:0:57830
columndef=24:flavour_text,string
values=24:0:Someone calling themselves 'The Face' needs a large amount of fish to feed their 'clients' with. Seems a bit weird\\, but they're paying well. I need someone to make the delivery to Port Sarim for me.<br>- Henderson

[port_task_the_pandemonium_courier_7]
columns=25
table=port_task
columndef=0:task_id,int
values=0:0:27
columndef=1:name,string
values=1:0:Musa Point ship part delivery
columndef=2:task_type,int
values=2:0:0
columndef=3:level_required,int

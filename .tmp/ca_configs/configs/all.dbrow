columndef=23:task_board_graphic,model
values=23:0:57837
columndef=24:flavour_text,string
values=24:0:Our friends who have travelled to the far west need some more warhammers sending over so that they may continue to show the outerlanders there how a true warrior fights!<br>- Skulgrimen

[port_task_rellekka_courier_5]
columns=25
table=port_task
columndef=0:task_id,int
values=0:0:386
columndef=1:name,string
values=1:0:Rellekka fabric delivery

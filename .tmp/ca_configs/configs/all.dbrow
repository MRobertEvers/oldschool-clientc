columndef=23:task_board_graphic,model
values=23:0:57834
columndef=24:flavour_text,string
values=24:0:Some of the warriors who decided to visit the lands to the west are sending back some fabrics they've traded with the outerlanders there. It's a long trip\\, but I'll pay well if anyone can make it.<br>- Yrsa

[port_task_rellekka_courier_6]
columns=25
table=port_task
columndef=0:task_id,int
values=0:0:387
columndef=1:name,string
values=1:0:Etceteria warhammer delivery

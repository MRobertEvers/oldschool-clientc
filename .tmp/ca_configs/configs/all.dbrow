values=23:0:57825
columndef=24:flavour_text,string
values=24:0:Need someone to collect some gold bars from Corsair Cove for me. The quicker the better.<br>- Anonymous

[port_task_the_pandemonium_courier_13]
columns=25
table=port_task
columndef=0:task_id,int
values=0:0:33
columndef=1:name,string
values=1:0:Port Khazard kyatt teeth delivery
columndef=2:task_type,int

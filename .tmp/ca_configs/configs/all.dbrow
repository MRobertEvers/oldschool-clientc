values=0:2:2534,20,0,-3,Clues,Beginner = 3<br>Easy = 6<br>Medium = 14<br>Hard = 30<br>Elite = 62<br>Master = 130,Awarded per clue completion.
values=0:3:836,20,-2,0,Achievement Diary<br> - Task,Easy = 4<br>Medium = 12<br>Hard = 28<br>Elite = 64,Awarded per task completion.
values=0:4:836,20,-2,0,Achievement Diary<br> - Tier Completion,-,A bonus award of half of the total points the tier is worth.
values=0:5:4059,20,-4,0,Boss<br> - Kill,#,Gained per boss kill.
values=0:6:4074,20,-4,0,Boss<br> - First Kill,-,20x multiplier for the first kill of the boss.
values=0:7:3400,20,-2,0,Combat Achievement<br> - Task,Easy = 4<br>Medium = 12<br>Hard = 28<br>Elite = 64<br>Master = 100<br>Grandmaster = 150,Awarded per task completion.

columndef=23:task_board_graphic,model
values=23:0:57811
columndef=24:flavour_text,string
values=24:0:Had some cacti come in from the Ruins of Unkah that needs sending on to Brimhaven. Looking for someone to get the job done.<br>- The Pandemonium Port Master

[port_task_the_pandemonium_courier_9]
columns=25
table=port_task
columndef=0:task_id,int
values=0:0:29
columndef=1:name,string
values=1:0:Catherby grog delivery
columndef=2:task_type,int

values=16:0:32945,1
columndef=23:task_board_graphic,model
values=23:0:57813
columndef=24:flavour_text,string
values=24:0:Apparently they're running low on fishing bait over in Catherby. Not sure why. They're literally just worms. Regardless\\, I have some I can send over to them. Just need someone to take it.<br>- Gerrant

[port_task_catherby_courier_2]
columns=25
table=port_task
columndef=0:task_id,int
values=0:0:60
columndef=1:name,string
values=1:0:Ardougne fish delivery
columndef=2:task_type,int
values=2:0:0
columndef=3:level_required,int
values=3:0:28
columndef=4:starting_port,dbrow

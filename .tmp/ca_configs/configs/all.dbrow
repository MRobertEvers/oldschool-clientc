columndef=23:task_board_graphic,model
values=23:0:57814
columndef=24:flavour_text,string
values=24:0:Another order of staffs! These ones need taking to the capital of Varlamore. Will pay well to anyone happy to make the journey.<br>- Elgan

[port_task_prifddinas_courier_14]
columns=25
table=port_task
columndef=0:task_id,int
values=0:0:376
columndef=1:name,string
values=1:0:Prifddinas spice delivery

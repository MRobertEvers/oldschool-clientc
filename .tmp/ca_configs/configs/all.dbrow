columndef=23:task_board_graphic,model
values=23:0:57834
columndef=24:flavour_text,string
values=24:0:I'm looking for a capable courier to take a delivery of pies to some friends of mine up north. They've got a big event coming up soon.<br>- Romily Weaklax

[port_task_port_sarim_courier_18]
columns=25
table=port_task

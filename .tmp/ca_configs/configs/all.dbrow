values=16:0:32558,7
columndef=23:task_board_graphic,model
values=23:0:57818
columndef=24:flavour_text,string
values=24:0:Etceteria need some warhammers sending over to help deal with some problems they've been having in those caves they're digging. Probably disturbed a basilisk or something.<br>- Skulgrimen

[port_task_rellekka_courier_7]
columns=25
table=port_task
columndef=0:task_id,int
values=0:0:388
columndef=1:name,string
values=1:0:Neitiznot sand delivery

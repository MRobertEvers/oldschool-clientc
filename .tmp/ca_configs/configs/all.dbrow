values=16:0:32599,1
columndef=23:task_board_graphic,model
values=23:0:57823
columndef=24:flavour_text,string
values=24:0:I thought some merchants were carrying valuable goods from Musa Point\\, but it turned out to just be some bananas. Could someone take them back for me? The original ship ran into some problems at sea.<br>- Captain Harry Robin

[port_task_the_pandemonium_courier_3]
columns=25
table=port_task
columndef=0:task_id,int
values=0:0:23
columndef=1:name,string
values=1:0:Pandemonium rum delivery
columndef=2:task_type,int
values=2:0:0
columndef=3:level_required,int
values=3:0:10
columndef=4:starting_port,dbrow
values=4:0:8588
columndef=5:cargo_port,dbrow

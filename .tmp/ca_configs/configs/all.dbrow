values=23:0:57834
columndef=24:flavour_text,string
values=24:0:There's a shortage of rope on the docks here. I need someone to go and collect some from Neitiznot as soon as possible.<br>- Rellekka Port Master

[port_task_rellekka_courier_4]
columns=25
table=port_task
columndef=0:task_id,int
values=0:0:385
columndef=1:name,string

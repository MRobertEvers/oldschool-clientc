columndef=23:task_board_graphic,model
values=23:0:57830
columndef=24:flavour_text,string
values=24:0:We accidentally took an extra shipment of logs when we docked at Port Sarim. The crewmate responsible is now scrubbing our decks. Please pick up the logs and return them to Port Sarim<br>- Captain Wilbur

[port_task_port_sarim_courier_4]
columns=25
table=port_task
columndef=0:task_id,int
values=0:0:5

[skill_feature_farming_scarecrow_page]
columns=10
table=skill_features
columndef=0:icon,obj
values=0:0:6059
columndef=2:text,string
values=2:0:Level 23 Farming allows you to make a scarecrow and place it in a flower patch.<br>Scarecrows ward sweetcorn from being attacked by birds\\, which helps to prevent disease.<br><br>How to make a scarecrow:<br>1. Fill an empty sack with straw from a bale.<br>2. Drive the hay sack onto a bronze spear.<br>3. Place a watermelon on top as a head.<br>4. Stand the scarecrow in an empty flower patch.
columndef=3:skill,int,int,int
values=3:0:21,-1,9

param=param_882,int,8295
param=param_885,int,1
param=param_1855,int,0
param=param_2574,int,16147

[struct_6441]
param=param_879,str,Barbarian Gathering
param=param_880,str,- You become capable of chopping wood, mining rocks and fishing with your bare hands without requiring any tools or bait.<br><br>- Your hands are equivalent to the crystal version of the respective tools where those exist.<br><br>- Whenever you gain <col=#>Fishing</col>, <col=#>Woodcutting</col> or <col=#>Mining</col> XP while gathering you will also receive an additional 10% XP in both <col=#>Strength</col> and <col=#>Agility</col>.<br><br>- Up to 3 different types of gathered items (wood, fish, metallic ore and coal) can be placed in the <col=#>Knapsack</col>, which has a total maximum capacity of 140.<br><br>- On failing to mine a rock, catch a fish or chop a tree you will have a separate 50% chance to succeed instead.<br><br>- The <col=#>Knapsack</col> can be emptied at a bank.
param=param_884,int,8156
param=param_1853,int,8237

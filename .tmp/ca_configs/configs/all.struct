[struct_6450]
param=param_879,str,Map of Alacrity
param=param_880,str,This item will allow you to teleport to <col=#>Agility shortcuts</col>.<br>- You will be sent to the less favourable side of the shortcut, or the starting side if it is one-way.<br>- Teleports can only be used if you meet all of the requirements to reach their location.<br>- Shortcuts retain all of their typical requirements.<br><br>This item ignores wilderness teleport restrictions.
param=param_884,int,8162
param=param_1853,int,8243
param=param_1854,int,8270
param=param_881,int,8189

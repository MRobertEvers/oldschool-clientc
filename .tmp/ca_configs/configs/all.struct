param=param_881,int,2674
param=param_883,int,2675
param=param_885,int,3
param=param_1274,int,3070

[struct_1734]
param=param_879,str,The Botanist
param=param_880,str,- Farming cycles occur every 1 minute instead of every 5 minutes. (I.e. Your crops grow 5 times faster than normal.)<br><br>- Resources gathered from Farming are multiplied by 2x. Resources generated this way will not provide any additional experience.<br><br>- Mixing Potions always results in a 4-dose Potion, and there is a 95% chance to save your secondary ingredient.<br><br>- Stats boosted above their base level will no longer drain back down over time.

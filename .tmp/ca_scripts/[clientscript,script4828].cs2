// 4828
[clientscript,script4828](component $component0, int $int1)
if (cc_find($component0, 0) = ^true) {
	cc_settrans(0);
	if (~script1972 = 0) {
		cc_setonmouseover("script4827(1, $component0, $int1)");
		cc_setonmouseleave("script4827(0, $component0, $int1)");
	}
}
if (cc_find($component0, 3) = ^true) {
	cc_settrans(0);
	cc_setgraphic("graphic_788");
}
if (cc_find($component0, 4) = ^true) {
	cc_setcolour($int1);
}

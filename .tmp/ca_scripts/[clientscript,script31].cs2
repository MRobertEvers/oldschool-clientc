// 31
[clientscript,script31](component $component0, component $component1, graphic $graphic2, graphic $graphic3, graphic $graphic4, graphic $graphic5, graphic $graphic6, graphic $graphic7)
cc_create($component0, 5, 0, 0);
cc_setposition(0, 0, 1, 1);
cc_setsize(0, 32, 1, 1);
cc_setgraphic($graphic2);
cc_settiling(false);
cc_setonclick("script34($component0, $component1, event_mousey)");
cc_setonscrollwheel("script36($component0, $component1, event_mousey)");
cc_setnoclickthrough(true);
.cc_create($component0, 5, 1, 0);
.cc_setposition(0, 16, 1, 0);
def_int $height8 = if_getscrollheight($component1);
if ($height8 <= 0) {
	$height8 = if_getheight($component1);
}
def_int $height9 = 0;
if ($height8 > 0) {
	$height9 = calc((if_getheight($component0) - 32) * if_getheight($component1) / $height8);
} else {
	$height9 = calc(if_getheight($component0) - 32);
}
if ($height9 < 10) {
	$height9 = 10;
}
.cc_setsize(0, $height9, 1, 0);
.cc_setgraphic($graphic4);
.cc_settiling(false);
.cc_setdraggable($component0, 0);
.cc_setondrag("script35($component0, $component1, event_mousey, 0)");
.cc_setondragcomplete("script35($component0, $component1, event_mousey, 1)");
.cc_setdraggablebehavior(1);
cc_create($component0, 5, 2, 0);
cc_setposition(0, .cc_gety, 1, 0);
cc_setsize(0, 5, 1, 0);
cc_setgraphic($graphic3);
cc_settiling(false);
cc_create($component0, 5, 3, 0);
cc_setposition(0, calc(.cc_gety + .cc_getheight - 5), 1, 0);
cc_setsize(0, 5, 1, 0);
cc_setgraphic($graphic5);
cc_settiling(false);
cc_create($component0, 5, 4, 0);
cc_setposition(0, 0, 1, 0);
cc_setsize(0, 16, 1, 0);
cc_setgraphic($graphic6);
cc_settiling(false);
cc_setonhold("script32($component0, $component1)");
cc_setnoclickthrough(true);
cc_create($component0, 5, 5, 0);
cc_setposition(0, 0, 1, 2);
cc_setsize(0, 16, 1, 0);
cc_setgraphic($graphic7);
cc_settiling(false);
cc_setonhold("script33($component0, $component1)");
cc_setnoclickthrough(true);
if_setonscrollwheel("script36($component0, $component1, event_mousey)", $component1);

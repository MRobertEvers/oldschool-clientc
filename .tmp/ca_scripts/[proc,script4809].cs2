// 4809
[proc,script4809](component $component0, int $int1, int $int2, int $int3, int $int4, int $int5, string $text0, string $text1)(int, int)
cc_create($component0, 3, $int1, 0);
cc_setsize($int4, $int5, 0, 0);
cc_setposition($int2, $int3, 0, 0);
cc_setcolour(^white);
cc_setfill(true);
def_int $trans6 = 0;
if (calc($int1 % 2) = 1) {
	$trans6 = 230;
} else {
	$trans6 = 245;
}
cc_settrans($trans6);
$int1 = calc($int1 + 1);
cc_create($component0, 4, $int1, 0);
cc_setsize($int4, $int5, 0, 0);
cc_setposition(calc($int2 + 5), $int3, 0, 0);
cc_settext($text0);
cc_settextfont(fontmetrics_495);
cc_settextalign(0, 1, 0);

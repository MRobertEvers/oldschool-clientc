// 716
[proc,script716](obj $obj0)(int)
def_int $total1 = inv_total(inv_93, $obj0);
def_obj $obj2 = oc_cert($obj0);
if ($obj2 = $obj0) {
	return($total1);
}
def_int $total3 = inv_total(inv_93, $obj2);
if (calc(^max_32bit_int - $total1) < $total3) {
	return(^max_32bit_int);
}
return(calc($total1 + $total3));

// 35
[clientscript,script35](component $component0, component $component1, int $int2, int $int3)
def_int $int4 = 0;
def_int $int5 = 0;
if (cc_find($component0, 1) = ^true) {
	if (.cc_find($component0, 2) = ^true) {
		.cc_setposition(0, calc($int2 + 16), 1, 0);
	}
	if (.cc_find($component0, 3) = ^true) {
		.cc_setposition(0, calc($int2 + 16 + cc_getheight - 5), 1, 0);
	}
	$int4 = calc(if_getheight($component0) - 32 - cc_getheight);
	$int5 = calc(if_getscrollheight($component1) - if_getheight($component1));
	$int2 = calc($int2 * $int5 / max(1, $int4));
	~script37($component0, $component1, $int2, $int3);
}

// 4827
[clientscript,script4827](int $int0, component $component1, int $int2)
if ($int0 = 1) {
	if (cc_find($component1, 0) = ^true) {
		cc_settrans(100);
	}
	if (cc_find($component1, 3) = ^true) {
		cc_settrans(125);
		cc_setgraphic("graphic_788");
	}
	if (cc_find($component1, 4) = ^true) {
		cc_setcolour($int2);
	}
} else {
	~script4828($component1, $int2);
}

// 740
[clientscript,script740](component $component0, component $component1)
def_int $int2 = ~script1045(calc(if_getscrollheight($component1) - if_getheight($component1)), 1);
def_int $int3 = calc(if_getheight($component0) - 32 - cc_getheight);
if (cc_find($component0, 1) = ^true) {
	cc_setposition(0, calc(16 + $int3 * if_getscrolly($component1) / $int2), 1, 0);
}
if (.cc_find($component0, 2) = ^true) {
	.cc_setposition(0, cc_gety, 1, 0);
}
if (.cc_find($component0, 3) = ^true) {
	.cc_setposition(0, calc(cc_gety + cc_getheight - 5), 1, 0);

print("Initializing Lua script")
Game.ModelViewer_Init()


local io_queue = Platform.GetIOQueue()
print(io_queue)

Game.Dat1_ConfigFileFetch(io_queue)

Platform.LoadIO(io_queue)

Game.Dat1_ConfigFileLoad(io_queue)
print("Config file loaded")

Game.Dat1_ModelFetch(io_queue, 0)

Platform.LoadIO(io_queue)

Game.Dat1_ModelLoad(io_queue)
print("Model loaded")

Game.Dat1_SubmitGameCacheModel(0)
print("Game cache model submitted")

Game.ModelViewer_RenderModel(0)
print("Render Model")
local model_id = ...

local io_queue = Platform.GetIOQueue()

Game.Dat1_ModelFetch(io_queue, model_id)

Platform.LoadIO(io_queue)

Game.Dat1_ModelLoad(io_queue)
print("Model loaded")

Game.Dat1_SubmitGameCacheModel(model_id)
print("Game cache model submitted")

Game.ModelViewer_RenderModel(model_id)
